geographbg:ХитърПетър rdfs:label "Хитър Петър"@bg ;
    geographbg:имаАлтернативноИме "Итар Пейо"@bg ;
    geographbg:имаОписание "Традиционен герой от българския фолклор, известен с хитрост, мъдрост и находчивост. Истории за него се разказват в Добруджа, Тракия и Македония."@bg ;
    geographbg:свързанС geographbg:ДобруджаЕтнографскаОбласт,
        geographbg:МакедонияЕтнографскаОбласт,
        geographbg:ТракияЕтнографскаОбласт .

geographbg:ХлябИСолЦеремония a geographbg:Събитие ;
    rdfs:label "Хляб и сол (церемония)"@bg ;
    geographbg:имаОписание "Традиционна славянска церемония за посрещане на гости. Момиче в народна носия поднася питка и сол. Гостите откъсват залък, потапят в солта и изяждат. Разпространена в славянски страни, Литва и Румъния."@bg ;
    geographbg:свързанС geographbg:България,
        geographbg:Литва,
        geographbg:Полша,
        geographbg:Румъния,
        geographbg:Русия,
        geographbg:СевернаМакедония,
        geographbg:Словакия,
        geographbg:Сърбия,
        geographbg:Украйна,
        geographbg:Хърватия,
        geographbg:Чехия .

