    geographbg:имаОписание "Основан край Мюнхен като обединение на националистически емигрантски групи."@bg ;
    geographbg:основанПрезГодина 1948 ;
    geographbg:свързанС geographbg:МюнхенГрад .

geographbg:БългарскиОсвободителниБратства a geographbg:Организация ;
    rdfs:label "Български освободителни братства"@bg .

geographbg:БългарскиФолклорСписание rdfs:label "Български фолклор (списание)"@bg ;
    geographbg:имаОписание "Рецензирано научно списание на Института за етнология и фолклористика с етнографски музей при БАН. Основано през 1975 г. Публикува фолклористични, етноложки и антроположки изследвания. Излиза в четири книжки годишно."@bg ;
    geographbg:основанПрезГодина 1975 ;
    geographbg:свързанС geographbg:ИнститутЗаЕтнологияИФолклористикаСЕтнографскиМузей .

geographbg:БългарскоНародноТворчество rdfs:label "Българско народно творчество"@bg ;
    geographbg:имаОписание "Общо наименование за произведенията на изкуството и постиженията на културата, предаващи се традиционно от поколение на поколение българи. Включва български народни приказки, легенди, пословици, поговорки, песни, танци, народни облекла и художествени мотиви за украса."@bg .

geographbg:БългарскоСдружениеНаРодоветеОтМакедония a geographbg:Организация ;
    rdfs:label "Българско сдружение на родовете от Македония"@bg ;
    geographbg:имаАлтернативноИме "БСРМ"@bg ;
    geographbg:имаОписание "Неправителствена непартийна организация на наследници на видни семейства и личности от Македония."@bg ;
    geographbg:находящСеВ geographbg:София ;
    geographbg:основанПрезГодина 2012 .

