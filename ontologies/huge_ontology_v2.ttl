    geographbg:имаСтатутНаЗащитенаМестност "Опазване на характерен ландшафт."@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:КръставаСело .

geographbg:СухаЛъкаКръставаЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Суха лъка (защитена местност, Кръстава)"@bg ;
    geographbg:датаНаОбявяване "1976-04-19"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 3.2 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на характерен ландшафт."@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:КръставаСело .

geographbg:СуходолКвартал a geographbg:Квартал ;
    rdfs:label "Суходол (квартал)"@bg ;
    geographbg:държава geographbg:България .

geographbg:СуходолЯзовир a geographbg:Язовир ;
    rdfs:label "Суходол (язовир)"@bg ;
    geographbg:намираСеНаРека geographbg:СуходолскаРека .

geographbg:СушицаРекаБоздаг a geographbg:Река ;
    rdfs:label "Сушица (река, Боздаг)"@bg ;
    geographbg:вливаСеВ geographbg:ПанегаРека ;
    geographbg:държава geographbg:Гърция ;
    geographbg:извираОт [ a geographbg:Местоположение ;
