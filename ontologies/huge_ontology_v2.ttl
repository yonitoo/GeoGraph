    geographbg:датаНаОбявяване "2001-01-23"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 760.83 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на Поморийското езеро, солниците и прилежащите крайбрежни терени като влажна зона с международно значение и като местообитание на 63 вида застрашени от изчезване птици."@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:ПомориеГрад ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаПоморийскоЕзеро ;
