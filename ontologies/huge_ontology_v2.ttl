    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 710.57 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на защитени и ендемични растителни и животински видове и техните местообитания, и за опазване на природни местообитания."@bg ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:ВидраЖивотинскиВид ;
    geographbg:имаХарактеренРастителенВид geographbg:РодопскиСиливряк ;
    geographbg:намираСеВЗемлищетоНа geographbg:ГьовренСело,
        geographbg:ТриградСело,
        geographbg:ЯгодинаСело ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаТриградМурсалицаПтици ;
    geographbg:свързанС geographbg:ТриградскоЖдрелоПролом .

geographbg:Тримирене a geographbg:Събитие ;
    rdfs:label "Тримирене"@bg ;
    geographbg:имаАлтернативноИме "Едноница"@bg,
        "Тримеро"@bg,
        "Търпило"@bg ;
    geographbg:имаОписание "Спазване на строг пост (без храна и вода, сексуално въздържание) през първите три дни на Тодоровата неделя. В последния ден тримерникът се причестява и раздава постна храна. Смята се за „живо одуше“."@bg ;
    geographbg:свързанС geographbg:ТодороваНеделя .

geographbg:ТримиренеОбичай a geographbg:Събитие ;
    rdfs:label "Тримирене (обичай)"@bg ;
    geographbg:имаАлтернативноИме "Едноница"@bg,
        "Тримеро"@bg,
        "Търпило"@bg ;
    geographbg:имаОписание "Спазване на строг пост през първите три дни на Тодоровата неделя. В последния ден тримерникът се причестява и раздава постна храна. Смята се за „живо одуше“."@bg ;
    geographbg:свързанС geographbg:ТодороваНеделя .

geographbg:ТричанеНаКучета a geographbg:Събитие ;
    rdfs:label "Тричане на кучетата"@bg ;
    geographbg:имаОписание "Обичай, изпълняван на Чист понеделник (Тодорова неделя) за предпазване на кучетата от бяс. Известен в Източна и Южна България. Включва ритуално въртене или люлеене на кучета. Регионални варианти: „цирене“ (Добруджа), „церилка“ (Странджа), „Виси куче“ (Пловдивско), „Беси понеделник“ (Троянско). Обичаят е криминализиран през 2011 г."@bg ;
    geographbg:свързанС geographbg:Гърция,
        geographbg:ДобруджаЕтнографскаОбласт,
        geographbg:ИзточнаБългарияЕтнографскаОбласт,
        geographbg:ИзточниРодопи,
        geographbg:ПиринскиКрай,
        geographbg:ПловдивскоОбласт,
        geographbg:Румъния,
        geographbg:СтранджаЕтнографскаОбласт,
        geographbg:ТодороваНеделя,
        geographbg:ТроянскоРегион,
        geographbg:ЦентралнаБългария,
        geographbg:ЮжнаБългарияЕтнографскаОбласт .

geographbg:ТроговаДолина a geographbg:РелефнаФорма ;
    rdfs:label "Трогова долина"@bg ;
    geographbg:имаОписание "Троговата (ледникова) долина е глациална форма на релефа, характерна за планините — започва от отворената страна на циркуса и е образувана от ерозионното действие на ледник. Троговите долини и циркусите са форми на релефа, характерни за планините."@bg .

geographbg:ТръбопроводПровадияДевня a geographbg:Водопровод ;
    rdfs:label "Тръбопровод Провадия-Девня"@bg ;
    geographbg:свързва geographbg:ЗаводСодиДевня,
        geographbg:ПровадияГрад .

geographbg:ТрънскаМахала a geographbg:КварталНаСофия ;
    rdfs:label "Трънска махала"@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:СофияГрад ;
    geographbg:намираСеМежду geographbg:РепубликаКвартал,
        geographbg:ФилиповциКвартал ;
    geographbg:намираСеНаБрягНа geographbg:БанскаРекаПритокМарица ;
    geographbg:разположенВМестност geographbg:ЛюлинРайон,
        geographbg:ОбработваемиЗемиИПромишлениТерени .

geographbg:ТрънскаНосия rdfs:label "Трънска носия"@bg ;
    geographbg:имаОписание "Народна носия от Трънско, Краище и Знеполе, част от белодрешковските народни облекла. Женската носия включва сукман (литак), алавицита (праведници), пъстроцветни престилки, тканица (колан), вълнени чорапи и опинци. Мъжката носия (билетите) включва беневреци (бременци), кошули, доранче, пояс и капа."@bg ;
    geographbg:свързанС geographbg:БелодрешнаНосия,
        geographbg:ЗнеполеОбласт,
        geographbg:КраищеОбласт,
        geographbg:Трънско .

