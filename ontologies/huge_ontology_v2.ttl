    geographbg:имаЛиста "елиптични, заоблени на върха, долните с дръжки, горните приседнали"@bg ;
    geographbg:имаМестообитание "пясъчни плажове по Средиземноморието и Черноморието"@bg ;
    geographbg:имаОрехчета "дребни и тъмнокафяви"@bg ;
    geographbg:имаПопулация "малочислени"@bg ;
