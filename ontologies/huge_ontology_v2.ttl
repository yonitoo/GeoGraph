geographbg:ПолезащитниГорскиПоясиЮжнаДобруджа a geographbg:Гора,
        geographbg:ИзкуственоНасаждение ;
    rdfs:label "Полезащитни горски пояси в Южна Добруджа"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаИстория "Ветрозащитно залесяване започва след 1925 г. Първите полезащитни пояси от съвременен тип в Добруджа са засадени в землището на село Карвуна през 1936 – 1939 г."@bg ;
    geographbg:имаОписание "Изкуствено създадени горски насаждения за борба с ветровата и водната ерозия, сушата и суховеите. Първите са засадени в землището на село Карвуна през 1936 – 1939 г. Системата е регламентирана с постановление от 8 март 1951 г. Главните пояси са перпендикулярно на ветровете (разстояние 400-600м), второстепенните напречно на главните (разстояние 1000-2000м). Актуална средна височина 18-20м."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 6510.0 ] ;
    geographbg:имаХарактеренРастителенВид geographbg:ГорскаКруша,
        geographbg:Кайсия,
        geographbg:Леска,
        geographbg:Лигуструм,
        geographbg:Липа,
        geographbg:Люляк,
        geographbg:ОбикновенБряст,
        geographbg:Орех,
        geographbg:ОстролистенКлен,
        geographbg:Слива,
        geographbg:ФренскоГрозде,
        geographbg:Череша,
        geographbg:Черница ;
    geographbg:находящСеВ geographbg:ЮжнаДобруджа ;
    geographbg:началоНаИзграждане "след 1925 г."@bg ;
    geographbg:общаПлощДобричкаОбласт [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 6510.0 ] ;
    geographbg:първиПоясиСъвремененТип "1936-1939, землище на село Карвуна"@bg ;
    geographbg:регламентираноИзграждане "след 1951-03-08 (ПМС № 236)"@bg ;
    geographbg:среднаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност "18-20"^^xsd:string ] ;
    geographbg:цел "борба с ветровата и водната ерозия, със сушата и суховеите"@bg .

