geographbg:ЧернатицаРид a geographbg:Рид ;
    rdfs:label "Чернатица (рид)"@bg .

geographbg:ЧернодрешнаНосия rdfs:label "Чернодрешна носия"@bg ;
    geographbg:имаОписание "Мъжки традиционен костюм, една от главните категории на мъжките български носии. Името идва от тъмния цвят на вълнената тъкан за горните дрехи. Костюмът включва панталони (потури, чешири, шалвари или димии), риза, горни дрехи (елек, джамадан, аба, салтамарка) и пояс. Разпространена приблизително на изток от ятовата граница, както и в Македония, достигайки на североизток до Кюстендилско и Горноджумайско."@bg ;
    geographbg:свързанС geographbg:Горноджумайско,
        geographbg:Кюстендилско,
        geographbg:МакедонияЕтнографскаОбласт .

geographbg:ЧерноземниПочвиБългария a geographbg:ЧерноземниПочви ;
    rdfs:label "Черноземни почви в България"@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Декар ;
            geographbg:имаСтойност 23000000.0 ] ;
    geographbg:имаРазновидности "карбонатни, типични, излужени, деградирани, тежки глинести"@bg ;
    geographbg:разпространениВ geographbg:СевернаБългария,
        geographbg:ЮгоизточнаБългария .

