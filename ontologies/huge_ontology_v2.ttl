@prefix geographbg: <http://example.org/geographbg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geographbg:AmmarIbnAliAlMawsili a geographbg:Човек ;
    rdfs:label "Ammar ibn Ali al-Mawsili"@bg ;
    geographbg:имаАвтор geographbg:ИнжективниПрепарати .

geographbg:AnserThraceiensis a geographbg:ЖивотинскиВид ;
    rdfs:label "Anser thraceiensis"@bg ;
    geographbg:имаОписание "Фосилен вид птица, описан от България."@bg .

geographbg:BalcanasGenus a geographbg:ЖивотинскиВид ;
    rdfs:label "Balcanas (род)"@bg ;
    geographbg:имаОписание "Фосилен род птица, описан от България (ранен плиоцен, Дорково)."@bg .

geographbg:Bovinae a geographbg:Подсемейство ;
    rdfs:label "Говеда"@bg ;
    geographbg:имаРод geographbg:Bison,
        geographbg:Bos,
        geographbg:Boselaphus,
        geographbg:Bubalus,
        geographbg:Pseudonovibos,
        geographbg:Pseudoryx,
        geographbg:Syncerus,
        geographbg:Taurotragus,
        geographbg:Tetracerus,
        geographbg:Tragelaphus .

geographbg:ChauvireriaGenus a geographbg:ЖивотинскиВид ;
    rdfs:label "Chauvireria (род)"@bg ;
    geographbg:имаОписание "Фосилен род птица, описан от България (ранен плейстоцен, Вършец)."@bg .

geographbg:DeinotheriumСкелетАсеновград a geographbg:КултуренОбект ;
    rdfs:label "Скелет от Deinotherium (Палеонтологичен музей Асеновград)"@bg ;
    geographbg:находящСеВ geographbg:ПалеонтологиченМузейАсеновград .

geographbg:FulicaAtraPontica a geographbg:ЖивотинскиВид ;
    rdfs:label "Fulica atra pontica"@bg ;
    geographbg:имаОписание "Субфосилен подвид птица, описан от България (ранен холоцен)."@bg .

geographbg:ISO31662BG a owl:Thing ;
    rdfs:label "ISO 3166-2:BG"@bg ;
    geographbg:имаОписание "Стандарт на ISO, който дефинира геокодове. Част от ISO 3166-2, засягаща България."@bg .

geographbg:KalimantsiaBulgaricaФрагмент a geographbg:КултуренОбект ;
    rdfs:label "Фрагмент от череп на Kalimantsia bulgarica"@bg ;
    geographbg:находящСеВ geographbg:ПалеонтологиченМузейАсеновград .

geographbg:LidovePovidkyJihomakedonske rdfs:label "Lidové povídky jihomakedonské"@bg ;
    geographbg:имаОписание "Етнографски сборник с български народни приказки, предания и легенди, събрани от Стефан Веркович и издадени от Пьотър Лавров и Иржи Поливка в Прага в 1932 година. Съдържа едни от първите записи на български вълшебни приказки. Приказките са събрани от Христодул Божиков от село Висока (Лъгадинско поле) и други от села Лехово, Търли и Старчища."@bg ;
    geographbg:основанПрезГодина 1932 ;
    geographbg:свързанС geographbg:ВисокаСелоЛъгадинско,
        geographbg:ЛеховоСело,
        geographbg:СтарчищаСело,
        geographbg:ТърлиСело .

geographbg:NicotianaRustica a geographbg:Тютюн ;
    rdfs:label "Nicotiana rustica"@bg ;
    geographbg:имаУпотреба "пушене, смъркане"@bg .

geographbg:NicotianaTabacum a geographbg:Тютюн ;
    rdfs:label "Nicotiana tabacum"@bg ;
    geographbg:имаУпотреба "пушене на цигари и пури"@bg .

geographbg:ParakramaBahu a geographbg:Човек ;
    rdfs:label "Parakrama Bahu"@bg ;
    geographbg:имаИсторическоСъбитие geographbg:Мелиорация .

geographbg:PhalacrocoraxSerdicensis a geographbg:ЖивотинскиВид ;
    rdfs:label "Phalacrocorax serdicensis"@bg ;
    geographbg:имаОписание "Фосилен вид птица, описан от България."@bg .

geographbg:PhaseolusVulgaris a geographbg:РастителенВид ;
    rdfs:label "Фасул"@bg ;
    geographbg:използваСеЗа "храна"@bg ;
    geographbg:имаРод geographbg:Phaseolus ;
    geographbg:разпространенВ "тропични, субтропични и умерени климати"@bg .

geographbg:RezenKnollАнтарктика a geographbg:ПланинскиВръх ;
    rdfs:label "Rezen Knoll (Антарктика)"@bg .

geographbg:SEMPERVIVA a geographbg:Организация ;
    rdfs:label "Българско дружество за опазване на биологичното разнообразие SEMPERVIVA"@bg .

geographbg:StruthioKaratheodoris a geographbg:ЖивотинскиВид ;
    rdfs:label "Struthio karatheodoris"@bg ;
    geographbg:имаОписание "Фосилен вид птица, установен в България."@bg .

geographbg:АЕЦКозлодуй a geographbg:АЕЦ ;
    rdfs:label "АЕЦ Козлодуй"@bg ;
