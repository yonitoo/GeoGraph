            geographbg:имаМернаЕдиница geographbg:Мегават ;
            geographbg:имаСтойност 3760.0 ] .

geographbg:АРМАПБ a geographbg:Организация ;
    rdfs:label "Асоциация за развъждане на местни автохтонни породи в България"@bg .

geographbg:АТПБухово a geographbg:Организация ;
    rdfs:label "АТП –Бухово"@bg ;
    geographbg:находящСеВ geographbg:БуховоМестоположение .

geographbg:АбланицаРека a geographbg:Река ;
    rdfs:label "Абланица (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:еСъставящаЧастНа geographbg:ЧепинскаРека ;
    geographbg:извираОт [ a geographbg:Местност ;
            rdfs:label "местността Флорови колиби"@bg ;
            geographbg:находящСеВ geographbg:ЗападниРодопи ] ;
    geographbg:имаАлтернативноИме "Ябланица"@bg ;
    geographbg:находящСеВ geographbg:ЗападниРодопи .

geographbg:Авицена a geographbg:Човек ;
    rdfs:label "Авицена"@bg ;
    geographbg:имаАвтор geographbg:КанонНаМедицината .

geographbg:АврамовоСело a geographbg:Село ;
    rdfs:label "Аврамово (село)"@bg ;
    geographbg:близоДо geographbg:АврамоваСедловина,
        geographbg:ГараАврамово .

geographbg:АвренСелоКрумовград a geographbg:Село ;
    rdfs:label "Аврен (Крумовградско)"@bg .

geographbg:Австрия geographbg:предлагаДанъчниОблекчения false .

geographbg:Автобус66София a geographbg:ИнфраструктуренОбект ;
    rdfs:label "Автобус №66 (София)"@bg ;
    geographbg:свързва geographbg:КварталДрагалевци,
        geographbg:ХижаАлеко .

geographbg:АвтомагистралаТракия a geographbg:Път ;
    rdfs:label "Автомагистрала „Тракия“"@bg ;
    geographbg:имаОписание "Автомагистрала „Тракия“ (А1) е автомагистрала в Южна България. Свързва столицата София с град Бургас на брега на Черно море, преминавайки през Пловдив и Сливен. Обща дължина 360 km. Първата автомагистрала в България, наименувана на историко-географската област Тракия."@bg ;
    geographbg:именуваНа geographbg:Тракия ;
    geographbg:преминаваПрез geographbg:ПловдивГрад,
        geographbg:СливенГрад ;
    geographbg:свързва geographbg:БургасГрад,
        geographbg:София .

geographbg:АвтомобиленПътПрезАврамоваСедловина a geographbg:Път ;
    rdfs:label "Автомобилен път Велинград - Якоруда - Разлог"@bg ;
    geographbg:преминаваПрез geographbg:АврамоваСедловина ;
    geographbg:свързва geographbg:ВелинградГрад,
        geographbg:Разлог,
        geographbg:ЯкорудаГрад .

geographbg:АвтономнаМакедонияВестник1920 a owl:Thing ;
    rdfs:label "Автономна Македония (вестник, 1920-1923)"@bg ;
    geographbg:имаОписание "Български седмичен вестник, орган на македонската емиграция в България, излизал от 1920 до 1923 г. в София."@bg ;
    geographbg:свързанС geographbg:МакедонскаФедеративнаЕмигрантскаОрганизация,
        geographbg:София .

geographbg:АгенцияЗаБългаритеВЧужбина a geographbg:Организация ;
    rdfs:label "Агенция за българите в чужбина"@bg .

geographbg:АгликинаПолянаМестност a geographbg:ЗащитенаМестност,
        geographbg:Местност ;
    rdfs:label "Агликина поляна"@bg ;
    geographbg:близоДо geographbg:ВратникПроход,
        geographbg:СливенГрад ;
    geographbg:датаНаОбявяване "1964-01-21"^^xsd:date ;
    geographbg:имаИстория "Сборно място на хайдутите по време на османската власт."@bg ;
    geographbg:имаОписание "Просторна поляна, заобиколена от вековни дъбове и букове."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 120.0 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на вековна букова гора."@bg ;
    geographbg:имаХарактеренРастителенВид geographbg:Бук,
        geographbg:Дъб ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаСинитеКамъниГребенец,
        geographbg:СливенскиБалкан .

geographbg:АграрниНауки a owl:Class ;
    rdfs:label "Аграрни науки"@bg ;
    rdfs:subClassOf geographbg:Наука .

geographbg:АграфаПланинскиМасив a geographbg:Планина ;
    rdfs:label "Аграфа (планински масив)"@bg ;
    geographbg:държава geographbg:Гърция ;
    geographbg:находящСеВ geographbg:ПиндПланина .

geographbg:АгушевиКонаци a geographbg:КултуренОбект ;
    rdfs:label "Агушеви конаци"@bg ;
    geographbg:близоДо geographbg:Арда ;
    geographbg:имаИстория "Комплексът от сгради в Могилица е изграден за около 20 години от местни майстори. Първата част е завършена 1825 г., а втората през 1843 г. (надпис '1258 по егира'). Конаците са реставрирани от арх. Георги Лабов. В края на ХХ век е реставриран и превърнат в етнографски музей. След реституция през 2001 г. Агушевите конаци са върнати на наследниците на Салих Ага."@bg ;
    geographbg:имаОписание "Архитектурен и художествен паметник от национално значение. Най-големият запазен феодален ансамбъл в Родопите. Архитектурен ансамбъл от две представителни жилищни сгради и стопански постройки. Съградени са така, че да образуват 3 самостоятелни двора. Всички сгради в конака имат общо 221 прозореца, 86 врати и 24 комина. Кулата е разположена в югоизточната част на конака и наподобява на морски фар. В Агушевите конаци е имало библиотека – една от най-големите частни библиотеки на Балканите в края на ХІХ и началото на ХХ век."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Декар ;
            geographbg:имаСтойност 4.0 ] ;
    geographbg:находящСеВ geographbg:МогилицаСело .

geographbg:АдМарум a geographbg:Крепост ;
    rdfs:label "Ад Марум"@bg ;
    geographbg:имаНадморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 35.0 ] .

geographbg:АджемлерСело a geographbg:Село ;
    rdfs:label "Аджемлер"@bg .

geographbg:АзмакаПритокСазлийка a geographbg:Река ;
    rdfs:label "Азмака (приток на Сазлийка)"@bg ;
    geographbg:вливаСеВ geographbg:СазлийкаРека ;
    geographbg:държава geographbg:България ;
    geographbg:извираОт [ a geographbg:Извор ;
            rdfs:label "извор-чешма в Кирилово"@bg ;
            geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
                    geographbg:имаМернаЕдиница geographbg:Метър ;
                    geographbg:имаСтойност 265.0 ] ;
            geographbg:находящСеВ geographbg:КириловоСело ] ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 25.0 ] ;
    geographbg:площНаВодосборенБасейн [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 152.0 ] ;
    geographbg:преминаваПрез geographbg:ЕлениноСело,
        geographbg:ЗагореСело,
        geographbg:КириловоСело,
        geographbg:МаджеритоСело ;
    geographbg:притокНа geographbg:СазлийкаРека .

geographbg:Азоналност_Явление a geographbg:Азоналност ;
    rdfs:label "Азоналност"@bg ;
    geographbg:имаОписание "Разпространение на природно явление извън причинно-следствената връзка със зоналните особености на дадена територия."@bg ;
    geographbg:имаПроизход "гръцки a – отрицателна частица и Zönë  — «пояс, зона»"@bg ;
    geographbg:определя "формирането на регионални ландшафтни комплекси"@bg .

geographbg:Айгер a geographbg:Карлинг,
        geographbg:ЛедниковРог ;
    rdfs:label "Айгер"@bg ;
    geographbg:намираСеВ geographbg:БернскиАлпи ;
    geographbg:намираСеВЗемлищетоНа geographbg:БернскиАлпи ;
    geographbg:находящСеВ geographbg:БернскиАлпи .

geographbg:АйдаЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Айда (защитена местност)"@bg ;
    geographbg:датаНаОбявяване "1973-12-20"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 3.5 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на забележителен ландшафт, местообитания на редки и уязвими растителни и животински видове."@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:СпахиевоСело .

geographbg:АксуРекаГърция a geographbg:Река ;
    rdfs:label "Аксу (река, Гърция)"@bg ;
    geographbg:държава geographbg:Гърция ;
    geographbg:извираОт geographbg:ГюмюрджинскиСнежникРид .

geographbg:АлКинди a geographbg:Човек ;
    rdfs:label "Ал Кинди"@bg ;
    geographbg:имаАвтор geographbg:DeGradibus .

geographbg:АладаВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Алада (връх)"@bg .

geographbg:АладжаМанастирЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Аладжа манастир (защитена местност)"@bg ;
    geographbg:датаНаОбявяване "1943-02-03"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 17.0 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на територии със забележителен ландшафт и опазване на местообитанията на застрашени и редки растителни и животински видове и съобщества."@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:ВарнаГрад ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаБатова ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркЗлатниПясъци .

geographbg:АладжаМанастирКултуренОбект a geographbg:КултуренОбект,
        geographbg:Манастир ;
    rdfs:label "Аладжа манастир"@bg ;
    geographbg:близоДо geographbg:ВарнаГрад,
        geographbg:ЗлатниПясъциКурорт ;
    geographbg:имаАлтернативноИме "Света Троица"@bg,
        "Свети Спас"@bg ;
    geographbg:имаЕтимология "Името 'аладжа' е от персийски или арабски произход и означава 'пъстър, шарен'."@bg ;
    geographbg:имаОписание "Средновековен скален манастир. Манастирските пещери са изсечени в 25-метрова отвесна карстова скала."@bg ;
    geographbg:находящСеВ geographbg:ФрангенскоПлато ;
    geographbg:основанПрезГодина 1250 .

geographbg:АлафрангаДрехиКопривщица rdfs:label "Алафранга дрехи (Копривщица)"@bg ;
    geographbg:свързанС geographbg:КопривщенскаНосия .

geographbg:АлбумПеснитеНаНашитеДеца a geographbg:КултуренОбект ;
    rdfs:label "Песните на нашите деца (албум)"@bg ;
    geographbg:имаОписание "Втори фолклорен албум на Димитър Аргиров, издаден 2016 г. Посветен на 85-год. от рождението на Илия Аргиров. Съдържа 12 песни от репертоара на Илия Аргиров, три в дует."@bg ;
    geographbg:основанПрезГодина 2016 .

geographbg:АлбумПиринскиЦветя a geographbg:КултуренОбект ;
    rdfs:label "Пирински цветя (албум)"@bg ;
    geographbg:имаОписание "Трети фолклорен албум на Димитър Аргиров, издаден 2017 г. Посветен на 50-год. юбилей на певеца и 5-год. от кончината на баща му Илия Аргиров. Съдържа 12 студийни и 1 концертна песен."@bg ;
    geographbg:основанПрезГодина 2017 .

geographbg:АлдомировскоБлато a geographbg:Блато,
        geographbg:ЗащитенаМестност ;
    rdfs:label "Алдомировско блато"@bg ;
    geographbg:близоДо geographbg:АлдомировциЖПГара,
        geographbg:СливницаГрад,
        geographbg:ТриУшиРид ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Блато с карстов характер."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 129.40 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на естествените местообитания на защитени и редки видове водолюбиви птици и растителните асоциации на 40 вида висши растения."@bg ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:Бойник,
