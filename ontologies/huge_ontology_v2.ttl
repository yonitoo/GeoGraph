geographbg:МараЛишанкаОбичай a geographbg:Събитие ;
    rdfs:label "Мара Лишанка (обичай)"@bg ;
    geographbg:имаОписание "Момински обичай сред рупците в Странджа, изпълняван в срядата след Великден за плодородие, дъжд и предпазване от злини. Приготвя се кукла „Мара Лишанка“ от чехли, носи се от мома, пеят се песни, накрая куклата се „изкъпва“ в река."@bg,
        "Момински обичай, изпълняван сред рупците в Странджа в срядата след Великден за плодородие, дъжд и предпазване от злини. Приготвя се кукла „Мара Лишанка“ от чехли, която се носи от мома. Момите пеят и играят, накрая куклата се „изкъпва“ в река."@bg ;
    geographbg:свързанС geographbg:РупциЕтнографскаГрупа,
        geographbg:СтранджаЕтнографскаОбласт .

