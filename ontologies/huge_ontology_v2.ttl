    rdfs:label "Кулата (връх, Ардински дял)"@bg .

geographbg:КумаЛиса rdfs:label "Кума Лиса"@bg ;
    geographbg:имаОписание "Персонаж в приказките за животни в българския фолклор, символ на хитрост, коварство и изобретателност. Често самата тя бива надхитряна. Подобен персонаж се среща и в руския фолклор."@bg .

geographbg:КуманицаПещера a geographbg:Пещера ;
    rdfs:label "Куманица (пещера)"@bg ;
    geographbg:находящСеВ geographbg:БиосференРезерватСтенето ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 2000.0 ] .

geographbg:КумановскаКаза a geographbg:АдминистративнаЕдиница ;
    rdfs:label "Кумановска каза"@bg .

geographbg:КумруджаРека a geographbg:Река ;
    rdfs:label "Кумруджа"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:еСъставящаЧастНа [ a geographbg:Река ;
            rdfs:label "Коленска река"@bg ;
            geographbg:извираОт [ a geographbg:Местоположение ;
                    rdfs:label "Сърнена Средна гора, близо до връх Горяла могила"@bg ;
                    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
                            geographbg:имаМернаЕдиница geographbg:Метър ;
                            geographbg:имаСтойност 588.0 ] ] ] ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 47.0 ] ;
    geographbg:площНаВодосборенБасейн [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 321.0 ] ;
    geographbg:преминаваПрез geographbg:ГорноБотевоСело,
        geographbg:ДаскалАтанасовоСело,
        geographbg:КоленаСело,
        geographbg:ПшеничевоСело,
        geographbg:РадневоГрадБлатница ;
    geographbg:притокНа geographbg:СазлийкаРека .

geographbg:КурбанОбичай a geographbg:Събитие ;
    rdfs:label "Курбан (обичай)"@bg ;
    geographbg:имаОписание "Личен празник в България, правен от човек, избавил се от премеждие с помощта на светец. В Западна България е близък до светеца."@bg .

geographbg:КурортноСелищеСозополис a geographbg:Местоположение ;
    rdfs:label "курортно селище Созополис"@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 8.85 ] ;
    geographbg:находящСеВ geographbg:НосКолокита .

geographbg:КуртамзалиСело a geographbg:Село ;
    rdfs:label "Куртамзали"@bg ;
    geographbg:държава geographbg:СевернаМакедония ;
    geographbg:имаАлтернативноИме "Куртхамзали"@bg ;
    geographbg:имаИстория "През XIX век селото е чисто турско. В „Етнография на вилаетите Адрианопол, Монастир и Салоника“ (1873): 40 домакинства, 92 мюсюлмани. Васил Кънчов (1900): Курт Хамзали, 180 жители, всички турци."@bg ;
    geographbg:имаНаселение [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:БройЖители ;
            geographbg:имаСтойност 121 ;
            rdfs:comment "към 2002 г."@bg ] ;
    geographbg:находящСеВ geographbg:ОбщинаДойран,
        geographbg:ПланинаБоска .

geographbg:Кутело a geographbg:ПланинскиВръх ;
    rdfs:label "Кутело"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 2908.0 ] ;
    geographbg:находящСеВ geographbg:Пирин .

geographbg:КъмпингДобруджа a geographbg:Къмпинг ;
    rdfs:label "Добруджа (къмпинг)"@bg ;
    geographbg:близоДо geographbg:ЕзерецкоЕзеро,
        geographbg:ШабленскаТузла,
        geographbg:ШабленскоЕзеро ;
    geographbg:находящСеВ "северната част на българското Черноморие, край град Шабла"@bg .

geographbg:КъмпингКарвуна a geographbg:Къмпинг ;
    rdfs:label "Карвуна (къмпинг)"@bg ;
    geographbg:находящСеВ "най-северната част на Българското Черноморие, 1 km от село Крапец"@bg ;
    geographbg:построенПрез "началото на 70-те години на XX век"@bg .

geographbg:КътинскаРека a geographbg:Река ;
    rdfs:label "Кътинска река"@bg ;
    geographbg:вливаСеВ geographbg:Искър ;
    geographbg:държава geographbg:България ;
    geographbg:извираОт geographbg:СтараПланина ;
    geographbg:находящСеВ geographbg:СофийскоПоле ;
    geographbg:притокНа geographbg:Искър .

geographbg:КътинскиПирамиди a geographbg:ПрироднаЗабележителностСтатут,
        geographbg:СкалноОбразувание ;
    rdfs:label "Кътински пирамиди"@bg ;
    geographbg:датаНаОбявяване "1962-01-01"^^xsd:date ;
    geographbg:имаГеология "Слабо споени неоген-кватернерни гравелити, пясъчници и алевролити."@bg ;
    geographbg:имаОписание "Ерозионни форми... оформени сред слабо споени неоген-кватернерни гравелити, пясъчници и алевролити. Височина на скалния откос 5-10 м, индивидуална височина на самите пирамиди не надвишава 2 м."@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
