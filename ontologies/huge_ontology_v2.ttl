            geographbg:имаСтойност 60.0 ] ;
    geographbg:имаРазновидности "различни разновидности на чернозема"@bg ;
    geographbg:разпространениВ geographbg:Украйна .

geographbg:Чернялка a geographbg:Река ;
    rdfs:label "Чернялка"@bg ;
    geographbg:имаДължина [ a geographbg:КоличественаСтойност ;
