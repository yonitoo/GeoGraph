geographbg:БеломорскаОтточнаОбластБългария a geographbg:ГеографскиРегион ;
    rdfs:label "Беломорска отточна област (България)"@bg ;
    geographbg:имаОписание "Част от територията на България, чиито речни води се оттичат в Бяло море. Включва Задбалканските котловини, част от Средногорието, Горнотракийската низина, Тунджанската низина, Осоговска планина, Влахина, Малешевска планина, Огражден, Беласица, Славянка, Рила, Пирин и Родопите."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 47133.0 ] ;
    geographbg:находящСеВ geographbg:България ;
    geographbg:свързанС geographbg:БялоМоре .

geographbg:ВарнаГрад a geographbg:Град ;
    rdfs:label "Варна"@bg,
        "Варна (град)"@bg ;
    geographbg:имаАнтичноИме "Одесос"^^xsd:string ;
    geographbg:имаОписание "В древността градът носи името Одесос. Одесос е градът-предшественик на днешна Варна."@bg ;
    geographbg:имаПолезноИзкопаемо [ a geographbg:МинераленИзвор ;
            rdfs:label "Минерални води Варна"@bg ] ;
    geographbg:находящСеВ geographbg:ЧерноморскиЕврорегион .

