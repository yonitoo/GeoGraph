geographbg:ЕтнографскиИнститутСМузей a geographbg:Музей,
        geographbg:Организация ;
    rdfs:label "Етнографски институт с музей"@bg ;
    geographbg:основанПрезГодина 1949 ;
    geographbg:свързанС geographbg:БАН .

geographbg:ЕтнографскиМузейБерковица a geographbg:Музей ;
    rdfs:label "Етнографски музей (Берковица)"@bg ;
    geographbg:имаОписание "Запознава с бита и обичаите на хората от Северозападна България. Във фондохранилищата му се пазят хиляди предмети от сферата на художественото творчество и занаяти, както и народните обичаи. Повечето експонати са свързани със занаятите, носиите и предметите от бита. Съхранява артефакти като каменна пластика, накити, монети, оръдия на труда и оръжия, битова и строителна керамика от региона."@bg ;
    geographbg:находящСеВ geographbg:БерковицаГрад .

geographbg:ЕтнографскиМузейБургас a geographbg:Музей ;
    rdfs:label "Етнографски музей (Бургас)"@bg ;
    geographbg:имаОписание "Експозицията се намира в т.нар. „Бракалова къща“. На първия етаж на сградата е аранжиран интериора на бургаската градска къща от 19 век и дамска мода от този период. На втория етаж е изложена сбирка от български традиционни костюми от всички етнографски групи в Бургаски регион. Показани са ритуални костюми и накити от ХІХ в."@bg ;
    geographbg:находящСеВ geographbg:БракаловаКъща ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейБургас .

geographbg:ЕтнографскиМузейБялаЧерква a geographbg:Музей ;
    rdfs:label "Етнографски музей (Бяла черква)"@bg ;
    geographbg:имаОписание "Етнографската експозиция включва над 2000 предмета: оръдия на труда, облекло, съдове, накити, представящи бита и традициите на населението от региона."@bg ;
    geographbg:находящСеВ geographbg:БялаЧеркваГрад ;
    geographbg:основанПрезГодина 2004 ;
    geographbg:свързанС geographbg:НародноЧиталищеБачоКиро1869 .

geographbg:ЕтнографскиМузейВарна a geographbg:Музей ;
    rdfs:label "Етнографски музей (Варна)"@bg ;
    geographbg:имаОписание "Експонирано е огромното разнообразие в културата и бита на хората от Варненския край от втората половина на XIX и началото на XX в. В музея са изложени демонстрации на основните поминъци, народни носии. Библиотеката на музея разполага с над 1600 броя книги и албуми."@bg ;
    geographbg:находящСеВ geographbg:СградаЕтнографскиМузейВарна .

geographbg:ЕтнографскиМузейДунавскиРиболовИЛодкостроене a geographbg:ЕтнографскиМузей ;
    rdfs:label "Етнографски музей „Дунавски риболов и лодкостроене“"@bg ;
    geographbg:имаЕкспозиция "Старинни модели на рибарска лодка „чамница“ и съвременна двуостра рибарска лодка „тутраканка“, каменни тежести за въдици, каменни хромели за смилане на царевично брашно"@bg ;
    geographbg:имаИстория "Музеят е открит през 1974 г. и е единствен в страните по поречието на река Дунав. Създаден е, за да съхрани богатата материална и духовна култура, обществено устройство и бит на българите от крайдунавските рибарски селища."@bg ;
    geographbg:имаСграда [ a geographbg:ИнфраструктуренОбект ;
            rdfs:label "Сграда на Етнографски музей „Дунавски риболов и лодкостроене“"@bg ;
            geographbg:датаНаЗавършване "1907-01-01"^^xsd:date ] ;
    geographbg:намираСеВЗемлищетоНа geographbg:ТутраканГрад .

geographbg:ЕтнографскиМузейДунавскиРиболовИЛодкостроенеТутракан a geographbg:Музей ;
    rdfs:label "Етнографски музей „Дунавски риболов и лодкостроене“ (Тутракан)"@bg ;
    geographbg:имаОписание "Единствен в страните по поречието на река Дунав. Създаден е, за да съхрани богатата материална и духовна култура, обществено устройство и бит на българите от крайдунавските рибарски селища. Експозицията е разположена в сграда с 7 изложбени зали, два аранжимента на интериор и минераложка изложба. В лапидариума са експонирани старинни модели на рибарски лодки и различни каменни тежести за въдици."@bg ;
    geographbg:находящСеВ geographbg:СградаМузейРиболовТутракан ;
    geographbg:основанПрезГодина 1974 ;
    geographbg:свързанС geographbg:ИсторическиМузейТутракан .

geographbg:ЕтнографскиМузейКаварна a geographbg:Музей ;
    rdfs:label "Етнографски музей (Каварна)"@bg ;
    geographbg:находящСеВ geographbg:КаварнаГрад .

geographbg:ЕтнографскиМузейРазград a geographbg:Музей ;
    rdfs:label "Етнографски музей (Разград)"@bg ;
    geographbg:имаИстория "Експозицията е открита на 10 септември 1999 г."@bg ;
    geographbg:имаОписание "Посветен на културата на една от местните етнографски групи – капанците. Представена е традиционната духовна култура на местната етнографска група, основните празници в техния годишен календар, облекло, накити и други."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенМетър ;
            geographbg:имаСтойност 150.0 ] ;
    geographbg:находящСеВ geographbg:ВъзрожденскиКъщиМузейРазград .

geographbg:ЕтнографскиМузейЧирпанлиеватаКъща a geographbg:КултуренОбект,
        geographbg:Музей ;
    rdfs:label "Етнографски музей \"Чирпанлиевата къща\""@bg ;
    geographbg:имаИстория "Създадена като етнографски музей през 1972 г."@bg ;
    geographbg:имаОписание "Показва предметите от традиционната материална и духовна култура от епохата на Възраждането. На първия етаж са показани два от типичните за Шипка занаяти - ножарство и свиркарство, а на втория е пресъздаден характерния шипченски бит от 19 - ти век и началото на 20- ти век."@bg ;
    geographbg:находящСеВ geographbg:ЧирпанлиеватаКъща ;
    geographbg:стопанисваСеОт geographbg:НародноЧиталищеСветлина1861 .

geographbg:ЕтнографскоАрхеологическиМузейЕлхово a geographbg:Музей ;
    rdfs:label "Етнографско-археологически музей (Елхово)"@bg ;
    geographbg:имаОписание "Етнографската експозиция представя разнообразното етнографско наследство на община Елхово и на голяма част от Странджанско-Сакарския край. Фондът съхранява над 22500 оригинални етнографски материали. Археологическата експозиция представя богатата хилядолетна култура на земите по Долна Тунджа. Музеят притежава над 3100 тома специализирана литература."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенМетър ;
            geographbg:имаСтойност 244.0 ] ;
    geographbg:находящСеВ geographbg:СградиМузейЕлхово ;
    geographbg:основанПрезГодина 1958 .

geographbg:ЕтнографскоВъзрожденскиКомплексСветиСофронийВрачански a geographbg:КултуренОбект,
        geographbg:Музей ;
    rdfs:label "Етнографско-възрожденски комплекс „Свети Софроний Врачански“"@bg ;
    geographbg:имаИстория "Създадена между 1972 и 1987 година."@bg ;
    geographbg:имаОписание "Архитектурно-етнографска музейна експозиция. Включва 3 възрожденски къщи и училище „Възнесение“. Представя традиционния бит, занаятите и културата на населението от Врачански регион от края на XIX до средата на XX век."@bg ;
    geographbg:находящСеВ geographbg:ВрацаГрад ;
    geographbg:свързанС geographbg:КъщаГригорияНайденов,
        geographbg:КъщаДимитракиХаджитошев,
        geographbg:КъщаИванЗамбин,
        geographbg:РегионаленИсторическиМузейВраца,
        geographbg:УчилищеВъзнесениеВраца .

geographbg:ЕтнографскоИсторическиМузейБаняСело a geographbg:Музей ;
    rdfs:label "Етнографско-исторически музей (Баня)"@bg ;
    geographbg:имаОписание "Изложени са останки от съдове от XI век преди Христа, археологически находки с келтски произход, надгробни плочи от времето на османското владичество. Етнографската част влючва глинени и други битови съдове, народни носии и произведения на народното творчество, типични за Баня. В обособен са изложени експонати, свързани с целия цикъл на ленопроизводството. Музеят има и богат снимков материал."@bg ;
    geographbg:находящСеВ geographbg:БаняСелоРазлог .

geographbg:ЕтърМузей a geographbg:КултуренОбект,
        geographbg:Музей ;
    rdfs:label "Регионален етнографски музей на открито „Етър“"@bg ;
    geographbg:имаОписание "Музей на открито, представляващ възстановка на българския бит, култура и занаятчийство. Намира се единствената в България сбирка на народна техника на вода (10 експоната). Занаятчийска чаршия представя 16 образци на балканската архитектура. Обявен за паметник на културата през 1971 г."@bg ;
    geographbg:находящСеВ geographbg:ГабровоГрад ;
    geographbg:основанПрезГодина 1964 .

geographbg:ЕтъраМузей geographbg:близоДо geographbg:СоколскиМанастирКултуренОбект .

