geographbg:ДунавскаРавнинаБГ a geographbg:ГеографскиРегион,
        geographbg:Равнина ;
    rdfs:label "Дунавска равнина (България)"@bg ;
    geographbg:имаКлимат "умереноконтинентален"@bg ;
    geographbg:имаОписание "Надморската височина на Дунавската равнина се увеличава от запад на изток: Западна (средно 130 m), Средна (средно 138 m), Източна (средно 204 m, Лилякско плато 517 m). Заема 28,42% от територията на България. Дели се на Западна, Средна и Източна от долините на реките Вит и Янтра."@bg,
        "Средна годишна сума на валежите: 500-600 mm."@bg ;
