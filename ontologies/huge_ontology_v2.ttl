geographbg:ХижаЗвездица a geographbg:Хижа ;
    rdfs:label "Звездица (хижа)"@bg ;
    geographbg:близоДо geographbg:Владая,
        geographbg:ЗлатнитеМостове,
        geographbg:КварталКняжево,
        geographbg:ХижаЕделвайсВитоша,
        geographbg:ХижаКумата,
        geographbg:ХижаОстрица,
        geographbg:ХижаСелимица,
        geographbg:ЧерниВръх ;
    geographbg:държава geographbg:България ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:БройЖители ;
            geographbg:имаСтойност 120 ] ;
    geographbg:имаОписание "Триетажна сграда с локално парно, ресторант и 120 места леглова база. В близост има ски писта, ски влек и моторни шейни. Бивше име: почивен дом „Звездица“ на БГА „Балкан“."@bg ;
    geographbg:находящСеВ [ a geographbg:Местност ;
            rdfs:label "Марина поляна"@bg ;
            geographbg:находящСеВ geographbg:Витоша ],
        geographbg:Витоша .

