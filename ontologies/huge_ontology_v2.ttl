        geographbg:КарталяскатаВода,
        geographbg:СеновръщицаРека ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 28.0 ] ;
    geographbg:площНаВодосборенБасейн [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 101.0 ] ;
    geographbg:преминаваПрез geographbg:ЕнинаСело,
