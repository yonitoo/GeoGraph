        geographbg:ДедецСело,
        geographbg:ДобромирциСело,
        geographbg:ЗлатоградГрад ;
    geographbg:датаНаОбявяване "1982-05-07"^^xsd:date ;
    geographbg:имаОписание "Намира се непосредствено край пътя за Златоград, в посока село Добромирци, между селата Дедец и Добромирци, на около 1 km от село Бенковски. Има височина 2 m, а горната част е с диаметър 3 m."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
