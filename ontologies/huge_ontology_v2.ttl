        owl:Class ;
    rdfs:label "Криминология"@bg ;
    rdfs:subClassOf geographbg:СоциалниНауки .

geographbg:КричимЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Кричим (защитена местност)"@bg ;
    geographbg:датаНаОбявяване "2000-11-01"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 169.77 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на местообитанията и популациите на защитени видове растения и животни, в това число ветрушка, обикновен мишелов, ястреб, малък корморан, бял щъркел, черен щъркел, голяма бяла чапла, сива чапла, представители на разред пойни птици, сови, кълвачи, прилепи, невестулка, видра, обикновена блатна костенурка, шипоопашата костенурка, шипобедрена костенурка, крастава жаба, жаба дървесница, малък тритон, както и съхраняване на уникална лонгозна гора и забележителен ландшафт."@bg ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:ВидраЖивотинскиВид,
        geographbg:МалъкКорморан ;
    geographbg:намираСеВЗемлищетоНа geographbg:КуртовоКонареСело .

geographbg:КрупнишкаСеизмичнаЗона a geographbg:ГеографскиРегион ;
    rdfs:label "Крупнишка сеизмична зона"@bg .

geographbg:КрушевскаАвтономнаГрупа a geographbg:Организация ;
    rdfs:label "Крушевска автономна група"@bg ;
    geographbg:имаОписание "Създадена на 1 юни 1919 година в София с цел автономия за Македония."@bg ;
    geographbg:находящСеВ geographbg:София ;
    geographbg:основанПрезГодина 1919 .

geographbg:КръстаВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Кръста (връх)"@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1560.9 ] ;
    geographbg:находящСеВ geographbg:Витоша .

geographbg:КръстатаКазарма a geographbg:КултуренОбект,
        geographbg:Музей ;
    rdfs:label "Кръстата казарма"@bg ;
    geographbg:имаИстория "Построена по поръчка на Осман Пазвантоглу през 1801 г. След Освобождението служи за съд и за казарма. През 1965 – 1967 година сградата е реставрирана и приспособена за музей. От 1969 година в сградата е уредена етнографска експозиция."@bg ;
    geographbg:имаОписание "Сградата е в рядката за строителството форма на правилен геометричен кръст и е обявена за паметник на културата от местно значение. Етнографската експозиция представя традиционната култура на населението от Видинска област от края на XIX век до 1920-те години."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенМетър ;
            geographbg:имаСтойност 1260.0 ] ;
    geographbg:находящСеВ geographbg:ВидинГрад ;
    geographbg:основанПрезГодина 1801 ;
    geographbg:свързанС geographbg:РегионаленМузеенКомплексВидин .

geographbg:КръстовХълмБалчик a geographbg:Хълм ;
    rdfs:label "Кръстов хълм (Балчик)"@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 102.0 ] ;
    geographbg:находящСеВ geographbg:БалчикГрад .

geographbg:КръстоорСело a geographbg:Село ;
    rdfs:label "Кръстоор"@bg ;
    geographbg:находящСеВ geographbg:БитолскоОбласт .

geographbg:КръщениеБългарскиНародниОбичаи a geographbg:Събитие ;
    rdfs:label "Кръщение (български народни обичаи)"@bg ;
    geographbg:имаОписание "Обичаи, свързани с кръщаването на дете, преплитащи християнски и езически елементи. Кръстникът е главно обредно лице. Включва калесване, църковен ритуал, празнична трапеза, даряване, избиране и обявяване на името. Обичай „хвърляне на детето“ за избор на нов кръстник."@bg,
        "Обичаи, свързани с кръщаването на детето, преплитащи християнски и паганистични представи. Главно обредно лице е кумът (кръстник). Включва калесване на кръстника, църковен ритуал, връщане на детето, празнична трапеза, даряване, избиране и обявяване на името. Съществува и обичай „хвърляне на детето“ за избор на нов кръстник."@bg .

geographbg:КубратГрад a geographbg:Град ;
    rdfs:label "Кубрат"@bg ;
    geographbg:държава geographbg:България .

geographbg:Кубратово a geographbg:Село ;
    rdfs:label "Кубратово"@bg ;
    geographbg:държава geographbg:България .

geographbg:КукериОбичай a geographbg:Събитие ;
    rdfs:label "Кукери (обичай)"@bg ;
    geographbg:имаАлтернативноИме "баба̀ри"@bg,
        "бабри"@bg,
        "бабугери"@bg,
        "дервиши"@bg,
        "джамалари"@bg,
        "джумали"@bg,
        "калогерос"@bg,
        "кьопек бей"@bg,
        "маскари"@bg,
        "станчинари"@bg,
        "старци"@bg,
        "сурати"@bg,
        "сурова̀ри"@bg,
        "чауши"@bg ;
    geographbg:имаОписание "Карнавален маскарад в Югоизточна Европа, провеждан в началото на Великия пост или между Коледа и Богоявление. Включва група от сюжети и персонажи (Кукер, Баба, Цар и др.) с характерни маски и костюми. Игрите се провеждат из цялото село и завършват с обредно заораване и засяване."@bg,
        "Карнавален маскарад в Югоизточна Европа. Провежда се в началото на Великия пост (Сирни понеделник) или между Коледа и Богоявление (Мръсни дни). Включва персонажи като Кукер, Баба, Цар и др. с характерни маски и костюми. Игрите се провеждат из селото, с мимически сюжети, шум от звънци и завършват с обредно заораване и засяване. Костюмите и маските са еволюирали с времето, ставайки по-големи и сложни."@bg ;
    geographbg:свързанС geographbg:ЗападнаБългария,
        geographbg:ИзточнаБългарияЕтнографскаОбласт,
        geographbg:ЮгоизточнаЕвропа .

geographbg:КуклишСело a geographbg:Село ;
    rdfs:label "Куклиш"@bg ;
    geographbg:държава geographbg:СевернаМакедония ;
    geographbg:находящСеВ geographbg:ОбщинаСтрумица .

geographbg:КукушкаКаза a geographbg:АдминистративнаЕдиница ;
    rdfs:label "Кукушка каза"@bg .

geographbg:КулаЛегендарнаСестра a geographbg:КултуренОбект ;
    rdfs:label "Кула (легендарна сестра)"@bg ;
    geographbg:имаОписание "Легендарна сестра от Видинския край, дъщеря на български болярин. Задомила се в град Кула, но съпругът ѝ пропилял наследството."@bg ;
    geographbg:свързанС geographbg:КулаГрад .

