geographbg:ЖивОгънОбичай rdfs:label "Жив огън (обичай)"@bg ;
    geographbg:имаОписание "Български народен обичай за подновяване на огъня в домашните огнища или при епидемии. Огънят се запалва от триене на сухи (липови) дървета от млади мъже. Изпълнява се на Горещник, Еньовден или Еремия. При епидемии хората или животните прескачат огъня."@bg ;
    geographbg:свързанС geographbg:УргариСело .

geographbg:ЖиватаВодаИзвор a geographbg:Извор,
        geographbg:КарстовИзвор ;
    rdfs:label "Живата вода (извор)"@bg,
        "Живата вода (извор, Боснек)"@bg ;
    geographbg:близоДо _:ncc8a91b1aa8c40249f5b4c7116f19027b273 ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Сифонен карстов извор. Подхранва се от пукнатинни води. Водата изтича след напълване на пещерно резервоарче."@bg,
        "Сифонен карстов извор. Подхранва се от пукнатинни води. Във вътрешността на скалите, зад извора, се намира пещерно разширение, което е свързано чрез сифонно каналче с извора. Водата изтича от извора, след като се напълни пещерното резервоарче до горното коляно на сифона."@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1070.0 ] ;
    geographbg:находящСеВ [ a geographbg:Местност ;
            rdfs:label "Врелото (местност)"@bg ],
        geographbg:АлеяНаБоснешкияКарст,
        geographbg:БоснешкиКарстовРайон,
        geographbg:Витоша,
        geographbg:ПрироденПаркВитоша .

geographbg:ЖивотновъдствоБългария a geographbg:Животновъдство ;
    rdfs:label "Животновъдство в България"@bg ;
    geographbg:включваСектори geographbg:Говедовъдство,
        geographbg:Козевъдство,
        geographbg:Коневъдство,
        geographbg:Овцевъдство,
        geographbg:Птицевъдство,
        geographbg:Свиневъдство ;
    rdfs:comment "Отрасъл в първичния икономически сектор — развъждане и отглеждане на селскостопански животни. Подотрасли: говедовъдство (вкл. биволовъдство), овцевъдство, козевъдство, свиневъдство, коневъдство, птицевъдство."@bg .

