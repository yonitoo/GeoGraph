        geographbg:СелоЗаберново,
        geographbg:СелоКалово ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Горите са разновъзрастни, с много вековни дъбови дървета (над 85% над 120 години). Сред тях е 1000-годишният дъб благун. Горските масиви са представени главно от вековни благуново-горунови формации. Релефът е красиво нагънат. В карстовата част на Пазлаците има пещерни образувания. Запазени мегалитни тракийски долмени."@bg ;
    geographbg:имаХарактеренРастителенВид geographbg:Благун,
        geographbg:Горун,
        geographbg:Дъб,
        geographbg:ОбикновенДъб ;
    geographbg:находящСеВ [ a geographbg:Долина ;
            rdfs:label "Долина на Заберска река"@bg ;
            geographbg:намираСеНаРека geographbg:ЗаберскаРека ],
        [ a geographbg:Долина ;
            rdfs:label "Долина на Казански дол"@bg ;
            geographbg:намираСеНаРека geographbg:КазанскиДолРека ],
        geographbg:СтранджаПланина .

