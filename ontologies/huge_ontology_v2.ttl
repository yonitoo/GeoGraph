    geographbg:имаАлтернативноИме "Яница"@bg ;
    geographbg:имаРуини geographbg:АнтиченТеатър,
        geographbg:Укрепления,
        geographbg:ХрамНаЗевс ;
    geographbg:имаСтароИме "Зоровигли"@bg ;
    geographbg:намираСеНаРека geographbg:АхелойРека ;
    geographbg:разположенВМестност geographbg:МалкаВлахия .

geographbg:СтрашимировскоБлатоЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Страшимировско блато (защитена местност)"@bg ;
    geographbg:близоДо geographbg:БелославГрад,
        geographbg:СтрашимировоСело ;
    geographbg:датаНаОбявяване "1987-07-23"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 154.0 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване на естествените местообитания на редки изащитени видове птици."@bg ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:КъдроглавПеликан,
        geographbg:МалъкКорморан,
        geographbg:РозовПеликан ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаЯтатаПтици ;
    geographbg:разположенВМестност geographbg:МестностЯтата .

geographbg:СтрумаКораб a owl:Thing ;
    rdfs:label "Струма (кораб)"@bg ;
    geographbg:имаИстория "Построен 1867 г. като яхта „Ксанта“. По-късно „Македония“ (българска собственост, превоз на добитък). През 1941 г. нает за превоз на еврейски бежанци от Румъния за Палестина. Потопен от съветска подводница на 24 февруари 1942 г. в Черно море. Загиват 768 души, 1 оцелял."@bg .

geographbg:СтрумишкаКаза a geographbg:АдминистративнаЕдиница ;
    rdfs:label "Струмишка каза"@bg .

geographbg:СтрумскаОперация a geographbg:Събитие ;
    rdfs:label "Струмска операция"@bg ;
    geographbg:имаОписание "Настъпателна операция на българската армия през Първата световна война (17 – 23 август 1916 г.). Проведена успоредно с Леринската настъпателна операция. Води до окупация на 4000 km2 в гръцката част на Източна Македония. Българските войски заемат Сяр, Драма и Кавала."@bg .

geographbg:СтъпкатаНаКралиМаркоГабрене a geographbg:КултуренОбект,
        geographbg:СкалноОбразувание ;
    rdfs:label "Стъпката на Крали Марко (Габрене)"@bg ;
    geographbg:близоДо geographbg:ГабренеСело ;
    geographbg:имаОписание "Праисторическо култово съоръжение (I-IV век сл. Хр.), част от древно светилище. Скала с два издълбани басейна (един с форма на човешка стъпка, друг кръгъл)."@bg ;
    geographbg:находящСеВ geographbg:БеласицаПланина,
        geographbg:МестностСариевКамък .

geographbg:СтърничковКамък a geographbg:ПрироднаЗабележителностСтатут,
        geographbg:СкалноОбразувание ;
    rdfs:label "Стърничков камък"@bg ;
    geographbg:близоДо geographbg:ЖелезнишкаРека .

geographbg:СубурбанизацияПроцес a geographbg:Субурбанизация ;
    rdfs:label "Субурбанизация"@bg ;
    geographbg:имаАгломерация geographbg:Агломерация .

geographbg:Судан a geographbg:Държава ;
    rdfs:label "Судан"@bg .

geographbg:СукманенаНосия rdfs:label "Сукманена носия"@bg ;
    geographbg:имаОписание "Женски традиционен костюм, една от главните категории на женските български носии. Характерна е с носенето върху ризата на сукман – дебела вълнена туникообразна богато украсена дреха, – върху която се носи една предна престилка. Разпространена в равнинните части на Тракия, до Стара планина и Търновско на север, както и в Североизточна и Средна Западна България."@bg ;
    geographbg:свързанС geographbg:СевероизточнаБългарияЕтнографскаОбласт,
        geographbg:СреднаЗападнаБългарияЕтнографскаОбласт,
        geographbg:СтараПланина,
        geographbg:ТракияЕтнографскаОбласт,
        geographbg:Търновско .

geographbg:СулинскиРъкав a geographbg:Река ;
    rdfs:label "Сулински ръкав"@bg ;
    geographbg:еСъставящаЧастНа geographbg:ТулченскиРъкав .

geographbg:СурваФестивал a geographbg:Събитие ;
    rdfs:label "Сурва (фестивал)"@bg ;
    geographbg:имаАлтернативноИме "Международен фестивал на маскарадните игри „Сурва“"@bg ;
    geographbg:имаОписание "Най-големият маскараден фестивал в България и на Балканите, провеждан в Перник. Популяризира традиционна ергенска обредност (сурвакари, кукери). Първо издание 1966 г. Международен статут от 1985 г. Обичаят „Сурова“ е вписан в ЮНЕСКО през 2015 г."@bg ;
    geographbg:находящСеВ geographbg:ПерникГрад ;
    geographbg:основанПрезГодина 1966 .

geographbg:Сурвакане a geographbg:Събитие ;
    rdfs:label "Сурвакане"@bg ;
    geographbg:имаОписание "Български народен обичай на Сурваки (Нова година). Сурвакари (деца 4-12 г. или ергени) обхождат домове, сурвакат със сурвачка за здраве и плодородие, получават дарове. Регионални варианти включват „ходене за лешници“, „за китка“, роли на „шиповичар“, „коте“, „магаре“, „Носене на камък“ в Родопите."@bg ;
    geographbg:свързанС geographbg:ГоцеделчевскоРегион,
        geographbg:ЛомскоРегион,
        geographbg:ПиринскиКрай,
        geographbg:ПловдивскоОбласт,
        geographbg:РазложкоОбласт,
        geographbg:Родопи,
        geographbg:СакарПланина,
        geographbg:СофийскоПоле,
        geographbg:СтранджанскиРегион,
        geographbg:СурвакиПразник,
        geographbg:Сурвачка .

geographbg:СурваканеОбичай a geographbg:Събитие ;
    rdfs:label "Сурвакане (обичай)"@bg ;
    geographbg:имаОписание "Български народен обичай на Сурваки. Сурвакари (деца или ергени) обхождат домове, сурвакат със сурвачка за здраве и плодородие, получават дарове. Регионални варианти включват „Носене на камък“ в Родопите."@bg ;
    geographbg:свързанС geographbg:СурвакиПразник,
        geographbg:Сурвачка .

geographbg:СуровичевоСело a geographbg:Село ;
    rdfs:label "Суровичево"@bg ;
    geographbg:находящСеВ geographbg:Леринско .

geographbg:СухаЛъкаКлетваБивакЗащитенаМестност a geographbg:ЗащитенаМестност ;
