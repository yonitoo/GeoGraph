    geographbg:имаИстория "Османски регистри (1616-1617): 46 джизие ханета. (1625): 35 ханета. XIX век: Демирхисарска каза. Етнография (1873): 30 домакинства, 100 българи. Кънчов (1900): 350 българи. Мишев (1905): 480 българи патриаршисти гъркомани, 90 власи. 1906: 70 къщи. 1928: 39 бежански семейства, 144 души."@bg ;
    geographbg:находящСеВ geographbg:БеласицаПланина,
        geographbg:ДемСинтика .

geographbg:ЛистЗаМакедонскатаЕмиграцияВестник a owl:Thing ;
    rdfs:label "Лист за македонската емиграция (вестник)"@bg ;
    geographbg:имаОписание "Български вестник, орган на Изпълнителния комитет на Съюза на македонските братства в България. Излизал от 2 юли 1919 до 14 септември 1919 г."@bg ;
    geographbg:свързанС geographbg:София,
        geographbg:СъюзНаМакедонскитеЕмигрантскиОрганизации .

geographbg:ЛифтДрагалевциГолиВръх a geographbg:Лифт ;
    rdfs:label "Лифт Драгалевци – Голи връх"@bg ;
    geographbg:преминаваПрез geographbg:ЗаслонБайКръстьо ;
    geographbg:свързва [ a geographbg:ПланинскиВръх ;
            rdfs:label "Голи връх (Витоша)"@bg ],
        geographbg:КварталДрагалевци .

geographbg:ЛифтКняжевоКопитото a geographbg:Лифт ;
    rdfs:label "Лифт Княжево – Копитото"@bg ;
    geographbg:имаОписание "Първият кабинков лифт в България, произведен от австрийската фирма „Братя Гирак/Girak“. Дължина 1920 m, с разлика във височините 600 m. Разполагал е с 53 четириместни кабини и е превозвал по 600 души на час в посока със скорост 3 m/s. Не работи от началото на 90-те."@bg,
        "Първият кабинков лифт в България. Дължина 1920 m, разлика във височините 600 m. 53 четириместни кабини, капацитет 600 души/час, скорост 3 m/s. Не работи от началото на 90-те."@bg ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 1.92 ] ;
    geographbg:основанПрезГодина 1962 ;
    geographbg:свързва geographbg:КварталКняжево,
        geographbg:Копитото .

geographbg:ЛовецСелоСтараЗагора a geographbg:Село ;
    rdfs:label "Ловец (Старозагорско)"@bg .

