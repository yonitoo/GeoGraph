    rdfs:label "Планина"@bg ;
    rdfs:subClassOf geographbg:РелефнаФорма .

geographbg:Витоша a geographbg:Планина ;
    rdfs:label "Витоша"@bg ;
    geographbg:граничиС geographbg:ЛозенскаПланина,
        geographbg:ПернишкаКотловина,
        geographbg:СамоковскаКотловина,
