    rdfs:label "Рила"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:БеломорскаОтточнаОбластБългария .

geographbg:ЧерноМоре a geographbg:Море ;
    rdfs:label "Черно море"@bg ;
    geographbg:имаОписание "Черно море е междуконтинентално (вътрешноконтинентално) море със соленост 17,3‰ — значително по-ниска от Световния океан (около 36‰). Шелфът е най-широк в северозападната част (до 190 km). Поради сероводородния слой на дълбочина под 150–200 m живите организми обитават основно горния воден слой."@bg ;
    geographbg:имаПриток geographbg:Дунав,
        geographbg:Камчия ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 0.0 ] .

