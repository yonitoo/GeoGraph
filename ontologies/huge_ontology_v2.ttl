geographbg:Пшеница a geographbg:ЗърненаКултура,
        geographbg:ЗърненоЖитнаКултура ;
    rdfs:label "Пшеница"@bg ;
    geographbg:имаЕкологичниОсобености "Пшеницата е взискателна към почвата, нуждае се от средно до високо ниво на хумус в нея и неутрална киселинност."@bg ;
    geographbg:имаИстория "Пшеницата е едно от първите зърнено-житни растения, култивирани от хората."@bg ;
    geographbg:имаМорфологичниОсобености "Стъблата са цилиндрични, кухи, разчленени на възли и междувъзлия."@bg ;
    geographbg:имаПлощНаОтглеждане [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 220000000.0 ] ;
    geographbg:имаПроизводство [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:ТонГодишно ;
            geographbg:имаСтойност 729000000.0 ] ;
    geographbg:имаПроизход "Плодородния полумесец"@bg ;
    geographbg:имаРазпространение geographbg:Англия,
        geographbg:Германия,
        geographbg:Гърция,
        geographbg:Египет,
        geographbg:Индия,
        geographbg:Испания,
        geographbg:Кипър,
        geographbg:Китай,
        geographbg:Скандинавия .

