    geographbg:имаОписание "Водна каскада. Наименувани през 1910 г. на Алеко Константинов. Обща височина 15-20 метра. Състоят се от горен и долен водопад."@bg,
        "Водна каскада. Наименувани през 1910 г. на Алеко Константинов. Обща височина 15-20 метра. Състоят се от горен и долен водопад. Най-пълноводни през пролетта."@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1160.0 ] ;
