geographbg:ПарорияЗащитенаМестност a geographbg:Гора,
        geographbg:ЗащитенаМестност ;
    rdfs:label "Парория (защитена местност)"@bg ;
    geographbg:близоДо geographbg:ЗаберновоСело,
