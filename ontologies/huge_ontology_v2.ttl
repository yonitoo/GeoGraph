geographbg:Коледуване a geographbg:Събитие ;
    rdfs:label "Коледуване"@bg ;
    geographbg:държава geographbg:Беларус,
        geographbg:България,
        geographbg:Полша,
        geographbg:Румъния,
        geographbg:Русия,
        geographbg:СевернаМакедония,
        geographbg:Словакия,
        geographbg:Сърбия,
        geographbg:Украйна,
        geographbg:Чехия ;
    geographbg:имаОписание "Традиционен български обичай, част от празнично-обредния комплекс на Коледа и първият обред от ергенските обичаи в периода на Мръсните дни. Коледарите (младежи) обхождат домове, пеят песни за здраве и плодородие и получават дарове. Подготовката започва от Игнажден. Времето за коледуване е от полунощ до изгрев слънце на Коледа."@bg ;
    geographbg:свързанС geographbg:КоледаПразник,
        geographbg:МръсниДни .

geographbg:КоледуванеОбичай a geographbg:Събитие ;
    rdfs:label "Коледуване (обичай)"@bg ;
    geographbg:държава geographbg:Беларус,
        geographbg:България,
        geographbg:Полша,
        geographbg:Румъния,
        geographbg:Русия,
        geographbg:СевернаМакедония,
        geographbg:Словакия,
        geographbg:Сърбия,
        geographbg:Украйна,
        geographbg:Чехия ;
    geographbg:имаОписание "Традиционен български обичай, част от Коледа и Мръсните дни. Младежи (коледари) с водач (станеник) обикалят домове, пеят песни за здраве и плодородие, получават дарове. Подготовката започва от Игнажден. Изпълнява се от полунощ до изгрев на Коледа."@bg ;
    geographbg:свързанС geographbg:КоледаПразник,
        geographbg:МръсниДни .

