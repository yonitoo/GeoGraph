geographbg:ЗаслонКикиш a geographbg:Заслон ;
    rdfs:label "Кикиш (заслон)"@bg ;
    geographbg:близоДо geographbg:БоянскиВодопад,
        geographbg:ВръхКикиш,
        geographbg:ДрагалевскиМанастир,
        geographbg:ЗлатнитеМостове,
        geographbg:КварталБояна,
        geographbg:КварталДрагалевци,
        geographbg:ХижаКаменДел ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Разполага с кухня, столова и спално помещение. Реновиран през 2016 г. и действа като туристическа хижа."@bg ;
    geographbg:находящСеВ [ a geographbg:Местност ;
            rdfs:label "Кикиш (местност)"@bg ;
            geographbg:находящСеВ geographbg:Витоша ] ;
    geographbg:основанПрезГодина 1962 ;
    geographbg:стопанисваСеОт [ a geographbg:Организация ;
            rdfs:label "Туристическа секция „Кикиш“ при дружество „Планинец“ — София"@bg ] .

