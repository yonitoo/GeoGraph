geographbg:КараконджулСъщество a geographbg:КултуренОбект ;
    rdfs:label "Караконджул"@bg ;
    geographbg:имаАлтернативноИме "буганец"@bg,
        "вонкашно"@bg,
        "гундурак"@bg,
        "калакандзер"@bg,
        "кандзо"@bg,
        "канканджур"@bg,
        "кара-кон"@bg,
        "кара-кончо"@bg,
        "караконджер"@bg,
        "меджарок"@bg,
        "поганец"@bg,
        "поганче"@bg ;
    geographbg:имаОписание "Фолклорно създание, което плаши и вреди на хората през Мръсните дни. Космат човек с голяма глава, рога, опашка, едно око, един крак или получовек-полукон. Живее в пещери, реки, воденици. Злосторничи нощем. Плаши се от кръст, молитва, тамян, чесън, пелин."@bg ;
    geographbg:свързанС geographbg:МръсниДни .

