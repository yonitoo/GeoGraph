geographbg:България a geographbg:Държава ;
    rdfs:label "България"@bg ;
    geographbg:граничиС geographbg:Гърция,
        geographbg:Румъния,
        geographbg:СевернаМакедония,
        geographbg:Сърбия,
        geographbg:Турция ;
    geographbg:имаИзлазНа geographbg:ЧерноМоре ;
    geographbg:имаКоефициентНаРаждаемост [ a geographbg:КоефициентНаРаждаемост ;
            geographbg:имаМернаЕдиница geographbg:Промил ;
            geographbg:имаСтойност 8.5 ] ;
