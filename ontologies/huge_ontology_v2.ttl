geographbg:БългарскаНароднаМузика a geographbg:КултуренОбект ;
    rdfs:label "Българска народна музика"@bg ;
    geographbg:имаОписание "Музикален жанр, базиран на традиционния музикален фолклор. Предимно вокална, с неравноделни размери. Разделена на фолклорни области: Северняшка, Добруджанска, Шопска, Тракийска, Странджанска, Македонска, Родопска. Основни инструменти: гайда, кавал, гъдулка, булгарина, тъпан."@bg ;
    geographbg:свързанС geographbg:ДобруджанскаФолклорнаОбласт,
        geographbg:МакедонскаФолклорнаОбласт,
        geographbg:РодопскаФолклорнаОбласт,
        geographbg:СеверняшкаФолклорнаОбласт,
        geographbg:СтранджанскаФолклорнаОбласт,
        geographbg:ТракийскаФолклорнаОбласт,
        geographbg:ШопскаФолклорнаОбласт .

geographbg:БългарскаНосия rdfs:label "Българска носия"@bg ;
    geographbg:имаОписание "Народното облекло на българина от Възраждането до към средата на 20 век. То отразява спецификата, традиционната култура и бита на българския народ. Произходът му е главно балкански. Мъжките носии се класифицират в две основни групи – чернодрешна и белодрешна, а женските – в три групи – двупрестилчена, сукманена и саичена носия."@bg ;
    geographbg:свързанС geographbg:БалканскиПолуостров .

geographbg:БългарскаСоциалдемократическаПартия a geographbg:ПолитическаПартия ;
    rdfs:label "Българска социалдемократическа партия"@bg ;
    geographbg:имаМандати [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:БройЖители ;
            geographbg:имаСтойност 2.0 ] .

geographbg:БългарскиИзворСело a geographbg:Село ;
    rdfs:label "Български извор (село)"@bg .

