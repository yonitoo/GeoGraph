    geographbg:имаОписание "Уникалният триетажен хабитат представлява вековна букова гора, с разпръснати единични дървета ела и планински явор и подлес от тис и лавровишня."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
