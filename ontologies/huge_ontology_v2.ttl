geographbg:БългарскаГораИсторическаЗона a geographbg:Гора,
        geographbg:ИсторическаОбласт ;
    rdfs:label "Българска гора (историческа горска зона)"@bg ;
    geographbg:близоДо geographbg:БелградГрад,
        geographbg:НишГрад,
        geographbg:ПазарджикГрадИсторГора,
        geographbg:ТракийскаНизина,
        geographbg:ТраяновиВратаПроход ;
    geographbg:имаАлтернативноИме "Български лес"@bg,
        "Великата българска гора"@bg ;
    geographbg:имаОписание "Горска зона, простираща се между Белград и източния край на прохода Траянови врата в началото на Тракийската низина. Областта между Ниш и Пазарджик. Описвана от участници в първите три кръстоносни похода през XI–XII в. В по-тесен географски смисъл обхваща гористите планински масиви на Тимошко, източно от река Велика Морава."@bg ;
    geographbg:находящСеВ geographbg:ТимошкоРегион ;
    geographbg:преминаваПрез [ a geographbg:Долина ;
            rdfs:label "Поречие на Велика Морава"@bg ;
            geographbg:намираСеНаРека geographbg:ВеликаМораваРека ],
        [ a geographbg:Долина ;
            rdfs:label "Поречие на Нишава"@bg ;
            geographbg:намираСеНаРека geographbg:НишаваРека ] .

geographbg:БългарскаЗемеделскаБанкаКлонБалчик a geographbg:Организация ;
    rdfs:label "Клон на Българската земеделска банка (Балчик)"@bg ;
    geographbg:находящСеВ geographbg:БалчикГрад .

geographbg:БългарскаНароднаБанкаАгенцияБалчик a geographbg:Организация ;
