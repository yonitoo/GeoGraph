                    geographbg:имаМернаЕдиница geographbg:Метър ;
                    geographbg:имаСтойност 1397.0 ] ;
            geographbg:находящСеВ geographbg:СтараПланина ] ;
    geographbg:имаАлтернативноИме "Стара река (Енинска)"@bg ;
