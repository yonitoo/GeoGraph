geographbg:ЛонгознаГора a geographbg:Гора ;
    rdfs:label "Лонгозна гора"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Представляват крайречни гори в долните течения на черноморските реки, където най-силно се чувства смекчаващо климатично влияние на морето. Възникването им се свързва със специфични климатични, хидрологични, исторически и флорогеографски условия. Формирани са върху кватернерни наслаги и богати, влажни и дълбоки наносни и блатни почви. Възникват в края на ледниковия период, началото на холоцена. Специфични са за условията на преходно-континентален и средиземноморски климат с мека и влажна зима. Отличават се от останалите крайречни гори в България с наличието на някои вечнозелени и топлолюбиви видове в състава си."@bg ;
    geographbg:имаХарактеренРастителенВид geographbg:БитинскиСинчец,
        geographbg:БлатнаПеруника,
        geographbg:Брей,
        geographbg:БроеничестаЛивадина,
        geographbg:Бръшлян,
        geographbg:БялБряст,
        geographbg:БялаВърба,
        geographbg:БялаТопола,
        geographbg:ВисокаСкрипка,
        geographbg:ВрабчовиЧревца,
        geographbg:ГорскиКъсокрак,
        geographbg:ГрадскоОмайниче,
        geographbg:ГроздовиднаПесъкиня,
        geographbg:Гърбач,
        geographbg:ДиваЛоза,
        geographbg:ДребноцветноЧадърче,
        geographbg:КучиДрян,
        geographbg:КървавочервенЛапад,
        geographbg:Лепка,
        geographbg:ЛечебнаРазваленка,
        geographbg:Мекиш,
        geographbg:Мехунка,
        geographbg:ОбикновенГлог,
        geographbg:ОбикновенДъб,
        geographbg:ОбикновенПирей,
        geographbg:ОбикновенПовет,
        geographbg:ОбикновенХмел,
        geographbg:ОбикновенаБлатия,
        geographbg:ОбикновенаКоприва,
        geographbg:ОбикновенаМаслинка,
        geographbg:ОбикновеноБлатноКокиче,
        geographbg:ПолскиБряст,
        geographbg:ПолскиКлен,
        geographbg:ПолскиЯсен,
        geographbg:ПълзящОчиболец,
        geographbg:ПълзящоЛютиче,
        geographbg:Чашкодрян,
        geographbg:ЧеренОман,
        geographbg:ЧернаЕлша,
        geographbg:ЧернаТопола,
        geographbg:ЧерноморскаВедрица ;
    geographbg:находящСеВ geographbg:ГорнотракийскаНизина,
        geographbg:ТунджанскаРавнина ;
    geographbg:свързанС [ a geographbg:Местност ;
            rdfs:label "Долно течение на река Батова"@bg ;
            geographbg:намираСеНаРека geographbg:РекаБатова ],
        [ a geographbg:Местност ;
            rdfs:label "Долно течение на река Камчия"@bg ;
            geographbg:намираСеНаРека geographbg:КамчияРекаЛонгоз ],
        [ a geographbg:Местност ;
            rdfs:label "Долно течение на река Ропотамо"@bg ;
