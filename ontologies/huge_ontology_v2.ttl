geographbg:ЗлатнитеМостове a geographbg:Местност,
        geographbg:СкалноОбразувание ;
    rdfs:label "Златните мостове"@bg ;
    geographbg:близоДо geographbg:ВладайскаРека,
        geographbg:ЧерниВръх ;
    geographbg:държава geographbg:България ;
    geographbg:имаАлтернативноИме "Морените"@bg ;
    geographbg:имаЕтимология "Името идва от лишеите със златист цвят, които покриват големите камъни. Според други източници името идва от златен пясък, който се е намирал тук преди време."@bg ;
    geographbg:имаОписание "Представлява най-голямата каменна река в района на Витоша. Името идва от лишеите със златист цвят или от златен пясък."@bg,
        "Разположена е на надморска височина от 1350 до 1500 метра в поречието на Владайската река."@bg ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1350.0 ],
        [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1425.0 ] ;
    geographbg:намираСеНаРека geographbg:ВладайскаРека ;
    geographbg:находящСеВ geographbg:Витоша .

