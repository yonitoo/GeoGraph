    geographbg:имаОписание "Планинско възвишение от вулканичен произход. Представлява остатък от плиоценски вулканичен конус, неактивен от близо 1 милион години. Прорязан от север на юг от река Струма. Името идва от факта, че прилича на наметнат кожух."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 1.2 ] ;
    geographbg:имаПолезноИзкопаемо geographbg:АрагонитПолезноИзкопаемо,
        geographbg:КалцитПолезноИзкопаемо,
        geographbg:Флуорит ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:КотешкаЗмия ;
    geographbg:имаХарактеренРастителенВид geographbg:ВебиевБадем,
        geographbg:МногоцветенПарвотризетум,
        geographbg:ОбикновенДракункулус ;
    geographbg:находящСеВ geographbg:СанданскоПетричкаКотловина ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 2.0 ] ;
    geographbg:обявенаСъсЗаповед "1962 г. (0,4 ха), 1971 г. (увеличена на 94,2 ха)"@bg ;
    geographbg:преминаваПрез geographbg:РекаСтрума .

geographbg:Копитото a geographbg:Местност ;
    rdfs:label "Копитото"@bg,
