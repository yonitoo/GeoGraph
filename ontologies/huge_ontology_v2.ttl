geographbg:СборникМакедонскихПесенСказокОбычаевВерковича rdfs:label "Сборникъ македонскихъ пѣсенъ, сказокъ, обычаевъ С. И. Верковича"@bg ;
    geographbg:имаОписание "Труд на Пьотър Лавров с коментар върху петербургския архив с български фолклорни произведения на Стефан Веркович, издаден в Санкт Петербург през 1908 г. Архивът съдържа народни песни, приказки и обичаи, записани в Южна Македония."@bg ;
    geographbg:основанПрезГодина 1908 ;
    geographbg:свързанС geographbg:ЮжнаМакедония .

geographbg:СборникъВерковичаНародныяПѣсни a owl:Thing ;
    rdfs:label "Сборникъ Верковича. Ι. Народныя пѣсни македонскихъ болгаръ"@bg ;
    geographbg:имаОписание "Етнографски сборник с български народни песни, събрани от Стефан Веркович, издаден през 1920 г. в Петроград."@bg ;
    geographbg:свързанС geographbg:ПетроградГрад .

geographbg:СватбарскаМузика a geographbg:КултуренОбект ;
    rdfs:label "Сватбарска музика"@bg ;
    geographbg:имаОписание "Жанр в българската народна музика, популярен през 70-те и 80-те г. на XX в. Изпълнявана от сватбарски оркестри. Характеризира се с виртуозни инструментални изпълнения, импровизация и интеграция на цигански, турски, сръбски и джаз елементи. Надсвирването в Стамболово е важна сцена."@bg ;
    geographbg:свързанС geographbg:НадсвирванеСтамболово .

geographbg:СветецОбичай a geographbg:Събитие ;
    rdfs:label "Светец (обичай)"@bg ;
    geographbg:имаАлтернативноИме "курбан"@bg,
        "светъц"@bg,
        "свинтул"@bg,
        "слава"@bg,
        "служба"@bg,
        "стопанин"@bg ;
    geographbg:имаОписание "Традиционен празник на Балканите, отбелязван от семейство на определен християнски празник. Включва вечерница, празничен обяд, курбан, обредни хлябове, коливо, прекадяване. Патерица е денят след празника."@bg ;
    geographbg:свързанС geographbg:Албания,
        geographbg:БалканскиПолуостров,
        geographbg:БоснаИХерцеговина,
        geographbg:Далмация,
        geographbg:ЗападнаБългария,
        geographbg:Косово,
        geographbg:Румъния,
        geographbg:СевернаМакедония,
        geographbg:Сърбия,
        geographbg:ТимошкоРегион,
        geographbg:ЧернаГора .

