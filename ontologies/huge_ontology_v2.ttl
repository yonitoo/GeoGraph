    rdfs:label "Къща музей на Борис Христов"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:КъщаМузейПанчоВладигеров a geographbg:Музей ;
    rdfs:label "Къща музей на Панчо Владигеров"@bg ;
