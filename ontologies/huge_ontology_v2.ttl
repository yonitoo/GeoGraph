        geographbg:ТемнатаДупкаПещераЛакатник .

geographbg:ЛаутаПарк a geographbg:Парк ;
    rdfs:label "Лаута (парк)"@bg ;
    geographbg:близоДо geographbg:СтадионЛокомотивПловдив ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Обществен парк. В миналото районът е бил оризища. В началото на XX век е имало горски насаждения. В периода 1940 – 1944 г. се оформя като специален горски масив. Реконструиран след 2013 г."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенМетър ;
            geographbg:имаСтойност 402421.0 ] ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:ГълъбГривяк,
        geographbg:Катерица,
        geographbg:Кълвач,
        geographbg:Фазан ;
    geographbg:имаХарактеренРастителенВид geographbg:Бръшлян,
        geographbg:БялБор,
        geographbg:БялаАкация,
        geographbg:БялаБреза,
        geographbg:Глухарче,
        geographbg:ГорскаДетелина,
        geographbg:Здравец,
        geographbg:КитайскиМехурник,
        geographbg:КонскиКестен,
        geographbg:ЛетенДъб,
        geographbg:ОбикновенЯвор,
        geographbg:ОбикновенЯсен,
        geographbg:ПлачещаВърба,
        geographbg:Чинар ;
    geographbg:находящСеВ geographbg:РайонТракияПловдив .

geographbg:ЛеденишкаКула a geographbg:КултуренОбект,
        geographbg:Музей ;
    rdfs:label "Леденишка кула"@bg ;
    geographbg:близоДо geographbg:Янтра ;
    geographbg:имаАлтернативноИме "Бейската кула"@bg,
        "Кулата на Шемши бей"@bg ;
    geographbg:имаИстория "Сграда от XVII век. Първите данни за сградата идват от 1650 г., когато е възстановена за обитаване от Шемши бей. Опожарявана на 2 пъти от български хайдути. Реставрирана е през 1969 г."@bg ;
    geographbg:имаОписание "Изградена от ломен камък. Считана е за най-високата битова сграда на Балканите, изградена изцяло от камък. Преобразувана в етнографски музей на 3 етажа. На 1-вия етаж е разположена етнографската експозиция. На 2-рия етаж се намират спалнята на Шемши бей и няколко гостни. На 3-тия етаж има 9 издадени покрити балкона и 2 просторни зали."@bg ;
    geographbg:находящСеВ geographbg:ЛеденикСело .

geographbg:ЛеденоХоро a geographbg:Събитие ;
    rdfs:label "Ледено хоро"@bg ;
    geographbg:имаАлтернативноИме "мъжко хоро"@bg ;
    geographbg:имаОписание "Сравнително нов ежегоден български обичай в Калофер на Йордановден. Мъже играят хоро в ледените води на река Тунджа. Започва да се организира през 70-те години на XX век. Изпълнява се и в други градове като Благоевград, Враца, Дупница, Мъглиж, Казанлък и др."@bg ;
    geographbg:находящСеВ geographbg:БлагоевградГрад,
        geographbg:ВрацаГрад,
        geographbg:ДупницаГрад,
        geographbg:ЗвериноСело,
        geographbg:КазанлъкГрад,
        geographbg:КалоферГрад,
        geographbg:КладницаСело,
        geographbg:КърджалиГрад,
        geographbg:ЛовечГрад,
        geographbg:Луковит,
        geographbg:МонтанаГрад,
        geographbg:МъглижГрад,
        geographbg:ПанагюрищеГрад,
        geographbg:ПлевенГрад,
        geographbg:Радомирци,
        geographbg:СвищовГрад,
        geographbg:СливенГрад,
        geographbg:ТроянГрад ;
    geographbg:преминаваПрез geographbg:ТунджаРека ;
    geographbg:свързанС geographbg:ЙордановденПразник .

