            geographbg:имаСтойност 450.0 ] ;
    geographbg:имаСтъбло "Метамерно устройство, достигащо 150 cm височина"@bg ;
    geographbg:имаСъцветие "Клас, съставен от коленчато вретено с класчета"@bg ;
    geographbg:имаТип "Ечемик за брашно"@bg,
        "Пивоварен"@bg,
