geographbg:СтараПланина a geographbg:Планина ;
    rdfs:label "Стара планина"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "В Стара планина има находища на черни въглища (Балканбас), антрацитни въглища (Свогенски басейн), железни руди (Кремиковци, Чипровци, Мартиново, Троянско), медни и полиметални руди (Врачанска, Голема планина, Етрополска планина), мрамор (Берковско) и глини (Годечко). Реките в Стара планина се характеризират с дъждовно-снежно, снежно-дъждовно, дъждовно и карстово подхранване. Неблагоприятни климатични явления тук са мъглите, температурните инверсии в котловините и поледиците."@bg ;
    geographbg:имаПолезноИзкопаемо geographbg:Глини,
        geographbg:ЖелязнаРуда,
        geographbg:Мрамор ;
    geographbg:найВисокВръхНа geographbg:БотевВръх .

geographbg:Искър a geographbg:Река ;
    rdfs:label "Искър"@bg ;
    geographbg:вливаСеВ geographbg:Дунав ;
    geographbg:дължинаВБългария [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 368.0 ] ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Река Искър е маловодна през месеците август–октомври (късно лято–есен)."@bg ;
    geographbg:имаПриток geographbg:БистрицаМусаленска,
        geographbg:БлатоРекаВБългария,
        geographbg:ГабровницаПритокНаИскър,
        geographbg:ГостиляРека,
        geographbg:ЗлатнаПанегаРека,
        geographbg:ИскрецкаРека,
        geographbg:Какач,
        geographbg:ЛесновскаРека,
        geographbg:МалкиИскър,
        geographbg:Палакария ;
    geographbg:имаСъставящаЧаст geographbg:БелиИскърРека,
        geographbg:ЧерниИскър ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Километър ;
            geographbg:имаСтойност 368.0 ] ;
    geographbg:площНаВодосборенБасейн [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 8646.0 ] ;
    geographbg:преминаваПрез geographbg:ДунавскаОтточнаОбластБългария .

geographbg:ЗападниРодопи a geographbg:Местоположение,
        geographbg:Планина ;
    rdfs:label "Западни Родопи"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Родопите (вкл. Западните Родопи) са богати на полезни изкопаеми: оловно-цинкови руди, железни руди, азбест. За строителни нужди се експлоатират вулкански туфи и мрамор."@bg ;
    geographbg:имаПолезноИзкопаемо geographbg:ОловноЦинковаРуда .

geographbg:КубиченМетър a geographbg:МернаЕдиница ;
    rdfs:label "m³"@bg ;
    rdfs:comment "Символ: m³"@bg .

