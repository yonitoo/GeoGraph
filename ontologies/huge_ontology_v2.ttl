geographbg:ВампирСъщество a geographbg:КултуренОбект ;
    rdfs:label "Вампир (митология)"@bg ;
    geographbg:имаАлтернативноИме "въпир"@bg,
        "онпыр"@bg,
        "упир"@bg ;
    geographbg:имаОписание "Митологичен персонаж, който пие кръв. В българския фолклор е дух на умрял човек, който тормози близките си, но не пие кръв. Страхува се от вода, тръни, светлина, огън, вълци. Може да се превърне в плътеник."@bg ;
    geographbg:свързанС geographbg:ПлътеникСъщество .

geographbg:ВарденеКвасОбичай a geographbg:Събитие ;
    rdfs:label "Вардене квас"@bg ;
    geographbg:имаАлтернативноИме "Пазене квас"@bg ;
    geographbg:имаОписание "Български обичай, изпълняван от Игнажден до Васильовден, характерен за Русенско и Разградско. Участват само жени. Две моми замесват тесто с билки, което се пази 12 нощи. Използва се за лек и магии."@bg ;
    geographbg:свързанС geographbg:РазградскоОбласт,
        geographbg:РусенскоОбласт .

