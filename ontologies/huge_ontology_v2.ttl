geographbg:СъборНаНароднотоТворчество a geographbg:Събитие ;
    rdfs:label "Събор на народното творчество"@bg ;
    geographbg:имаОписание "Система от фестивали в България за сценично представяне на български фолклор. Първият е Странджанският събор (1960 г., Граматиково). Включва регионални събори (Добруджански, Родопски, Ямболски, Пирински, Сливенски) и Националния събор в Копривщица (от 1965 г.)."@bg ;
    geographbg:свързанС geographbg:ДобруджанскиСъбор,
        geographbg:НационаленСъборНаБългарскотоНародноТворчество,
        geographbg:ПиринскиСъбор,
        geographbg:РодопскиСъборРожен,
        geographbg:СливенскиСъбор,
        geographbg:СтранджанскиСъбор,
        geographbg:ЯмболскиСъбор .

geographbg:СъветскаМакедонияВестник a owl:Thing ;
    rdfs:label "Съветска Македония (вестник)"@bg ;
    geographbg:имаОписание "Български вестник на прокомунистическата македонска емиграция в България, излизал в София от 1923 г."@bg ;
    geographbg:свързанС geographbg:София .

geographbg:СъветскоБългарскоМинноДружество a geographbg:Организация ;
