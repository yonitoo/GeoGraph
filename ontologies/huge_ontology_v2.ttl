    geographbg:близоДо geographbg:БанскоСелоСтрумица .

geographbg:КрепостХисарлъкаКюстендил a geographbg:Крепост ;
    rdfs:label "Хисарлъка (крепост, Кюстендил)"@bg ;
    geographbg:имаИстория "Късноантична и средновековна крепост, изградена в края на 4 – началото на 5 век. Поправяна през 6 в., преживява Първата и Втората българска държава и е съборена от османските завоеватели през 15 век."@bg ;
    geographbg:находящСеВ geographbg:ХисарлъкаЛесопаркКюстендил .

geographbg:КрепостХоризонтБалчик a geographbg:Крепост ;
    rdfs:label "Крепост Хоризонт (Балчик)"@bg ;
    geographbg:находящСеВ geographbg:КварталХоризонтБалчик .

geographbg:КрепостШкодра a geographbg:Крепост ;
    rdfs:label "Крепост в Шкодра"@bg ;
    geographbg:находящСеВ geographbg:ШкодраГрад .

geographbg:КресненскоДефиле a geographbg:Пролом ;
    rdfs:label "Кресненско дефиле"@bg ;
    geographbg:намираСеНаРека geographbg:РекаСтрума .

geographbg:КриваПаланкаГрад a geographbg:Град ;
    rdfs:label "Крива Паланка"@bg ;
    geographbg:находящСеВ geographbg:СлавищеОбласт .

geographbg:КриваЧукаВръх a geographbg:ПланинскиВръх ;
