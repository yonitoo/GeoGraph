geographbg:ВгражданеНаСянкаОбичай rdfs:label "Вграждане на сянка"@bg ;
    geographbg:имаОписание "Български ритуал, познат на Балканите, в Трансилвания и Унгария. Според легендата, млада жена бива зазидана жива в основите на строеж за омилостивяване. Свързан с Кадин мост, Дяволския мост, Турчин мост, моста Павлекюпрюси, Маринов мост, Извора на Белоногата."@bg ;
    geographbg:свързанС geographbg:БалканскиПолуостров,
        geographbg:Трансилвания,
        geographbg:Унгария .

geographbg:ВедаСловена rdfs:label "Веда Словена"@bg ;
    geographbg:имаОписание "„Веда словена: Български народни песни от предисторическата и предхристиянската епоха“ е сборник с народно песенно творчество публикуван от Стефан Веркович в два тома (1874 г. и 1881 г.). Песните са събирани основно в Татарпазарджишката и Неврокопската каза, предоставени от Иван Гологанов от село Търлис, Неврокопско."@bg ;
    geographbg:основанПрезГодина 1874 ;
    geographbg:свързанС geographbg:НеврокопскаКаза,
        geographbg:ТатарпазарджишкаКаза,
        geographbg:ТърлисСело .

geographbg:ВедаСловенаСборник a owl:Thing ;
    rdfs:label "Веда Словена"@bg ;
    geographbg:имаОписание "Сборник с български народни песни, публикуван в два тома (1874, 1881)."@bg .

