    geographbg:датаНаОбявяване "1934-01-01"^^xsd:date ;
    geographbg:държава geographbg:България ;
    geographbg:извираОт geographbg:РекаСтрума ;
    geographbg:имаГеология "Изградена от мощен монцонитов плутон в ядрото, вместен сред горнокредни вулканити (андезити, андезитови брекчи, туфи, туфити). По северната периферия лежат терциерни конгломерати и пясъчници. В северното подножие - плиоценски езерни утайки. Образувана през неогена и кватернера чрез тектонско издигане."@bg ;
    geographbg:имаКлимат "Планински над 1800 м.н.в. Валежи: 700-1050 mm. Средна януарска t°: -4°C (-8°C на Черни връх). Средна юлска t°: 13°C (8°C на Черни връх). Преобладаващи ЮЗ ветрове."@bg ;
    geographbg:имаОписание "Единствената куполообразна планина в България. Формата ѝ е почти кръгла. Диаметър 20-25 km."@bg,
        "На територията на Витоша се намира Природен парк „Витоша“ — най-старият природен парк на Балканския полуостров (създаден 1934 г.). Витоша НЕ е национален парк, а природен парк."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ;
            geographbg:имаСтойност 278.0 ] ;
    geographbg:имаСреднаНадморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 1500.0 ] ;
    geographbg:имаТипПочва [ a geographbg:Почва ;
            rdfs:label "Торфени почви"@bg ],
        [ a geographbg:Почва ;
            rdfs:label "Торфенисто-блатни почви"@bg ],
        geographbg:КанелениГорскиПочви,
        geographbg:КафявиГорскиПочви,
        geographbg:ПланинскоЛивадниПочви ;
    geographbg:имаФауна "Бозайници: благороден елен, сърна, дива свиня, кафява мечка, вълк, лисица, видра, дива котка, 11 вида прилепи. Птици: 236 вида (120 гнездят). Риби: речна пъстърва. Безгръбначни: около 150 балкански и български ендемити, 85 реликтни вида."@bg ;
    geographbg:имаФлора "Горите заемат над 50% от територията, пасищата – 25%. Около 1500 вида висши растения (50% от всички в България), 24 български и балкански ендемита, 52 вида от Червената книга на България."@bg ;
    geographbg:найВисокВръхНа geographbg:ЧерниВръх ;
    geographbg:находящСеВ [ a geographbg:ГеографскиРегион ;
            rdfs:label "Средногорие"@bg ],
        [ a geographbg:ГеографскиРегион ;
            rdfs:label "Завалско-Планска планинска редица"@bg ],
        geographbg:ЗападнаБългария ;
    geographbg:преминаваПрез geographbg:БукаПреслапСедловина,
        geographbg:ВладайскаСедловина,
        geographbg:ЯремаСедловина ;
