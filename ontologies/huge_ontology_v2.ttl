geographbg:КняжевскаГора a geographbg:Гора,
        geographbg:Парк ;
    rdfs:label "Княжевска гора"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаОписание "Държавен парк. Сред основните туристически връзки на София с Природен парк „Витоша“. Попада във височинния пояс на мезофилните и ксеромезофилни дъбово-габърови гори (650 до 800 м н.в.). Надморска височина: 650-900 м. Площ: 910 декара (решение на МС). На територията на парка се намират 3 каптажа, 58 пейки с гранитна основа, гранитни стълби, 12 „витошки“ пейки и 2000 метра отводнени алеи."@bg ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 91.0 ] ;
    geographbg:имаТипПочва geographbg:КафяваГорскаПреходнаПочва,
        geographbg:КафяваГорскаТъмнаПочва ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:ЧеренКълвач ;
    geographbg:имаХарактеренРастителенВид geographbg:Акация,
        geographbg:Бреза,
        geographbg:БялБор,
        geographbg:Дуглазка,
        geographbg:ЗименДъб,
        geographbg:Клек,
        geographbg:ЛетенДъб,
        geographbg:ПланинскиЯсен,
        geographbg:Смърч,
        geographbg:ЦерРастение,
        geographbg:ЧеренБор,
        geographbg:Ясен ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Метър ;
            geographbg:имаСтойност 650.0 ] ;
    geographbg:находящСеВ geographbg:КварталКняжево,
        geographbg:Княжево ;
    geographbg:основанПрезГодина 1881 ;
    geographbg:свързанС geographbg:ПрироденПаркВитоша .

