geographbg:ДойчовОстровЗащитенаМестност a geographbg:ЗащитенаМестност ;
    rdfs:label "Дойчов остров (защитена местност)"@bg ;
    geographbg:датаНаОбявяване "2007-12-27"^^xsd:date ;
    geographbg:имаПлощ [ a geographbg:КоличественаСтойност ;
            geographbg:имаМернаЕдиница geographbg:Хектар ;
            geographbg:имаСтойност 16.05 ] ;
    geographbg:имаСтатутНаЗащитенаМестност "Опазване и поддържане на крайречни заливни гори, доминирани от бяла върба (Salix alba), бяла топола (Populus alba) и черна топола (Populus nigra), места за размножаване на консервационно значими видове риба и опазване на местообитанията на морския орел (Haliaeetus albicilla), малка бяла чапла (Egretta garzetta), сива чапла (Ardea cinerea), червена чапла (Ardea purpurea), нощна чапла (Nycticorax nycticorax)."@bg ;
    geographbg:находящСеВ geographbg:ЗащитенаЗонаРибарнициМечка ;
