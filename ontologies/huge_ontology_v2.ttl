geographbg:РусалииОбичай a geographbg:Събитие ;
    rdfs:label "Русалии (обичай)"@bg ;
    geographbg:имаАлтернативноИме "калушари"@bg ;
    geographbg:имаОписание "Ритуални игри, изпълнявани през Русалийската седмица или поганните дни. Характерни за България, Румъния, Македония. Група мъже (русалии) с водач (ватаф) обикалят села, изпълнявайки магично-шаманистични игри с музика за лекуване на болести."@bg ;
    geographbg:свързанС geographbg:България,
        geographbg:Румъния,
