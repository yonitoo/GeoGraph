# Притоци: Раворска река, Копривска река, Добралъшко дере, Ливадишко дере, Тумбешко дере, Чамурдере

# --- From "Мугленска река" ---
geographbg:МугленскаРекаМугленска a geographbg:Река ;
    rdfs:label "Мугленска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Смолян
    geographbg:притокНа geographbg:ЧаирдереРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "27.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Голям Перелик, Западни Родопи"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "2036.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Голяма река"@bg ;
    geographbg:преминаваПрез geographbg:МуглаСело .

geographbg:ГолямПереликВръх a geographbg:ПланинскиВръх ; rdfs:label "Голям Перелик"@bg .
geographbg:МуглаСело a geographbg:Село ; rdfs:label "Мугла"@bg .
# Притоци: Переликско дере, Гечувска река, Гингерска река, Малка река, Селска река

# --- From "Мустанова река" ---
geographbg:МустановаРекаМустанова a geographbg:Река ;
    rdfs:label "Мустанова река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:притокНа geographbg:ЕледжикРекаЕледжик ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "28.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до с. Петрово, община Стара Загора"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "186.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Малкия Азмак"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "67.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ПъстренСело .

geographbg:ПетровоСелоМустанова a geographbg:Село ; rdfs:label "Петрово (Старозагорско)"@bg .
geographbg:ПъстренСело a geographbg:Село ; rdfs:label "Пъстрен"@bg .
# Притоци: Билюкчаирска река, Боклуджадере
# Язовири: "Петрово", "Пъстрен", "Априлово"

# --- From "Мътивир" ---
geographbg:МътивирРека a geographbg:Река ;
    rdfs:label "Мътивир"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:СофийскаОбластБуновска ;
    geographbg:притокНа geographbg:ТополницаРекаБуновска ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "61.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    # Образува се от Баба река, Ръжана и Мешковица
    geographbg:имаАлтернативноИме "Голяма река"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "412.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ТополницаЯзовир ;
    geographbg:преминаваПрез geographbg:ПауновоСело, geographbg:ИхтиманГрад .

geographbg:БабаРекаМътивир a geographbg:Река ; rdfs:label "Баба река (съставяща Мътивир)"@bg .
geographbg:РъжанаРекаМътивир a geographbg:Река ; rdfs:label "Ръжана (река, съставяща Мътивир)"@bg .
geographbg:МешковицаРекаМътивир a geographbg:Река ; rdfs:label "Мешковица (река)"@bg .
geographbg:МътивирРека geographbg:еСъставящаЧастНа geographbg:БабаРекаМътивир, geographbg:РъжанаРекаМътивир, geographbg:МешковицаРекаМътивир .
geographbg:ТополницаЯзовир a geographbg:Язовир ; rdfs:label "Тополница (язовир)"@bg ; geographbg:намираСеНаРека geographbg:ТополницаРекаБуновска .
geographbg:ПауновоСело a geographbg:Село ; rdfs:label "Пауново"@bg .
geographbg:ИхтиманГрад a geographbg:Град ; rdfs:label "Ихтиман"@bg .
# Притоци: ... (много)

# --- From "Мътница (приток на Чепинска река)" ---
geographbg:МътницаПритокЧепинска a geographbg:Река ;
    rdfs:label "Мътница (приток на Чепинска река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:ЧепинскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "16.3"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт geographbg:ЯзовирБатак ; # "изтича от язовир Батак"
    geographbg:преминаваПрез geographbg:ДорковоСело, geographbg:КостандовоГрад, geographbg:ВелинградГрад .

geographbg:ДорковоСело a geographbg:Село ; rdfs:label "Дорково"@bg .
geographbg:КостандовоГрад a geographbg:Град ; rdfs:label "Костандово"@bg .
# Притоци: Връбница, Ракитовска Стара река

# --- From "Новоселска река (приток на Омуровска река)" ---
geographbg:НовоселскаРекаПритокОмуровска a geographbg:Река ;
    rdfs:label "Новоселска река (приток на Омуровска река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:притокНа geographbg:ОмуровскаРекаНовоселска ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "22.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до хижа Каваклийка, Сърнена Средна гора"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "802.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Ямачдере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "118.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ГорноНовоСело, geographbg:ДолноНовоСело, geographbg:НайденовоСело, geographbg:ГолямДолСело .

geographbg:ОмуровскаРекаНовоселска a geographbg:Река ; rdfs:label "Омуровска река"@bg ; geographbg:притокНа geographbg:Марица .
geographbg:ГорноНовоСело a geographbg:Село ; rdfs:label "Горно Ново село"@bg .
geographbg:ДолноНовоСело a geographbg:Село ; rdfs:label "Долно Ново село"@bg .
geographbg:НайденовоСело a geographbg:Село ; rdfs:label "Найденово"@bg .
geographbg:ГолямДолСело a geographbg:Село ; rdfs:label "Голям дол"@bg .
# Притоци: Баалъкдере, Куздере, Кузгундере, Гелгюлика, Калфенска река

# --- From "Овчарица" ---
geographbg:ОвчарицаРекаОвчарица a geographbg:Река ;
    rdfs:label "Овчарица (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Сливен, Област Ямбол, Област Стара Загора
    geographbg:притокНа geographbg:СазлийкаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "72.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Светиилийски възвишения, близо до връх Острата вила"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "310.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "636.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ОвчарицаЯзовир ; # Also in Сазлийка
    geographbg:преминаваПрез geographbg:ПрохоровоСело, geographbg:КовачевоСелоРаднево, geographbg:ТрояновоСелоРаднево .

geographbg:СветиилийскиВъзвишения a geographbg:Хълм ; rdfs:label "Светиилийски възвишения"@bg . # Or Рид
geographbg:ОстратаВилаВръх a geographbg:ПланинскиВръх ; rdfs:label "Острата вила"@bg .
geographbg:ПрохоровоСело a geographbg:Село ; rdfs:label "Прохорово (Новозагорско)"@bg .
geographbg:КовачевоСелоРаднево a geographbg:Село ; rdfs:label "Ковачево (Радневско)"@bg .
geographbg:ТрояновоСелоРаднево a geographbg:Село ; rdfs:label "Трояново (Радневско)"@bg .
geographbg:ЯзовирПрохорово a geographbg:Язовир ; rdfs:label "Прохорово (язовир)"@bg ; geographbg:намираСеНаРека geographbg:ОвчарицаРекаОвчарица .
# Притоци: ... (много)

# --- From "Пикла" ---
geographbg:ПиклаРека a geographbg:Река ;
    rdfs:label "Пикла"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПловдивБелишка ;
    geographbg:притокНа geographbg:СтрямаРека ;
    geographbg:имаАлтернативноИме "Тикла"@bg ;
    # Образува се от Айрянска река и Пукната река
    geographbg:преминаваПрез geographbg:МътеницаСело, geographbg:ПаничериСело, geographbg:ЖитницаСелоПловдив, geographbg:ДуванлииСело, geographbg:КалояновоСело, geographbg:ГрафИгнатиевоСело .

geographbg:АйрянскаРека a geographbg:Река ; rdfs:label "Айрянска река"@bg .
geographbg:ПукнатаРека a geographbg:Река ; rdfs:label "Пукната река"@bg .
geographbg:ПиклаРека geographbg:еСъставящаЧастНа geographbg:АйрянскаРека, geographbg:ПукнатаРека .
geographbg:МътеницаСело a geographbg:Село ; rdfs:label "Мътеница (Пловдивско)"@bg .
geographbg:ПаничериСело a geographbg:Село ; rdfs:label "Паничери"@bg .
geographbg:ЖитницаСелоПловдив a geographbg:Село ; rdfs:label "Житница (Пловдивско)"@bg .
geographbg:ДуванлииСело a geographbg:Село ; rdfs:label "Дуванлии"@bg .
geographbg:КалояновоСело a geographbg:Село ; rdfs:label "Калояново (Пловдивско)"@bg .
geographbg:ГрафИгнатиевоСело a geographbg:Село ; rdfs:label "Граф Игнатиево"@bg .

# --- From "Равногорска река" ---
geographbg:РавногорскаРекаРавногорска a geographbg:Река ;
    rdfs:label "Равногорска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:СтараРекаРавногорска ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "24.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Санджак, Баташка планина"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1686.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Боазка река"@bg ;
    geographbg:преминаваПрез geographbg:РавногорСело, geographbg:РозовоСелоПазарджик .

geographbg:СтараРекаРавногорска a geographbg:Река ; rdfs:label "Стара река (приток на Марица, горно течение)"@bg . # Needs disambiguation
geographbg:СанджакВръх a geographbg:ПланинскиВръх ; rdfs:label "Санджак (връх)"@bg .
geographbg:РавногорСело a geographbg:Село ; rdfs:label "Равногор"@bg .
geographbg:РозовоСелоПазарджик a geographbg:Село ; rdfs:label "Розово (Пазарджишко)"@bg .
# Притоци: Батачка река, Умишка река
geographbg:РавногорскаРекаРавногорска geographbg:свързанС geographbg:БаташкиВодносиловПътКаскада . # "част от водите ѝ се прехвърлят в язовир „Батак“"

# --- From "Розов кладенец" ---
geographbg:РозовКладенецЯзовир a geographbg:Язовир ;
    rdfs:label "Розов кладенец (язовир)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:намираСеВЗемлищетоНа geographbg:ГълъбовоГрад, geographbg:ОбручищеСело ;
    geographbg:основанПрезГодина "1960"^^xsd:integer ; # 1957-1960
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "20400000.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаЗалятаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "3.63"^^xsd:decimal ; # 363 ha
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаДължинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1285.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ; # Main wall
    geographbg:имаВисочинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "11.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ; # Main wall
    geographbg:свързанС geographbg:ТЕЦБрикел, geographbg:ТЕЦКонтурГлобалМарицаИзток3, geographbg:ТЕЦЕйИЕсМарицаИзток1 ;
    geographbg:намираСеНаРека geographbg:СоколицаРека ; # Implied
    geographbg:захранваСеОт geographbg:СоколицаРека, geographbg:СазлийкаРека .

geographbg:ГълъбовоГрад a geographbg:Град ; rdfs:label "Гълъбово"@bg ; geographbg:находящСеВ geographbg:ОбластСтараЗагора .
geographbg:ОбручищеСело a geographbg:Село ; rdfs:label "Обручище"@bg ; geographbg:находящСеВ geographbg:ОбластСтараЗагора .
geographbg:ТЕЦБрикел a geographbg:ИнфраструктуренОбект ; rdfs:label "ТЕЦ Брикел"@bg .
geographbg:ТЕЦКонтурГлобалМарицаИзток3 a geographbg:ИнфраструктуренОбект ; rdfs:label "ТЕЦ КонтурГлобал Марица Изток 3"@bg .
geographbg:ТЕЦЕйИЕсМарицаИзток1 a geographbg:ИнфраструктуренОбект ; rdfs:label "ТЕЦ Ей И Ес Марица Изток I"@bg .
geographbg:ОбластСтараЗагора a geographbg:Област ; rdfs:label "Област Стара Загора"@bg ; geographbg:държава geographbg:България .

# --- From "Свеженска река" ---
geographbg:СвеженскаРека a geographbg:Река ;
    rdfs:label "Свеженска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПловдив ;
    geographbg:притокНа geographbg:БялаРекаПритокСтряма ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "26.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "близо до връх Чатал дърво, Сърнена Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1059.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "121.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:БялаРекаПритокСтряма ;
    geographbg:преминаваПрез geographbg:СвеженСело, geographbg:ДомлянСело .

geographbg:ОбластПловдив a geographbg:Област ; rdfs:label "Област Пловдив"@bg ; geographbg:държава geographbg:България .
geographbg:СърненаСреднаГора a geographbg:Планина ; rdfs:label "Сърнена Средна гора"@bg .
geographbg:ЧаталДървоВръх a geographbg:ПланинскиВръх ; rdfs:label "Чатал дърво"@bg ; geographbg:находящСеВ geographbg:СърненаСреднаГора .
geographbg:СвеженСело a geographbg:Село ; rdfs:label "Свежен"@bg ; geographbg:находящСеВ geographbg:ОбластПловдив .
geographbg:ДомлянСело a geographbg:Село ; rdfs:label "Домлян"@bg ; geographbg:находящСеВ geographbg:ОбластПловдив .
geographbg:ЯзовирДомлян a geographbg:Язовир ;
    rdfs:label "Домлян (язовир)"@bg ;
    geographbg:намираСеНаРека geographbg:СвеженскаРека .
geographbg:ЧифлишкоДере a geographbg:Река ; rdfs:label "Чифлишко дере"@bg .
geographbg:МраченишкаРека a geographbg:Река ; rdfs:label "Мраченишка река"@bg .
geographbg:СвеженскаРека geographbg:имаПриток geographbg:ЧифлишкоДере, geographbg:МраченишкаРека .
geographbg:БялаРекаПритокСтряма geographbg:имаПриток geographbg:СвеженскаРека .

# --- From "Соколица (река)" ---
geographbg:СоколицаРека a geographbg:Река ;
    geographbg:находящСеВ geographbg:ОбластХасково, geographbg:ОбластСтараЗагора ;
    geographbg:притокНа geographbg:СазлийкаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "60.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "подножие на връх Боговец, Сакар планина"@bg ;
        geographbg:находящСеВ geographbg:СакарПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "713.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Сакарско дере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "343.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ОрловДолСело, geographbg:ВладимировоСелоХасково, geographbg:МъдрецСело, geographbg:ИскрицаСело, geographbg:ОбручищеСело .

geographbg:ОбластХасково a geographbg:Област ; rdfs:label "Област Хасково"@bg ; geographbg:държава geographbg:България .
geographbg:СакарПланина a geographbg:Планина ; rdfs:label "Сакар планина"@bg .
geographbg:БоговецВръх a geographbg:ПланинскиВръх ; rdfs:label "Боговец (връх)"@bg ; geographbg:находящСеВ geographbg:СакарПланина .
geographbg:ОрловДолСело a geographbg:Село ; rdfs:label "Орлов дол"@bg ; geographbg:находящСеВ geographbg:ОбластХасково .
geographbg:ВладимировоСелоХасково a geographbg:Село ; rdfs:label "Владимирово (Хасковско)"@bg ; geographbg:находящСеВ geographbg:ОбластХасково .
geographbg:МъдрецСело a geographbg:Село ; rdfs:label "Мъдрец (село)"@bg ; geographbg:находящСеВ geographbg:ОбластСтараЗагора .
geographbg:ИскрицаСело a geographbg:Село ; rdfs:label "Искрица (село)"@bg ; geographbg:находящСеВ geographbg:ОбластСтараЗагора .

# --- From "Стара река (приток на Стряма)" ---
geographbg:СтараРекаПритокСтряма a geographbg:Река ;
    rdfs:label "Стара река (приток на Стряма)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПловдив ;
    geographbg:притокНа geographbg:СтрямаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "20.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "подножие на рид Равнец, Калоферска планина, Стара планина"@bg ;
        geographbg:находящСеВ geographbg:СтараПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1942.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Голямата река (Стара река, Стряма)"@bg ;
    geographbg:преминаваПрез geographbg:КарловоГрад .

geographbg:РавнецРид a geographbg:Рид ; rdfs:label "Равнец (рид)"@bg ; geographbg:находящСеВ geographbg:СтараПланина .
geographbg:КалоферскаПланина a geographbg:Планина ; rdfs:label "Калоферска планина"@bg ; geographbg:находящСеВ geographbg:СтараПланина .
geographbg:КарловоГрад a geographbg:Град ; rdfs:label "Карлово"@bg ; geographbg:находящСеВ geographbg:ОбластПловдив .
geographbg:КарловскиВодопад a geographbg:Водопад ;
    rdfs:label "Карловски водопад"@bg ;
    geographbg:имаАлтернативноИме "Сучурум"@bg ;
    geographbg:намираСеНаРека geographbg:СтараРекаПритокСтряма .
geographbg:БаняГрадКарловско a geographbg:Град ; rdfs:label "Баня (Карловско)"@bg .

# --- From "Стрелчанска Луда Яна" ---
geographbg:СтрелчанскаЛудаЯнаРека a geographbg:Река ;
    rdfs:label "Стрелчанска Луда Яна"@bg ;
    geographbg:държава geographbg:България ;
    # Софийска област, Област Пазарджик
    geographbg:притокНа geographbg:ЛудаЯнаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "39.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "близо до връх Голям Богдан, Същинска Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СъщинскаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1472.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Медедере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "173.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СтрелчаГрад .

geographbg:ГолямБогданВръх a geographbg:ПланинскиВръх ; rdfs:label "Голям Богдан"@bg ; geographbg:находящСеВ geographbg:СъщинскаСреднаГора .
geographbg:СтрелчаГрад a geographbg:Град ; rdfs:label "Стрелча"@bg ; geographbg:находящСеВ geographbg:ОбластПазарджик .
geographbg:ПопинциСело a geographbg:Село ; rdfs:label "Попинци"@bg .
# Притоци: Дълбокото дере, Азанско дере, Бъзево дере, Кладнидялска река, Скумсале, Черешката, Церов дол, Четлево дере, Граднишки дол

# --- From "Сушица (река)" ---
geographbg:СушицаРекаПритокЮговска a geographbg:Река ;
    rdfs:label "Сушица (река, приток на Юговска)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПловдив ;
    geographbg:притокНа geographbg:ЮговскаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "24.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "подножие на връх Сини връх, Добростански рид, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1425.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "62.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СиниВръхСело, geographbg:МостовоСело .

geographbg:ЮговскаРека a geographbg:Река ;
    rdfs:label "Юговска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:еСъставящаЧастНа geographbg:ДжурковскаРека, geographbg:МанастирскаРекаЮговска ;
    # Област Смолян, Област Пловдив
    geographbg:притокНа geographbg:ЧепеларскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "45.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    # Образува се от Джурковска и Манастирска река
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "332.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:СушицаРекаПритокЮговска ;
    geographbg:преминаваПрез geographbg:ЛъкиГрад .
geographbg:СиниВръхВръх a geographbg:ПланинскиВръх ; rdfs:label "Сини връх (Добростански рид)"@bg .
geographbg:ДобростанскиРид a geographbg:Рид ; rdfs:label "Добростански рид"@bg ; geographbg:находящСеВ geographbg:ЗападниРодопи .
geographbg:СиниВръхСело a geographbg:Село ; rdfs:label "Сини връх (село)"@bg .
geographbg:МостовоСело a geographbg:Село ; rdfs:label "Мостово"@bg .
geographbg:ЮговоСело a geographbg:Село ; rdfs:label "Югово"@bg .
geographbg:РезерватЧервенатаСтена a geographbg:Резерват ; rdfs:label "Червената стена (резерват)"@bg .
geographbg:БеланташПлато a geographbg:Плато ; rdfs:label "Беланташ"@bg .

# --- From "Тешел (язовир)" ---
geographbg:ОбластСмолян a geographbg:Област ; rdfs:label "Област Смолян"@bg ; geographbg:държава geographbg:България .
geographbg:БуйновскаРека a geographbg:Река ; rdfs:label "Буйновска река"@bg .
geographbg:ВЕЦДевин geographbg:захранваСеОт geographbg:ЯзовирТешел .

# --- From "Тошков чарк" ---
geographbg:ВЕЦБатакКаскада geographbg:захранваСеОт geographbg:ЯзовирТошковЧарк . # "водите му се нагнетяват в главната напорна деривация на ВЕЦ „Батак“"

# --- From "Узунджовска река" ---
geographbg:УзунджовскаРека a geographbg:Река ;
    rdfs:label "Узунджовска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластХасково ;
    geographbg:притокНа geographbg:ХарманлийскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "21.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до шосето Хасково – Димитровград"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "179.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Хандере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "81.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:УзунджовоСело .

geographbg:УзунджовоСело a geographbg:Село ; rdfs:label "Узунджово"@bg ; geographbg:находящСеВ geographbg:ОбластХасково .
geographbg:БряговоСелоХасково a geographbg:Село ; rdfs:label "Брягово (Хасковско)"@bg .
geographbg:АрадереПритокУзунджовска a geographbg:Река ; rdfs:label "Арадере (приток на Узунджовска)"@bg .
geographbg:УзунджовскаРека geographbg:имаПриток geographbg:АрадереПритокУзунджовска .

# --- From "Хасковска река" ---
geographbg:ХасковскаРека a geographbg:Река ;
    rdfs:label "Хасковска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластХасково ;
    geographbg:притокНа geographbg:ХарманлийскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "45.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "рид Мечковец, Източни Родопи, близо до връх Мечковец"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "770.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "179.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СпахиевоСело, geographbg:СираковоСелоХасково, geographbg:ВъгларовоСело, geographbg:ХасковоГрад .

geographbg:МечковецРид a geographbg:Рид ; rdfs:label "Мечковец (рид)"@bg ; geographbg:находящСеВ geographbg:ИзточниРодопи .
geographbg:МечковецВръх a geographbg:ПланинскиВръх ; rdfs:label "Мечковец (връх)"@bg .
geographbg:СпахиевоСело a geographbg:Село ; rdfs:label "Спахиево"@bg .
geographbg:СираковоСелоХасково a geographbg:Село ; rdfs:label "Сираково (Хасковско)"@bg .
geographbg:ВъгларовоСело a geographbg:Село ; rdfs:label "Въгларово"@bg .
geographbg:ХасковоГрад a geographbg:Град ; rdfs:label "Хасково"@bg ; geographbg:находящСеВ geographbg:ОбластХасково .
geographbg:СтойковоСело a geographbg:Село ; rdfs:label "Стойково (Хасковско)"@bg .
geographbg:БалъклиПритокХасковска a geographbg:Река ; rdfs:label "Балъкли (приток на Хасковска)"@bg .
geographbg:СевджадереПритокХасковска a geographbg:Река ; rdfs:label "Севджадере (приток на Хасковска)"@bg .
geographbg:ХасковскаРека geographbg:имаПриток geographbg:БалъклиПритокХасковска, geographbg:СевджадереПритокХасковска .
geographbg:ЯзовирСираково a geographbg:Язовир ; rdfs:label "Сираково (язовир)"@bg ; geographbg:намираСеНаРека geographbg:ХасковскаРека .

# --- From "Чаира (язовир)" ---
geographbg:ЧаирскаРека a geographbg:Река ; rdfs:label "Чаирска река"@bg .

# --- From "Чаирдере" ---
geographbg:ЧаирдереРека a geographbg:Река ;
    rdfs:label "Чаирдере (река, съставяща Въча)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:притокНа geographbg:ВъчаРека ;
    geographbg:находящСеВ geographbg:ОбластСмолян ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "21.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Делибоска, Мурсалица, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1919.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:еСъставящаЧастНа geographbg:ВъчаРека . # "дават началото на същинската река Въча"

geographbg:ДелибоскаВръх a geographbg:ПланинскиВръх ; rdfs:label "Делибоска"@bg .
geographbg:МурсалицаРид a geographbg:Рид ; rdfs:label "Мурсалица (рид)"@bg ; geographbg:находящСеВ geographbg:ЗападниРодопи .
geographbg:ТешелСело a geographbg:Село ; rdfs:label "Тешел"@bg ; geographbg:находящСеВ geographbg:ОбластСмолян .
geographbg:ТриградскаРека a geographbg:Река ; rdfs:label "Триградска река"@bg .
geographbg:ЧаирдереРека geographbg:имаПриток geographbg:ТриградскаРека, geographbg:МугленскаРекаМугленска .

# --- From "Черковска река" ---
geographbg:ЧерковскаРека a geographbg:Река ;
    rdfs:label "Черковска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Стара Загора, Област Сливен
    geographbg:притокНа geographbg:БлатницаРекаБлатница ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "26.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "местност Юрта, Сърнена Средна гора, близо до връх Голям Гавраил"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "612.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "77.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:БратяКунчевиСело, geographbg:ПодслонСело, geographbg:СъбраноСело, geographbg:ЛюбенецСело .

geographbg:ГолямГавраилВръх a geographbg:ПланинскиВръх ; rdfs:label "Голям Гавраил"@bg .
geographbg:БратяКунчевиСело a geographbg:Село ; rdfs:label "Братя Кунчеви"@bg .
geographbg:ПодслонСело a geographbg:Село ; rdfs:label "Подслон (село)"@bg .
geographbg:СъбраноСело a geographbg:Село ; rdfs:label "Събрано"@bg .
