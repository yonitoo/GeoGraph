geographbg:ВъзстановкаПосрещанеРускиВойскиКопривщица a geographbg:Събитие ;
    rdfs:label "Възстановка на посрещането на руските освободителни войски в Копривщица"@bg ;
    geographbg:имаОписание "Част от празниците по случай Националния празник 3 март. Провежда се на площад „20-ти април“ в Копривщица. Организира се от местен инициативен комитет с участие на клубове от НД „Традиция“. Включва преглед на почетна рота, слово, поднасяне на венци и възстановка на посрещането на освободителите."@bg ;
    geographbg:находящСеВ geographbg:Площад20АприлКопривщица .

geographbg:КаравеловаСедянка a geographbg:Събитие ;
    rdfs:label "Каравелова седянка"@bg ;
    geographbg:имаОписание "Традиционно събитие в Копривщица в памет на Любен Каравелов, част от летните фолклорни празници „С Копривщица в сърцето“. Провежда се на площада пред родния му дом. Включва четения, театрализиран спектакъл по „Българи от старо време“ и фолклорни изпълнения."@bg ;
    geographbg:свързанС geographbg:ЛетниФолклорниПразнициСКопривщицаВСърцето ;
    geographbg:находящСеВ geographbg:КъщаМузейЛюбенИПеткоКаравелови . # The square in front of it

geographbg:ЛетниФолклорниПразнициСКопривщицаВСърцето a geographbg:Събитие ;
    rdfs:label "Летни фолклорни празници „С Копривщица в сърцето“"@bg ;
    geographbg:имаОписание "Ежегодно културно събитие в Копривщица. Организират се от Община Копривщица, Народното читалище и Дирекцията на музеите. Включват документални изложби, народно веселие, „Дебелянови вечери“, храмов празник, представяне на книги, „Мегданско хоро“. На всеки пет години съвпадат с Националния събор на българското народно творчество."@bg ;
    geographbg:находящСеВ geographbg:КопривщицаГрад ;
    geographbg:стопанисваСеОт geographbg:ОбщинаКопривщица ;
    geographbg:стопанисваСеОт geographbg:НародноЧиталищеКопривщица ;
    geographbg:стопанисваСеОт geographbg:ДирекцияНаМузеитеКопривщица .

geographbg:ОбщинаКопривщица a geographbg:Община ;
    rdfs:label "Община Копривщица"@bg .

geographbg:НародноЧиталищеКопривщица a geographbg:КултуренОбект ;
    rdfs:label "Народно читалище (Копривщица)"@bg ;
    geographbg:находящСеВ geographbg:КопривщицаГрад .

geographbg:МегданскоХороКопривщица a geographbg:Събитие ;
    rdfs:label "Мегданско хоро (Копривщица)"@bg ;
    geographbg:имаОписание "Традиционно събитие в Копривщица, част от летните фолклорни празници. Провежда се ежеседмично през лятото на площад „20-ти Април“. Участват фолклорни групи и индивидуални изпълнители."@bg ;
    geographbg:находящСеВ geographbg:Площад20АприлКопривщица ;
    geographbg:свързанС geographbg:ЛетниФолклорниПразнициСКопривщицаВСърцето .

geographbg:МеждународенФолклоренФестивалБургас a geographbg:Събитие ;
    rdfs:label "Международен фолклорен фестивал в Бургас"@bg ;
    geographbg:имаОписание "Фестивал за фолклорна музика в Бургас, провеждан от 1965 до 2019 г. Първоначално Балканиада на народните песни и танци. От 1999 г. се връчва награда „Нестинарка“."@bg ;
    geographbg:основанПрезГодина "1965"^^xsd:integer ;
    geographbg:находящСеВ geographbg:БургасГрад .

geographbg:НаградаНестинарка a geographbg:КултуренОбект ; # Award
    rdfs:label "Награда „Нестинарка“"@bg ;
    geographbg:имаОписание "Награда за песенно и танцово творчество, връчвана от 1999 г. като част от Международния фолклорен фестивал в Бургас."@bg ;
    geographbg:свързанС geographbg:МеждународенФолклоренФестивалБургас .

geographbg:НационаленСъборНаБългарскотоНародноТворчество a geographbg:Събитие ;
    rdfs:label "Национален събор на българското народно творчество"@bg ;
    geographbg:имаОписание "Събор на народното творчество, провеждан през около 5 години в местността „Войводенец“ край Копривщица от 1965 г. Представя автентичен български фолклор. Мото: „България пее в Копривщица“. Химн: „Хубава си, моя горо“."@bg ;
    geographbg:основанПрезГодина "1965"^^xsd:integer ;
    geographbg:находящСеВ geographbg:МестностВойводенец ;
    geographbg:близоДо geographbg:КопривщицаГрад .

geographbg:МестностВойводенец a geographbg:Местност ;
    rdfs:label "Войводенец"@bg ;
    geographbg:близоДо geographbg:КопривщицаГрад .

geographbg:НишавскиХоровод a geographbg:Събитие ;
    rdfs:label "Нишавски хоровод"@bg ;
    geographbg:имаОписание "Международен фолклорен фестивал, провеждан всяка година около 24 май в Драгоман. Основан през 2001 г. Участват представители от населени места по поречието на р. Нишава в България и Сърбия."@bg ;
    geographbg:основанПрезГодина "2001"^^xsd:integer ;
    geographbg:находящСеВ geographbg:Драгоман ;
    geographbg:стопанисваСеОт geographbg:НародноЧиталищеДрагоман1925 ;
    geographbg:стопанисваСеОт geographbg:ЦентърЗаКултураДимитровградСърбия .

geographbg:НародноЧиталищеДрагоман1925 a geographbg:КултуренОбект ;
    rdfs:label "Народно читалище „Драгоман 1925“"@bg ;
    geographbg:находящСеВ geographbg:Драгоман .

geographbg:ЦентърЗаКултураДимитровградСърбия a geographbg:КултуренОбект ;
    rdfs:label "Център за култура (Димитровград, Сърбия)"@bg ;
    geographbg:находящСеВ geographbg:ДимитровградСърбия .

geographbg:ДимитровградСърбия a geographbg:Град ;
    rdfs:label "Димитровград (Сърбия)"@bg ;
    geographbg:държава geographbg:Сърбия .

geographbg:ФестивалНаНароднатаНосияЖеравна a geographbg:Събитие ;
    rdfs:label "Фестивал на народната носия (Жеравна)"@bg ;
    geographbg:имаОписание "Ежегоден фестивал в с. Жеравна, основан от Христо Димитров. Провежда се в края на август в местността Добромерица. Представят се автентични носии от всички области на България."@bg ;
    geographbg:основанПрезГодина "2008"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ЖеравнаСело ;
    geographbg:находящСеВ geographbg:МестностДобромерица .

geographbg:ЖеравнаСело a geographbg:Село ;
    rdfs:label "Жеравна"@bg .

geographbg:МестностДобромерица a geographbg:Местност ;
    rdfs:label "Добромерица"@bg ;
    geographbg:близоДо geographbg:ЖеравнаСело .

geographbg:ПрегледНаХудожественатаСамодейност a geographbg:Събитие ;
    rdfs:label "Преглед на художествената самодейност"@bg ;
    geographbg:имаОписание "Система от фестивали на любителски групи в изпълнителските изкуства, провеждани в България от 1946 г. Първите са в Плевен и Пловдив. Изградена е йерархична система от общински, окръжни и национални прегледи. Републиканските прегледи завършват на всеки 5 години от 1959 г."@bg ;
    geographbg:основанПрезГодина "1946"^^xsd:integer ;
    geographbg:държава geographbg:България .

geographbg:НационаленФолклоренСъборРожен a geographbg:Събитие ;
    rdfs:label "Национален фолклорен събор „Рожен“"@bg ;
    geographbg:имаОписание "Събор на народното творчество на прохода Рожен в Родопите. Представя народна музика, обичаи, облекла. Първият събор е през 1898 г. (местен). Родопски събор-надпяване от 1961 г. Национален от 1993 г."@bg ;
    geographbg:находящСеВ geographbg:РоженПроход ;
    geographbg:находящСеВ geographbg:Родопи .

geographbg:РоженПроход a geographbg:Проход ;
    rdfs:label "Рожен (проход)"@bg ;
    geographbg:находящСеВ geographbg:Родопи .

geographbg:СурваФестивал a geographbg:Събитие ;
    rdfs:label "Сурва (фестивал)"@bg ;
    geographbg:имаАлтернативноИме "Международен фестивал на маскарадните игри „Сурва“"@bg ;
    geographbg:имаОписание "Най-големият маскараден фестивал в България и на Балканите, провеждан в Перник. Популяризира традиционна ергенска обредност (сурвакари, кукери). Първо издание 1966 г. Международен статут от 1985 г. Обичаят „Сурова“ е вписан в ЮНЕСКО през 2015 г."@bg ;
    geographbg:основанПрезГодина "1966"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ПерникГрад .

geographbg:СъборНаНароднотоТворчество a geographbg:Събитие ;
    rdfs:label "Събор на народното творчество"@bg ;
    geographbg:имаОписание "Система от фестивали в България за сценично представяне на български фолклор. Първият е Странджанският събор (1960 г., Граматиково). Включва регионални събори (Добруджански, Родопски, Ямболски, Пирински, Сливенски) и Националния събор в Копривщица (от 1965 г.)."@bg ;
    geographbg:свързанС geographbg:СтранджанскиСъбор ;
    geographbg:свързанС geographbg:ДобруджанскиСъбор ;
    geographbg:свързанС geographbg:РодопскиСъборРожен ;
    geographbg:свързанС geographbg:ЯмболскиСъбор ;
    geographbg:свързанС geographbg:ПиринскиСъбор ;
    geographbg:свързанС geographbg:СливенскиСъбор ;
    geographbg:свързанС geographbg:НационаленСъборНаБългарскотоНародноТворчество .

