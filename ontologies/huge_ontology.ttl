        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаТипСтена "земнонасипна"@bg ;
    geographbg:имаДължинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "510"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:захранваСеОт [ a geographbg:Река ; rdfs:label "Отовица (река)"@bg ], geographbg:БистрицаДупнишка, geographbg:Джерман, [ a geographbg:Река ; rdfs:label "Валявица (река)"@bg ], geographbg:ФудиняРека, [ a geographbg:Река ; rdfs:label "Горица (река)"@bg ] ;
