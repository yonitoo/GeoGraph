    geographbg:находящСеВ "окръг Кюстенджа, Румъния, на брега на Черно море"@bg ;
    geographbg:близоДо geographbg:ГКППДуранкулак .

# --- Калиакра ---
geographbg:НосКалиакра
    geographbg:типНос "дълъг и тесен нос"@bg ;
    geographbg:находящСеВ "българското северно черноморско крайбрежие, югоизточната част на Добруджанското плато"@bg ;
    geographbg:близоДо geographbg:СелоБългарево, geographbg:СелоСветиНиколаКаварна ;
    geographbg:разстояниеОтКаварна [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "12"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:дължинаНаПолуостров [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:еРезерват geographbg:РезерватКалиакра ;
    geographbg:височинаНаСкали [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "70"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаМузейДа "да"@bg ;
    geographbg:имаФарДа "да"@bg ;
    geographbg:имаПараклисДа "да"@bg ;
    geographbg:историческоИме "Тиризис"@bg, "Тетрасида"@bg, "Калацерка"@bg, "Килагра"@bg, "Челигра бурун"@bg ;
    geographbg:столицаНаКняжество "Карвунско княжество (Балик, Добротица)"@bg .

geographbg:СелоСветиНиколаКаварна a geographbg:Село ;
    rdfs:label "Свети Никола (село, община Каварна)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаКаварна .

geographbg:ДобруджанскоПлато a geographbg:Плато ;
    rdfs:label "Добруджанско плато"@bg .

# --- Калиакра (находище на природен газ) ---
geographbg:НаходищеГазКалиакра a geographbg:НаходищеНаПрироденГаз ;
    rdfs:label "Калиакра (находище на природен газ)"@bg ;
    geographbg:находящСеВ "континенталния шелф и изключителната икономическа зона на България в Черно море"@bg ;
    geographbg:откритоОт geographbg:МелроузРисорсиз ;
    geographbg:датаНаОткриване "2008-01"^^xsd:integerMonth ;
    geographbg:прогнозниЗапаси [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1950000000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:концесионер geographbg:МелроузРисорсизООДВарна ;
    geographbg:срокНаКонцесия "7 години (от 2010-10-04)"@bg ;
    geographbg:площНаКонцесия [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "18.9895"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .

geographbg:МелроузРисорсиз a geographbg:Компания ;
    rdfs:label "Мелроуз Рисорсиз"@bg .

geographbg:МелроузРисорсизООДВарна a geographbg:Компания ;
    rdfs:label "Мелроуз Рисорсиз ООД, Варна"@bg .

# --- Камен бряг ---
geographbg:СелоКаменБряг a geographbg:Село ;
    rdfs:label "Камен бряг (село)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаКаварна, geographbg:ОбластДобрич ;
    geographbg:имаАлтернативноИме "Каменник"@bg, "Кая бей кьой"@bg, "Стънка"@bg ;
    geographbg:близоДоАрхеологическиОбект geographbg:АрхеологическаМестностЯйлата ;
    geographbg:близоДоПрироднаЗабележителност geographbg:ОгънчетоКаменБряг .

