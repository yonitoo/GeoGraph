    geographbg:датаНаОбявяване "2003-08-06"^^xsd:date ;
    geographbg:имаОписание "Представлява високо скално плато, в чиито отвесни стени се е образувал естествен тесен улей, в който е заклещен огромен камък. Скалните стени са високи над 100 m."@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "4550"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаИстория "Изпълнявал функцията на светилище през ранната желязна епоха и късната античност. Проучвания 2004 г. от Иван Христов."@bg .

