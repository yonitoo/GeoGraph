# --- From "Брезовска река" ---
geographbg:БрезовскаРека a geographbg:Река ;
    rdfs:label "Брезовска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Пловдив, Област Стара Загора
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "52.7"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Братан, Сърнена Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1043.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Попращенка"@bg, "Стара река (Брезовска)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "237.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:РозовецСело, geographbg:ЗелениковоСело, geographbg:БрезовоГрад, geographbg:ЧобаСело .

