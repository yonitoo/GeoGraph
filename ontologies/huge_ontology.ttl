    rdfs:label "Каракачански етнографски музей"@bg ;
    geographbg:находящСеВ geographbg:СярГрад ;
    geographbg:основанПрезГодина "1979"^^xsd:integer ;
    geographbg:имаОписание "Целта на музея е да покаже традиционния бит на каракачаните в Източна Македония. Преместен в нова сграда през 1997 г."@bg .

geographbg:СярГрад a geographbg:Град ;
    rdfs:label "Сяр"@bg ;
    geographbg:държава geographbg:Гърция .

geographbg:ИзточнаМакедонияРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Източна Македония"@bg .

geographbg:РотариКлубСолун a geographbg:Организация ;
    rdfs:label "Ротари клуб Солун"@bg ;
    geographbg:находящСеВ geographbg:СолунГрад .

# Triples from "Каракачански кон"
geographbg:КаракачанскиКонПорода a geographbg:ЖивотинскиВид ;
    rdfs:label "Каракачански кон (порода)"@bg ;
    geographbg:имаОписание "Сред най-примитивните породи български коне. Най-запазената порода от всички местни примитивни коне."@bg ;
    geographbg:находящСеВ geographbg:Родопи, geographbg:Рила, geographbg:Пирин, geographbg:СтараПланина .

# Triples from "Евреи в България"
geographbg:България geographbg:имаНаселение [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "1162"^^xsd:integer ;
    geographbg:имаМернаЕдиница geographbg:БройЖители ;
    rdfs:comment "Брой на самоопределилите се като евреи към 2011 г."@bg
] .

geographbg:ОрганизацияНаЕвреитеВБългарияШалом a geographbg:Организация ;
    rdfs:label "Организация на евреите в България „Шалом“"@bg ;
    geographbg:находящСеВ geographbg:София .

# Triples from "Наша глас"
geographbg:НашаГласВестник a owl:Thing ; # No specific class for Newspaper
    rdfs:label "Наша глас (вестник)"@bg ;
    geographbg:основанПрезГодина "1990"^^xsd:integer ;
    geographbg:свързанС geographbg:ТимишоараГрад ;
    geographbg:имаОписание "Вестник на българите в Банат, издаван в град Тимишоара от 1990 година."@bg .

geographbg:ТимишоараГрад a geographbg:Град ;
    rdfs:label "Тимишоара"@bg ;
    geographbg:държава geographbg:Румъния .

