# --- From "Джебелска река" ---
geographbg:ДжебелскаРека a geographbg:Река ;
    rdfs:label "Джебелска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластКърджали ;
    geographbg:притокНа geographbg:ВърбицаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "26.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "рид Жълти дял, Източни Родопи, близо до връх Алада"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1100.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "118.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ГърбищеСело, geographbg:МакСело, geographbg:ТютюнчеСело, geographbg:ДжебелГрад .

