# --- Бистрица (Дупнишка) ---
geographbg:РекаБистрицаДупнишка a geographbg:Река ;
    rdfs:label "Бистрица (Дупнишка)"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаДупница, geographbg:СеверозападнаРила ;
    geographbg:еПритокНа geographbg:РекаДжерман ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВПодножиетоНа geographbg:ВръхДамга ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "2595"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаДжерман ;
    geographbg:мястоНаВливане geographbg:ГрадДупница ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "500"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "133"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаМалаБистрица ;
    geographbg:протичаПрез geographbg:СелоБистрицаДупнишко, geographbg:ГрадДупница ;
    geographbg:използваСеЗа "електродобив (Каскада „Рила“)"@bg, "напояване"@bg .

geographbg:ВръхДамга a geographbg:ПланинскиВръх ; rdfs:label "Дамга (връх)"@bg ; geographbg:находящСеВ geographbg:СеверозападнаРила .
geographbg:РекаМалаБистрица a geographbg:Река ; rdfs:label "Мала Бистрица (река)"@bg .
geographbg:СелоБистрицаДупнишко a geographbg:Село ; rdfs:label "Бистрица (село, община Дупница)"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .
geographbg:ГрадДупница a geographbg:Град ; rdfs:label "Дупница (град)"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .
geographbg:СеверозападнаРила a geographbg:ЧастНаПланина ; rdfs:label "Северозападна Рила"@bg ; geographbg:еЧастОт geographbg:Рила .
geographbg:РекаДжерман a geographbg:Река ; rdfs:label "Джерман (река)"@bg .

# --- Бродска река ---
geographbg:РекаБродска a geographbg:Река ;
    rdfs:label "Бродска река"@bg ;
    geographbg:имаАлтернативноИме "Бродската ряка"@bg, "Буланъка"@bg, "Дурвица"@bg, "Кизил Чай"@bg, "Свети Йоан"@bg ;
    geographbg:находящСеВ "Сярско, Егейска Македония, Гърция"@bg, geographbg:ПланинаШарлия ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаШарлия ;
        rdfs:comment "югозападно под връх Буро"
    ] ;
    geographbg:вливаСеВ geographbg:РекаБелицаСярско ;
    geographbg:мястоНаВливане "източно от Бейлик махала"@bg ;
    geographbg:имаПриток geographbg:РекаЛясково, geographbg:РекаУглеш .

geographbg:ПланинаШарлия a geographbg:Планина ; rdfs:label "Шарлия (планина)"@bg .
geographbg:РекаЛясково a geographbg:Река ; rdfs:label "Лясково (река)"@bg .
geographbg:РекаУглеш a geographbg:Река ; rdfs:label "Углеш (река)"@bg .
geographbg:РекаБелицаСярско a geographbg:Река ; rdfs:label "Белица (Сярско)"@bg .

# --- Градешница (река) ---
geographbg:РекаГрадешницаСтрумешница a geographbg:Река ;
    rdfs:label "Градешница (приток на Струмешница)"@bg ;
    geographbg:имаАлтернативноИме "Билски дол"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаПетрич, geographbg:ПланинаОгражден ;
    geographbg:еПритокНа geographbg:РекаСтрумешница ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "13.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВПодножиетоНа geographbg:ВръхБилскаЧука ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1550"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрумешница ;
    geographbg:мястоНаВливане "югоизточно от село Струмешница"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "62"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "0.375"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:имаПриток geographbg:РекаБаскалска, geographbg:РекаДоленскаОгражден, geographbg:РекаЧуриловска .

geographbg:ВръхБилскаЧука a geographbg:ПланинскиВръх ; rdfs:label "Билска чука"@bg ; geographbg:находящСеВ geographbg:ПланинаОгражден .
geographbg:РекаБаскалска a geographbg:Река ; rdfs:label "Баскалска река"@bg .
geographbg:РекаДоленскаОгражден a geographbg:Река ; rdfs:label "Доленска река (Огражден)"@bg .
geographbg:РекаЧуриловска a geographbg:Река ; rdfs:label "Чуриловска река"@bg .
geographbg:ПланинаОгражден a geographbg:Планина ; rdfs:label "Огражден (планина)"@bg .

# --- Градински езера ---
geographbg:ЕзернаГрупаГрадинскиЕзера a geographbg:ЕзернаГрупа ;
    rdfs:label "Градински езера"@bg ;
    geographbg:находящСеВ "Калински дял, Северозападна Рила"@bg ;
    geographbg:имаОписание "Две групи езера, всяка с по три циркусни езера. Източната група е наричана Воденичарски езера (Горни Градински езера), а другата - Долни Градински езера."@bg ;
    geographbg:включва geographbg:ЕзернаГрупаВоденичарскиЕзера, geographbg:ЕзернаГрупаДолниГрадинскиЕзера .

geographbg:ЕзернаГрупаВоденичарскиЕзера a geographbg:ЕзернаГрупа ;
    rdfs:label "Воденичарски езера"@bg ;
    geographbg:имаАлтернативноИме "Горни Градински езера"@bg .
geographbg:ЕзернаГрупаДолниГрадинскиЕзера a geographbg:ЕзернаГрупа ;
    rdfs:label "Долни Градински езера"@bg .
geographbg:КалинскиДял a geographbg:ПланинскиДял ; rdfs:label "Калински дял"@bg ; geographbg:еЧастОт geographbg:СеверозападнаРила .

# --- Джубрена ---
geographbg:РекаДжубрена a geographbg:Река ;
    rdfs:label "Джубрена"@bg ;
    geographbg:находящСеВ geographbg:СофийскаОбласт, geographbg:ОбластКюстендил, geographbg:БелчинскаПланина, geographbg:ПланинаВерила, geographbg:ДупнишкаКотловина ;
    geographbg:еПритокНа geographbg:РекаДжерман ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:БелчинскаПланина ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1250"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ] ;
        rdfs:comment "1,6 км югозападно от село Клисура, община Самоков"
    ] ;
    geographbg:вливаСеВ geographbg:РекаДжерман ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "523"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "северната част на град Дупница"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "254"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаСапаревска, geographbg:РекаШарбан, geographbg:РекаСемчин, geographbg:РекаТополницаДжубрена ;
    geographbg:протичаПрез geographbg:СелоКрайници, geographbg:СелоЧервенБрег, geographbg:СелоЯхиново ;
    geographbg:използваСеЗа "напояване"@bg .

geographbg:БелчинскаПланина a geographbg:Планина ; rdfs:label "Белчинска планина"@bg ; geographbg:еЧастОт geographbg:СеверозападнаРила .
geographbg:ПланинаВерила a geographbg:Планина ; rdfs:label "Верила (планина)"@bg .
geographbg:ДупнишкаКотловина a geographbg:Котловина ; rdfs:label "Дупнишка котловина"@bg .
geographbg:РекаСапаревска a geographbg:Река ; rdfs:label "Сапаревска река"@bg .
geographbg:РекаШарбан a geographbg:Река ; rdfs:label "Шарбан (река)"@bg .
geographbg:РекаСемчин a geographbg:Река ; rdfs:label "Семчин (река)"@bg .
geographbg:СелоКрайници a geographbg:Село ; rdfs:label "Крайници"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .
geographbg:СелоЧервенБрег a geographbg:Село ; rdfs:label "Червен брег (село)"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .
geographbg:СелоЯхиново a geographbg:Село ; rdfs:label "Яхиново"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .

# --- Дяково (язовир) ---
geographbg:ЯзовирДяково a geographbg:Язовир ;
    rdfs:label "Дяково (язовир)"@bg ;
    geographbg:находящСеВ "землището на село Дяково, Дупнишко"@bg ;
    geographbg:еЗавършенПрез "1975"^^xsd:integer ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "35000000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "199"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:захранваСеОт geographbg:РекаОтовица, geographbg:РекаБистрицаДупнишка, geographbg:РекаДжерман, geographbg:РекаВалявицаДяково, geographbg:РекаФудиня, geographbg:РекаГорица ; # Чрез деривации
    geographbg:използваСеЗа "техническо водоснабдяване на ТЕЦ „Бобов дол“"@bg, "битово водоснабдяване"@bg .

