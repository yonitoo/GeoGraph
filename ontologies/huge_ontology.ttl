    rdfs:label "Пседерци"@bg ;
    geographbg:находящСеВ geographbg:КулскоОбласт ;
    geographbg:държава geographbg:България .

geographbg:КулскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Кулско"@bg .

geographbg:КарталБаирРидТърново a geographbg:Рид ;
    rdfs:label "Картал-баир (Търново)"@bg ;
    geographbg:близоДо geographbg:ВеликоТърновоГрад .

geographbg:ЖидовГробТърново a geographbg:Местност ;
