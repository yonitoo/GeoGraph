geographbg:общаДължина a owl:ObjectProperty ; rdfs:label "общаДължина"@bg ; rdfs:domain geographbg:Река, geographbg:Път ; rdfs:range geographbg:КоличественаСтойност . # Domain разширен
geographbg:площНаВодосборенБасейн a owl:ObjectProperty ; rdfs:label "площНаВодосборенБасейн"@bg ; rdfs:domain geographbg:Река ; rdfs:range geographbg:КоличественаСтойност .
