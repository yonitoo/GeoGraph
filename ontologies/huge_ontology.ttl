    geographbg:находящСеВ geographbg:ОбластХасково ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "38.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Сакар планина, кръстопът Голямата звезда"@bg ;
        geographbg:находящСеВ geographbg:СакарПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "612.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Буюклийска река"@bg, "Канаклийска река"@bg ;
    geographbg:площНаВодосборенБасейн [
