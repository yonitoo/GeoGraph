    geographbg:държава geographbg:СевернаМакедония ;
    geographbg:находящСеВ geographbg:БеласицаПланина ;
    geographbg:близоДо geographbg:БанскоСелоСтрумица ;
    geographbg:близоДо geographbg:ГабровоСелоСтрумица ;
    geographbg:имаИстория "Според преданията в местността е имало село Манастирово и манастир, посветен на Свети Илия. Изселването е свързано с различни предания."@bg .

geographbg:МандраджикСело geographbg:имаНаселение [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "414"^^xsd:integer ;
        geographbg:имаМернаЕдиница geographbg:БройЖители ;
        rdfs:comment "към 2001 г."@bg
    ] ;
    geographbg:имаАлтернативноИме "Мандраки"@el ;
    geographbg:имаИстория "Етнография (1873): 19 домакинства, 46 мюсюлмани. Кънчов (1900): 90 турци. 1928: 67 бежански семейства, 278 души."@bg .

geographbg:МемешлиСело geographbg:имаНаселение [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "16"^^xsd:integer ;
        geographbg:имаМернаЕдиница geographbg:БройЖители ;
