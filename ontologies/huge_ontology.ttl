    rdfs:label "Ямболско"@bg .

geographbg:ЖивОгънОбичай
    rdfs:label "Жив огън (обичай)"@bg ;
    geographbg:имаОписание "Български народен обичай за подновяване на огъня в домашните огнища или при епидемии. Огънят се запалва от триене на сухи (липови) дървета от млади мъже. Изпълнява се на Горещник, Еньовден или Еремия. При епидемии хората или животните прескачат огъня."@bg ;
    geographbg:свързанС geographbg:УргариСело .

geographbg:УргариСело a geographbg:Село ;
    rdfs:label "Ургари"@bg ;
    geographbg:находящСеВ geographbg:СтранджаЕтнографскаОбласт ;
    geographbg:държава geographbg:България .

geographbg:ЗаемниДни a geographbg:Период ;
    rdfs:label "Заемни дни"@bg ;
    geographbg:имаОписание "Първите три или последните три дни от месец март, свързани със студено, лошо време. Използват се за прогностични практики. В Пиринския край, Разложко, Кюстендилско, Родопите - първите три дни. В Драмско, Стружко, Пловдивско, Хасковско - последните три."@bg ;
    geographbg:свързанС geographbg:ПиринскиКрай ;
    geographbg:свързанС geographbg:РазложкоОбласт ;
    geographbg:свързанС geographbg:Кюстендилско ;
