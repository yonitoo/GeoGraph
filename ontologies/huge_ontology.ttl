    rdfs:label "Търновско"@bg .

geographbg:КопривщенскаНосия
    rdfs:label "Копривщенска носия"@bg ;
    geographbg:имаОписание "Традиционно облекло на жителите на град Копривщица. Облеклото е било съобразено със занятието, произхода, имота и обществената нагласа. Описани са мъжка чорбаджийска носия, носии на едри скотовъдци, курбетчии, домашари, обикновени хора и женска копривщенска носия (сукман, кенета, нагръдки, ръкавници, чопрази, салтамарка, чорапи, обувки, шамия). Споменават се и алафранга дрехи."@bg ;
    geographbg:свързанС geographbg:КопривщицаГрад .

geographbg:АлафрангаДрехиКопривщица
    rdfs:label "Алафранга дрехи (Копривщица)"@bg ;
    geographbg:свързанС geographbg:КопривщенскаНосия .

geographbg:КостурскиМузейНаНароднатаНосия a geographbg:Музей ;
    rdfs:label "Костурски музей на народната носия"@bg ;
    geographbg:находящСеВ geographbg:КостурГрад ;
    geographbg:находящСеВ geographbg:КъщаБратяЕмануилКостур ;
    geographbg:основанПрезГодина "1999"^^xsd:integer ;
    geographbg:стопанисваСеОт geographbg:ДружествоХармонияКостур ;
    geographbg:имаОписание "Целта на музея е да запознава с традиционното облекло в Костур и Костурско до XX век. На първия етаж са изложени женски носии от околните села, като Нестрам. На втория етаж са градските облекла и аксесоари."@bg .

geographbg:КостурГрад a geographbg:Град ;
    rdfs:label "Костур"@bg ;
    geographbg:държава geographbg:Гърция .

geographbg:КъщаБратяЕмануилКостур a geographbg:КултуренОбект ;
    rdfs:label "Родна къща на братята Емануил (Костур)"@bg ;
    geographbg:имаОписание "Родна къща на братята революционери Панайотис и Йоанис Емануил от XVIII век."@bg ;
    geographbg:находящСеВ geographbg:ДолцаМахалаКостур ;
    geographbg:близоДо geographbg:КостурскоЕзеро .

