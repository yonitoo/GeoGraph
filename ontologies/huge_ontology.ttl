    geographbg:близоДо geographbg:НосКарталбурун, geographbg:ДуранкулашкоЕзеро .

# --- Кранево ---
geographbg:СелоКранево a geographbg:Село ;
    rdfs:label "Кранево (село)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБалчик, geographbg:ОбластДобрич ;
    geographbg:имаАлтернативноИме "Екрене"@bg ;
    geographbg:дължинаПлажнаИвица [
