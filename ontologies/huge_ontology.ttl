geographbg:ГрадСандански a geographbg:Град ; rdfs:label "Сандански (град)"@bg ; geographbg:находящСеВ geographbg:ОбщинаСандански .

# --- Бистрица (Соволянска) ---
geographbg:РекаСоволянскаБистрица a geographbg:Река ;
    rdfs:label "Бистрица (Соволянска)"@bg ;
    geographbg:имаАлтернативноИме "Главня"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаКюстендил, geographbg:ОсоговскаПланина, geographbg:ПланинаЛисец, geographbg:ЧудинскаПланина, geographbg:КаменишкаКотловина, geographbg:КюстендилскаКотловина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "51"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ОсоговскаПланина ;
        rdfs:comment "1,2 km североизточно от връх Руен" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "2182"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "462"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "900 m югозападно от село Коняво"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "300"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаЧернаОсогово, geographbg:РекаЛева, geographbg:РекаКоприваСоволянска, geographbg:РекаЛесковска ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2.29"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при село Соволяно"
    ] ;
    geographbg:протичаПрез geographbg:СелоГърляно, geographbg:СелоРъсово, geographbg:СелоДолноСело, geographbg:СелоЦеровица, geographbg:СелоКършалево, geographbg:СелоМазарачево, geographbg:СелоСоволяно, geographbg:СелоСкриняно, geographbg:СелоНиколичевци, geographbg:СелоЯбълковоСоволянска ;
    geographbg:използваСеЗа "напояване"@bg, "ВЕЦ „Осогово“"@bg .

