    geographbg:притокНа geographbg:Арда ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "48.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "Переликско-Преспански дял, Западни Родопи, близо до с. Мугла"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1770.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "259.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СмолянГрад, geographbg:ВлаховоСело, geographbg:ЛъкаСелоСмолян, geographbg:ПодвисСелоСмолян, geographbg:РовинаСело, geographbg:ТърънСело, geographbg:РавнищаСело .

