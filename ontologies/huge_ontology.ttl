    ] .

# --- Градевска река ---
geographbg:РекаГрадевска
    geographbg:имаАлтернативноИме "Злата река"@bg, "Еловица"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаРазлог, geographbg:ОбщинаСимитли, geographbg:ЮгозападенДялРила, geographbg:СеверенПирин ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "31"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ЮгозападенДялРила ;
        rdfs:comment "300 m югозападно от връх Капатник" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "2054"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "286"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане geographbg:ГрадСимитли ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "253"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаОсеновска ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.91"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:протичаПрез geographbg:СелоГрадево, geographbg:ГрадСимитли .

geographbg:СелоГрадево a geographbg:Село ; rdfs:label "Градево"@bg ; geographbg:находящСеВ geographbg:ОбщинаСимитли .
