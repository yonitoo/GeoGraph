# --- From "Луда Яна" ---
geographbg:ЛудаЯнаРека a geographbg:Река ;
    rdfs:label "Луда Яна (река)"@bg ;
    geographbg:имаПриток geographbg:СтрелчанскаЛудаЯнаРека ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "74.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Бич, Същинска Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СъщинскаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1423.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Елишка река"@bg, "Панагюрска Луда Яна"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "685.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ПанагюрищеГрад, geographbg:ПопинциСело, geographbg:РосенСелоПазарджик, geographbg:ЧерногоровоСело, geographbg:КралиМаркоСело, geographbg:ПищиговоСело .

geographbg:БичВръх a geographbg:ПланинскиВръх ; rdfs:label "Бич (връх)"@bg .
geographbg:ПанагюрищеГрад a geographbg:Град ; rdfs:label "Панагюрище"@bg .
geographbg:РосенСелоПазарджик a geographbg:Село ; rdfs:label "Росен (Пазарджишко)"@bg .
geographbg:ЧерногоровоСело a geographbg:Село ; rdfs:label "Черногорово"@bg .
geographbg:КралиМаркоСело a geographbg:Село ; rdfs:label "Крали Марко (село)"@bg .
geographbg:ПищиговоСело a geographbg:Село ; rdfs:label "Пищигово"@bg .
geographbg:СинитовоСело a geographbg:Село ; rdfs:label "Синитово"@bg .
geographbg:Марица geographbg:имаПриток geographbg:ЛудаЯнаРека .
# Притоци: ... (много)

# --- From "Мартинка (река)" ---
geographbg:МартинкаРека a geographbg:Река ;
    rdfs:label "Мартинка (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Стара Загора, Област Хасково
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "55.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Чирпански възвишения, близо до с. Винарово"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "403.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Винаровска река"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "395.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ВинаровоСело, geographbg:МалкоТръновоСело, geographbg:ДимитриевоСело, geographbg:СамуиловоСелоСтараЗагора, geographbg:БялИзворСелоОпан, geographbg:СтранскоСело, geographbg:РадиевоСело, geographbg:ГолямоАсеновоСело, geographbg:БродСело, geographbg:ЗлатополеСело .

geographbg:ЧирпанскиВъзвишения a geographbg:Хълм ; rdfs:label "Чирпански възвишения"@bg . # Or Рид
geographbg:ВинаровоСело a geographbg:Село ; rdfs:label "Винарово (Чирпанско)"@bg .
geographbg:МалкоТръновоСело a geographbg:Село ; rdfs:label "Малко Тръново"@bg .
geographbg:ДимитриевоСело a geographbg:Село ; rdfs:label "Димитриево"@bg .
geographbg:СамуиловоСелоСтараЗагора a geographbg:Село ; rdfs:label "Самуилово (Старозагорско)"@bg .
geographbg:БялИзворСелоОпан a geographbg:Село ; rdfs:label "Бял извор (Опанско)"@bg .
geographbg:СтранскоСело a geographbg:Село ; rdfs:label "Странско"@bg .
geographbg:РадиевоСело a geographbg:Село ; rdfs:label "Радиево"@bg .
geographbg:ГолямоАсеновоСело a geographbg:Село ; rdfs:label "Голямо Асеново"@bg .
geographbg:БродСело a geographbg:Село ; rdfs:label "Брод (село)"@bg .
geographbg:Марица geographbg:имаПриток geographbg:МартинкаРека .
# Притоци: Ездачевска река, Айдъндере, Козаревска река, Синурдере

# --- From "Меричлерска река" ---
geographbg:МеричлерскаРека a geographbg:Река ;
    rdfs:label "Меричлерска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Стара Загора, Област Хасково
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "37.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Извор ; rdfs:label "извор Кюнта, близо до с. Свобода"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "199.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "117.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ГитаСело, geographbg:МеричлериГрад, geographbg:ДимитровградГрад .

geographbg:СвободаСелоЧирпан a geographbg:Село ; rdfs:label "Свобода (Чирпанско)"@bg .
geographbg:ГитаСело a geographbg:Село ; rdfs:label "Гита"@bg .
geographbg:МеричлериГрад a geographbg:Град ; rdfs:label "Меричлери"@bg .
geographbg:ДимитровградГрад a geographbg:Град ; rdfs:label "Димитровград"@bg .
geographbg:Марица geographbg:имаПриток geographbg:МеричлерскаРека .
# Притоци: Селско дере, Памуклудере, Зайлиндере

# --- From "Мечка (река)" ---
geographbg:МечкаРека a geographbg:Река ;
    rdfs:label "Мечка (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Пловдив
    geographbg:имаПриток geographbg:ЧинардереРека ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "43.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Самантепе, Преспански дял, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "954.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Банска река (Мечка)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "278.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ПоройнаСело, geographbg:ПървомайГрад .

geographbg:СамантепеВръх a geographbg:ПланинскиВръх ; rdfs:label "Самантепе"@bg .
geographbg:ПреспанскиДял a geographbg:Планина ; rdfs:label "Преспански дял"@bg ; geographbg:находящСеВ geographbg:ЗападниРодопи .
geographbg:ПървомайГрад a geographbg:Град ; rdfs:label "Първомай"@bg .
geographbg:Марица geographbg:имаПриток geographbg:МечкаРека .
