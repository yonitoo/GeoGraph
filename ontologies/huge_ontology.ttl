# --- From "Очушница" ---
geographbg:ОчушницаРека a geographbg:Река ;
    rdfs:label "Очушница"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:СофийскаОбласт ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "26.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Калето, Септемврийски рид, Ихтиманска Средна гора"@bg ;
        geographbg:находящСеВ geographbg:ИхтиманскаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1185.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Черна река (Очушница)"@bg ;
    geographbg:преминаваПрез geographbg:ПчелинСело, geographbg:КостенецГрад .

geographbg:КалетоВръхИхтиманска a geographbg:ПланинскиВръх ; rdfs:label "Калето (връх, Ихтиманска Средна гора)"@bg .
geographbg:СептемврийскиРид a geographbg:Рид ; rdfs:label "Септемврийски рид"@bg ; geographbg:находящСеВ geographbg:ИхтиманскаСреднаГора .
geographbg:ПчелинСело a geographbg:Село ; rdfs:label "Пчелин (Софийска област)"@bg .
geographbg:КостенецГрад a geographbg:Град ; rdfs:label "Костенец (град)"@bg .
geographbg:Марица geographbg:имаПриток geographbg:ОчушницаРека .
