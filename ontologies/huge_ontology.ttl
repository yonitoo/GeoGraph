# --- From "Харманлийска река" ---
geographbg:ХарманлийскаРека a geographbg:Река ;
    rdfs:label "Харманлийска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Кърджали, Област Хасково
    geographbg:притокНа geographbg:Марица ;
    geographbg:имаПриток geographbg:ХасковскаРека, geographbg:УзунджовскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "90.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ; # "над 90 km"
    geographbg:извираОт [ a geographbg:Извор ; rdfs:label "извор чешма Величка, близо до курорт Паничково, Източни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ;
        # н.в. 755m (от схемата)
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "956.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:НочевоСело, geographbg:ТракиецСело, geographbg:КонушСелоХасково, geographbg:ВойводовоСелоХасково, geographbg:МалевоСелоХасково, geographbg:ДиневоСело, geographbg:БряговоСелоХасково, geographbg:ХарманлиГрад .

geographbg:ПаничковоКурорт a geographbg:Местност ; rdfs:label "Паничково (курорт)"@bg . # Курорт
geographbg:НочевоСело a geographbg:Село ; rdfs:label "Ночево"@bg .
geographbg:ТракиецСело a geographbg:Село ; rdfs:label "Тракиец (село)"@bg .
geographbg:КонушСелоХасково a geographbg:Село ; rdfs:label "Конуш (Хасковско)"@bg .
geographbg:ВойводовоСелоХасково a geographbg:Село ; rdfs:label "Войводово (Хасковско)"@bg .
geographbg:ДиневоСело a geographbg:Село ; rdfs:label "Динево"@bg .
geographbg:ХарманлиГрад a geographbg:Град ; rdfs:label "Харманли"@bg .
geographbg:ЯзовирТракиец a geographbg:Язовир ; rdfs:label "Тракиец (язовир)"@bg ; geographbg:намираСеНаРека geographbg:ХарманлийскаРека .
geographbg:Марица geographbg:имаПриток geographbg:ХарманлийскаРека .
# Притоци от схемата: Дюдюклюдере, Лява река, Асардере, Кюпрюдере, Сичерско дере, Дерменджидере, Къзъклийско дере, Пчеларовска река, Батакдере, Саламдере, Кюлюдере, Бързей, Сазлия, Хасковска река, Юнгюрмездере, Узунджовска река, Курудере, Кюмюрлукдере

# --- From "Ченгенедере" ---
geographbg:ЧенгенедереРека a geographbg:Река ;
    rdfs:label "Ченгенедере (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластХасково ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "20.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Сакар планина, близо до с. Мустрак"@bg ;
        geographbg:находящСеВ geographbg:СакарПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "354.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Бахчадере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "38.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
    # Влива се в напоителен канал близо до Капитан Андреево
geographbg:МустракСело a geographbg:Село ; rdfs:label "Мустрак"@bg .
geographbg:ДжидереПритокЧенгенедере a geographbg:Река ; rdfs:label "Джидере (приток на Ченгенедере)"@bg .
geographbg:ЧенгенедереРека geographbg:имаПриток geographbg:ДжидереПритокЧенгенедере .
geographbg:Марица geographbg:имаПриток geographbg:ЧенгенедереРека . # Indirectly now

# --- From "Чепинска река" ---
geographbg:ЧепинскаРека a geographbg:Река ;
    rdfs:label "Чепинска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "81.7"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Малка Сюткя, Баташка планина, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1990.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Рибна река"@bg, "Бистрица (Чепинска)"@bg, "Банска Бистрица"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "900.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ВелинградГрад, geographbg:ДрагиновоСело, geographbg:ВетренДолСело, geographbg:ВарвараСелоПазарджик .

geographbg:МалкаСюткяВръх a geographbg:ПланинскиВръх ; rdfs:label "Малка Сюткя"@bg .
geographbg:ВелинградГрад a geographbg:Град ; rdfs:label "Велинград"@bg .
geographbg:ДрагиновоСело a geographbg:Село ; rdfs:label "Драгиново"@bg .
geographbg:ВетренДолСело a geographbg:Село ; rdfs:label "Ветрен дол"@bg .
geographbg:ВарвараСелоПазарджик a geographbg:Село ; rdfs:label "Варвара (Пазарджишко)"@bg .
geographbg:КовачевоСелоСептември a geographbg:Село ; rdfs:label "Ковачево (Септемврийско)"@bg .
geographbg:КлептузаИзвор a geographbg:Извор ; rdfs:label "Клептуза"@bg ; geographbg:находящСеВ geographbg:ВелинградГрад .
geographbg:Марица geographbg:имаПриток geographbg:ЧепинскаРека .
