geographbg:СелоПолена a geographbg:Село ; rdfs:label "Полена"@bg ; geographbg:находящСеВ geographbg:ОбщинаСимитли .
geographbg:СелоКрупник a geographbg:Село ; rdfs:label "Крупник"@bg ; geographbg:находящСеВ geographbg:ОбщинаСимитли .
geographbg:СелоЧерниче a geographbg:Село ; rdfs:label "Черниче"@bg ; geographbg:находящСеВ geographbg:ОбщинаСимитли .

# --- Треклянска река ---
geographbg:ТреклянскаРека a geographbg:Река ;
    rdfs:label "Треклянска река"@bg ;
    geographbg:имаАлтернативноИме "Меланщица"@bg, "Раянска река"@bg ;
    geographbg:находящСеВ geographbg:ОбластПерник, geographbg:ОбластКюстендил, geographbg:БоховскаПланина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "50"^^xsd:decimal ; # Над 50 km
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:БоховскаПланина ;
        rdfs:comment "300 m югозападно от граничния със Сърбия връх Огорелица" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1286"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "595"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "северната част на град Земен"@bg ;
    geographbg:имаПриток geographbg:РекаЯвор ;
    geographbg:протичаПрез geographbg:СелоГорнаМелна, geographbg:СелоДолнаМелна, geographbg:СелоДългаЛука, geographbg:СелоКосовоТрекляно, geographbg:СелоТрекляно, geographbg:СелоГабрешевци, geographbg:СелоРаянци, geographbg:СелоКалотинци, geographbg:СелоВраняСтена, geographbg:СелоПещераЗемен .

geographbg:БоховскаПланина a geographbg:Планина ; rdfs:label "Боховска планина"@bg .
geographbg:СелоГорнаМелна a geographbg:Село ; rdfs:label "Горна Мелна"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрън .
geographbg:СелоДолнаМелна a geographbg:Село ; rdfs:label "Долна Мелна"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрън .
geographbg:СелоДългаЛука a geographbg:Село ; rdfs:label "Дълга лука"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрън .
geographbg:СелоКосовоТрекляно a geographbg:Село ; rdfs:label "Косово (област Кюстендил)"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрекляно .
geographbg:СелоТрекляно a geographbg:Село ; rdfs:label "Трекляно"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрекляно .
geographbg:СелоГабрешевци a geographbg:Село ; rdfs:label "Габрешевци"@bg ; geographbg:находящСеВ geographbg:ОбщинаТрекляно .
geographbg:СелоРаянци a geographbg:Село ; rdfs:label "Раянци"@bg ; geographbg:находящСеВ geographbg:ОбщинаЗемен .
geographbg:СелоВраняСтена a geographbg:Село ; rdfs:label "Враня стена"@bg ; geographbg:находящСеВ geographbg:ОбщинаЗемен .
geographbg:СелоПещераЗемен a geographbg:Село ; rdfs:label "Пещера (област Перник)"@bg ; geographbg:находящСеВ geographbg:ОбщинаЗемен .
geographbg:ОбщинаТрекляно a geographbg:Община ; rdfs:label "Община Трекляно"@bg ; geographbg:находящСеВ geographbg:ОбластКюстендил .

# --- Цапаревска река ---
geographbg:РекаЦапаревска a geographbg:Река ;
    rdfs:label "Цапаревска река"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаСтрумяни, geographbg:МалешевскаПланина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "24"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:МалешевскаПланина ;
        rdfs:comment "около 300 m западно от връх Голак" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1372"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "125"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане geographbg:СелоМикрево ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "78"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаПравеца, geographbg:РекаРибнишка, geographbg:РекаЛиповска, geographbg:РекаГоремска ;
    geographbg:протичаПрез geographbg:СелоМикрево ; # Само в устието
    geographbg:използваСеЗа "напояване"@bg .

geographbg:РекаПравеца a geographbg:Река ; rdfs:label "Правеца (река)"@bg .
geographbg:РекаРибнишка a geographbg:Река ; rdfs:label "Рибнишка река"@bg .
geographbg:РекаЛиповска a geographbg:Река ; rdfs:label "Липовска река"@bg .
geographbg:РекаГоремска a geographbg:Река ; rdfs:label "Горемска река"@bg .
geographbg:СелоМикрево a geographbg:Село ; rdfs:label "Микрево"@bg ; geographbg:находящСеВ geographbg:ОбщинаСтрумяни .

# --- Шегава ---
geographbg:РекаШегава a geographbg:Река ;
    rdfs:label "Шегава"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаКюстендил, geographbg:КонявскаПланина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "10"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:КонявскаПланина ;
        rdfs:comment "северозападно от седловината Стражата" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1014"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "505"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "около 400 м североизточно от село Раждавица"@bg ;
    geographbg:имаОписание "Красива каньоновидна долина с пещери и скални образувания."@bg ;
    geographbg:протичаПрез "махали на село Буново"@bg ;
    geographbg:използваСеЗа "водоснабдяване"@bg, "напояване"@bg .

geographbg:ОбщинаСапареваБаня a geographbg:Община ; rdfs:label "Община Сапарева баня"@bg ; geographbg:находящСеВ geographbg:ОбластКюстендил .
