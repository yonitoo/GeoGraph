geographbg:ХижаАлеко a geographbg:Хижа ;
    rdfs:label "Алеко (хижа)"@bg ;
    geographbg:находящСеВ [ a geographbg:Местност ; rdfs:label "Масловица"@bg ; geographbg:находящСеВ geographbg:Витоша ] ;
    geographbg:близоДо geographbg:МалъкРезенВръх ;
    geographbg:основанПрезГодина "1932"^^xsd:integer ; # Завършена
    geographbg:имаИстория "Първата хижа на Витоша, строена 1924-1932 г. от туристи и скиори, последователи на Алеко Константинов."@bg ;
    geographbg:имаКапацитет [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "88"^^xsd:integer ;
        geographbg:имаМернаЕдиница geographbg:БройЖители # Using БройЖители as a proxy for beds
    ] ;
    geographbg:имаОписание "Масивна триетажна сграда. Електрифицирана, водоснабдена, централно отопление. Ресторант, кафене, магазин, ски-гардероб. Районът е ски-център с 4 ски-влека, 2 седалкови лифта и писти."@bg ;
    geographbg:стопанисваСеОт [ a geographbg:Организация ; rdfs:label "Туристическо дружество „Алеко Константинов“"@bg ], [ a geographbg:Организация ; rdfs:label "Спортно-туристическо дружество „Мотен“"@bg ] ;
    geographbg:държава geographbg:България .

