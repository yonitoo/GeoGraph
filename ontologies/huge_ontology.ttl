# --- From "Овчарица (язовир)" ---
geographbg:ОвчарицаЯзовир a geographbg:Язовир ;
    rdfs:label "Овчарица (язовир)"@bg ;
    geographbg:основанПрезГодина "1967"^^xsd:integer ;
    geographbg:намираСеНаРека geographbg:ОвчарицаРекаОвчарица ;
    geographbg:свързанС geographbg:ТЕЦМарицаИзток2 ;
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "62400000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] ;
    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "6.99"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] ; # 699 ha
    # Main dam "Овчарица": height 22m, length 1480m
    # Dam "Бял кладенец": height 15m, length 475m
    # Dam "Скендер дере": height 7m, length 182m
    # Counter-dam "Овчи кладенец": height 7m, length 725m
    geographbg:намираСеВЗемлищетоНа geographbg:КовачевоСелоРаднево, geographbg:ОвчиКладенецСело, geographbg:РадецкиСело, geographbg:БялКладенецСело, geographbg:СкалицаСело .
geographbg:ТЕЦМарицаИзток2 a geographbg:ИнфраструктуренОбект ; rdfs:label "ТЕЦ Марица Изток 2"@bg .
