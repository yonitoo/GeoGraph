geographbg:ИзпълнителнаАгенцияПоГорите geographbg:свързанС geographbg:МинистерствоНаЗемеделиетоИХраните .

geographbg:ПрироденПаркВитоша geographbg:свързанС geographbg:БистришкоБранище .
geographbg:ПрироденПаркВитоша geographbg:свързанС geographbg:ТорфеноБранище .

geographbg:ДетскиЕкостационарБелитеБрези a geographbg:ИнфраструктуренОбект ;
    rdfs:label "Детски екостационар „Белите брези“"@bg ;
    geographbg:находящСеВ geographbg:ПрироденПаркВитоша ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Дендрариума (Витоша)"@bg ] ;
    geographbg:имаОписание "Комплексен, детски, информационен, образователен и изложбен център. Провеждат се учебни беседи. Сградата демонстрира екологични строителни технологии. Построен 2011-2012 г."@bg .
geographbg:МузейНаМечката a geographbg:Музей ;
    rdfs:label "Музей на мечката"@bg ;
    geographbg:находящСеВ geographbg:ДетскиЕкостационарБелитеБрези .
geographbg:МузейНаВоднотоКонче a geographbg:Музей ;
    rdfs:label "Музей на водното конче"@bg ;
    geographbg:находящСеВ geographbg:ДетскиЕкостационарБелитеБрези .
geographbg:МузейНаСовите a geographbg:Музей ;
    rdfs:label "Музей на совите"@bg ;
    geographbg:находящСеВ geographbg:ДетскиЕкостационарБелитеБрези .
geographbg:ИнформационнаАлеяИгликинаПоляна a geographbg:Пътека ;
    rdfs:label "Информационна алея (Игликина поляна)"@bg ;
    geographbg:близоДо geographbg:ДетскиЕкостационарБелитеБрези ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Игликина поляна"@bg ] .

geographbg:АлековиВодопади a geographbg:Водопад, geographbg:ПрироднаЗабележителностСтатут ;
    rdfs:label "Алекови водопади"@bg ;
    geographbg:имаАлтернативноИме "Драгалевски водопади"@bg, "Скакавишки водопади"@bg, "Скоковете"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:намираСеНаРека geographbg:СкакавицаРекаВитоша ;
    geographbg:близоДо geographbg:КварталДрагалевци ;
    geographbg:близоДо geographbg:КварталСимеоново ;
    geographbg:имаОписание "Водна каскада. Наименувани през 1910 г. на Алеко Константинов. Обща височина 15-20 метра. Състоят се от горен и долен водопад. Най-пълноводни през пролетта."@bg ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркВитоша ;
    geographbg:имаВисочинаНаПада [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "17.5"^^xsd:decimal ; # Average of 15-20
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:държава geographbg:България .

