# Притоци на Сушица: Чолакдере, Луда яна (приток на Сушица), Манастирско дере

# --- From "Яденица" ---
geographbg:ЯденицаРека a geographbg:Река ;
    rdfs:label "Яденица (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "26.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "местност Чакърица, Източна Рила, близо до бивша хижа Христо Смирненски"@bg ;
        geographbg:находящСеВ geographbg:Рила ; # Източна Рила
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1992.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Куртовско дере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "138.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ГолямоБеловоСело, geographbg:БеловоГрад .

geographbg:ГолямоБеловоСело a geographbg:Село ; rdfs:label "Голямо Белово"@bg .
geographbg:Марица geographbg:имаПриток geographbg:ЯденицаРека .
