# --- From "Каскада „Арда“" ---
geographbg:КаскадаАрда a geographbg:Каскада ; rdfs:label "Каскада Арда"@bg .
geographbg:ВЕЦКърджали a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Кърджали"@bg ; geographbg:частОтКаскада geographbg:КаскадаАрда ;
    geographbg:основанПрезГодина "1970"^^xsd:integer ; # In operation
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "110.4"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] .
geographbg:ВЕЦСтуденКладенец a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Студен кладенец"@bg ; geographbg:частОтКаскада geographbg:КаскадаАрда ;
    geographbg:основанПрезГодина "1958"^^xsd:integer ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "85.5"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] . # After 2009 (67.2 + 17 + 1.3)
