# --- From "Стара река (среден приток на Марица)" ---
geographbg:СтараРекаСреденПритокМарица a geographbg:Река ;
    rdfs:label "Стара река (среден приток на Марица)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Пазарджик, Област Пловдив
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "61.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    # Образува се от Черна и Бяла река
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "350.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:БатакГрад, geographbg:ПещераГрад, geographbg:БягаСело, geographbg:ИспериховоСело, geographbg:КуртовоКонареСело, geographbg:НовоСелоСтамболийски .

geographbg:ЧернаРекаСъставящаСтараРека a geographbg:Река ; rdfs:label "Черна река (съставяща Стара река, среден приток на Марица)"@bg ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Баташка планина, местност Картела"@bg ;
        geographbg:находящСеВ geographbg:БаташкаПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1743.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] .
geographbg:БялаРекаСъставящаСтараРека a geographbg:Река ; rdfs:label "Бяла река (съставяща Стара река, среден приток на Марица)"@bg .
geographbg:СтараРекаСреденПритокМарица geographbg:еСъставящаЧастНа geographbg:ЧернаРекаСъставящаСтараРека, geographbg:БялаРекаСъставящаСтараРека .
geographbg:ПещераГрад a geographbg:Град ; rdfs:label "Пещера (град)"@bg .
geographbg:БягаСело a geographbg:Село ; rdfs:label "Бяга"@bg .
geographbg:ИспериховоСело a geographbg:Село ; rdfs:label "Исперихово"@bg .
