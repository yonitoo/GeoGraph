geographbg:ЕленЛопатар a geographbg:ЖивотинскиВид ; rdfs:label "Елен лопатар"@bg .
geographbg:Белка a geographbg:ЖивотинскиВид ; rdfs:label "Белка"@bg .
geographbg:ДиваКоза a geographbg:ЖивотинскиВид ; rdfs:label "Дива коза"@bg .
geographbg:Сокерица a geographbg:ЖивотинскиВид ; rdfs:label "Сокерица"@bg .
geographbg:Кръсточовка a geographbg:ЖивотинскиВид ; rdfs:label "Кръсточовка"@bg .
