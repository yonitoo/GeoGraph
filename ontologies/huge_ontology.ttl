        geographbg:имаСтойност "21.4"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:захранваСеОт geographbg:ВЕЦБатак, geographbg:ДеривацияНоваМахала, geographbg:ДеривацияБистрицаБП, geographbg:ДеривацияРавногор ;
    geographbg:оттичаСеВ geographbg:ВЕЦПещера .

geographbg:ЯзовирБеглика a geographbg:Язовир ;
    rdfs:label "Беглика (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът, geographbg:ХидровъзелГолямБеглик ;
    geographbg:еПостроенПрез "1954-1956" ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1600000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:захранваСеОт geographbg:РекаБеглишка ;
    geographbg:оттичаСеВ geographbg:ГлавнаНапорнаДеривацияВЕЦБатак . # Чрез помпена станция

geographbg:ЯзовирТошковЧарк a geographbg:Язовир ;
    rdfs:label "Тошков чарк (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът, geographbg:ХидровъзелГолямБеглик ;
    geographbg:еПостроенПрез "1954-1956" ;
    geographbg:имаОбем [
