geographbg:ПрироденПаркВитоша a geographbg:ПрироденПарк ;
    rdfs:label "Природен парк „Витоша“"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27079"^^xsd:decimal ; # или 270 кв. км.
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:основанПрезГодина "1934"^^xsd:integer ;
    geographbg:обявенаСъсЗаповед "Постановление № ІІІа 15422 от 27.10.1934 г."@bg ;
    geographbg:имаИстория "Първият парк на Балканския полуостров. Границите и площта са променяни многократно."@bg ;
    geographbg:имаФлора "500 вида сладководни водорасли; 805 вида гъби; 360 вида лишеи; 326 вида мъхове; 1489 вида висши растения."@bg ;
    geographbg:имаФауна "Безгръбначни – 540 вида; Насекоми – голям дъбов сечко, буков сечко, червена горска мравка; Риби – балканска пъстърва; Птици – 236 вида (120 гнездящи, 53 прелетни); Бозайници – благороден елен, сърна, мечка, вълк, заек, лисица, видра, дива котка; 13 вида прилепи."@bg ;
    geographbg:държава geographbg:България .

