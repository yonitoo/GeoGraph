    geographbg:съседенНос geographbg:НосУрсусбурун, geographbg:НосСиврибурун, geographbg:НосКрапец .

geographbg:НосУрсусбурун a geographbg:Нос ;
    rdfs:label "Урсусбурун (нос)"@bg .

geographbg:НосСиврибурун a geographbg:Нос ;
    rdfs:label "Сиврибурун (нос)"@bg .

geographbg:НосКрапец a geographbg:Нос ;
    rdfs:label "Крапец (нос)"@bg .

# --- Космос (къмпинг) ---
