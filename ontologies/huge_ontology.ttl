# --- From "Давидковска река" ---
geographbg:ДавидковскаРека a geographbg:Река ;
    rdfs:label "Давидковска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Смолян, Област Кърджали
    geographbg:притокНа geographbg:Арда ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "36.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "близо до връх Преспа, Переликско-Преспански дял, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1578.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Иноголу дере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "232.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СтърницаСело, geographbg:ДавидковоСело, geographbg:ДебеляновоСело .

