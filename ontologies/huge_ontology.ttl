        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "6"^^xsd:decimal ; # Average of 3-9 l/s
        geographbg:имаМернаЕдиница geographbg:ЛитърВСекунда
    ] ;
    geographbg:имаТемпература [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27.75"^^xsd:decimal ; # Average of 23-32.5 C
        geographbg:имаМернаЕдиница geographbg:ГрадусЦелзий
    ] .
geographbg:ЖелезнишкаРека geographbg:захранваСеОт geographbg:ЖелезнишкиМинералниИзвори . # Or имаПриток if it's a distinct stream
geographbg:РекаЕгуля a geographbg:Река ;
    rdfs:label "Егуля (река)"@bg ;
    geographbg:извираОт geographbg:Плана .
geographbg:ЖелезнишкаРека geographbg:имаПриток geographbg:РекаЕгуля .
geographbg:РекаЕгуля geographbg:притокНа geographbg:ЖелезнишкаРека .
geographbg:ГрчкиДолПоток a geographbg:Поток ;
    rdfs:label "Грчки дол (поток)"@bg .
geographbg:ЖелезнишкаРека geographbg:имаПриток geographbg:ГрчкиДолПоток .
geographbg:ГрчкиДолПоток geographbg:притокНа geographbg:ЖелезнишкаРека .
geographbg:ЗлиоДолПоток a geographbg:Поток ;
    rdfs:label "Злио дол (поток)"@bg .
geographbg:ЖелезнишкаРека geographbg:имаПриток geographbg:ЗлиоДолПоток .
geographbg:ЗлиоДолПоток geographbg:притокНа geographbg:ЖелезнишкаРека .
geographbg:ДяволскиМостЖелезница a geographbg:Мост ;
    rdfs:label "Дяволски мост (Железница)"@bg ;
    geographbg:близоДо geographbg:ЖелезнишкаРека . # At its mouth
geographbg:МестностУрвич a geographbg:Местност ;
    rdfs:label "Урвич (местност)"@bg .
geographbg:СтърничковКамък a geographbg:СкалноОбразувание, geographbg:ПрироднаЗабележителностСтатут ;
    rdfs:label "Стърничков камък"@bg ;
    geographbg:близоДо geographbg:ЖелезнишкаРека .

geographbg:КилиитеКварталСофия a geographbg:Квартал ;
    rdfs:label "Килиите (квартал, София)"@bg ;
    geographbg:находящСеВ [ a geographbg:АдминистративнаЕдиница ; rdfs:label "Район „Витоша“ (София)"@bg ; geographbg:находящСеВ geographbg:София ] ;
    geographbg:имаОписание "Разположен на 9,3 километра югозападно от центъра на София. Граничи с квартал „Княжево“ на север и изток."@bg ;
    geographbg:граничиС geographbg:КварталКняжево ;
    geographbg:граничиС geographbg:Витоша .

geographbg:КладнишкаКрепост a geographbg:Крепост ;
    rdfs:label "Кладнишка крепост"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:Кладница ;
    geographbg:основанПрезГодина "0450"^^xsd:integer ; # 5-6 век, taking mid-point
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1"^^xsd:decimal ; # 10 декара
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Средновековна българска крепост. Стратегическо място. Част от система крепости, защитавали Сердика. Двойни зидове от ломен камък и хоросан. Вход от ЮИ."@bg ;
    geographbg:имаИстория "Построена в периода 5 – 6 век. Вероятно разрушена при превземането на Сердика от хан Крум."@bg ;
    geographbg:държава geographbg:България .
geographbg:КладнишкиМанастир a geographbg:Манастир ;
    rdfs:label "Кладнишки манастир"@bg ;
    geographbg:близоДо geographbg:КладнишкаКрепост ;
    geographbg:имаИстория "Възстановен през 1848 г."@bg .
geographbg:ПараклисСветаПеткаКладнишкаКрепост a geographbg:КултуренОбект ; # Assuming параклис is a КултуренОбект
    rdfs:label "Параклис „Св. Петка“ (Кладнишка крепост)"@bg ;
    geographbg:находящСеВ geographbg:КладнишкаКрепост .

geographbg:ТелевизионнаКулаКопитото a geographbg:ТелевизионнаКула ;
    rdfs:label "Телевизионна кула „Копитото“"@bg ;
    geographbg:находящСеВ geographbg:Копитото ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1345"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаВисочинаНаСтена [ # Height of the tower itself
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "186"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:основанПрезГодина "1986"^^xsd:integer ;
    geographbg:имаОписание "Проектирана от архитектите Любен Попдонев и Стефан Тилев. Замества старата телевизионна кула в София и обслужва столицата и Софийско поле."@bg ;
    geographbg:държава geographbg:България .

geographbg:МогилатаВилнаЗонаСофия a geographbg:ВилнаЗона ;
    rdfs:label "Могилата (вилна зона, София)"@bg ;
    geographbg:находящСеВ [ a geographbg:АдминистративнаЕдиница ; rdfs:label "Район „Витоша“ (София)"@bg ; geographbg:находящСеВ geographbg:София ] ;
    geographbg:имаОписание "Разположена на 9,3 километра южно от центъра на София. Намира се на горното течение на Сухата река."@bg ;
    geographbg:граничиС geographbg:КварталДрагалевци ;
    geographbg:граничиС geographbg:КварталСимеоново ;
    geographbg:граничиС geographbg:Витоша .
geographbg:СухатаРекаСофия a geographbg:Река ;
    rdfs:label "Сухата река (София)"@bg .
geographbg:МогилатаВилнаЗонаСофия geographbg:намираСеНаРека geographbg:СухатаРекаСофия .

geographbg:НационаленКиноцентърКварталСофия a geographbg:Квартал, geographbg:Местност ;
    rdfs:label "Национален киноцентър (квартал, София)"@bg ;
    geographbg:находящСеВ [ a geographbg:АдминистративнаЕдиница ; rdfs:label "Район „Витоша“ (София)"@bg ; geographbg:находящСеВ geographbg:София ] ;
    geographbg:имаОписание "Разположен на 6,9 километра южно от центъра на града."@bg ;
    geographbg:граничиС geographbg:КварталБояна ;
    geographbg:граничиС [ a geographbg:Квартал ; rdfs:label "Киноцентъра III (квартал, София)"@bg ] ;
    geographbg:граничиС [ a geographbg:Парк, geographbg:Градина ; rdfs:label "Парк „Ботаническа градина“ (София)"@bg ] ;
    geographbg:граничиС geographbg:КварталДрагалевци ;
    geographbg:граничиС geographbg:Витоша .

geographbg:ЯнчовскаРека
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "Североизточни склонове на Витоша, северно от хижа Алеко"@bg ;
        geographbg:находящСеВ geographbg:Витоша
    ] ;
    geographbg:вливаСеВ geographbg:БистрицаВитошка . # Specifically, Старата река part of Бистрица
geographbg:РекаСтанциите a geographbg:Река ;
    rdfs:label "Река Станциите"@bg .
geographbg:ЯнчовскаРека geographbg:имаПриток geographbg:РекаСтанциите .
geographbg:РекаСтанциите geographbg:притокНа geographbg:ЯнчовскаРека .
geographbg:МестностСтамболовото a geographbg:Местност ;
    rdfs:label "Стамболовото (местност)"@bg ;
    geographbg:близоДо geographbg:ЯнчовскаРека .
geographbg:ИзкуственоЕзероБистрица a geographbg:Езеро ;
    rdfs:label "Изкуствено езеро (Бистрица, Янчовска река)"@bg ;
    geographbg:намираСеНаРека geographbg:ЯнчовскаРека ;
    geographbg:близоДо geographbg:СелоБистрицаСофия .

geographbg:ГолямРезенВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Голям Резен"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2277"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ЧерниВръх ;
    geographbg:близоДо geographbg:СкопарникВръх ;
    geographbg:свързанС geographbg:МалъкРезенВръх ;
    geographbg:имаОписание "Част от вододела между Черно море и Средиземно море. Северните и източните склонове се отводняват в река Искър, югозападните и южните в река Матница (приток на Струма). На върха е разположена радарна станция."@bg .
geographbg:МатницаРека a geographbg:Река ;
    rdfs:label "Матница (река)"@bg ;
    geographbg:притокНа geographbg:Струма .
geographbg:ГолямРезенВръх geographbg:свързанС geographbg:МатницаРека . # Drainage
geographbg:ГолямРезенВръх geographbg:свързанС geographbg:Искър . # Drainage
geographbg:РадарнаСтанцияГолямРезен a geographbg:ИнфраструктуренОбект ;
    rdfs:label "Радарна станция Голям Резен"@bg ;
    geographbg:находящСеВ geographbg:ГолямРезенВръх .
geographbg:ГолямРезенВръх geographbg:близоДо geographbg:БистришкоБранище .
geographbg:RezenKnollАнтарктика a geographbg:ПланинскиВръх ;
    rdfs:label "Rezen Knoll (Антарктика)"@bg .

geographbg:КаменДелВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Камен дел"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1862"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаГеология "Андезит."@bg .
geographbg:ЗаслонУшите a geographbg:Заслон ;
    rdfs:label "Заслон „Ушите“"@bg ;
    geographbg:находящСеВ geographbg:Витоша .
geographbg:КаменДелВръх geographbg:близоДо geographbg:ЗаслонУшите .

geographbg:КоминитеВръх a geographbg:ПланинскиВръх, geographbg:СкалноОбразувание ;
    rdfs:label "Комините (връх)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1620"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Предпочитана дестинация за катерачи. Място, където се заражда българският алпинизъм. Първи опити за изкачване с въже през 1919 г."@bg .

geographbg:КръстаВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Кръста (връх)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1560.9"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

geographbg:МалъкРезенВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Малък Резен"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2182"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ХижаАлеко ;
    geographbg:свързанС geographbg:ГолямРезенВръх ;
    geographbg:имаОписание "Част от Резньовете. Свързан с Голям Резен чрез седловина. Между тях има лавиноопасен улей. Каменист връх."@bg .

geographbg:Резньовете a geographbg:ПланинскиВръх ; # Group of peaks
    rdfs:label "Резньовете"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:ЧерниВръх ;
    geographbg:имаОписание "Две самостоятелни върхови очертания на плато (Голям Резен и Малък Резен), дълго около 1 km и широко 400-500 метра. На изток платото завършва със стръмна стена до 200 метра височина."@bg ;
    geographbg:имаСъставящаЧаст geographbg:ГолямРезенВръх ;
    geographbg:имаСъставящаЧаст geographbg:МалъкРезенВръх .

geographbg:СелимицаВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Селимица (връх)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:ЧерниВръх .
geographbg:СедловинаСедлото a geographbg:Седловина ;
    rdfs:label "Седлото (седловина, Витоша)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:свързва geographbg:СелимицаВръх, geographbg:ЧерниВръх .
geographbg:Лалугер a geographbg:ЖивотинскиВид ;
    rdfs:label "Лалугер"@bg .
geographbg:СелимицаВръх geographbg:имаХарактеренЖивотинскиВид geographbg:Лалугер . # In its foothills

geographbg:СиваГрамадаВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Сива грамада (връх)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2003"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

geographbg:СкопарникВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Скопарник"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2226"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ЧерниВръх ;
    geographbg:имаГеология "Монцонити."@bg ;
    geographbg:имаТипПочва [ a geographbg:Почва ; rdfs:label "Ранкерни почви"@bg ] ;
    geographbg:близоДо geographbg:БистришкоБранище ;
    geographbg:имаЕтимология "Стара стръмна планина."@bg ;
    geographbg:имаОписание "Разположен на вододела на реките Струма и Искър."@bg .

geographbg:УшитеВръхВитоша a geographbg:ПланинскиВръх ;
    rdfs:label "Ушите (връх, Витоша)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:разположенВМестност [ a geographbg:Плато ; rdfs:label "Платото (Витоша)"@bg ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1906"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ЗаслонУшите .
geographbg:ХижаТинтява a geographbg:Хижа ;
    rdfs:label "Хижа „Тинтява“"@bg ;
    geographbg:находящСеВ geographbg:Витоша .

geographbg:ЧерниВръх
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2290"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Лепая (местност)"@bg ] ;
    geographbg:намираСеВЗемлищетоНа geographbg:Чуйпетлово ;
    geographbg:имаКлимат "Средногодишна скорост на вятъра: 9,3 m/s. Вторият най-ветровит връх в България."@bg .
geographbg:МетеорологичнаСтанцияЧерниВръх a geographbg:ИнфраструктуренОбект ;
    rdfs:label "Метеорологична станция Черни връх"@bg ;
    geographbg:находящСеВ geographbg:ЧерниВръх ;
    geographbg:основанПрезГодина "1935"^^xsd:integer .
geographbg:ХижаКумата a geographbg:Хижа ;
    rdfs:label "Хижа „Кумата“"@bg ;
    geographbg:находящСеВ geographbg:Витоша .
geographbg:ЧерниВръх geographbg:близоДо geographbg:ХижаАлеко ;
    geographbg:близоДо geographbg:ХижаКумата .

geographbg:ЗаслонБайКръстьо
    geographbg:находящСеВ [ a geographbg:Местност ; rdfs:label "Бай Кръстьо (местност)"@bg ; geographbg:находящСеВ geographbg:Витоша ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1400"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:КварталДрагалевци ;
    geographbg:имаИстория "Наименуван на създателя му Кръстьо Грозев. В началото на XX век Грозев изгражда чешма и заслона край нея."@bg .
geographbg:ЛифтДрагалевциГолиВръх a geographbg:Лифт ;
    rdfs:label "Лифт Драгалевци – Голи връх"@bg ;
    geographbg:свързва geographbg:КварталДрагалевци, [ a geographbg:ПланинскиВръх ; rdfs:label "Голи връх (Витоша)"@bg ] ;
    geographbg:преминаваПрез geographbg:ЗаслонБайКръстьо . # Междинна станция

geographbg:ЗаслонКикиш a geographbg:Заслон ;
    rdfs:label "Кикиш (заслон)"@bg ;
    geographbg:находящСеВ [ a geographbg:Местност ; rdfs:label "Кикиш (местност)"@bg ; geographbg:находящСеВ geographbg:Витоша ] ;
    geographbg:имаОписание "Разполага с кухня, столова и спално помещение. Реновиран през 2016 г. и действа като туристическа хижа."@bg ;
    geographbg:основанПрезГодина "1962"^^xsd:integer ;
    geographbg:стопанисваСеОт [ a geographbg:Организация ; rdfs:label "Туристическа секция „Кикиш“ при дружество „Планинец“ — София"@bg ] ;
    geographbg:държава geographbg:България .

geographbg:ЗаслонКикиш geographbg:близоДо geographbg:ДрагалевскиМанастир .
geographbg:ЗаслонКикиш geographbg:близоДо geographbg:КварталДрагалевци .
