geographbg:БГПлюсТелевизия a geographbg:Организация ;
    rdfs:label "БГ+"@bg ;
    geographbg:имаАлтернативноИме "Телевизия Българе"@bg ;
    geographbg:основанПрезГодина "2019"^^xsd:integer ;
    geographbg:имаОписание "Български телевизионен канал, основан от Христо Димитров. Работи в подкрепа на българския дух, култура, история, изкуство, традиции и фолклор. Предишно име: Телевизия „Българе“ (до март 2022 г.), която заменя „In LIFE TV“."@bg .

geographbg:БългарскиФолклорСписание
    rdfs:label "Български фолклор (списание)"@bg ;
    geographbg:имаОписание "Рецензирано научно списание на Института за етнология и фолклористика с етнографски музей при БАН. Основано през 1975 г. Публикува фолклористични, етноложки и антроположки изследвания. Излиза в четири книжки годишно."@bg ;
    geographbg:основанПрезГодина "1975"^^xsd:integer ;
    geographbg:свързанС geographbg:ИнститутЗаЕтнологияИФолклористикаСЕтнографскиМузей .

geographbg:ВедаСловена
    rdfs:label "Веда Словена"@bg ;
    geographbg:имаОписание "„Веда словена: Български народни песни от предисторическата и предхристиянската епоха“ е сборник с народно песенно творчество публикуван от Стефан Веркович в два тома (1874 г. и 1881 г.). Песните са събирани основно в Татарпазарджишката и Неврокопската каза, предоставени от Иван Гологанов от село Търлис, Неврокопско."@bg ;
    geographbg:основанПрезГодина "1874"^^xsd:integer ;
    geographbg:свързанС geographbg:ТатарпазарджишкаКаза ;
    geographbg:свързанС geographbg:НеврокопскаКаза ;
    geographbg:свързанС geographbg:ТърлисСело .

