# --- From "Атеренска река" ---
geographbg:АтеренскаРека a geographbg:Река ;
    rdfs:label "Атеренска река"@bg ;
    # България и Гърция
    geographbg:притокНа geographbg:Арда ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "35.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ; # "около 35 km"
    geographbg:дължинаВБългария [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "20.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Извор ; rdfs:label "извор-чешма, с. Черни рид, рид Сърта, Източни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "569.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    # площНаВодосборенБасейнВБългария [ ... "59.0" ... ]
    geographbg:преминаваПрез geographbg:ЧерниРидСело, geographbg:КобилиноСело, geographbg:ДрабишнаСело .
    # В Гърция: Зони, Кипринос
geographbg:СъртаРид a geographbg:Рид ; rdfs:label "Сърта (рид)"@bg ; geographbg:находящСеВ geographbg:ИзточниРодопи .
geographbg:ЧерниРидСело a geographbg:Село ; rdfs:label "Черни рид"@bg .
geographbg:КобилиноСело a geographbg:Село ; rdfs:label "Кобилино"@bg .
geographbg:ДрабишнаСело a geographbg:Село ; rdfs:label "Драбишна"@bg .
geographbg:Арда geographbg:имаПриток geographbg:АтеренскаРека .

# --- From "Боровица (река)" ---
geographbg:БоровицаРека a geographbg:Река ;
    rdfs:label "Боровица (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Смолян, Област Пловдив, Област Кърджали
    geographbg:притокНа geographbg:Арда ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "42.1"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Елварника, Переликско-Преспански дял, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1622.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Хамбардере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "301.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ЯзовирКърджали ;
    geographbg:преминаваПрез geographbg:БезводноСело, geographbg:ВойновоСело, geographbg:НенковоСело .

geographbg:ЕлварникаВръх a geographbg:ПланинскиВръх ; rdfs:label "Елварника"@bg .
geographbg:ПереликскоПреспанскиДял a geographbg:Планина ; rdfs:label "Переликско-Преспански дял"@bg ; geographbg:находящСеВ geographbg:ЗападниРодопи .
geographbg:БезводноСело a geographbg:Село ; rdfs:label "Безводно (Кърджалийско)"@bg .
geographbg:ВойновоСело a geographbg:Село ; rdfs:label "Войново (Кърджалийско)"@bg .
geographbg:НенковоСело a geographbg:Село ; rdfs:label "Ненково"@bg .
geographbg:ЯзовирБоровица a geographbg:Язовир ; rdfs:label "Боровица (язовир)"@bg ; geographbg:намираСеНаРека geographbg:БоровицаРека .
geographbg:Арда geographbg:имаПриток geographbg:БоровицаРека .
# Притоци: Муровска река, Бичка, Чатърдере, Сусусдере, Кокездере, Сандере, Яйлъдере, Евдере, Коджадере

# --- From "Върбица (река)" ---
geographbg:ВърбицаРека a geographbg:Река ;
    rdfs:label "Върбица (река, приток на Арда)"@bg ;
    geographbg:имаПриток geographbg:ДжебелскаРека, geographbg:НеделинскаРека, geographbg:ЧорбаджийскаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "98.1"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    # Образува се от Голяма река и Малка река (приток на Върбица)
    geographbg:еСъставящаЧастНа geographbg:ГолямаРекаСъставящаВърбица, geographbg:МалкаРекаПритокВърбица ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1203.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ЯзовирСтуденКладенец ;
    geographbg:преминаваПрез geographbg:МързянСело, geographbg:ЕрмаРекаСело, geographbg:ЗлатоградГрад, geographbg:ПресекаСело, geographbg:МогилянеСело, geographbg:БенковскиСелоКирково, geographbg:ЕроветеСело, geographbg:ВърлиДолСело, geographbg:БързеяСело, geographbg:КрилатицаСело, geographbg:ФотиновоСелоКирково, geographbg:СтарейшиноСело, geographbg:ВърбенСелоКирково, geographbg:ПтичарСело, geographbg:СедлариСело, geographbg:ГлухарСело .

