geographbg:ХижаРодина a geographbg:Хижа ; # Почивна станция
    rdfs:label "Родина (хижа)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1566"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ЗлатнитеМостове ;
    geographbg:основанПрезГодина "1942"^^xsd:integer ; # Завършена и осветена
    geographbg:имаОписание "Почивна станция на БДЖ. Проектирана от Райна Дамянова и Атанас Делибашев. Построена със средства на Софийското железничарско туристическо дружество и организацията на Българските железничари и моряци. Можела да приюти до 150 души. По-късно разширена. Обща площ 690 m2. Два апартамента, 58 легла. Столова, бар, зала за съвещания. Не функционира, обявена за продан 2016 г., руши се."@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "690"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаКапацитет [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "58"^^xsd:integer ; # Beds
        geographbg:имаМернаЕдиница geographbg:БройЖители
    ] ;
    geographbg:държава geographbg:България .

