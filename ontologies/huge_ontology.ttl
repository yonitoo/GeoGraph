geographbg:РекаГорица a geographbg:Река ; rdfs:label "Горица (река)"@bg .

# --- Илийна река ---
geographbg:РекаИлийна a geographbg:Река ;
    rdfs:label "Илийна река"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаРила, geographbg:ЮгозападенДялРила ;
    geographbg:еПритокНа geographbg:РилскаРека ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "16"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:образуваСеОт geographbg:РекаМермерица, geographbg:РекаКараомерица ;
    geographbg:вливаСеВ geographbg:РилскаРека ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1026"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "2,8 km югозападно от Рилския манастир"@bg ;
    geographbg:имаПриток geographbg:ПотокДядоильовДол .

geographbg:РекаМермерица a geographbg:Река ; rdfs:label "Мермерица (река)"@bg ; geographbg:извираОт geographbg:МермерскоЕзеро .
geographbg:РекаКараомерица a geographbg:Река ; rdfs:label "Караомерица (река)"@bg ; geographbg:извираОт geographbg:СиньоЕзероКараомеришко .
geographbg:МермерскоЕзеро a geographbg:Езеро ; rdfs:label "Мермерско езеро"@bg .
geographbg:СиньоЕзероКараомеришко a geographbg:Езеро ; rdfs:label "Синьо езеро (Караомеришки циркус)"@bg .
geographbg:ПотокДядоильовДол a geographbg:Поток ; rdfs:label "Дядоильов дол"@bg .
geographbg:ОбщинаРила a geographbg:Община ; rdfs:label "Община Рила"@bg ; geographbg:находящСеВ geographbg:ОбластКюстендил .
geographbg:ЮгозападенДялРила a geographbg:ПланинскиДял ; rdfs:label "Югозападен дял на Рила"@bg ; geographbg:еЧастОт geographbg:Рила .
geographbg:РилскаРека a geographbg:Река ; rdfs:label "Рилска река"@bg .

# --- Калин (язовир) ---
geographbg:ЯзовирКалин a geographbg:Язовир ;
    rdfs:label "Калин (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаРила ;
    geographbg:находящСеВ "землището на село Пастра"@bg ;
    geographbg:имаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2394"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:еСобственостНа geographbg:НЕК ;
    geographbg:еПостроенПрез "1940-1947" ;
    geographbg:строител geographbg:Гранитоид ;
    geographbg:типЯзовирнаСтена "бетонна гравитачна"@bg ;
    geographbg:височинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "15"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:дължинаНаКоронаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "390"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1020000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "35"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:захранваСеОт "естествен водосбор"@bg, geographbg:ЯзовирМалъкКалин, geographbg:РекаДебращица ; # Чрез канал "Калин"
    geographbg:оттичаСеВ geographbg:ЯзовирКарагьол, geographbg:ПАВЕЦКалин .

geographbg:Гранитоид a geographbg:Организация ; rdfs:label "Гранитоид (дружество)"@bg .
geographbg:РекаДебращица a geographbg:Река ; rdfs:label "Дебращица (река)"@bg .
geographbg:КаскадаРила a geographbg:ХидроенергийнаКаскада ; rdfs:label "Каскада „Рила“"@bg .
geographbg:НЕК a geographbg:Организация ; rdfs:label "Национална електрическа компания"@bg .
geographbg:ЯзовирМалъкКалин a geographbg:Язовир ; rdfs:label "Малък Калин (язовир)"@bg .
geographbg:ЯзовирКарагьол a geographbg:Язовир ; rdfs:label "Карагьол (язовир)"@bg .
geographbg:ПАВЕЦКалин a geographbg:ПомпеноАкумулиращаВодноелектрическаЦентрала ; rdfs:label "ПАВЕЦ Калин"@bg .

# --- Калина (река) ---
geographbg:РекаКалинаГърция a geographbg:Река ;
    rdfs:label "Калина (река, Гърция)"@bg ;
