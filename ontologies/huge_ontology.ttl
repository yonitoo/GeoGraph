geographbg:МалкиИскър a geographbg:Река ; # Вече може да е създаден
    rdfs:label "Малки Искър"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:имаАлтернативноИме "Равна река"@bg ;
    geographbg:извираОт geographbg:ЕтрополскаПланина ; # "в Етрополска планина"
    geographbg:вливаСеВ geographbg:Искър ;
