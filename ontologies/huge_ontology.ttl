geographbg:Марица geographbg:имаПриток geographbg:СребраРека .

# --- From "Стара река (горен приток на Марица)" ---
geographbg:СтараРекаГоренПритокМарица a geographbg:Река ;
    rdfs:label "Стара река (горен приток на Марица)"@bg ;
    geographbg:държава geographbg:България ;
    # Софийска област, Област Пазарджик
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "27.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "циркус между върховете Ибър и Сивричал, Източна Рила"@bg ;
        geographbg:находящСеВ geographbg:Рила ; # Източна Рила
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "2300.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Айряндере (Стара река)"@bg, "Чавча (Стара река)"@bg, "Костенецка река"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "91.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:КостенецСело .

