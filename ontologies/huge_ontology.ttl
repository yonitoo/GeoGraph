    geographbg:притокНа geographbg:БистрицаВитошка .

geographbg:АлдомировскоБлато a geographbg:Блато, geographbg:ЗащитенаМестност ; # Два типа от текста
    rdfs:label "Алдомировско блато"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:СофийскаКотловина ; # "в най-западната част на Софийската котловина"
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "129.40"^^xsd:decimal ; # "Площта му е 129,40 хектара"
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] .
geographbg:СофийскаКотловина a geographbg:Котловина ; rdfs:label "Софийска котловина"@bg ; geographbg:държава geographbg:България .
geographbg:Сливница a geographbg:Град ; rdfs:label "Сливница"@bg ; geographbg:държава geographbg:България .
geographbg:Алдомировци a geographbg:Село ; rdfs:label "Алдомировци"@bg ; geographbg:държава geographbg:България . # жп. гара Алдомировци
geographbg:ТриУши a geographbg:Рид ; rdfs:label "Три уши"@bg ; geographbg:държава geographbg:България . # планинския рид Три уши

geographbg:АрианаЕзеро a geographbg:Езеро ; # "Ариана (езеро)"
    rdfs:label "Ариана (езеро)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:БорисоваГрадина ; # "Борисовата градина в София"
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "8900.0"^^xsd:decimal ; # "площ от 8900 м²" - трябва патерн за m²
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър # Ако имаме такава единица
    ] ;
    # geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "175.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ] ; # "Дълго е 175 м"
    geographbg:имаМаксималнаДълбочина [ # "дълбоко е 1,20 м"
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.20"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .
geographbg:БорисоваГрадина a geographbg:Парк ; rdfs:label "Борисова градина"@bg ; geographbg:държава geographbg:България ; geographbg:находящСеВ geographbg:София .

