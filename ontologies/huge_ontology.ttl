geographbg:СтрумаКораб a owl:Thing ; # Assuming a generic Thing for a ship
    rdfs:label "Струма (кораб)"@bg ;
    geographbg:имаИстория "Построен 1867 г. като яхта „Ксанта“. По-късно „Македония“ (българска собственост, превоз на добитък). През 1941 г. нает за превоз на еврейски бежанци от Румъния за Палестина. Потопен от съветска подводница на 24 февруари 1942 г. в Черно море. Загиват 768 души, 1 оцелял."@bg .

geographbg:АвтомагистралаСтрума a geographbg:Път ;
    rdfs:label "Автомагистрала „Струма“ (А3)"@bg ;
    geographbg:имаОписание "Свързва София с ГКПП Кулата (граница с Гърция). Дублира републикански път I-1 и Европейски път Е79. Планирана дължина 172 km, към февруари 2024 г. изградени 143 km."@bg ;
    geographbg:свързва geographbg:София, [ a geographbg:Местоположение ; rdfs:label "ГКПП Кулата"@bg ] ;
    geographbg:държава geographbg:България .

geographbg:СелоСтрума a geographbg:Село ;
    rdfs:label "Струма (село)"@bg ;
    geographbg:находящСеВ [ a geographbg:Община ; rdfs:label "Община Сандански"@bg ] ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград ;
    geographbg:имаИстория "Възниква в резултат на миграция от село Кръстилци. Признато за село на 22 ноември 1960 г. (преди това населено място Лебница)."@bg ;
    geographbg:държава geographbg:България .
geographbg:ХрамСветиИларионМъгленскиСтрумаСело a geographbg:КултуренОбект ;
    rdfs:label "Храм „Свети Иларион, епископ Мъгленски“ (село Струма)"@bg ;
    geographbg:находящСеВ geographbg:СелоСтрума .

geographbg:СтрумскаОперация a geographbg:Събитие ;
    rdfs:label "Струмска операция"@bg ;
    geographbg:имаОписание "Настъпателна операция на българската армия през Първата световна война (17 – 23 август 1916 г.). Проведена успоредно с Леринската настъпателна операция. Води до окупация на 4000 km2 в гръцката част на Източна Македония. Българските войски заемат Сяр, Драма и Кавала."@bg .

geographbg:ФК_СтрумскаСлаваРадомир a geographbg:Организация ;
    rdfs:label "ФК „Струмска слава“ (Радомир)"@bg ;
    geographbg:основанПрезГодина "1927"^^xsd:integer ;
    geographbg:имаАлтернативноИме "Червено знаме (Радомир)"@bg, "Металург (Радомир)"@bg ;
    geographbg:находящСеВ [ a geographbg:Град ; rdfs:label "Радомир"@bg ] ;
    geographbg:имаОписание "Участва във Втора професионална футболна лига. Играе на Градския стадион в Радомир (капацитет 5000 места)."@bg .

geographbg:ХижаАкадемикВитоша a geographbg:Хижа ;
    rdfs:label "Академик (хижа, Витоша)"@bg ;
    geographbg:имаАлтернативноИме "Купена (хижа)"@bg, "Физкултурник (хижа)"@bg, "Високопланинска учебно-спортна база „Проф. Иван Стайков“"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:ГолямКупенВръх ;
    geographbg:имаОписание "Триетажна сграда с капацитет 150 места. Учебна база на НСА „Васил Левски“. Използва се за ведомствени нужди."@bg ;
    geographbg:основанПрезГодина "1972"^^xsd:integer ;
    geographbg:стопанисваСеОт [ a geographbg:Организация ; rdfs:label "Национална спортна академия „Васил Левски“"@bg ] ;
    geographbg:държава geographbg:България .
geographbg:ХижаАкадемикВитоша geographbg:близоДо geographbg:СелоЖелезницаСофия .
geographbg:ХижаАкадемикВитоша geographbg:близоДо geographbg:ЧерниВръх .
geographbg:ХижаАкадемикВитоша geographbg:близоДо geographbg:ХижаАлеко .

geographbg:ЯвороваПоляна a geographbg:Местност, geographbg:Ливада ;
    rdfs:label "Яворова поляна"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Селимишки дял"@bg ; geographbg:находящСеВ geographbg:Витоша ] ;
    geographbg:имаОписание "Наречена в чест на българския поет и революционер, Пейо Яворов. В границите на природен парк „Витоша“."@bg ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркВитоша ;
    geographbg:държава geographbg:България .

geographbg:ХижаПанчоТомов a geographbg:Хижа ;
    rdfs:label "Хижа „Панчо Томов“"@bg ;
    geographbg:находящСеВ geographbg:Витоша .
