    geographbg:находящСеВ geographbg:ОбщинаДойран ;
    geographbg:находящСеВ geographbg:ПланинаБоска ;
    geographbg:държава geographbg:СевернаМакедония ;
    geographbg:имаНаселение [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "121"^^xsd:integer ;
        geographbg:имаМернаЕдиница geographbg:БройЖители ;
        rdfs:comment "към 2002 г."@bg
    ] ;
    geographbg:имаИстория "През XIX век селото е чисто турско. В „Етнография на вилаетите Адрианопол, Монастир и Салоника“ (1873): 40 домакинства, 92 мюсюлмани. Васил Кънчов (1900): Курт Хамзали, 180 жители, всички турци."@bg .

geographbg:ЛипошБившеСело a geographbg:Село ;
    rdfs:label "Липош (бивше село)"@bg ;
    geographbg:имаАлтернативноИме "Липуш"@bg ;
    geographbg:находящСеВ geographbg:ДемСинтика ;
    geographbg:държава geographbg:Гърция ;
    geographbg:находящСеВ geographbg:БеласицаПланина ;
    geographbg:близоДо geographbg:ГорниПоройСело ;
    geographbg:близоДо geographbg:НеохориСелоСинтика ;
    geographbg:близоДо geographbg:ВръхЛипош ;
    geographbg:имаИстория "Османски регистри (1616-1617): 46 джизие ханета. (1625): 35 ханета. XIX век: Демирхисарска каза. Етнография (1873): 30 домакинства, 100 българи. Кънчов (1900): 350 българи. Мишев (1905): 480 българи патриаршисти гъркомани, 90 власи. 1906: 70 къщи. 1928: 39 бежански семейства, 144 души."@bg .

geographbg:МанастировоБившеСело a geographbg:Село ;
    rdfs:label "Манастирово (бивше село)"@bg ;
