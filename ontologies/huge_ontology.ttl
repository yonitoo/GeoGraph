# --- Гращица (река) ---
geographbg:РекаГращица a geographbg:Река ;
    rdfs:label "Гращица (река)"@bg ;
    geographbg:имаАлтернативноИме "Гращичка река"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаНевестино, geographbg:ОсоговскаПланина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "20"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ОсоговскаПланина ;
        rdfs:comment "източни склонове на Брезовски рид, 500 м югоизточно от връх Белток" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1413"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "446"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "700 m северозападно от село Невестино"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "64"^^xsd:decimal ;
