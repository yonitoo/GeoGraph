    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "28.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Сакар планина, близо до връх Чуката"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "471.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Улуклийска река"@bg, "Чарганлия"@bg, "Луда Яна"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "81.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ПомощникСело, geographbg:ДряновоСелоХасково, geographbg:ТроянСелоХасково .

geographbg:СакарПланина a geographbg:Планина ; rdfs:label "Сакар планина"@bg .
