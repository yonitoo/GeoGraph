geographbg:ЛеринскаНосия
    rdfs:label "Леринска носия"@bg ;
    geographbg:имаОписание "Българска носия от Лерин и Леринско. Различава се в осем вариации. Характерни елементи за женската леринска носия са белият сукман и вълнената или памучна риза. Булчинската носия включва монети на гърдите."@bg ;
    geographbg:свързанС geographbg:ЛеринГрад ;
    geographbg:свързанС geographbg:Леринско .

