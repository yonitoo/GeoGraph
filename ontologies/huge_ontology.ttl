    ] ;
    geographbg:имаОписание "Разположен северно от Стара Загора. Надморска височина варира от 260 м до 430 м."@bg ;
    geographbg:основанПрезГодина "1895"^^xsd:integer ;
    geographbg:имаИстория "Създаден на 28 февруари 1895 г. от митрополит Методий Кусев под името „Св. княз Борис-Михаил“. До началото на XIX век на това място се е простирала дъбова гора, изсечена от турския аскер."@bg ;
