        geographbg:имаСтойност "1345"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Разположена точно над град София. Намира се телевизионна кула Копитото и хотел „Копитото“."@bg ;
    geographbg:имаГеографскаШирина "42.636349"^^xsd:decimal ;
    geographbg:имаГеографскаДължина "23.243741"^^xsd:decimal ;
    geographbg:държава geographbg:България .

geographbg:ХотелКопитото a geographbg:Хотел ;
    rdfs:label "Хотел „Копитото“"@bg ;
    geographbg:находящСеВ geographbg:Копитото .

geographbg:ЛифтКняжевоКопитото a geographbg:Лифт ;
    rdfs:label "Лифт Княжево – Копитото"@bg ;
    geographbg:свързва geographbg:КварталКняжево, geographbg:Копитото ;
    geographbg:основанПрезГодина "1962"^^xsd:integer ;
    geographbg:имаОписание "Първият кабинков лифт в България. Дължина 1920 m, разлика във височините 600 m. 53 четириместни кабини, капацитет 600 души/час, скорост 3 m/s. Не работи от началото на 90-те."@bg ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.92"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] .

geographbg:ПрироденПаркВитоша
    rdfs:label "Природен парк „Витоша“"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27079"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:обявенаСъсЗаповед "Постановление № ІІІа 15422 от 27.10.1934 г. на министъра на народното стопанство"@bg ;
    geographbg:датаНаОбявяване "1934-10-27"^^xsd:date ;
    geographbg:имаИстория "Първият природен парк в България и на Балканския полуостров. Първоначална площ около 6410 ха. Прекатегоризиран в Народен парк (1952 г.), Природен парк (2000 г.). Границите са променяни многократно."@bg ;
    geographbg:имаФлора "500 вида сладководни водорасли; 805 вида гъби; 360 вида лишеи; 326 вида мъхове; 1489 вида висши растения."@bg ;
    geographbg:имаФауна "Безгръбначни – 540 вида; Насекоми – голям дъбов сечко, буков сечко, червена горска мравка; Риби – балканска пъстърва; Птици – 236 вида (120 гнездящи, 53 прелетни); Бозайници – благороден елен, сърна, мечка, вълк, заек, лисица, видра, дива котка; 13 вида прилепи."@bg ;
    geographbg:държава geographbg:България .

geographbg:ДирекцияНаПрироденПаркВитоша a geographbg:Организация ;
    rdfs:label "Дирекция на Природен парк „Витоша“"@bg .
geographbg:ПрироденПаркВитоша geographbg:стопанисваСеОт geographbg:ДирекцияНаПрироденПаркВитоша .
geographbg:ИзпълнителнаАгенцияПоГорите a geographbg:Организация ;
    rdfs:label "Изпълнителна агенция по горите"@bg .
geographbg:ДирекцияНаПрироденПаркВитоша geographbg:свързанС geographbg:ИзпълнителнаАгенцияПоГорите .
geographbg:МинистерствоНаЗемеделиетоИХраните a geographbg:Организация ;
