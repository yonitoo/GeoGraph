geographbg:ЛипникЛесопарк a geographbg:Парк, geographbg:Гора ;
    rdfs:label "Липник (лесопарк)"@bg ;
    geographbg:находящСеВ geographbg:СелоНиколовоРусе ;
    geographbg:близоДо geographbg:РусеГрад ;
    geographbg:имаПлощ [
