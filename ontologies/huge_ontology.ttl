        geographbg:имаСтойност "1011"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .
geographbg:АлековиВодопади geographbg:близоДо geographbg:ДрагалевскиМанастир .
geographbg:АлековиВодопади geographbg:близоДо geographbg:ЗаслонБайКръстьо .
geographbg:ХотелСветиГеоргиСимеоново a geographbg:Хотел ;
