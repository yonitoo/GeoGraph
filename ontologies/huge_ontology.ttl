# --- From "Тунджа" ---
geographbg:ТунджаРека a geographbg:Река ;
    rdfs:label "Тунджа (река)"@bg ;
    # България и Турция
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "390.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:дължинаВБългария [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "349.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "близо до връх Юрушка грамада, Калоферска планина, Стара планина"@bg ;
        geographbg:находящСеВ geographbg:СтараПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "2083.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Селска река (Тунджа)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "8429.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ; # Total
    # площНаВодосборенБасейнВБългария [ ... "7884.0" ... ]
    geographbg:преминаваПрез geographbg:КалоферГрад, geographbg:ОсетеновоСело, geographbg:АлександровоСелоПавелБаня, geographbg:ПавелБаняГрад, geographbg:ВиденСело, geographbg:ОвощникСело, geographbg:ЯгодаСело, geographbg:ЮлиевоСело, geographbg:ШановоСело, geographbg:ЗимницаСелоМъглиж, geographbg:НоваМахалаСелоНиколаево, geographbg:НиколаевоГрад, geographbg:ПаничеревоСело, geographbg:БаняСелоНоваЗагора, geographbg:ЧервенаковоСело, geographbg:БинкосСело, geographbg:МечкаревоСело, geographbg:СамуиловоСелоСливен, geographbg:КрушареСело, geographbg:ЖелюВойводаСело, geographbg:ЯмболГрад, geographbg:ЗавойСело, geographbg:ВеселиновоСелоЯмбол, geographbg:ОкопСело, geographbg:ХановоСело, geographbg:ТеневоСело, geographbg:КоневецСело, geographbg:ЕлховоГрад, geographbg:КняжевоСелоТополовград, geographbg:СремСело .
    # В Турция: Суакаджагъ, Хатипкьой, Дегирменянъ, Авариз, Одрин

geographbg:ЮрушкаГрамадаВръх a geographbg:ПланинскиВръх ; rdfs:label "Юрушка грамада"@bg .
