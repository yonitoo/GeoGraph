geographbg:ЯзовирДяково a geographbg:Язовир ;
    rdfs:label "Язовир „Дяково“"@bg ;
    geographbg:намираСеВЗемлищетоНа [ a geographbg:Село ; rdfs:label "Дяково (село)"@bg ], [ a geographbg:Село ; rdfs:label "Кременик (село)"@bg ] ;
    geographbg:имаОписание "Използва се за техническо водоснабдяване на ТЕЦ „Бобов дол“ и битово водоснабдяване. Форма на разперена длан. Захранва се от две деривации."@bg ;
    geographbg:основанПрезГодина "1975"^^xsd:integer ; # Завършен
    geographbg:имаОбем [
