geographbg:Мартеница a geographbg:КултуренОбект ;
    rdfs:label "Мартеница"@bg ;
    geographbg:имаАлтернативноИме "мартинка"@bg, "марта"@bg, "мартичка"@bg, "гадалушка"@bg, "кичилка"@bg, "Пижо и Пенда"@bg ;
    geographbg:имаОписание "Обредна украса от усукани бял и червен конец (вълнени или памучни), които се слагат на 1 март за здраве. Носи се до появата на цъфнало дърво или прелетна птица, след което се поставя на дърво или под камък. Разпространена на Балканите."@bg ;
    geographbg:свързанС geographbg:БабаМарта ;
    geographbg:свързанС geographbg:ПървиМартПразник ;
    geographbg:свързанС geographbg:БалканскиПолуостров ;
