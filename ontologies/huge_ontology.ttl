        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1911"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "459"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "500 m източно от село Жабокрът"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "93"^^xsd:decimal ; # или 128
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "0.29"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:имаПриток geographbg:РекаГлогошка, geographbg:РекаКалушкоДере ;
    geographbg:протичаПрез geographbg:ГрадКюстендил, geographbg:СелоЖиленци, geographbg:СелоЯбълковоБанщица, geographbg:СелоЖабокрът ;
    geographbg:използваСеЗа "напояване"@bg .

