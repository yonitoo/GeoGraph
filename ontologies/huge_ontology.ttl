# --- Банщица ---
geographbg:РекаБанщица a geographbg:Река ;
    rdfs:label "Банщица"@bg ;
    geographbg:находящСеВ geographbg:ОбластКюстендил, geographbg:ОбщинаКюстендил, geographbg:ОсоговскаПланина, geographbg:ПланинаЛисец ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "22"^^xsd:decimal ;
