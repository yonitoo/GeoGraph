    rdfs:label "Погледец (хижа)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ; # Североизточен дял
    geographbg:близоДо geographbg:ХижаАлеко ;
    geographbg:близоДо geographbg:СелоБистрицаСофия ;
    geographbg:граничиС geographbg:БистришкоБранище ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Катунище (местност)"@bg ] ;
