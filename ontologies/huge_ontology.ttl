geographbg:ИзравнителРила a geographbg:Изравнител ; rdfs:label "Изравнител Рила"@bg .

# --- Каскада „Санданска Бистрица“ ---
geographbg:КаскадаСанданскаБистрица a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Каскада „Санданска Бистрица“"@bg ;
    geographbg:находящСеВПоречиетоНа geographbg:РекаСанданскаБистрица ;
    geographbg:находящСеВ geographbg:Пирин ;
    geographbg:еПостроенПрез "1967-1972" ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "119"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:включваСъоръжение geographbg:ВЕЦПопинаЛъка, geographbg:ВЕЦЛиляново, geographbg:ВЕЦСандански,
        geographbg:ИзравнителПопинаЛъка, geographbg:ИзравнителЛиляново, geographbg:ИзравнителСандански ;
    geographbg:еСобственостНа geographbg:ЕнергоПроБългарияОрганизация .

geographbg:ВЕЦПопинаЛъка a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Попина лъка"@bg ;
    geographbg:еЧастОт geographbg:КаскадаСанданскаБистрица ;
    geographbg:еЗавършенПрез "1969"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "22"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ИзравнителПопинаЛъка .

geographbg:ВЕЦЛиляново a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Лиляново"@bg ;
    geographbg:еЧастОт geographbg:КаскадаСанданскаБистрица ;
    geographbg:еЗавършенПрез "1969"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "20"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ИзравнителЛиляново .

geographbg:ВЕЦСандански a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Сандански"@bg ;
    geographbg:еЧастОт geographbg:КаскадаСанданскаБистрица ;
    geographbg:еЗавършенПрез "1971"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "14.2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ИзравнителСандански .

geographbg:ИзравнителПопинаЛъка a geographbg:Изравнител ; rdfs:label "Изравнител Попина лъка"@bg ; geographbg:имаОбем [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "46000"^^xsd:decimal ;
    geographbg:имаМернаЕдиница geographbg:КубиченМетър
] .
geographbg:ИзравнителЛиляново a geographbg:Изравнител ; rdfs:label "Изравнител Лиляново"@bg ; geographbg:имаОбем [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "45000"^^xsd:decimal ;
    geographbg:имаМернаЕдиница geographbg:КубиченМетър
] .
geographbg:ИзравнителСандански a geographbg:Изравнител ; rdfs:label "Изравнител Сандански"@bg ; geographbg:имаОбем [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "30000"^^xsd:decimal ;
    geographbg:имаМернаЕдиница geographbg:КубиченМетър
] .
geographbg:РекаСанданскаБистрица a geographbg:Река ; rdfs:label "Бистрица (Санданска)"@bg .

# --- Малък Калин (язовир) ---
geographbg:ЯзовирМалъкКалин
    geographbg:еЧастОт geographbg:КаскадаРила ;
    geographbg:находящСеВ "землището на село Пастра"@bg ;
    geographbg:еПостроенПрез "1940-1949" ;
    geographbg:еСобственостНа geographbg:НЕК ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "20000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Най-високият изкуствен водоем в България."@bg ;
    geographbg:типЯзовирнаСтена "бетонна гравитачна"@bg ;
    geographbg:височинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "4.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:дължинаНаКоронаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "54.9"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:захранваСеОт "естествен водосбор"@bg ;
    geographbg:оттичаСеВ geographbg:ЯзовирКалин .

# --- Осеновска река ---
geographbg:РекаОсеновска a geographbg:Река ;
    rdfs:label "Осеновска река"@bg ;
    geographbg:имаАлтернативноИме "Раковица"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаСимитли, geographbg:ЮгозападенДялРила ;
    geographbg:еПритокНа geographbg:РекаГрадевска ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "19"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:label "Арамлийски кладенец"@bg ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "2269"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаГрадевска ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "520"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "до бившия стопански двор на село Градево"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "88"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаТоплицаОсеновска ;
    geographbg:протичаПрез geographbg:СелоДолноОсеново .

geographbg:РекаТоплицаОсеновска a geographbg:Река ; rdfs:label "Топлица (приток на Осеновска река)"@bg .
geographbg:СелоДолноОсеново a geographbg:Село ; rdfs:label "Долно Осеново"@bg ; geographbg:находящСеВ geographbg:ОбщинаСимитли .
geographbg:РекаГрадевска a geographbg:Река ; rdfs:label "Градевска река"@bg .

# --- Панега ---
geographbg:РекаПанега
    geographbg:имаАлтернативноИме "Просяченска река"@bg, "Лиса Чай"@bg, "Севендрия Чай"@bg ;
    geographbg:находящСеВ "Егейска Македония, Северна Гърция"@bg ;
    geographbg:еПритокНа geographbg:РекаДраматица ; # Или обратното според гръцкия източник
    geographbg:извираОт geographbg:ПещераМаарата ;
    geographbg:вливаСеВ geographbg:РекаДраматица ;
    geographbg:мястоНаВливане "при село Баница"@bg ;
    geographbg:имаПриток geographbg:РекаДервентска, geographbg:РекаВиливища, geographbg:РекаКалинаГърция, geographbg:РекаСушицаБоздаг .

geographbg:ПещераМаарата a geographbg:Пещера ; rdfs:label "Маарата (пещера)"@bg .
geographbg:РекаДервентска a geographbg:Река ; rdfs:label "Дервентска река"@bg .
geographbg:РекаВиливища a geographbg:Река ; rdfs:label "Виливища (река)"@bg .
geographbg:РекаДраматица a geographbg:Река ; rdfs:label "Драматица"@bg .
geographbg:РекаСушицаБоздаг a geographbg:Река ; rdfs:label "Сушица (Боздаг)"@bg .

# --- Серовица ---
geographbg:РекаСеровица a geographbg:Река ;
    rdfs:label "Серовица"@bg ;
    geographbg:имаАлтернативноИме "Баничка река"@bg, "Циклата"@bg ;
    geographbg:находящСеВ "Егейска Македония, Гърция"@bg, geographbg:ПланинаШарлия ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаШарлия ;
        rdfs:comment "южно под връх Ляксово"
    ] ;
    geographbg:вливаСеВ geographbg:РекаБродска ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:протичаПрез "град Сяр"@bg .

# --- Скакавица (река) ---
geographbg:РекаСкакавица a geographbg:Река ;
    rdfs:label "Скакавица (река)"@bg ;
    geographbg:находящСеВ geographbg:Рила ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:Рила ;
        rdfs:comment "източен склон на връх Кабул"
    ] ;
    geographbg:еПритокНа geographbg:РекаДжерман ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:образува geographbg:ЕзероСкакавишко, geographbg:ВодопадСкакавица .

geographbg:ЕзероСкакавишко a geographbg:Езеро ; rdfs:label "Скакавишко езеро"@bg .
geographbg:ВодопадСкакавица a geographbg:Водопад ; rdfs:label "Скакавица (водопад)"@bg .

# --- Студена (язовир) ---
geographbg:ЯзовирСтудена a geographbg:Язовир ;
    rdfs:label "Студена (язовир)"@bg ;
    geographbg:находящСеВ "Западна България, землища на селата Студена, Кладница и Боснек, община Перник"@bg ;
    geographbg:еПостроенНа geographbg:РекаСтрума ;
    geographbg:еВъведенВЕксплоатацияНа "1953-12-05"^^xsd:date ;
    geographbg:типЯзовирнаСтена "бетонна гравитачна с контрафорси"@bg ;
    geographbg:височинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "53"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:дължинаНаКоронаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "268"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25200000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:захранваСеОт geographbg:РекаСтрума, "Канал Владая (Владайска и Рударска река)"@bg, "Канал Палакария (река Палакария)"@bg ;
    geographbg:използваСеЗа "водоснабдяване на Перник и съседни селища"@bg ;
    geographbg:включваСъоръжение geographbg:ВЕЦСтудена .

geographbg:ВЕЦСтудена a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Студена"@bg ;
    geographbg:еВъведенВЕксплоатацияНа "1955"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "780"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Киловат
    ] .
geographbg:РекаСтрума a geographbg:Река ; rdfs:label "Струма (река)"@bg .

# --- Сушица (Боздаг) ---
geographbg:РекаСушицаБоздаг
    geographbg:имаАлтернативноИме "Куру Чай"@bg, "Наковица"@bg ;
    geographbg:находящСеВ "Егейска Македония, Северна Гърция"@bg, geographbg:ПланинаБоздаг ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаБоздаг ;
        rdfs:comment "южно под гребена Карталка"
    ] ;
    geographbg:вливаСеВ geographbg:РекаПанега ;
    geographbg:мястоНаВливане "северозападно над Голям Семендрик"@bg ;
    geographbg:имаПриток geographbg:РекаЛовна, geographbg:РекаДебелина, geographbg:РекаПреход, geographbg:РекаБуро .

geographbg:РекаЛовна a geographbg:Река ; rdfs:label "Ловна (река)"@bg .
geographbg:РекаДебелина a geographbg:Река ; rdfs:label "Дебелина (река)"@bg .
geographbg:РекаПреход a geographbg:Река ; rdfs:label "Преход (река)"@bg .
geographbg:РекаБуро a geographbg:Река ; rdfs:label "Буро (река)"@bg .

# --- Тополница (приток на Джубрена) ---
geographbg:РекаТополницаДжубрена a geographbg:Река ;
    rdfs:label "Тополница (приток на Джубрена)"@bg ;
    geographbg:имаАлтернативноИме "Клисурата"@bg ;
    geographbg:находящСеВ geographbg:СофийскаОбласт, geographbg:ОбластКюстендил, geographbg:ПланинаВерила, geographbg:ДупнишкаКотловина ;
    geographbg:еПритокНа geographbg:РекаДжубрена ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаВерила ;
        rdfs:comment "1 km източно от връх Голям Дебелец" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1230"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:РекаДжубрена ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "524"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "420 m преди устието на Джубрена"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "133"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаДяковска ;
    geographbg:протичаПрез geographbg:СелоЯребковица, geographbg:СелоТополница, geographbg:СелоЯхиново ;
    geographbg:използваСеЗа "напояване"@bg .

geographbg:РекаДяковска a geographbg:Река ; rdfs:label "Дяковска река"@bg ; geographbg:имаЯзовир geographbg:ЯзовирДяково .
geographbg:СелоЯребковица a geographbg:Село ; rdfs:label "Яребковица"@bg ; geographbg:находящСеВ geographbg:ОбщинаСамоков .
geographbg:СелоТополница a geographbg:Село ; rdfs:label "Тополница (село)"@bg ; geographbg:находящСеВ geographbg:ОбщинаДупница .

# --- Фудиня ---
geographbg:РекаФудиня
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:comment "северозападно подножие на връх Таш мандра"
    ] ;
    geographbg:вливаСеВ geographbg:РекаДжерман ;
    geographbg:мястоНаВливане "средата на Горно поле"@bg ;
    geographbg:използваСеЗа "водоснабдяване на град Дупница и язовир Дяково (чрез деривация Джерман)"@bg .

# --- Чемерика (река) ---
geographbg:РекаЧемерика a geographbg:Река ;
    rdfs:label "Чемерика (река)"@bg ;
    geographbg:имаАлтернативноИме "Платанорема"@bg, "Куручай"@bg, "Ксиропотамос"@bg ;
    geographbg:находящСеВ "Егейска Македония, Северна Гърция"@bg, geographbg:ПланинаБоздаг ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаБоздаг ;
        rdfs:comment "южно под връх Кула"
    ] ;
    geographbg:вливаСеВ geographbg:РекаДраматица ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:мястоНаВливане "срещу Сандък чифлик и Чай чифлик"@bg ;
    geographbg:протичаПрез "град Драма"@bg .

# --- Шарлийска река ---
geographbg:РекаШарлийска a geographbg:Река ;
    rdfs:label "Шарлийска река"@bg ;
    geographbg:имаАлтернативноИме "Кушлу"@bg, "Скотино Рема"@bg ;
    geographbg:находящСеВ "Сярско, Егейска Македония, Гърция"@bg, geographbg:ПланинаШарлия ;
    geographbg:еПритокНа geographbg:РекаБелицаСярско ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаШарлия ;
        rdfs:comment "местността Мандри, западно от връх Цървил"
    ] ;
    geographbg:вливаСеВ geographbg:РекаБелицаСярско ;
    geographbg:мястоНаВливане "местността Бахчелък"@bg ;
    geographbg:имаОписание "На нея е разположен водопад Скак."@bg ;
    geographbg:протичаПрез "село Цървища"@bg .

# --- Явор (река) ---
geographbg:РекаЯвор a geographbg:Река ;
    rdfs:label "Явор (река)"@bg ;
    geographbg:имаАлтернативноИме "Ясеница"@bg, "Асеница"@bg ;
    geographbg:находящСеВ geographbg:ОбластПерник, geographbg:ОбщинаТрън, geographbg:ОбщинаЗемен ;
    geographbg:еПритокНа geographbg:ТреклянскаРека ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "32"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ЕловишкаПланина ;
        rdfs:comment "400 м източно от връх Плоча" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1200"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:ТреклянскаРека ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "629"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане geographbg:СелоКалотинци ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "186"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаПрестолскиДол, geographbg:РекаРакитовДол, geographbg:РекаДивлянска, geographbg:РекаСелскаЯвор ;
    geographbg:протичаПрез geographbg:СелоГорочевци, geographbg:СелоВидрар, geographbg:СелоДокьовци, geographbg:СелоПенкьовци, geographbg:СелоДивля, geographbg:СелоКалотинци ;
    geographbg:използваСеЗа "напояване"@bg .

