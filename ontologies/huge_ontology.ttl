    rdfs:label "УейкЪп! България"@bg ;
    geographbg:имаАлтернативноИме "Събуди се! Експеримент"@bg ;
    geographbg:имаОписание "Културно-образователен фестивал, провеждан ежегодно от 2011 г. в Родопите, между Куклен и Кукленския манастир. Продължителност 3 дни. Обединява култура, музика и български обичаи."@bg ;
