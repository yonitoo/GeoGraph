# Страница "Панчаревско езеро" вече е обработена.

geographbg:ПасарелЯзовир a geographbg:Язовир ; # От title "Пасарел (язовир)"
    rdfs:label "Пасарел (язовир)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ПанчаревскиПролом ; # "в Панчаревският пролом"
    geographbg:намираСеНаРека geographbg:Искър ;
    geographbg:имаАлтернативноИме "язовир Кокаляне"@bg ;
    geographbg:общаДължина [ # "Язовирът има дължина 2 km"
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаОбем [ # "максимален завирен обем 2,7 млн. m³"
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2700000.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаВисочинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "94.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "700.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

