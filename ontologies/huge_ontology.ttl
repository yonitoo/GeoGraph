    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Карасиври, Същинска Средна гора"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "845.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Текедере"@bg ;
    geographbg:площНаВодосборенБасейн [
