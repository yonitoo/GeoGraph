    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "2852.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:дължинаВБългария [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "470.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:площНаВодосборенБасейн [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "802266.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] .
geographbg:ЧерноМоре geographbg:имаПриток geographbg:Дунав .

