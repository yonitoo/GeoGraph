        geographbg:имаСтойност "2000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Разположен в обширен горски масив от липови дървета. Смятан за най-големия лесопарк в България. Изграждането започва през 1950-те години. Има вили, ресторанти, изкуствени езера, хотел, зоокът, детски кът, спортна база, къмпинг. Тук се намира бившата резиденция „Липник“."@bg ;
    geographbg:имаХарактеренРастителенВид geographbg:Липа ;
    geographbg:държава geographbg:България .

