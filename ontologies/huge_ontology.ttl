geographbg:ДжамалПразник a geographbg:Събитие ;
    rdfs:label "Джамал (празник)"@bg ;
    geographbg:имаОписание "Празник в региона на Елин Пелин, водещ началото си от село Нови хан. Провежда се първата събота на януари. Джамали обикалят къщите, плашат зли сили и вещаят здраве и благоденствие. Практикува се и в Габра, Равно поле, Александрово (Ловешко)."@bg ;
    geographbg:свързанС geographbg:ЕлинПелинРегион ;
    geographbg:свързанС geographbg:НовиХанСело ;
    geographbg:свързанС geographbg:ГабраСело ;
    geographbg:свързанС geographbg:РавноПоле ;
    geographbg:свързанС geographbg:АлександровоСелоЛовеч .

geographbg:ЕлинПелинРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Регион на Елин Пелин"@bg ;
    geographbg:свързанС geographbg:ЕлинПелинГрад .

geographbg:НовиХанСело a geographbg:Село ;
    rdfs:label "Нови хан"@bg ;
    geographbg:държава geographbg:България .

geographbg:АлександровоСелоЛовеч a geographbg:Село ;
