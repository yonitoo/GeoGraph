geographbg:КаскадаБелмекенСестримоЧаира a geographbg:Каскада ;
    rdfs:label "Каскада „Белмекен-Сестримо-Чаира“"@bg ;
    geographbg:находящСеВ geographbg:Рила ;
    geographbg:находящСеВ [ a geographbg:Област ; rdfs:label "Област Пазарджик"@bg ] ;
    geographbg:имаОписание "Най-голямото и сложно хидротехническо съоръжение в България. Изградена 1964-1999 г. Събира води от горните части на басейните на Марица, Струма и Места. Включва два пояса събирателни деривации, три язовира, два изравнителя, две ПАВЕЦ и две ВЕЦ."@bg ;
    geographbg:имаКапацитет [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1599"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:държава geographbg:България .
