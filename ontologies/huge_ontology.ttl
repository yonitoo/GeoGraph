# --- From "Черкезица" ---
geographbg:ЧеркезицаРека a geographbg:Река ;
    rdfs:label "Черкезица (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПловдив ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "48.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    # Извор не е ясно дефиниран за самата Черкезица, а за притока Сушица
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "269.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ГорнославСело, geographbg:ДолнославСело, geographbg:ИзбеглиСело, geographbg:ЗлатовръхСело, geographbg:БоянциСело, geographbg:БолярциСело, geographbg:БогданицаСело, geographbg:СелциСело, geographbg:ПоповицаСело .

geographbg:СушицаРекаПритокЧеркезица a geographbg:Река ; rdfs:label "Сушица (приток на Черкезица)"@bg ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "рид Добростан, Западни Родопи, близо до с. Врата"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1020.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] .
geographbg:ЧеркезицаРека geographbg:имаПриток geographbg:СушицаРекаПритокЧеркезица .
