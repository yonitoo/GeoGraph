geographbg:ОбщинаБлагоевград a geographbg:Община ; rdfs:label "Община Благоевград"@bg ; geographbg:находящСеВ geographbg:ОбластБлагоевград .
geographbg:ОбщинаТрън a geographbg:Община ; rdfs:label "Община Трън"@bg ; geographbg:находящСеВ geographbg:ОбластПерник .

geographbg:ПланинаЛисец a geographbg:Планина ; rdfs:label "Лисец (планина)"@bg .

# --- Баташки водносилов път ---
geographbg:КаскадаБаташкиВодносиловПът a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Баташки водносилов път"@bg ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "226"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:произвеждаСредногодишно [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "796000000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Киловатчас
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1959-09-06"^^xsd:date ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "761"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:включваСъоръжение geographbg:ВЕЦБатак, geographbg:ВЕЦПещера, geographbg:ВЕЦАлеко,
        geographbg:ЯзовирШирокаПоляна, geographbg:ЯзовирГолямБеглик, geographbg:ЯзовирБатак,
        geographbg:ЯзовирБеглика, geographbg:ЯзовирТошковЧарк, geographbg:ХидровъзелШирокаПоляна, geographbg:ХидровъзелГолямБеглик ;
    geographbg:еПроектиранОт geographbg:Енергохидропроект ;
    geographbg:еПостроенОт geographbg:Хидрострой ;
    geographbg:имаОписание "Една от първите хидроенергийни каскади в България. Включва три основни и четири по-малки водохранилища, три водноелектрически централи и два пояса от събирателни деривации."@bg .

geographbg:ВЕЦБатак a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Батак"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "46.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еЗавършенПрез "1958"^^xsd:integer ;
    geographbg:имаОписание "Първата подземна електроцентрала в България."@bg .

geographbg:ВЕЦПещера a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Пещера"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:еВъведенВЕксплоатацияНа "1959"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "136"^^xsd:decimal ; # След реконструкция
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:имаОписание "Подземна електроцентрала."@bg .

geographbg:ВЕЦАлеко a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Алеко"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:еВъведенВЕксплоатацияНа "1959"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "64.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:находящСеВ geographbg:СелоАлекоКонстантиново .

geographbg:ЯзовирШирокаПоляна a geographbg:Язовир ;
    rdfs:label "Широка поляна (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът, geographbg:ХидровъзелШирокаПоляна ;
    geographbg:еПостроенПрез "1959-1962" ; # Хидровъзелът
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "24000000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "4.3"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:находящСеВ geographbg:ЗападниРодопи ;
    geographbg:захранваСеОт geographbg:РекаКиреева, geographbg:ИзравнителДженевра, geographbg:ИзравнителБлатото ;
    geographbg:оттичаСеВ geographbg:ЯзовирГолямБеглик .

geographbg:ЯзовирГолямБеглик a geographbg:Язовир ;
    rdfs:label "Голям Беглик (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът, geographbg:ХидровъзелГолямБеглик ;
    geographbg:еПостроенПрез "1946-1951" ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "62100000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:находящСеВ geographbg:ЗападниРодопи ;
    geographbg:захранваСеОт geographbg:КриваРекаПритокДевинска, geographbg:ЯзовирШирокаПоляна, geographbg:ДеривацияБеглика ;
    geographbg:оттичаСеВ geographbg:ВЕЦБатак .

geographbg:ЯзовирБатак a geographbg:Язовир ;
    rdfs:label "Батак (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:еПостроенПрез "1954-1959" ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "310000000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
