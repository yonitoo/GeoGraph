geographbg:ДжумалПразник a geographbg:Събитие ;
    rdfs:label "Джумал (празник)"@bg ;
    geographbg:имаОписание "Кукерски празник в селата Попинци и Левски (Панагюрско), провеждан на Сирни заговезни. Пролетен празник за здраве и плодородие. Включва дървена конструкция „Джумал“, носена от мъже, придружена от маскирани „циганки“, „булка“, „младоженец“ и „крадец“."@bg ;
    geographbg:свързанС geographbg:ПопинциСело ;
    geographbg:свързанС geographbg:ЛевскиСелоПанагюрско ;
    geographbg:свързанС geographbg:ПанагюрскоОбласт .

