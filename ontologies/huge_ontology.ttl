geographbg:МаломальовишкиЕзера a geographbg:Езеро ; # Група езера
    rdfs:label "Маломальовишки езера"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:Рила ; # "в Мальовишкия дял на Северозападна Рила"
    geographbg:имаАлтернативноИме "Камилски езера"@bg .
geographbg:ГорноМаломальовишкоЕзеро a geographbg:Езеро ; # "Горното езеро"
    rdfs:label "Горно Маломальовишко езеро"@bg ;
    geographbg:находящСеВ geographbg:МаломальовишкиЕзера ; # Част от групата
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2118.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.0"^^xsd:decimal ; # "Площта му е 1 хектар"
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] .

geographbg:МусаленскиЕзера a geographbg:Езеро ; # Група езера
    rdfs:label "Мусаленски езера"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:Рила ; # "в Мусаленския циркус"
    geographbg:намираСеНаРека geographbg:БистрицаМусаленска . # "принадлежащи към басейна на река Боровецка Бистрица"

geographbg:ЛеденотоЕзеро a geographbg:Езеро ; # "Първо Мусаленско езеро ... Леденото езеро"
