geographbg:ХидровъзелШирокаПоляна a geographbg:Хидровъзел ;
    rdfs:label "Хидровъзел „Широка поляна“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:еПостроенПрез "1959-1962" ;
    geographbg:включваСъоръжение geographbg:ЯзовирШирокаПоляна, geographbg:ИзравнителДженевра, geographbg:ИзравнителКараджаДере, geographbg:ИзравнителБлатото .

geographbg:ХидровъзелГолямБеглик a geographbg:Хидровъзел ;
    rdfs:label "Хидровъзел „Голям Беглик“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБаташкиВодносиловПът ;
    geographbg:включваСъоръжение geographbg:ЯзовирГолямБеглик, geographbg:ЯзовирБеглика, geographbg:ЯзовирТошковЧарк, geographbg:ВЕЦБатак .

geographbg:ИзравнителДженевра a geographbg:Изравнител ;
    rdfs:label "Изравнител Дженевра"@bg ;
    geographbg:еЧастОт geographbg:ХидровъзелШирокаПоляна ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "90000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] .

geographbg:ИзравнителКараджаДере a geographbg:Изравнител ;
    rdfs:label "Изравнител Караджа дере"@bg ;
    geographbg:еЧастОт geographbg:ХидровъзелШирокаПоляна ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "121000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] .

geographbg:ИзравнителБлатото a geographbg:Изравнител ;
    rdfs:label "Изравнител Блатото"@bg ;
    geographbg:еЧастОт geographbg:ХидровъзелШирокаПоляна ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "122000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] .

geographbg:ГлавнаНапорнаДеривацияВЕЦБатак a geographbg:Деривация ;
    rdfs:label "Главна напорна деривация на ВЕЦ Батак"@bg ;
    geographbg:имаДължина [
         a geographbg:КоличественаСтойност ;
         geographbg:имаСтойност "11.7"^^xsd:decimal ;
         geographbg:имаМернаЕдиница geographbg:Километър
    ] .

geographbg:ДеривацияБеглика a geographbg:Деривация ; rdfs:label "Събирателна деривация Беглика"@bg .
geographbg:ДеривацияГашна a geographbg:Деривация ; rdfs:label "Събирателна деривация Гашна"@bg .
geographbg:ДеривацияНоваМахала a geographbg:Деривация ; rdfs:label "Събирателна деривация Нова махала"@bg .
geographbg:ДеривацияБистрицаБП a geographbg:Деривация ; rdfs:label "Събирателна деривация Бистрица (Баташки път)"@bg .
geographbg:ДеривацияРавногор a geographbg:Деривация ; rdfs:label "Събирателна деривация Равногор"@bg .

# --- Безбожка река ---
geographbg:РекаБезбожка a geographbg:Река ;
    rdfs:label "Безбожка река"@bg ;
    geographbg:имаАлтернативноИме "Дуиловица"@bg ;
    geographbg:находящСеВ geographbg:СеверенПирин ;
    geographbg:извираОт geographbg:ЕзероБезбожко ;
    geographbg:еПритокНа geographbg:РекаМеста ;
    geographbg:вливаСеВ geographbg:РекаМеста ; # В местността Лушин
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "16"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаНадморскаВисочина [ # Средна за реката
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1375"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .
geographbg:ЕзероБезбожко a geographbg:Езеро ; rdfs:label "Безбожко езеро"@bg ; geographbg:находящСеВ geographbg:СеверенПирин .

# --- Бела Места ---
geographbg:РекаБелаМеста a geographbg:Река ;
    rdfs:label "Бела Места"@bg ;
    geographbg:имаАлтернативноИме "Ропалица"@bg ; # В горното течение
    geographbg:находящСеВ geographbg:ОбщинаЯкоруда ;
    geographbg:еСъставящаНа geographbg:РекаМеста ; # Дясна
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "19.7"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:РопалишкиЕзера ;
    geographbg:нвНаИзвор [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2690"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "82.6"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.73"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при местността Меча дупка"
    ] ;
    geographbg:имаПриток geographbg:РекаГрънчарица, geographbg:РекаЯнчова, geographbg:РекаКазанишка .
geographbg:РопалишкиЕзера a geographbg:ЕзернаГрупа ; rdfs:label "Ропалишки езера"@bg ; geographbg:находящСеВ geographbg:ИзточнаРила .

# --- Белишка река (приток на Места) ---
geographbg:РекаБелишка a geographbg:Река ;
    rdfs:label "Белишка река (приток на Места)"@bg ;
    geographbg:имаАлтернативноИме "Карааланица"@bg ; # В горното течение
    geographbg:находящСеВ geographbg:ОбщинаБелица ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # До с. Краище
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "768"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "22.9"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ЧернополянскоЕзеро ;
    geographbg:нвНаИзвор [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2397"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "134"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.49"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "в устието"
    ] .
geographbg:ЧернополянскоЕзеро a geographbg:Езеро ; rdfs:label "Чернополянско езеро"@bg ; geographbg:находящСеВ geographbg:СреднаРила .

# --- Бистрица (Чечка) ---
geographbg:РекаБистрицаЧеч a geographbg:Река ;
    rdfs:label "Бистрица (Чечка)"@bg ;
    geographbg:имаАлтернативноИме "Чечка Бистрица"@bg, "Плетска река"@bg, "Плетенска река"@bg, "Пърдиконско дере"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаГърмен, geographbg:ОбщинаСатовча, geographbg:ОбщинаХаджидимово ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Ляв
    geographbg:вливаСеВ geographbg:РекаМеста ; # Северно от с. Теплен
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "443"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "48.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:РидДъбраш ;
        rdfs:comment "1,6 km североизточно от връх Свети Петър" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1695"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "197"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
geographbg:ВръхСветиПетърРодопи a geographbg:ПланинскиВръх ; rdfs:label "Свети Петър (връх в Дъбраш)"@bg ; geographbg:находящСеВ geographbg:РидДъбраш .

# --- Брезнишка река ---
geographbg:РекаБрезнишка a geographbg:Река ;
    rdfs:label "Брезнишка река"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаГоцеДелчев ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # Западно от с. Балдево
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "524"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ГорноБрезнишкоЕзеро ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "123"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.42"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при село Брезница"
    ] .
geographbg:ГорноБрезнишкоЕзеро a geographbg:Езеро ; rdfs:label "Горно Брезнишко езеро"@bg ; geographbg:находящСеВ geographbg:Пирин . # Брезнишки циркус

# --- Буровица ---
geographbg:РекаБуровица a geographbg:Река ;
    rdfs:label "Буровица"@bg ;
    geographbg:имаАлтернативноИме "Хамбарица"@bg ; # В горното течение
    geographbg:находящСеВ geographbg:ОбщинаХаджидимово, geographbg:ПланинаСлавянка ;
    geographbg:еПритокНа geographbg:РекаМътницаПирин ;
    geographbg:вливаСеВ geographbg:РекаМътницаПирин ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "626"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "13"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ВръхКойнар ; # Подножието
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "56"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "0.6"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "в устието"
    ] .
geographbg:ВръхКойнар a geographbg:ПланинскиВръх ; rdfs:label "Койнар (връх)"@bg ; geographbg:находящСеВ geographbg:ПланинаСлавянка .

# --- Бъндерица (река) ---
geographbg:РекаБъндерица a geographbg:Река ;
    rdfs:label "Бъндерица (река)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБанско ;
    geographbg:еСъставящаНа geographbg:РекаГлазне ; # Лява
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "13"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ГорноБъндеришкоЕзеро ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "37"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
geographbg:ГорноБъндеришкоЕзеро a geographbg:Езеро ; rdfs:label "Горно Бъндеришко езеро"@bg ; geographbg:находящСеВ geographbg:СеверенПирин . # Бъндеришки циркус

# --- Валявица (река) ---
geographbg:РекаВалявица a geographbg:Река ;
    rdfs:label "Валявица (река)"@bg ;
    geographbg:находящСеВ geographbg:СеверенПирин ;
    geographbg:извираОт geographbg:ВалявишкиЕзера ;
    geographbg:еСъставящаНа geographbg:РекаДемяница .

# --- Валявишки езера ---
geographbg:ВалявишкиЕзера a geographbg:ЕзернаГрупа ;
    rdfs:label "Валявишки езера"@bg ;
    geographbg:находящСеВ geographbg:СеверенПирин ; # Валявишки циркус
    geographbg:имаНадморскаВисочина "2300-2475 m" ;
    geographbg:оттичаСеВ geographbg:РекаВалявица .
geographbg:ГолямоВалявишкоЕзеро a geographbg:Езеро ;
    rdfs:label "Голямо Валявишко езеро"@bg ;
    geographbg:еЧастОт geographbg:ВалявишкиЕзера ;
    geographbg:имаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2379"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "8.51"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаДълбочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "18.9"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

# --- Вищерица ---
geographbg:РекаВищерица a geographbg:Река ;
    rdfs:label "Вищерица"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБанско, geographbg:ОбщинаГърмен ;
    geographbg:еПритокНа geographbg:РекаКанина ; # Десен
    geographbg:вливаСеВ geographbg:РекаКанина ; # В местността Гатера
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1151"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "24"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:РидДъбраш ;
        rdfs:comment "1,7 km северозападно от връх Каракая" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1586"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "80"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
geographbg:ВръхКаракая a geographbg:ПланинскиВръх ; rdfs:label "Каракая (връх в Дъбраш)"@bg ; geographbg:находящСеВ geographbg:РидДъбраш .

# --- Глазне ---
geographbg:РекаГлазне a geographbg:Река ;
    rdfs:label "Глазне"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБанско, geographbg:ОбщинаРазлог ;
    geographbg:еПритокНа geographbg:РекаИзток ; # Десен
    geographbg:вливаСеВ geographbg:РекаИзток ; # СИ от с. Баня
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "771"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "11"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър ;
        rdfs:comment "след образуването си"
    ] ;
    geographbg:образуваСеОт geographbg:РекаБъндерица, geographbg:РекаДемяница ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "119"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2.03"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при село Баня"
    ] .

# --- Демяница (река) ---
geographbg:РекаДемяница a geographbg:Река ;
    rdfs:label "Демяница (река)"@bg ;
    geographbg:находящСеВ geographbg:Пирин ;
    geographbg:извираОт geographbg:ВалявишкиЕзера ; # Под името Валявица
    geographbg:нвНаИзвор [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2400"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:еСъставящаНа geographbg:РекаГлазне ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "13.5"^^xsd:decimal ; # Приблизително, 13-14 km
        geographbg:имаМернаЕдиница geographbg:Километър ;
        rdfs:comment "до сливане с Бъндерица"
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "37"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:имаПриток geographbg:РекаВасилашка, geographbg:РекаГазейска, geographbg:РекаКъркъмска, geographbg:РекаЮлен .

# --- Дисилица (река) ---
geographbg:РекаДисилица a geographbg:Река ;
    rdfs:label "Дисилица (река)"@bg ;
    geographbg:имаАлтернативноИме "Добринищка река"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБанско ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # До моста за с. Елешница
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "705"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "21"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ДисилишкоЕзеро ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "57"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаПлешка, geographbg:РекаБуковец .
geographbg:ДисилишкоЕзеро a geographbg:Езеро ; rdfs:label "Дисилишко езеро"@bg ; geographbg:находящСеВ geographbg:Пирин . # Полежански циркус

# --- Каскада „Белмекен-Сестримо-Чаира“ ---
geographbg:КаскадаБелмекенСестримоЧаира a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Каскада „Белмекен-Сестримо-Чаира“"@bg ;
    geographbg:находящСеВ geographbg:ИзточнаРила, geographbg:ОбластПазарджик ;
    geographbg:еПостроенПрез "1964-1999" ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1599"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:произвеждаСредногодишно [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1002"^^xsd:decimal ; # 1995-2009
        geographbg:имаМернаЕдиница geographbg:Гигаватчас
    ] ;
    geographbg:включваСъоръжение geographbg:ЯзовирБелмекен, geographbg:ПАВЕЦБелмекен, geographbg:ПАВЕЦЧаира,
        geographbg:ЯзовирСтанковиБараки, geographbg:ЯзовирЧаира, geographbg:ВЕЦСестримо, geographbg:ВЕЦМоминаКлисура .

geographbg:ЯзовирБелмекен a geographbg:Язовир ;
    rdfs:label "Белмекен (язовир)"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:находящСеВ geographbg:ИзточнаРила ;
    geographbg:имаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1923"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "144100000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "4.6"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:захранваСеОт geographbg:РекаКриваРила, geographbg:ДеривацияГрънчар, geographbg:ДеривацияДжаферица, geographbg:ДеривацияМарица1900 ;
    geographbg:оттичаСеВ geographbg:ПАВЕЦБелмекен, geographbg:ПАВЕЦЧаира .

geographbg:ПАВЕЦБелмекен a geographbg:ПомпеноАкумулиращаВодноелектрическаЦентрала ;
    rdfs:label "ПАВЕЦ „Белмекен“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "375"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ЯзовирБелмекен ;
    geographbg:оттичаСеВ geographbg:ЯзовирСтанковиБараки .

geographbg:ПАВЕЦЧаира a geographbg:ПомпеноАкумулиращаВодноелектрическаЦентрала ;
    rdfs:label "ПАВЕЦ „Чаира“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "864"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ЯзовирБелмекен ;
    geographbg:оттичаСеВ geographbg:ЯзовирЧаира .

geographbg:ВЕЦСестримо a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Сестримо“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "240"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1975"^^xsd:integer ;
    geographbg:захранваСеОт geographbg:ЯзовирСтанковиБараки ;
    geographbg:оттичаСеВ geographbg:ВЕЦМоминаКлисура . # По-точно към нейния горен изравнител

geographbg:ВЕЦМоминаКлисура a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Момина клисура“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "120"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1975"^^xsd:integer ;
    geographbg:захранваСеОт geographbg:ВЕЦСестримо ; # Водите от
    geographbg:оттичаСеВ geographbg:ЯзовирПясъчник .

# --- Каскада „Доспат-Въча“ ---
geographbg:КаскадаДоспатВъча a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Каскада „Доспат-Въча“"@bg ;
    geographbg:находящСеВ geographbg:ЗападниРодопи ;
    geographbg:еПостроенПрез "1963-2010" ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "495"^^xsd:decimal ; # или 489 MW
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еСобственостНа geographbg:НЕК ;
    geographbg:еПостроенОт geographbg:Хидрострой ;
    geographbg:включваСъоръжение geographbg:ЯзовирДоспат, geographbg:ВЕЦТешел, geographbg:ЯзовирТешел, geographbg:ВЕЦДевин,
        geographbg:ЯзовирЦанковКамък, geographbg:ВЕЦЦанковКамък, geographbg:ЯзовирВъча, geographbg:ПАВЕЦОрфей,
        geographbg:ЯзовирКричим, geographbg:ВЕЦКричим, geographbg:ВЕЦВъча2, geographbg:ВЕЦВъча1 .

geographbg:ВЕЦТешел a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Тешел“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатВъча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "60"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1972"^^xsd:integer ;
    geographbg:захранваСеОт geographbg:ЯзовирДоспат ;
    geographbg:оттичаСеВ geographbg:ЯзовирТешел .

geographbg:ВЕЦДевин a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Девин“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатВъча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "88"^^xsd:decimal ; # След модернизация
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1984"^^xsd:integer ;
    geographbg:захранваСеОт geographbg:ЯзовирТешел, geographbg:РекаТриградска, geographbg:РекаМугленска ;
    geographbg:оттичаСеВ geographbg:ЯзовирЦанковКамък . # По коритото на Въча

geographbg:ВЕЦЦанковКамък a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Цанков камък“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатВъча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "85"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ЯзовирЦанковКамък ;
    geographbg:оттичаСеВ geographbg:ЯзовирВъча . # По коритото на Въча

geographbg:ПАВЕЦОрфей a geographbg:ПомпеноАкумулиращаВодноелектрическаЦентрала ;
    rdfs:label "ПАВЕЦ „Орфей“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатВъча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "160"^^xsd:decimal ; # 4x40 MW
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ЯзовирВъча ;
    geographbg:оттичаСеВ geographbg:ЯзовирКричим . # И използва води от него за помпен режим

geographbg:ВЕЦКричим a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Кричим“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатВъча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "80"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:еВъведенВЕксплоатацияНа "1973"^^xsd:integer ;
    geographbg:захранваСеОт geographbg:ЯзовирКричим .

# --- Каскада „Доспат“ (планирана) ---
geographbg:КаскадаДоспатПланирана a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Каскада „Доспат“ (планирана)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаДоспат, geographbg:ОбщинаСатовча ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "7750"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Киловат
    ] ;
    geographbg:включваСъоръжение geographbg:ВЕЦЦрънча . # И други ВЕЦ 1-6, ВЕЦ Бръщен

geographbg:ВЕЦЦрънча a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ „Црънча“"@bg ;
    geographbg:еЧастОт geographbg:КаскадаДоспатПланирана ;
    geographbg:еПостроенПрез "2010-2011" ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "3000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Киловат
    ] .

# --- Кочанска река (България) ---
geographbg:РекаКочанска a geographbg:Река ;
    rdfs:label "Кочанска река (България)"@bg ;
    geographbg:имаАлтернативноИме "Жижевска река"@bg, "Жижовска река"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаСатовча ;
    geographbg:еПритокНа geographbg:РекаДоспат ; # Десен
    geographbg:вливаСеВ geographbg:РекаДоспат ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "585"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "15.7"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ИзворКочан ; # Карстов, реално от Чарджик/Събътъка/Изора
    geographbg:имаПриток geographbg:РекаМарулевска .
geographbg:ИзворКочан a geographbg:Извор ; rdfs:label "Карстов извор северно от село Кочан"@bg .

# --- Крушевска река (Гърция) ---
geographbg:РекаКрушевскаГърция a geographbg:Река ;
    rdfs:label "Крушевска река (Гърция)"@bg ;
    geographbg:имаАлтернативноИме "Крушовица"@bg, "Вангелина река"@bg ; # Вангелина в горното течение
    geographbg:находящСеВ "Гърция" ;
    geographbg:еПритокНа geographbg:РекаЛещенска ; # Десен
    geographbg:вливаСеВ geographbg:РекаЛещенска .

# --- Мътница (приток на Места) ---
geographbg:РекаМътницаПирин a geographbg:Река ;
    rdfs:label "Мътница (приток на Места)"@bg ;
    geographbg:имаАлтернативноИме "Буланък"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаХаджидимово ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # ЮИ от гр. Хаджидимово
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "457"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "31"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ЮженПирин ;
        rdfs:comment "1 km североизточно от връх Моторок" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1685"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "176"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаБуровица .

# --- Осинска река ---
geographbg:РекаОсинска a geographbg:Река ;
    rdfs:label "Осинска река"@bg ;
    geographbg:извираОт geographbg:РидДъбраш ; # Местността Чарджик
    geographbg:еПритокНа geographbg:РекаДоспат ;
    geographbg:вливаСеВ geographbg:РекаДоспат ; # Между Црънча и Бръщен
    geographbg:оттичаСеВ geographbg:ЯзовирДоспат . # Част от водите

# --- Превалски езера ---
geographbg:ПревалскиЕзера a geographbg:ЕзернаГрупа ;
    rdfs:label "Превалски езера"@bg ;
    geographbg:находящСеВ geographbg:СеверенПирин ; # Превалски циркус
    geographbg:оттичаСеВ geographbg:ПревалскиПоток .
geographbg:ПревалскиПоток a geographbg:Река ; rdfs:label "Превалски поток"@bg ; geographbg:еПритокНа geographbg:РекаВалявица .

# --- Ретиже ---
geographbg:РекаРетиже a geographbg:Река ;
    rdfs:label "Ретиже"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБанско ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # При с. Места
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "646"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "18.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ПоповоезеренЦиркус ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "46"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.33"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "в устието"
    ] .
geographbg:ПоповоезеренЦиркус a geographbg:ПланинскиЦиркус ; rdfs:label "Поповоезерен циркус"@bg ; geographbg:находящСеВ geographbg:Пирин .

# --- Сърнена река ---
geographbg:РекаСърнена a geographbg:Река ;
    rdfs:label "Сърнена река"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБатак, geographbg:ОбщинаДоспат ;
    geographbg:еПритокНа geographbg:РекаДоспат ; # Ляв, най-голям
    geographbg:вливаСеВ geographbg:РекаДоспат ; # В с. Барутин
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1090"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "39.2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ВелийшкоВиденишкиДял ;
        rdfs:comment "650 метра южно от връх Пазартепе" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1780"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "181.1"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.919"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "в устието"
    ] .
geographbg:ВръхПазартепе a geographbg:ПланинскиВръх ; rdfs:label "Пазартепе (връх)"@bg ; geographbg:находящСеВ geographbg:ВелийшкоВиденишкиДял .

# --- Черна Места ---
geographbg:РекаЧернаМеста a geographbg:Река ;
    rdfs:label "Черна Места"@bg ;
    geographbg:имаАлтернативноИме "Софаница"@bg, "Ражавица"@bg ; # В горното течение
    geographbg:находящСеВ geographbg:ОбщинаЯкоруда ;
    geographbg:еСъставящаНа geographbg:РекаМеста ; # Лява
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "23.3"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ИзточнаРила ;
        rdfs:comment "между върховете Сивричал и Равни чал" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "2434"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "164"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.42"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при село Черна Места"
    ] .

# --- Изток (река) ---
geographbg:РекаИзток a geographbg:Река ;
    rdfs:label "Изток (река)"@bg ;
    geographbg:находящСеВ geographbg:Пирин ;
    geographbg:еПритокНа geographbg:РекаМеста ; # Десен
    geographbg:вливаСеВ geographbg:РекаМеста ; # При с. Баня
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "16.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ИзворИзворо ;
    geographbg:имаПриток geographbg:РекаРаковица, geographbg:РекаВалевичка, geographbg:РекаЯзо, geographbg:РекаБелаРекаРазлог, geographbg:РекаСедръч, geographbg:РекаДраглишка, geographbg:РекаГлазне .
geographbg:ИзворИзворо a geographbg:Извор ; rdfs:label "Изворо (карстов извор)"@bg ; geographbg:находящСеВ geographbg:Пирин .

