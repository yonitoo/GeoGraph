geographbg:ЯзовирСтудена
    rdfs:label "Язовир „Студена“"@bg ;
    geographbg:намираСеНаРека geographbg:Струма ;
    geographbg:намираСеВЗемлищетоНа geographbg:Студена, geographbg:Кладница, geographbg:Боснек ;
