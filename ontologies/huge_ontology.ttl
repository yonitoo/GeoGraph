        geographbg:имаСтойност "864"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Свързва най-югозападната част на Софийската котловина при квартал Княжево с най-източната част на Пернишката котловина при село Драгичево. Преминава през Владайския пролом на Владайска река."@bg ;
    geographbg:държава geographbg:България .

