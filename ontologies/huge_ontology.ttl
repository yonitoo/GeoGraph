geographbg:БукапреслапскаСедловина a geographbg:Седловина ;
    rdfs:label "Букапреслапска седловина"@bg ;
    geographbg:свързва geographbg:ВерилаПланина, geographbg:Витоша ;
    geographbg:находящСеВ [ a geographbg:Община ; rdfs:label "Община Самоков"@bg ] ;
    geographbg:находящСеВ geographbg:СофийскаОбластБуновска ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1109"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Свързва най-северната част на Самоковската котловина на изток с югоизточната част на Радомирската котловина на запад."@bg ;
    geographbg:държава geographbg:България .

geographbg:РепубликанскиПътIII627 a geographbg:Път ;
    rdfs:label "Републикански път III-627"@bg ;
    geographbg:преминаваПрез geographbg:БукапреслапскаСедловина .

geographbg:ВладайскиПроход a geographbg:Проход ;
    rdfs:label "Владайски проход"@bg ;
    geographbg:свързва geographbg:ЛюлинПланина, geographbg:Витоша ;
    geographbg:находящСеВ geographbg:ОбластСофия ;
    geographbg:находящСеВ [ a geographbg:Област ; rdfs:label "Област Перник"@bg ] ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "9.4"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:надморскаВисочина [ # височина на седловината
