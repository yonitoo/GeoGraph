geographbg:ПланинаЩудер a geographbg:Планина ; rdfs:label "Щудер (планина)"@bg .
geographbg:ПланинаБоздаг a geographbg:Планина ; rdfs:label "Боздаг (планина)"@bg .
geographbg:РекаПанега a geographbg:Река ; rdfs:label "Панега"@bg .

# --- Карагьол ---
geographbg:ЯзовирКарагьол
    geographbg:находящСеВ "землището на село Бистрица (Дупнишко)"@bg ;
    geographbg:имаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2364.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:еСобственостНа geographbg:НЕК ;
    geographbg:еПостроенПрез "1949-1953" ;
    geographbg:типЯзовирнаСтена "бетонна гравитачна"@bg ;
    geographbg:височинаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "19.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:дължинаНаКоронаНаСтена [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "186"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2200000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "10"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:захранваСеОт "естествен водосбор"@bg, geographbg:ЯзовирКалин, "долен изравнител на ПАВЕЦ Калин (помпено)"@bg ;
    geographbg:използваСеЗа "електродобив"@bg, "водоснабдяване на Дупница"@bg .

# --- Каскада „Пиринска Бистрица“ ---
geographbg:КаскадаПиринскаБистрица a geographbg:ХидроенергийнаКаскада ;
    rdfs:label "Каскада „Пиринска Бистрица“"@bg ;
    geographbg:находящСеВПоречиетоНа geographbg:РекаПиринскаБистрица ;
    geographbg:находящСеВ geographbg:Пирин ;
    geographbg:еПостроенПрез "1979-1992" ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "134"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:включваСъоръжение geographbg:ВЕЦПирин, geographbg:ВЕЦСпанчево, geographbg:ИзравнителПирин, geographbg:ИзравнителСпанчево ;
    geographbg:еСобственостНа geographbg:ЕнергоПроБългарияОрганизация .

geographbg:ВЕЦПирин a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Пирин"@bg ;
    geographbg:еЧастОт geographbg:КаскадаПиринскаБистрица ;
    geographbg:еЗавършенПрез "1992"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "22"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ИзравнителПирин .

geographbg:ВЕЦСпанчево a geographbg:ВодноелектрическаЦентрала ;
    rdfs:label "ВЕЦ Спанчево"@bg ;
    geographbg:еЧастОт geographbg:КаскадаПиринскаБистрица ;
    geographbg:еЗавършенПрез "1981"^^xsd:integer ;
    geographbg:имаИнсталиранаМощност [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "28"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Мегават
    ] ;
    geographbg:захранваСеОт geographbg:ИзравнителСпанчево .

geographbg:ИзравнителПирин a geographbg:Изравнител ; rdfs:label "Изравнител Пирин"@bg ; geographbg:имаОбем [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "60000"^^xsd:decimal ;
    geographbg:имаМернаЕдиница geographbg:КубиченМетър
] .
geographbg:ИзравнителСпанчево a geographbg:Изравнител ; rdfs:label "Изравнител Спанчево"@bg ; geographbg:имаОбем [
    a geographbg:КоличественаСтойност ;
    geographbg:имаСтойност "35000"^^xsd:decimal ;
    geographbg:имаМернаЕдиница geographbg:КубиченМетър
] .
geographbg:ЕнергоПроБългарияОрганизация a geographbg:Организация ; rdfs:label "Енерго-Про България"@bg .
geographbg:РекаПиринскаБистрица a geographbg:Река ; rdfs:label "Бистрица (Пиринска)"@bg .

# --- Каскада „Рила“ ---
geographbg:КаскадаРила
    geographbg:находящСеВ geographbg:ЗападнаРила ;
    geographbg:еПостроенПрез "1924-" ; # Започва 1924
    geographbg:включваСъоръжение geographbg:ЯзовирМалъкКалин, geographbg:ЯзовирКалин, geographbg:ЯзовирКарагьол,
