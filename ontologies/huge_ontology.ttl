        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаЦърква geographbg:ЦъркваСветаБогородицаДостойноЕстьКранево .

geographbg:ЦъркваСветаБогородицаДостойноЕстьКранево a geographbg:Църква ;
    rdfs:label "Църква „Света Богородица – Достойно есть“ (Кранево)"@bg ;
    geographbg:осветенаНа "2019-06-08"^^xsd:date .

# --- Крапец (област Добрич) ---
geographbg:СелоКрапец
