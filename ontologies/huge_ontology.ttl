# Triples from "Автономна Македония (1920 – 1923)"
geographbg:АвтономнаМакедонияВестник1920 a owl:Thing ;
    rdfs:label "Автономна Македония (вестник, 1920-1923)"@bg ;
    geographbg:имаОписание "Български седмичен вестник, орган на македонската емиграция в България, излизал от 1920 до 1923 г. в София."@bg ;
    geographbg:свързанС geographbg:МакедонскаФедеративнаЕмигрантскаОрганизация ; # It was organ of МФО
    geographbg:свързанС geographbg:София .

# Triples from "Македонско съзнание"
geographbg:МакедонскоСъзнаниеВестник a owl:Thing ;
    rdfs:label "Македонско съзнание (вестник)"@bg ;
    geographbg:имаОписание "Български вестник, орган на Македонската федеративна организация, излизал във Виена (1923-1926) и по-късно в Белград."@bg ;
    geographbg:свързанС geographbg:МакедонскаФедеративнаЕмигрантскаОрганизация ;
    geographbg:свързанС geographbg:ВиенаГрад ;
    geographbg:свързанС geographbg:БелградГрад .

# Triples from "Независима Македония (1923 – 1926)"
