    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "503"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "36"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:РидДъбраш ;
        rdfs:comment "южното подножие на връх Свети Петър" ;
        geographbg:имаНадморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1726"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "234"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2.95"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда ;
        rdfs:comment "при село Огняново"
    ] ;
    geographbg:имаПриток geographbg:РекаВищерица .

# --- Карадере (река в Драмско) ---
geographbg:РекаКарадереДрамско a geographbg:Река ;
    rdfs:label "Карадере (река в Драмско)"@bg ;
    geographbg:находящСеВ "Гърция" ; # Драмско
    geographbg:извираОт geographbg:ВръхЧакал ; # Родопи
    geographbg:еПритокНа geographbg:РекаМъжделска ;
    geographbg:вливаСеВ geographbg:РекаМъжделска ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "12"^^xsd:decimal ; # Приблизително
        geographbg:имаМернаЕдиница geographbg:Километър
    ] .
geographbg:ВръхЧакал a geographbg:ПланинскиВръх ; rdfs:label "Чакал (връх)"@bg ; geographbg:находящСеВ geographbg:ЗападниРодопи . # Предполагаемо

# --- Кременска река ---
geographbg:РекаКременска a geographbg:Река ;
