geographbg:СазлийкаРека a geographbg:Река ;
    rdfs:label "Сазлийка (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:имаПриток geographbg:СоколицаРека ;
    rdfs:имаАлтернативноИме "Ракитница (река)"@bg ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "145.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Руя, Сърнена Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "651.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Топлиците"@bg, "Казанска река"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "3239.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
