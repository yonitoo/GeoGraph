        geographbg:имаСтойност "1160"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .
geographbg:ДоленАлековВодопад a geographbg:Водопад ;
    rdfs:label "Долен Алеков водопад"@bg ;
    geographbg:еСъставящаЧастНа geographbg:АлековиВодопади ;
