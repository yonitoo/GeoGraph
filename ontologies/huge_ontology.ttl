geographbg:БоснешкиКарстовРайон
    rdfs:label "Боснешки карстов район"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:находящСеВ [ a geographbg:Планина ; rdfs:label "Голо бърдо"@bg ] ;
    geographbg:намираСеНаРека geographbg:Струма ; # Upper course
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "30"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреднаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "900"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаГеология "Комплекс от карбонатни скали, формирани през триас, в които е врязан Пернишкият разломен сноп. Окарстените скали заемат около 23 км2."@bg ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркВитоша ;
    geographbg:държава geographbg:България .

geographbg:АлеяНаБоснешкияКарст a geographbg:Пътека ;
    rdfs:label "Алея на Боснешкия карст"@bg ;
    geographbg:находящСеВ geographbg:БоснешкиКарстовРайон ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "10"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] .

geographbg:ЖиватаВодаИзвор
    rdfs:label "Живата вода (извор, Боснек)"@bg ;
    geographbg:находящСеВ geographbg:БоснешкиКарстовРайон ;
    geographbg:находящСеВ geographbg:АлеяНаБоснешкияКарст ;
    geographbg:близоДо [ a geographbg:Село ; rdfs:label "Боснек (село)"@bg ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1070"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Сифонен карстов извор. Подхранва се от пукнатинни води. Водата изтича след напълване на пещерно резервоарче."@bg .

geographbg:БоянскаЦърква a geographbg:КултуренОбект ;
    rdfs:label "Боянска църква „Св. св. Никола и Пантелеймон“"@bg ;
    geographbg:находящСеВ geographbg:КварталБояна ;
    geographbg:близоДо geographbg:Витоша ;
    geographbg:имаОписание "Средновековна българска църква, паметник на ЮНЕСКО (1979 г.). Филиал на Националния исторически музей (2003 г.). Двуетажна църква-гробница. Състои се от три, строени по различно време, постройки. Стенописи от XI-XII в., 1259 г. (Боянски майстор), XIV в., XVI-XVII в. и 1882 г."@bg ;
    geographbg:държава geographbg:България .

geographbg:БоянскиВодопад a geographbg:Водопад ;
    rdfs:label "Боянски водопад"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:намираСеНаРека geographbg:БоянскаРека ;
    geographbg:имаВисочинаНаПада [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1260"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Най-големият водопад във Витоша. Образуван от водите на Боянската река, спускащи се по северните склонове. Най-пълноводен при топене на снеговете. Замръзва през зимата. Обект за ледено катерене."@bg ;
    geographbg:държава geographbg:България .

geographbg:БоянскоЕзеро a geographbg:Езеро ;
    rdfs:label "Боянско езеро"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:КварталБояна ;
    geographbg:имаОписание "Изкуствено езеро. Създадено при построяването на Витошкия водопровод на София през 1906 г. Преди това е било блато."@bg ;
    geographbg:основанПрезГодина "1906"^^xsd:integer ;
    geographbg:близоДо geographbg:БоянскиВодопад ;
    geographbg:държава geographbg:България .

geographbg:КафяваКраставаЖаба a geographbg:ЖивотинскиВид ; rdfs:label "Кафява крастава жаба"@bg .
geographbg:ГолямаВоднаЖаба a geographbg:ЖивотинскиВид ; rdfs:label "Голяма водна жаба"@bg .
geographbg:МалъкГребенестТритон a geographbg:ЖивотинскиВид ; rdfs:label "Малък гребенест тритон"@bg .
geographbg:ГолямГребенестТритон a geographbg:ЖивотинскиВид ; rdfs:label "Голям гребенест тритон"@bg .
geographbg:БоянскоЕзеро geographbg:имаХарактеренЖивотинскиВид geographbg:КафяваКраставаЖаба, geographbg:ГолямаВоднаЖаба, geographbg:МалъкГребенестТритон, geographbg:ГолямГребенестТритон .

geographbg:БялатаВодаМестностСофия
    rdfs:label "Бялата вода (местност, София)"@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:София ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "983"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:КилиитеКварталСофия ;
    geographbg:близоДо geographbg:КварталБояна ;
    geographbg:находящСеВ [ a geographbg:Долина ; rdfs:label "Долина на приток на Владайска река"@bg ; geographbg:намираСеНаРека geographbg:ВладайскаРека ] ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркВитоша ;
    geographbg:имаОписание "Изградени две чешми и малка зона за почивка на популярната туристическа пътека от Княжево до Златните мостове."@bg ;
    geographbg:държава geographbg:България .

geographbg:ЗлатнитеМостове
    rdfs:label "Златните мостове"@bg ;
    geographbg:имаАлтернативноИме "Морените"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1425"^^xsd:decimal ; # Average of 1350-1500
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:намираСеНаРека geographbg:ВладайскаРека ;
    geographbg:имаОписание "Представлява най-голямата каменна река в района на Витоша. Името идва от лишеите със златист цвят или от златен пясък."@bg ;
    geographbg:държава geographbg:България .

geographbg:Копитото
    rdfs:label "Копитото (местност)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:София ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1345"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Разположена точно над град София. Намира се телевизионна кула Копитото и хотел „Копитото“."@bg ;
    geographbg:имаГеографскаШирина "42.636349"^^xsd:decimal ;
    geographbg:имаГеографскаДължина "23.243741"^^xsd:decimal ;
    geographbg:държава geographbg:България .

geographbg:ТелевизионнаКулаКопитото geographbg:основанПрезГодина "1985"^^xsd:integer . # Built in 1985, not 1986 as in previous extraction.
geographbg:ХотелКопитото a geographbg:Хотел ;
    rdfs:label "Хотел „Копитото“"@bg ;
    geographbg:находящСеВ geographbg:Копитото .

geographbg:ЛифтКняжевоКопитото a geographbg:Лифт ;
    rdfs:label "Лифт Княжево – Копитото"@bg ;
    geographbg:свързва geographbg:КварталКняжево, geographbg:Копитото ;
    geographbg:основанПрезГодина "1962"^^xsd:integer ;
    geographbg:имаОписание "Първият кабинков лифт в България, произведен от австрийската фирма „Братя Гирак/Girak“. Дължина 1920 m, с разлика във височините 600 m. Разполагал е с 53 четириместни кабини и е превозвал по 600 души на час в посока със скорост 3 m/s. Не работи от началото на 90-те."@bg ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.92"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] .

geographbg:ДрагалевскиМанастир
    rdfs:label "Драгалевски манастир „Успение Богородично“"@bg ;
    geographbg:имаАлтернативноИме "Света Богородица Витошка"@bg, "Витошка пречиста Богоматер"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:КварталДрагалевци ;
    geographbg:намираСеНаРека [ a geographbg:Река ; rdfs:label "Драгалевска река"@bg ] ;
    geographbg:имаОписание "Български православен девически манастир. Комплекс от църква, жилищни и стопански сгради. Църквата е паметник на културата от национално значение."@bg ;
    geographbg:имаИстория "Основан от цар Иван Александър. Опожарен и запустял след 1382 г. В 1476 г. софийският болярин Радослав Мавър подновява и зографисва църквата. Център на Софийската книжовна школа (ХІV – ХVІ век). През 1818 г. църквата е разширена. Васил Левски многократно отсяда в манастира (1871-1872 г.). През 1932 г. църквата е разширена с добавянето на нов наос."@bg ;
    geographbg:държава geographbg:България .

geographbg:ДухлатаПещера a geographbg:Пещера, geographbg:ПрироднаЗабележителностСтатут ;
    rdfs:label "Духлата (пещера)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:намираСеНаРека geographbg:Струма ; # On its right bank
    geographbg:близоДо [ a geographbg:Село ; rdfs:label "Боснек (село)"@bg ] ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "18200"^^xsd:decimal ; # Taking the larger figure
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаМаксималнаДълбочина [ # Depth
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "53"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Втората по дължина пещера в страната. Сложна многоетажна, лабиринтна система (6 етажа). Създадена от подземните течения на река Струма. Включва тунели, галерии, подземни езера, водопади и синтрови образувания. Името се свързва със силния звук от вятъра през входа."@bg ;
    geographbg:обявенаСъсЗаповед "1962 г."@bg ;
    geographbg:имаФауна "Установени 22 вида пещерни животни, сред които 6 вида прилепи."@bg ;
    geographbg:държава geographbg:България .

geographbg:ЖиватаВодаИзвор
    rdfs:label "Живата вода (извор, Боснек)"@bg ;
    geographbg:находящСеВ geographbg:БоснешкиКарстовРайон ;
    geographbg:находящСеВ geographbg:ПрироденПаркВитоша ;
    geographbg:находящСеВ geographbg:АлеяНаБоснешкияКарст ;
    geographbg:близоДо [ a geographbg:Село ; rdfs:label "Боснек (село)"@bg ] ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1070"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Сифонен карстов извор. Подхранва се от пукнатинни води. Във вътрешността на скалите, зад извора, се намира пещерно разширение, което е свързано чрез сифонно каналче с извора. Водата изтича от извора, след като се напълни пещерното резервоарче до горното коляно на сифона."@bg ;
    geographbg:държава geographbg:България .

geographbg:КладнишкиМанастирСветиНиколай a geographbg:Манастир ;
    rdfs:label "Кладнишки манастир „Свети Николай“"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:Кладница ;
    geographbg:имаИстория "Възобновен в 1841 година от дядо Спас от село Мърчаево. Постоянно действащ."@bg ;
    geographbg:имаОписание "Комплекс от черква, жилищни и стопански сгради. Черквата е малка еднокорабна, едноапсидна сграда, с две конхи, без купол, построена през 1841 г., вътрешният притвор – 1866 г. Изографисана през 1883 г. от Косто Антикаров. Обявен за паметник на културата."@bg ;
    geographbg:държава geographbg:България .
geographbg:КладнишкиМанастирСветиНиколай geographbg:близоДо geographbg:КладнишкаКрепост .

geographbg:МърчаевскиМанастирСветаТроица a geographbg:Манастир ;
    rdfs:label "Мърчаевски манастир „Света Троица“"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо [ a geographbg:Село ; rdfs:label "Мърчаево (село)"@bg ] ;
    geographbg:имаОписание "Постоянно действащ девически манастир. Част от Софийската Света гора. Комплексът се състои от църквата „Света Троица“, параклис „Успение на Свети Йоан Рилски“, параклис „Света Богородица“, две жилищни сгради, открита трапезария и кладенец."@bg ;
    geographbg:имаИстория "Предполага се, че е основан през Второто българско царство или по-рано. Възстановен в началото на 1970-те години, отворен 1975 г. Иконостасът на църквата е дело на Петър Кушлев."@bg ;
    geographbg:държава geographbg:България .
geographbg:ПараклисУспениеНаСветиЙоанРилскиМърчаево a geographbg:КултуренОбект ;
    rdfs:label "Параклис „Успение на Свети Йоан Рилски“ (Мърчаево)"@bg ;
    geographbg:находящСеВ geographbg:МърчаевскиМанастирСветаТроица ;
    geographbg:основанПрезГодина "2008"^^xsd:integer .
geographbg:ПараклисСветаБогородицаМърчаево a geographbg:КултуренОбект ;
    rdfs:label "Параклис „Света Богородица“ (Мърчаево)"@bg ;
    geographbg:находящСеВ geographbg:МърчаевскиМанастирСветаТроица ;
    geographbg:основанПрезГодина "2021"^^xsd:integer .

geographbg:ПараклисПреображениеГосподнеБистрица a geographbg:КултуренОбект ;
    rdfs:label "Параклис „Свето Преображение Господне“ (Бистрица)"@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:СелоБистрицаСофия ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1840"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:близоДо geographbg:ХижаАлеко ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Меча поляна (Витоша)"@bg ] ;
    geographbg:имаОписание "Построен незаконно от частни лица през декември 2017 г. Довършен през пролетта на 2018 г. и подарен на БПЦ. Разположен върху имот публична държавна собственост."@bg ;
    geographbg:основанПрезГодина "2017"^^xsd:integer ;
    geographbg:държава geographbg:България .

geographbg:ТорфеноБранище a geographbg:Резерват ;
    rdfs:label "Торфено бранище"@bg ;
    geographbg:находящСеВ geographbg:ПрироденПаркВитоша ;
    geographbg:основанПрезГодина "1935"^^xsd:integer ;
    geographbg:обявенаСъсЗаповед "Заповед No.16362 на Министерството на народното стопанство от 01.10.1935 година"@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "785.3"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Целта е да се запазят торфените комплекси във високите части на Витоша. Дебелината на торфената покривка достига до 2 метра. Възраст на торфището над 1000 години. В района няма гори. Достъпът на туристи е забранен (вододайна зона)."@bg ;
    geographbg:извираОт geographbg:ВладайскаРека, geographbg:БоянскаРека, [ a geographbg:Река ; rdfs:label "Драгалевска река"@bg ] ;
    geographbg:държава geographbg:България .

geographbg:ИваРастение a geographbg:РастителенВид ; rdfs:label "Ива"@bg .
