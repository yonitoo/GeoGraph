geographbg:ЗаслонБайКръстьо geographbg:близоДо geographbg:ЗаслонКикиш .
geographbg:ЗаслонБайКръстьо geographbg:близоДо geographbg:ХижаКаменДел .
geographbg:ЗаслонБайКръстьо geographbg:близоДо geographbg:КоминитеВръх .
geographbg:ЗаслонБайКръстьо geographbg:близоДо geographbg:КаменДелВръх .

geographbg:БялатаВодаМестностСофия a geographbg:Местност ;
    rdfs:label "Бялата вода (местност, София)"@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:София ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "983"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:КилиитеКварталСофия ;
    geographbg:близоДо geographbg:КварталБояна ;
    geographbg:находящСеВ [ a geographbg:Долина ; rdfs:label "Долина на приток на Владайска река"@bg ; geographbg:намираСеНаРека geographbg:ВладайскаРека ] ;
    geographbg:частОтПрироденПарк geographbg:ПрироденПаркВитоша ;
    geographbg:имаОписание "Изградени две чешми и малка зона за почивка. Намира се на популярна туристическа пътека от Княжево до Златните мостове."@bg ;
    geographbg:държава geographbg:България .

geographbg:ЗлатнитеМостове a geographbg:Местност, geographbg:СкалноОбразувание ;
    rdfs:label "Златните мостове"@bg ;
    geographbg:имаАлтернативноИме "Морените"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1425"^^xsd:decimal ; # Average of 1350-1500
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:намираСеНаРека geographbg:ВладайскаРека ;
    geographbg:имаОписание "Представлява най-голямата каменна река в района на Витоша. Името идва от лишеите със златист цвят или от златен пясък."@bg ;
    geographbg:държава geographbg:България .

geographbg:Копитото a geographbg:Местност ;
    rdfs:label "Копитото"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:близоДо geographbg:София ;
    geographbg:надморскаВисочина [
