    geographbg:находящСеВ geographbg:НеврокопскаКаза .

# Triples from "Народни песни на македонските българи"
geographbg:НародниПесниНаМакедонскитеБългариСборник a owl:Thing ;
    rdfs:label "Народни песни на македонските българи (сборник)"@bg ;
    geographbg:имаОписание "Етнографски сборник с български народни песни, събрани от Стефан Веркович, издаден през 1860 г. в Белград."@bg ;
    geographbg:свързанС geographbg:БелградГрад .

geographbg:ПросеникСелоСярско a geographbg:Село ;
    rdfs:label "Просеник (Сярско)"@bg ;
    geographbg:находящСеВ geographbg:СярскаКаза . # Assuming Сярска каза

