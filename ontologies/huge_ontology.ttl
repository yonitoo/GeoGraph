# --- From "Кумруджа" ---
geographbg:КумруджаРека a geographbg:Река ;
    rdfs:label "Кумруджа"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:притокНа geographbg:СазлийкаРека ;
    # Length with Коленска река is 47km, Кумруджа itself is ~7km
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "47.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ; # Combined
    geographbg:еСъставящаЧастНа [ a geographbg:Река ; rdfs:label "Коленска река"@bg ;
        geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "Сърнена Средна гора, близо до връх Горяла могила"@bg ;
            geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "588.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
        ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "321.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:КоленаСело, geographbg:ГорноБотевоСело, geographbg:ПшеничевоСело, geographbg:ДаскалАтанасовоСело, geographbg:РадневоГрадБлатница .

