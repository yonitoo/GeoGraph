geographbg:МакоцевскаРека a geographbg:Река ;
    rdfs:label "Макоцевска река"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:извираОт geographbg:СтараПланина ; # "Главното Старопланинско било"
    geographbg:вливаСеВ geographbg:ЛесновскаРека ;
    geographbg:притокНа geographbg:ЛесновскаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "43.0"^^xsd:decimal ; # "Дължината ѝ е 43 km"
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "227.0"^^xsd:decimal ; # "Площта на водосборния басейн ... е 227 km2"
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
geographbg:СтараПланина a geographbg:Планина ; rdfs:label "Стара планина"@bg ; geographbg:държава geographbg:България .
geographbg:ЛесновскаРека geographbg:имаПриток geographbg:МакоцевскаРека .
