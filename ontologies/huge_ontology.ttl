# --- Брежанска река ---
geographbg:РекаБрежанска a geographbg:Река ;
    rdfs:label "Брежанска река"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаСимитли ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "15"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:comment "северозападни склонове на връх Пирин"
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "32"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "0.235"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:имаПриток geographbg:РекаГорещица ;
    geographbg:протичаПрез "землищата на селата Брежани и Полето"@bg ;
    geographbg:използваСеЗа "напояване"@bg .

geographbg:РекаГорещица a geographbg:Река ; rdfs:label "Горещица"@bg .

# --- Бутковска река ---
geographbg:РекаБутковска a geographbg:Река ;
    rdfs:label "Бутковска река"@bg ;
    geographbg:находящСеВ "Сярско, Егейска Македония, Гърция"@bg, geographbg:ПланинаБеласица, geographbg:ПланинаКруша ;
    geographbg:еПритокНа geographbg:РекаБелицаСярско ; # Традиционно в Струма, сега в Бутковско езеро
    geographbg:странаНаПритока "ляв"@bg ; # Спрямо Белица
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:ПланинаБеласица ;
        rdfs:comment "високо под гранична пирамида № 6"
    ] ;
    geographbg:вливаСеВ geographbg:ЕзероБутковско ;
    geographbg:мястоНаВливане "южно от Бутково"@bg ;
    geographbg:имаПриток geographbg:РекаЛикорема, geographbg:РекаСтараБутковска, geographbg:РекаКсиропотамосБутковска, geographbg:РекаКопривицаБутковска .

