# --- From "Чинардере" ---
geographbg:ЧинардереРека a geographbg:Река ;
    rdfs:label "Чинардере"@bg ;
    geographbg:държава geographbg:България ;
    # Област Пловдив, Област Хасково
    geographbg:притокНа geographbg:МечкаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "31.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Сини връх, Добростански рид, Западни Родопи"@bg ;
        geographbg:находящСеВ geographbg:ЗападниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1195.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "92.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ТополовоСело, geographbg:НовиИзворСело, geographbg:ДълбокИзворСело, geographbg:ПоройнаСело .

