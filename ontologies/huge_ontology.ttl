# --- From "Ивайловград (язовир)" ---
geographbg:ЯзовирИвайловград a geographbg:Язовир ;
    rdfs:label "Ивайловград (язовир)"@bg ;
    geographbg:находящСеВ geographbg:ИзточниРодопи ;
    geographbg:намираСеНаРека geographbg:Арда ;
    geographbg:частОтКаскада geographbg:КаскадаАрда ;
    geographbg:основанПрезГодина "1964"^^xsd:integer ; # 1959-1964
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "156700000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] ; # Real volume
    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "15.1"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] .
    # Dam height 73m, length 365m
geographbg:ВЕЦИвайловград a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Ивайловград"@bg ; geographbg:частОтКаскада geographbg:КаскадаАрда .

# --- From "Каранска река" ---
