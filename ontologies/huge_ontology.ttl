geographbg:ПАВЕЦОрфей a geographbg:ВЕЦ ; rdfs:label "ПАВЕЦ Орфей"@bg ; geographbg:частОтКаскада geographbg:КаскадаДоспатВъча .

# --- From "Гашня" ---
geographbg:ГашняРека a geographbg:Река ;
    rdfs:label "Гашня"@bg ;
    geographbg:държава geographbg:България ;
    # Област Пазарджик, Област Смолян
    geographbg:притокНа geographbg:ВъчаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "20.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "подножие на връх Баташки Снежник, Баташка планина"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "2018.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "54.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ЯзовирЦанковКамък .

geographbg:БаташкаПланина a geographbg:Планина ; rdfs:label "Баташка планина"@bg .
geographbg:БаташкиСнежникВръх a geographbg:ПланинскиВръх ; rdfs:label "Баташки Снежник"@bg .

# --- From "Главанска река" ---
geographbg:ГлаванскаРекаГлаванска a geographbg:Река ;
    rdfs:label "Главанска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Стара Загора, Област Хасково
