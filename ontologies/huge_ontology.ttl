    geographbg:находящСеВ geographbg:ЕгейскаМакедония ;
    geographbg:държава geographbg:Гърция .

geographbg:СолунскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Солунско"@bg .

geographbg:СредниРодопи a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Средни Родопи"@bg ;
    geographbg:находящСеВ geographbg:РодопиЕтнографскаОбласт .

geographbg:СлавищкаНосия
    rdfs:label "Славищка носия"@bg ;
    geographbg:имаОписание "Характерна за района на град Крива Паланка и околните села (областта Славище). Женската носия има белези на шопските носии: бяла плетена кошуля, дълъг черен шаяк, пояс от вълнена и конопена тъкан, скута с дребни шарки. Зимните облекла включват безръкавно джубе."@bg ;
    geographbg:свързанС geographbg:СлавищеОбласт ;
    geographbg:свързанС geographbg:Шоплук .

geographbg:КриваПаланкаГрад a geographbg:Град ;
    rdfs:label "Крива Паланка"@bg ;
    geographbg:находящСеВ geographbg:СлавищеОбласт .

geographbg:СлавищеОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Славище"@bg .

geographbg:СевероизточнаБългарияЕтнографскаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Североизточна България (етнографска област)"@bg .

geographbg:СреднаЗападнаБългарияЕтнографскаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Средна Западна България (етнографска област)"@bg .

geographbg:ТиквешкаНосия
    rdfs:label "Тиквешка носия"@bg ;
    geographbg:имаОписание "Българска носия от областта Тиквеш. Част от средновардарските народни носии (източномакедонски тип). Преходна, свързва се с носиите от Велешко и Гевгелийско. Женската лятна невестинска носия включва кошуля, пояс, бохча (скутале), сагия, чорапи, подлактици, кърпа за глава, гердан. Мъжката лятна носия включва кошуля, пояс, фустан, гащи, чорапи, сагия."@bg ;
    geographbg:свързанС geographbg:ТиквешОбласт ;
    geographbg:свързанС geographbg:СредновардарскиНародниНосии ;
    geographbg:свързанС geographbg:ВелешкоОбласт ;
    geographbg:свързанС geographbg:ГевгелийскоОбласт .

geographbg:ТиквешОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Тиквеш (област)"@bg ;
    geographbg:находящСеВ geographbg:СевернаМакедония .

geographbg:СредновардарскиНародниНосии
    rdfs:label "Средновардарски народни носии"@bg ;
    geographbg:свързанС geographbg:ИзточномакедонскиТипНосии .

geographbg:ИзточномакедонскиТипНосии
    rdfs:label "Източномакедонски тип носии"@bg .

geographbg:ВелешкоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Велешко (област)"@bg .

geographbg:ГевгелийскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Гевгелийско (област)"@bg .

geographbg:ТрънскаНосия
    rdfs:label "Трънска носия"@bg ;
    geographbg:имаОписание "Народна носия от Трънско, Краище и Знеполе, част от белодрешковските народни облекла. Женската носия включва сукман (литак), алавицита (праведници), пъстроцветни престилки, тканица (колан), вълнени чорапи и опинци. Мъжката носия (билетите) включва беневреци (бременци), кошули, доранче, пояс и капа."@bg ;
    geographbg:свързанС geographbg:БелодрешнаНосия ;
    geographbg:свързанС geographbg:КраищеОбласт ;
    geographbg:свързанС geographbg:ЗнеполеОбласт ;
    geographbg:свързанС geographbg:Трънско .

geographbg:КраищеОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Краище (област)"@bg .

geographbg:ЗнеполеОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Знеполе"@bg .

geographbg:БългарскоНародноТворчество
    rdfs:label "Българско народно творчество"@bg ;
    geographbg:имаОписание "Общо наименование за произведенията на изкуството и постиженията на културата, предаващи се традиционно от поколение на поколение българи. Включва български народни приказки, легенди, пословици, поговорки, песни, танци, народни облекла и художествени мотиви за украса."@bg .

geographbg:LidovePovidkyJihomakedonske
    rdfs:label "Lidové povídky jihomakedonské"@bg ;
    geographbg:имаОписание "Етнографски сборник с български народни приказки, предания и легенди, събрани от Стефан Веркович и издадени от Пьотър Лавров и Иржи Поливка в Прага в 1932 година. Съдържа едни от първите записи на български вълшебни приказки. Приказките са събрани от Христодул Божиков от село Висока (Лъгадинско поле) и други от села Лехово, Търли и Старчища."@bg ;
    geographbg:основанПрезГодина "1932"^^xsd:integer ;
    geographbg:свързанС geographbg:ВисокаСелоЛъгадинско ;
    geographbg:свързанС geographbg:ЛеховоСело ;
    geographbg:свързанС geographbg:ТърлиСело ;
    geographbg:свързанС geographbg:СтарчищаСело .

geographbg:ВисокаСелоЛъгадинско a geographbg:Село ;
