    ] .
geographbg:ГорскоСтопанствоВитиня a geographbg:Организация ;
    rdfs:label "Горско стопанство „Витиня“"@bg .
geographbg:МургашЛесопарк geographbg:стопанисваСеОт geographbg:ГорскоСтопанствоВитиня .

geographbg:КюстендилГрад a geographbg:Град ;
    rdfs:label "Кюстендил"@bg ;
    geographbg:държава geographbg:България .
geographbg:ХисарлъкаХълмКюстендил a geographbg:Хълм ;
    rdfs:label "Хисарлъка (хълм, Кюстендил)"@bg ;
    geographbg:находящСеВ geographbg:КюстендилГрад .
geographbg:ХисарлъкаЛесопаркКюстендил a geographbg:Парк, geographbg:Гора ;
    rdfs:label "Хисарлъка (лесопарк, Кюстендил)"@bg ;
    geographbg:находящСеВ geographbg:ХисарлъкаХълмКюстендил ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "130"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Залесен с иглолистна гора в края на XIX – началото на XX в. под ръководството на лесовъда Йордан Митрев. Преобладава черният бор, срещат се бял бор, ела, смърч, явор, цер, липа. Има алеи, кътове за отдих, детски и спортни площадки, чешми, хотели, ресторанти, зоопарк, параклис."@bg ;
    geographbg:държава geographbg:България .

geographbg:Ела a geographbg:РастителенВид ; rdfs:label "Ела"@bg .
geographbg:Явор a geographbg:РастителенВид ; rdfs:label "Явор"@bg .
geographbg:ХисарлъкаЛесопаркКюстендил geographbg:имаХарактеренРастителенВид geographbg:ЧеренБор, geographbg:БялБор, geographbg:Ела, geographbg:Смърч, geographbg:Явор, geographbg:Цер, geographbg:Липа .

geographbg:КрепостХисарлъкаКюстендил a geographbg:Крепост ;
    rdfs:label "Хисарлъка (крепост, Кюстендил)"@bg ;
    geographbg:находящСеВ geographbg:ХисарлъкаЛесопаркКюстендил ;
    geographbg:имаИстория "Късноантична и средновековна крепост, изградена в края на 4 – началото на 5 век. Поправяна през 6 в., преживява Първата и Втората българска държава и е съборена от османските завоеватели през 15 век."@bg .
geographbg:ЗоопаркКюстендил a geographbg:ИнфраструктуренОбект ;
    rdfs:label "Зоопарк (Кюстендил)"@bg ;
    geographbg:находящСеВ geographbg:ХисарлъкаЛесопаркКюстендил .
geographbg:ПараклисСветиЧетиридесетМъченициКюстендил a geographbg:КултуренОбект ;
    rdfs:label "Параклис „Свети четиридесет мъченици“ (Кюстендил)"@bg ;
    geographbg:находящСеВ geographbg:ХисарлъкаЛесопаркКюстендил .

geographbg:КожухВъзвишение a geographbg:Хълм, geographbg:ПрироднаЗабележителностСтатут ;
    rdfs:label "Кожух (възвишение)"@bg ;
    geographbg:имаОписание "Планинско възвишение от вулканичен произход. Представлява остатък от плиоценски вулканичен конус, неактивен от близо 1 милион години. Прорязан от север на юг от река Струма. Името идва от факта, че прилича на наметнат кожух."@bg ;
    geographbg:находящСеВ geographbg:СанданскоПетричкаКотловина ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаПлощ [ # Width as a proxy for area characteristic
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаГеология "Вулканични скали, предимно туфи и туфити. Личат газови каверни и ниши."@bg ;
    geographbg:имаКлимат "преходносредиземноморски"@bg ;
    geographbg:обявенаСъсЗаповед "1962 г. (0,4 ха), 1971 г. (увеличена на 94,2 ха)"@bg ;
    geographbg:държава geographbg:България .

geographbg:КожухВръх a geographbg:ПланинскиВръх ;
    rdfs:label "Кожух (връх)"@bg ;
    geographbg:находящСеВ geographbg:КожухВъзвишение ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "281.2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

