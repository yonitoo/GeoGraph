    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "57.1"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Голяма Сюткя, Баташка планина"@bg ;
