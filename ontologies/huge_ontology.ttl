    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "56.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Извор ; rdfs:label "извор-чешма, Същинска Средна гора"@bg ;
