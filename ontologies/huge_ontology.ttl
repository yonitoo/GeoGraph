geographbg:МургашЛесопарк a geographbg:Парк, geographbg:Гора ;
    rdfs:label "Мургаш (лесопарк)"@bg ;
    geographbg:близоДо geographbg:ДолинаНаРекаИскър ;
    geographbg:близоДо geographbg:ВеженВръх ;
    geographbg:имаПлощ [
