# --- Област Добрич ---
geographbg:ОбластДобрич a geographbg:Област ;
    rdfs:label "Област Добрич"@bg .

# --- Община Балчик ---
geographbg:ОбщинаБалчик a geographbg:Община ;
    rdfs:label "Община Балчик"@bg ;
    geographbg:находящСеВ geographbg:ОбластДобрич .

# --- Град Балчик ---
geographbg:ГрадБалчик a geographbg:Град ;
    rdfs:label "Балчик (град)"@bg ;
    geographbg:административенЦентърНа geographbg:ОбщинаБалчик ;
    geographbg:находящСеВ geographbg:ОбластДобрич ;
    geographbg:близоДо geographbg:КурортАлбена ;
    geographbg:имаЗабележителност geographbg:ДворецБалчик, geographbg:БотаническаГрадинаБалчик, geographbg:БалчишкаСолница ;
    geographbg:имаПристанище geographbg:ПристанищеБалчик ;
    geographbg:имаЛетище geographbg:ЛетищеБалчик ;
    geographbg:историческоИме "Круни"@bg, "Крунос"@bg, "Дионисополис"@bg, "Карвуна"@bg .

# --- Село Оброчище ---
geographbg:СелоОброчище a geographbg:Село ;
    rdfs:label "Оброчище (село)"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаБалчик .

# --- Резерват Балтата ---
geographbg:РезерватБалтата a geographbg:ПоддържанРезерват ;
    rdfs:label "Балтата (поддържан резерват)"@bg ;
    geographbg:находящСеВ "землището на с. Оброчище, община Балчик, област Добрич"@bg ;
    geographbg:обявенНа "1978-04-20"^^xsd:date ;
    geographbg:прекатегоризиранНа "1999-10-15"^^xsd:date ;
    geographbg:целНаОпазване "естествена лонгозна гора с принадлежащата и флора и фауна"@bg ;
    geographbg:обхващаПоречиетоНа geographbg:РекаБатова ;
    geographbg:имаОписание "най-северно разположената лонгозна гора в България"@bg ;
    geographbg:близоДо geographbg:КурортАлбена .

# --- Река Батова ---
geographbg:РекаБатова a geographbg:Река ;
    rdfs:label "Батова река"@bg ;
    geographbg:извираОт geographbg:ФрангенскоПлато ;
    geographbg:имаАлтернативноИме "Джевизлийска река"@bg ;
    geographbg:вливаСеВ geographbg:ЧерноМоре ;
    geographbg:мястоНаВливане "между Варна и Балчик"@bg ;
    geographbg:имаОписание "единствената непресъхваща река в добруджанския край"@bg ;
    geographbg:устиеТип "лиман"@bg .

geographbg:ФрангенскоПлато a geographbg:Плато ;
    rdfs:label "Франгенско плато"@bg .

geographbg:ЧерноМоре a geographbg:Море ;
    rdfs:label "Черно море"@bg .

# --- Балчишка солница ---
geographbg:БалчишкаСолница a geographbg:Езеро, geographbg:Курорт ;
    rdfs:label "Балчишка солница"@bg ;
    geographbg:типЕзеро "крайморско езеро (лиман)"@bg ;
    geographbg:образуваноВърху "свлачище"@bg ;
    geographbg:находящСеВ "северната част на българското Черноморие"@bg ;
    geographbg:разстояниеОтБалчик [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър ;
        rdfs:comment "източно от Балчик"
    ] ;
    geographbg:соленост [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "28-160"^^xsd:string ; # Range
        geographbg:имаМернаЕдиница [ rdfs:label "‰"@bg ] ;
        rdfs:comment "28‰ в източната до 160‰ в западната част"
    ] ;
    geographbg:дъноПокритоС "радиоактивна тиня"@bg ;
    geographbg:запасЛечебнаТиня [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "38000"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Тон
    ] ;
    geographbg:годишноОбразуванеНаКал [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "200"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Тон
    ] ;
    geographbg:имаСанаториум geographbg:СанаториумТузлата .

geographbg:СанаториумТузлата a geographbg:Санаториум ;
    rdfs:label "Специализирана болница за рехабилитация Тузлата"@bg ;
    geographbg:функционираОт "1955"^^xsd:integer ;
    geographbg:специализиранЗаЛечениеНа "заболявания на опорно-двигателния апарат, периферна и централна нервна система, кожни заболявания и заболявания на обмяната на веществата"@bg ;
    geographbg:използваВода geographbg:МинералнаВодаТузлата .

geographbg:МинералнаВодаТузлата a geographbg:МинералнаВода ;
    rdfs:label "Минерална вода от Тузлата"@bg ;
    geographbg:типВода "сулфидна, хипотермална, слабо минерализирана"@bg .

# --- Добротинска река ---
geographbg:ДобротинскаРека a geographbg:Река ;
    rdfs:label "Добротинска река"@bg ;
    geographbg:типРека "непостоянна река"@bg ;
    geographbg:находящСеВ geographbg:Лудогорие, geographbg:Добруджа ;
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:comment "3 km източно от село Пчелина"
    ] ;
    geographbg:вливаСеВ geographbg:ЕзероСребърна ;
    geographbg:еПритокНа geographbg:РекаДунав ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "92.9"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "964"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаОписание "губи водите си в средното течение, поради варовиковият и льосов терен"@bg .

geographbg:Лудогорие a geographbg:ГеографскаОбласт ; rdfs:label "Лудогорие"@bg .
geographbg:Добруджа a geographbg:ГеографскаОбласт ; rdfs:label "Добруджа"@bg .
geographbg:ЕзероСребърна a geographbg:Езеро ; rdfs:label "Сребърна (езеро)"@bg .
geographbg:РекаДунав a geographbg:Река ; rdfs:label "Дунав (река)"@bg .

# --- Дуранкулашка балта ---
geographbg:ДуранкулашкаБалта a geographbg:Блато ;
    rdfs:label "Дуранкулашка балта"@bg ;
    geographbg:имаАлтернативноИме "Блато Балтата"@bg, "Езеро Балтата"@bg ;
    geographbg:находящСеВ "черноморския бряг, източно от село Дуранкулак, северно от Дуранкулашкото езеро"@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1-1.2"^^xsd:string ; # Range
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:свързаноС geographbg:ОрловоБлато, geographbg:СтаевскоБлато ;
    geographbg:близоДо geographbg:КъмпингКосмос .

geographbg:СелоДуранкулак a geographbg:Село ; rdfs:label "Дуранкулак (село)"@bg .
geographbg:ДуранкулашкоЕзеро a geographbg:Езеро ; rdfs:label "Дуранкулашко езеро"@bg .
geographbg:ОрловоБлато a geographbg:Блато ; rdfs:label "Орлово блато"@bg .
geographbg:СтаевскоБлато a geographbg:Блато ; rdfs:label "Стаевско блато"@bg .
geographbg:КъмпингКосмос a geographbg:Къмпинг ; rdfs:label "Космос (къмпинг)"@bg .

# --- Лещава ---
geographbg:БлатоЛещава a geographbg:Блато ;
    rdfs:label "Лещава (блато)"@bg ;
    geographbg:типБлато "крайдунавско блато"@bg ;
    geographbg:находящСеВ geographbg:ОбластСилистра, geographbg:ОбщинаСитово ;
    geographbg:местоположение "в устието на суходолието Кулак, 2,5 km западно от село Попина, 1 km северно от село Гарван"@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2-2.283"^^xsd:string ; # Range
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаМаксималнаДълбочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаШирина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.3"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

geographbg:ОбластСилистра a geographbg:Област ; rdfs:label "Област Силистра"@bg .
geographbg:ОбщинаСитово a geographbg:Община ; rdfs:label "Община Ситово"@bg ; geographbg:находящСеВ geographbg:ОбластСилистра .

# --- Пожаревско блато ---
geographbg:ПожаревскоБлато a geographbg:Блато ;
    rdfs:label "Пожаревско блато"@bg ;
    geographbg:находящСеВ "край река Дунав, до село Пожарево, област Силистра"@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "32.58"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Често през лятото пресъхва."@bg ;
    geographbg:оттичаСеВ geographbg:РекаДунав .

geographbg:СелоПожарево a geographbg:Село ;
    rdfs:label "Пожарево (село, област Силистра)"@bg ;
    a geographbg:Село ;
    geographbg:находящСеВ geographbg:ОбластСилистра .

# --- Полезащитни горски пояси в Южна Добруджа ---
geographbg:ПолезащитниГорскиПоясиЮжнаДобруджа a geographbg:ИзкуственоНасаждение ;
    rdfs:label "Полезащитни горски пояси в Южна Добруджа"@bg ;
    geographbg:цел "борба с ветровата и водната ерозия, със сушата и суховеите"@bg ;
    geographbg:началоНаИзграждане "след 1925 г."@bg ;
    geographbg:първиПоясиСъвремененТип "1936-1939, землище на село Карвуна"@bg ;
    geographbg:регламентираноИзграждане "след 1951-03-08 (ПМС № 236)"@bg ;
    geographbg:общаПлощДобричкаОбласт [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "6510"^^xsd:decimal ; # 65.1 хил. дка = 6510 ха
