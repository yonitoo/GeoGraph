    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "Белчинска планина, 1.6 км ЮЗ от с. Клисура"@bg ;
        geographbg:находящСеВ [ a geographbg:Планина ; rdfs:label "Белчинска планина"@bg ; geographbg:находящСеВ geographbg:Рила ] ;
        geographbg:надморскаВисочина [
            a geographbg:КоличественаСтойност ;
            geographbg:имаСтойност "1250"^^xsd:decimal ;
            geographbg:имаМернаЕдиница geographbg:Метър
        ]
    ] ;
    geographbg:вливаСеВ geographbg:Джерман ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "254"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез [ a geographbg:Село ; rdfs:label "Крайници (село)"@bg ], [ a geographbg:Село ; rdfs:label "Червен брег (село, Дупница)"@bg ], geographbg:Яхиново ;
    geographbg:държава geographbg:България .

