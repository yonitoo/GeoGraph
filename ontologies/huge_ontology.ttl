# --- Влахина река ---
geographbg:РекаВлахинска a geographbg:Река ;
    rdfs:label "Влахинска река"@bg ;
    geographbg:имаАлтернативноИме "Влахина река"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград, geographbg:ОбщинаКресна, geographbg:Пирин ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "ляв"@bg ;
    geographbg:имаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "27"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт geographbg:ВлахиниЕзера ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:нвНаУстие [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "180"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:мястоНаВливане "300 m североизточно от град Кресна"@bg ;
    geographbg:имаПлощНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "108"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:имаПриток geographbg:РекаГредарска, geographbg:РекаГеоргийца, geographbg:РекаСинаница, geographbg:РекаШаралийска ;
    geographbg:имаСреденГодишенОтток [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.69"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетърВСекунда
    ] ;
    geographbg:протичаПрез geographbg:СелоВлахи ;
    geographbg:използваСеЗа "водоснабдяване на град Кресна"@bg .

geographbg:ВлахиниЕзера a geographbg:ЕзернаГрупа ; rdfs:label "Влахини езера"@bg ; geographbg:находящСеВ geographbg:Пирин .
