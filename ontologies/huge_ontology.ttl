    rdfs:label "Преброяване на населението в България (1956)"@bg ;
    geographbg:свързанС geographbg:България ;
    geographbg:имаОписание "Преброяване на населението на 1 декември 1956 г."@bg .

geographbg:КняжествоБългария a geographbg:АдминистративнаЕдиница ;
    rdfs:label "Княжество България"@bg ;
    geographbg:обхващаПериодОтДо "1878-1908" ;
    geographbg:частОтИсториятаНа geographbg:България .

geographbg:ЦарствоБългария a geographbg:АдминистративнаЕдиница ;
    rdfs:label "Царство България"@bg ;
    geographbg:обхващаПериодОтДо "1908-1946" ;
    geographbg:частОтИсториятаНа geographbg:България .

# --- Преброявания на населението ---
geographbg:ПреброяванеНаНаселението1956 a geographbg:Събитие ;
    rdfs:label "Преброяване на населението в България (1956)"@bg ;
    geographbg:проведеноЗа geographbg:България ;
    geographbg:датаНаПровеждане "1956-12-01"^^xsd:date ;
    geographbg:имаОписание "Преброяване на населението на 1 декември 1956 г."@bg ;
    geographbg:имаРегистрираноНаселение [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "7613709"^^xsd:integer ; # From table, text says 7 629 254
        geographbg:имаМернаЕдиница geographbg:БройЖители ;
        rdfs:comment "Общ брой на населението към преброяването от 1956 г."@bg
    ] .

