# --- From "Бяла река (приток на Луда река)" ---
geographbg:БялаРекаПритокЛудаРека a geographbg:Река ;
    rdfs:label "Бяла река (приток на Луда река)"@bg ;
    geographbg:държава geographbg:България ;
    # Област Кърджали, Област Хасково
    geographbg:притокНа geographbg:ЛудаРека ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "69.6"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "рид Мъгленик, Източни Родопи"@bg ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "660.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Коджадере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "594.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ЧерничевоСелоКрумовград, geographbg:БялградецСело, geographbg:ГугуткаСело, geographbg:МеденБукСело, geographbg:ДолноЛуковоСело, geographbg:МандрицаСело, geographbg:ОдринциСело .

geographbg:ЛудаРека a geographbg:Река ;
    rdfs:label "Луда река"@bg ;
    # Държава: България и Гърция
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "100.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ; # "над 100 km"
    geographbg:дължинаВБългария [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "20.2"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "рид Пеперуда, Източни Родопи, Гърция, близо до връх Шапка"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ; # Частично
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "870.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Шейтан (Луда река)"@bg, "Дяволорема"@bg ;
    geographbg:преминаваПрез geographbg:СивКладенецСело . # В България
    # В Гърция: Микрон Дерион, Авдела, Димотика
