geographbg:ЗлатнитеМостове a geographbg:Местност, geographbg:СкалноОбразувание ;
    rdfs:label "Златните мостове"@bg ;
    geographbg:имаАлтернативноИме "Морените"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:имаОписание "Разположена е на надморска височина от 1350 до 1500 метра в поречието на Владайската река."@bg ;
    geographbg:имаЕтимология "Името идва от лишеите със златист цвят, които покриват големите камъни. Според други източници името идва от златен пясък, който се е намирал тук преди време."@bg ;
    geographbg:близоДо geographbg:ВладайскаРека, geographbg:ЧерниВръх .

geographbg:КаменниГъбиБелиПласт a geographbg:СкалноОбразувание, geographbg:ПрироднаЗабележителностСтатут ;
    rdfs:label "Каменни гъби (Бели пласт)"@bg ;
    geographbg:имаАлтернативноИме "Мантаркая"@bg ;
    geographbg:близоДо geographbg:БелиПластСело ;
    geographbg:датаНаОбявяване "1974-05-13"^^xsd:date ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "3.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаОписание "Скалните образувания с формата на гъби са изваяни в риолитови вулканични туфи. Розовият цвят се дължи на минерала клоиноптилолит, а сините и черните петна са от манганови конкреции. Зеленикава багра идва от минерала селадонит. Самите скали са високи до 2,5 – 3 m."@bg ;
    geographbg:имаГеология "риолитови вулканични туфи"@bg ;
    geographbg:имаХарактеренЖивотинскиВид geographbg:ОрелЗмияр, geographbg:ЕгипетскиЛешояд, geographbg:ЧервенокръстаЛястовица, geographbg:ИспанскоКаменарче, geographbg:ОбикновеноКаменарче .

