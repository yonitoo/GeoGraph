geographbg:СофийскаКотловина a geographbg:Котловина ;
    rdfs:label "Софийска котловина"@bg ;
    geographbg:имаАлтернативноИме "Софийско поле"@bg ;
    geographbg:находящСеВ geographbg:ЗападнаБългария ;
    geographbg:граничиС geographbg:ЧепънПланина, geographbg:МалаПланина, geographbg:СофийскаПланина, geographbg:МургашПланина, geographbg:Вискяр, geographbg:ЛюлинПланина, geographbg:Витоша, geographbg:ЛозенскаПланина, geographbg:ВакарелскаПланина, geographbg:РидБелица, geographbg:БурелскаКотловина, geographbg:СаранскаКотловина ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1180"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "75"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаСреднаНадморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "550"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаГеология "Дъното е развито върху сенонски пирокластити и плиоценски песъчливо-глинести седименти, припокрити с делувиални и наносни конуси. Полето е запълнено с плиоценски пясъци и глини, припокрити с дебели речни наноси."@bg ;
    geographbg:имаКлимат "умереноконтинентален с чести температурни инверсии и фьонови ветрове. Средногодишна температура 9–10 °C, средна януарска -2 °C, средна юлска 20 °C. Среден годишен валеж 550–560 mm."@bg ;
    geographbg:отводняваСеОт geographbg:Искър, geographbg:ПерловскаРека, geographbg:ВладайскаРека, geographbg:РекаБлато, geographbg:ЛесновскаРека ;
    geographbg:имаМинераленИзвор geographbg:МинераленИзворКняжево, geographbg:МинераленИзворГорнаБаня, geographbg:МинераленИзворПанчарево, geographbg:МинераленИзворБанкя, geographbg:МинераленИзворСофия ;
    geographbg:имаПолезноИзкопаемо geographbg:ЛигнитниВъглища ;
    geographbg:имаТипПочва geographbg:ЧерноземСмолници, geographbg:АлувиалноЛивадниПочви, geographbg:КанелениГорскиПочви .

