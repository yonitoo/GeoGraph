# --- From "Перперек (река)" ---
geographbg:ПерперекРека a geographbg:Река ;
    rdfs:label "Перперек (река)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластКърджали ;
    geographbg:притокНа geographbg:Арда ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "44.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "рид Чуката, Източни Родопи, близо до с. Черна нива"@bg ;
        geographbg:находящСеВ geographbg:ИзточниРодопи ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "709.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Каракуш дере"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "220.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ЯзовирСтуденКладенец ;
    geographbg:преминаваПрез geographbg:ДаскаловоСело, geographbg:ЯбълчениСело, geographbg:ЧернооченеСело, geographbg:БързаРекаСело, geographbg:ТриМогилиСело, geographbg:СтремовоСело, geographbg:ЛюляковоСело, geographbg:ГорнаКрепостСело, geographbg:ДолнаКрепостСело, geographbg:МурговоСело, geographbg:ЧифликСелоКърджали, geographbg:МъдрецСелоКърджали, geographbg:ПерперекСело, geographbg:СватбареСело .

