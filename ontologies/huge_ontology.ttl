    rdfs:label "Чудни скали"@bg ;
    geographbg:находящСеВ geographbg:ОбластВарна, geographbg:ОбщинаДългопол, geographbg:ЗащитенаЗонаКамчийскаПланинаПтици ;
    geographbg:близоДо geographbg:АспаруховоСелоВарна, geographbg:ЯзовирГеоргиТрайков, geographbg:РекаЛудаКамчия ;
    geographbg:датаНаОбявяване "1949-02-17"^^xsd:date ;
