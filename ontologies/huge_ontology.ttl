geographbg:ИнститутЗаЕтнологияИФолклористикаСЕтнографскиМузей
    geographbg:основанПрезГодина "2010"^^xsd:integer ; # Date of re-unification
    geographbg:имаОписание "Научно-изследователски институт с музей в София, част от БАН. Разположен в Царския дворец. Провежда изследвания и обучение по етнология, фолклористика, антропология и др. Научният архив съхранява над 3000 архивни единици, библиотеката - над 25 000 издания."@bg .

geographbg:ШишмановиДни2012 a geographbg:Събитие ;
    rdfs:label "Шишманови дни 2012"@bg ;
    geographbg:стопанисваСеОт geographbg:ИнститутЗаЕтнологияИФолклористикаСЕтнографскиМузей ;
    geographbg:имаОписание "Празници на фолклора и етнографията, организирани през 2012 г. по случай 150-годишнината от рождението на проф. Иван Д. Шишманов и 120-годишнината от създаването на Народния музей."@bg .

geographbg:ДниНаМиладиновци2011 a geographbg:Събитие ;
    rdfs:label "Дни на Миладиновци 2011"@bg ;
    geographbg:стопанисваСеОт geographbg:ИнститутЗаЕтнологияИФолклористикаСЕтнографскиМузей ;
    geographbg:имаОписание "Прояви през 2011 г. по повод 150-годишнината от издаването на сборника „Български народни песни“ на Братя Миладинови."@bg .

geographbg:КукериОбичай a geographbg:Събитие ;
    rdfs:label "Кукери (обичай)"@bg ;
    geographbg:имаОписание "Карнавален маскарад в Югоизточна Европа, провеждан в началото на Великия пост или между Коледа и Богоявление. Включва група от сюжети и персонажи (Кукер, Баба, Цар и др.) с характерни маски и костюми. Игрите се провеждат из цялото село и завършват с обредно заораване и засяване."@bg ;
    geographbg:свързанС geographbg:ЮгоизточнаЕвропа ;
    geographbg:свързанС geographbg:ЗападнаБългария ;
    geographbg:свързанС geographbg:ИзточнаБългарияЕтнографскаОбласт .

geographbg:ИзточнаБългарияЕтнографскаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Източна България (етнографска област)"@bg .

geographbg:КумаЛиса
    rdfs:label "Кума Лиса"@bg ;
    geographbg:имаОписание "Персонаж в приказките за животни в българския фолклор, символ на хитрост, коварство и изобретателност. Често самата тя бива надхитряна. Подобен персонаж се среща и в руския фолклор."@bg .

geographbg:МайсторМанол
    rdfs:label "Майстор Манол"@bg ;
    geographbg:имаОписание "Легендарен майстор строител от фолклора на Балканите, Анадола и Кавказкия регион, който вгражда съпругата си в основите на важен строеж. Свързван с крепостта в Шкодра, Артенския, Вишеградския и Беленския мост, църквата в Куртя де Арджеш, Селим джамия в Одрин."@bg ;
    geographbg:свързанС geographbg:БалканскиПолуостров ;
    geographbg:свързанС geographbg:Анадол ;
    geographbg:свързанС geographbg:КавказкиРегион .

