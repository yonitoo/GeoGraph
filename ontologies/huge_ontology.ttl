# --- From "Крива река (приток на Марица)" ---
geographbg:КриваРекаПритокМарица a geographbg:Река ;
    rdfs:label "Крива река (приток на Марица)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "28.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт geographbg:БелмекенЯзовир ; # "изтича от северната стена на язовир „Белмекен“"
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "105.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:СестримоСело .
geographbg:Марица geographbg:имаПриток geographbg:КриваРекаПритокМарица .
