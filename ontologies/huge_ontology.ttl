    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "0.1"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] ; # 10 ha
