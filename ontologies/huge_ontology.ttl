# --- From "Широка поляна (язовир)" ---
geographbg:ЯзовирШирокаПоляна a geographbg:Язовир ;
    rdfs:label "Широка поляна (язовир)"@bg ;
    geographbg:частОтКаскада geographbg:БаташкиВодносиловПътКаскада ;
    geographbg:находящСеВ geographbg:ЗападниРодопи ;
    geographbg:намираСеВЗемлищетоНа geographbg:БатакГрад ;
    geographbg:намираСеНаРека geographbg:КирееваРека ;
    geographbg:свързанС geographbg:ЯзовирГолямБеглик ;
    geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1500.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ] ;
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "24000000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] ;
    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "4.3"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] .
    # Built 1959-1962
    # 5 separate dams, main one on Киреева река: height 21.2m, length 80m

geographbg:КирееваРека a geographbg:Река ; rdfs:label "Киреева река"@bg .
