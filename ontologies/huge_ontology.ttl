    geographbg:намираСеНаРека geographbg:ТунджаРека ;
    geographbg:основанПрезГодина "1951"^^xsd:integer ;
    geographbg:имаОписание "Създаден за опазване на лонгозни гори по поречието на река Тунджа."@bg ;
    geographbg:държава geographbg:България .

geographbg:БългарскаГораИсторическаЗона a geographbg:Гора, geographbg:ИсторическаОбласт ;
    rdfs:label "Българска гора (историческа горска зона)"@bg ;
    geographbg:имаАлтернативноИме "Великата българска гора"@bg, "Български лес"@bg ;
    geographbg:имаОписание "Горска зона, простираща се между Белград и източния край на прохода Траянови врата в началото на Тракийската низина. Областта между Ниш и Пазарджик. Описвана от участници в първите три кръстоносни похода през XI–XII в. В по-тесен географски смисъл обхваща гористите планински масиви на Тимошко, източно от река Велика Морава."@bg .

geographbg:БелградГрад a geographbg:Град ;
    rdfs:label "Белград"@bg ;
    geographbg:държава geographbg:Сърбия .
geographbg:БългарскаГораИсторическаЗона geographbg:близоДо geographbg:БелградГрад .

