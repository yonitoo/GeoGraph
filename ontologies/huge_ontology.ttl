# --- From "Въча (язовир)" ---
geographbg:ВъчаЯзовир a geographbg:Язовир ;
    rdfs:label "Въча (язовир)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:Родопи ;
    geographbg:намираСеНаРека geographbg:ВъчаРека ;
    geographbg:частОтКаскада geographbg:КаскадаДоспатВъча ;
    geographbg:имаАлтернативноИме "Антонивановци (язовир)"@bg ;
    geographbg:основанПрезГодина "1975"^^xsd:integer ; # 1968-1975
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "226200000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] ;
    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "5.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] .
    # Dam height 144.5m (highest in Bulgaria), length 420m
    # Feeds ПАВЕЦ "Орфей"

geographbg:Родопи a geographbg:Планина ; rdfs:label "Родопи"@bg ; geographbg:държава geographbg:България .
geographbg:КричимГрад a geographbg:Град ; rdfs:label "Кричим"@bg .
