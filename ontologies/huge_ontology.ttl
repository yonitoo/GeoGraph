        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаМаксималнаДълбочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "16.4"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

geographbg:ВтороМусаленскоЕзеро a geographbg:Езеро ;
    rdfs:label "Горно Мусаленско езеро"@bg ; # "Второто езеро, наричано още Горно или Безименно"
    geographbg:имаАлтернативноИме "Безименно Мусаленско езеро"@bg ;
    geographbg:находящСеВ geographbg:МусаленскиЕзера ; # Част от групата
    geographbg:държава geographbg:България ; # Наследява се от групата или се добавя
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2576.0"^^xsd:decimal ; # "на 2576 m н.в."
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1.24"^^xsd:decimal ; # "Има площ 12,4 дка" (12.4 дка = 1.24 ха)
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:имаМаксималнаДълбочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "5.8"^^xsd:decimal ; # "дълбочина 5,8 м"
        geographbg:имаМернаЕдиница geographbg:Метър
    ] .

