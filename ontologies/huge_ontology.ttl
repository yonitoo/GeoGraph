    geographbg:основанПрезГодина "1834"^^xsd:integer ;
    geographbg:имаОписание "Богато декориран салон, сред няколкото стаи за пребиваване на копривщенци."@bg .

geographbg:НаградаСветиИванРилски a geographbg:Събитие ; # Award is an event/recognition
    rdfs:label "Награда Свети Иван Рилски"@bg ;
    geographbg:основанПрезГодина "2006"^^xsd:integer ;
    geographbg:имаОписание "Връчва ежегодно от МОН на директори на училища за високи постижения и принос в развитието на образователното дело."@bg ;
    geographbg:свързанС geographbg:РилскиМанастирКултуренОбект . # Ceremony location

geographbg:МетохОрлица a geographbg:КултуренОбект ; # Assuming метох is a type of cultural site/monastery dependency
