geographbg:КомплексАвшарян a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Комплекс „Авшарян“"@bg ;
    geographbg:находящСеВ geographbg:ШуменГрад ;
    geographbg:имаОписание "Къщата е построена на кръстовището на две улици в Арменската махала в Шумен и е била собственост на Ованес Авшарян, производител и търговец на килими. Къщата е триетажна с обширен двор, до който се достига чрез подлез под стопанска сграда. Стаите са оформени еднотипно – задната им стена е заета изцяло от големи таблени долапи, комбинирани с поставената под ъгъл входна ниша, а таваните са прави, от дъски и профилирани летви. Експозицията пресъздава градската атмосфера на богат шуменски дом от края на XIX докъм 1930-те години."@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "100"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаИстория "Къщата е предоставена за стопанисване на Регионален исторически музей – Шумен с решение на Общинския съвет в града от месец април 2016 г. На 31 март 2017 г. комплексът е официално открит за посетители. Реставрирана е през 1985 г."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейШумен .

geographbg:ШуменГрад a geographbg:Град ;
    rdfs:label "Шумен"@bg .

geographbg:РегионаленИсторическиМузейШумен a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Шумен"@bg .

geographbg:АгушевиКонаци a geographbg:КултуренОбект ;
    rdfs:label "Агушеви конаци"@bg ;
    geographbg:находящСеВ geographbg:МогилицаСело ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "4"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Декар
    ] ;
    geographbg:близоДо geographbg:Арда ;
    geographbg:имаИстория "Комплексът от сгради в Могилица е изграден за около 20 години от местни майстори. Първата част е завършена 1825 г., а втората през 1843 г. (надпис '1258 по егира'). Конаците са реставрирани от арх. Георги Лабов. В края на ХХ век е реставриран и превърнат в етнографски музей. След реституция през 2001 г. Агушевите конаци са върнати на наследниците на Салих Ага."@bg ;
    geographbg:имаОписание "Архитектурен и художествен паметник от национално значение. Най-големият запазен феодален ансамбъл в Родопите. Архитектурен ансамбъл от две представителни жилищни сгради и стопански постройки. Съградени са така, че да образуват 3 самостоятелни двора. Всички сгради в конака имат общо 221 прозореца, 86 врати и 24 комина. Кулата е разположена в югоизточната част на конака и наподобява на морски фар. В Агушевите конаци е имало библиотека – една от най-големите частни библиотеки на Балканите в края на ХІХ и началото на ХХ век."@bg .

geographbg:МогилицаСело a geographbg:Село ;
    rdfs:label "Могилица"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаСмолян .

geographbg:ОбщинаСмолян a geographbg:Община ;
    rdfs:label "Община Смолян"@bg .

geographbg:БалиноваКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Балинова къща"@bg ;
    geographbg:находящСеВ geographbg:БатакГрад ;
    geographbg:основанПрезГодина "1895"^^xsd:integer ;
    geographbg:имаОписание "Семейна къща в град Батак. В нея е живял Трендафил Балинов. Архитектурен и исторически паметник на културата, образец на традиционната архитектура в Батак. Етнографски музей от 1968 г. Уредената в нея етнографска експозиция е посветена на традиционната народна култура в градчето от края на XIX в. и началото на XX в. Обект № 3 от Историческия музей в Батак."@bg ;
    geographbg:свързанС geographbg:ИсторическиМузейБатак .

geographbg:ИсторическиМузейБатак a geographbg:Музей ;
    rdfs:label "Исторически музей Батак"@bg .

geographbg:ЕтнографскоИсторическиМузейБаняСело a geographbg:Музей ;
    rdfs:label "Етнографско-исторически музей (Баня)"@bg ;
    geographbg:находящСеВ geographbg:БаняСелоРазлог ;
    geographbg:имаОписание "Изложени са останки от съдове от XI век преди Христа, археологически находки с келтски произход, надгробни плочи от времето на османското владичество. Етнографската част влючва глинени и други битови съдове, народни носии и произведения на народното творчество, типични за Баня. В обособен са изложени експонати, свързани с целия цикъл на ленопроизводството. Музеят има и богат снимков материал."@bg .

geographbg:БаняСелоРазлог a geographbg:Село ;
    rdfs:label "Баня (село, област Благоевград)"@bg ;
    geographbg:находящСеВ geographbg:ОбластБлагоевград .

geographbg:ЕтнографскиМузейБерковица a geographbg:Музей ;
    rdfs:label "Етнографски музей (Берковица)"@bg ;
    geographbg:находящСеВ geographbg:БерковицаГрад ;
    geographbg:имаОписание "Запознава с бита и обичаите на хората от Северозападна България. Във фондохранилищата му се пазят хиляди предмети от сферата на художественото творчество и занаяти, както и народните обичаи. Повечето експонати са свързани със занаятите, носиите и предметите от бита. Съхранява артефакти като каменна пластика, накити, монети, оръдия на труда и оръжия, битова и строителна керамика от региона."@bg .

geographbg:БерковицаГрад a geographbg:Град ;
    rdfs:label "Берковица"@bg .

geographbg:ЕтнографскиМузейБургас a geographbg:Музей ;
    rdfs:label "Етнографски музей (Бургас)"@bg ;
    geographbg:находящСеВ geographbg:БракаловаКъща ;
    geographbg:имаОписание "Експозицията се намира в т.нар. „Бракалова къща“. На първия етаж на сградата е аранжиран интериора на бургаската градска къща от 19 век и дамска мода от този период. На втория етаж е изложена сбирка от български традиционни костюми от всички етнографски групи в Бургаски регион. Показани са ритуални костюми и накити от ХІХ в."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейБургас .

geographbg:БракаловаКъща a geographbg:КултуренОбект ;
    rdfs:label "Бракалова къща"@bg ;
    geographbg:основанПрезГодина "1873"^^xsd:integer ;
    geographbg:находящСеВ geographbg:БургасГрад .

geographbg:РегионаленИсторическиМузейБургас a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Бургас"@bg .

geographbg:МузейНаБусинскатаКерамика a geographbg:Музей ;
    rdfs:label "Музей на бусинската керамика"@bg ;
    geographbg:находящСеВ geographbg:БусинциСело ;
    geographbg:основанПрезГодина "1982"^^xsd:integer ;
    geographbg:имаОписание "Етнографски музей в село Бусинци, Трънско. Комплексът включва сбирка на бусинска керамика, музейна и изложбени зали, работни ателиета и малка хотелска част. Представя уникалната бусинска грънчарската традиция в развитието ѝ от ХVII век до съвременното изкуство на художници-керамици. Етнографската експозиция включва над 200 оригинални експоната традиционна бусинска керамика от стари майстори, както и модерна керамика в духа на бусинските традиции от съвременни художници. Сега в музея се съхраняват над 1300 предмета на над 1000 майстори от селото и околността. Тук се пази и над 100-годишна пещ."@bg .

geographbg:БусинциСело a geographbg:Село ;
    rdfs:label "Бусинци"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаТрън .

geographbg:ЕтнографскиМузейБялаЧерква a geographbg:Музей ;
    rdfs:label "Етнографски музей (Бяла черква)"@bg ;
    geographbg:находящСеВ geographbg:БялаЧеркваГрад ;
    geographbg:основанПрезГодина "2004"^^xsd:integer ;
    geographbg:имаОписание "Етнографската експозиция включва над 2000 предмета: оръдия на труда, облекло, съдове, накити, представящи бита и традициите на населението от региона."@bg ;
    geographbg:свързанС geographbg:НародноЧиталищеБачоКиро1869 .

geographbg:БялаЧеркваГрад a geographbg:Град ;
    rdfs:label "Бяла черква"@bg .

geographbg:НародноЧиталищеБачоКиро1869 a geographbg:КултуренОбект ;
    rdfs:label "Народно читалище „Бачо Киро 1869“"@bg .

geographbg:ЕтнографскиМузейВарна a geographbg:Музей ;
    rdfs:label "Етнографски музей (Варна)"@bg ;
    geographbg:находящСеВ geographbg:СградаЕтнографскиМузейВарна ;
    geographbg:имаОписание "Експонирано е огромното разнообразие в културата и бита на хората от Варненския край от втората половина на XIX и началото на XX в. В музея са изложени демонстрации на основните поминъци, народни носии. Библиотеката на музея разполага с над 1600 броя книги и албуми."@bg .

geographbg:СградаЕтнографскиМузейВарна a geographbg:КултуренОбект ;
    rdfs:label "Възрожденска къща (Етнографски музей Варна)"@bg ;
    geographbg:основанПрезГодина "1860"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ВарнаГрад .

geographbg:ГенгерКомплекс a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Архитектурно-етнографски комплекс „Генгер“"@bg ;
    geographbg:находящСеВ geographbg:АйтосГрад ;
    geographbg:имаОписание "Действаща на открито етнографска експозиция, представяща най-типичните за Айтоския край народни художествени занаяти (грънчарство, медникарство, приложни изкуства, хлебарство, кошничарство). Включва етнографска къща музей, ресторант и винарна."@bg .

geographbg:АйтосГрад a geographbg:Град ;
    rdfs:label "Айтос"@bg .

geographbg:МузейГрадскиБитНаРусе a geographbg:Музей ;
    rdfs:label "Музей „Градски бит на Русе“"@bg ;
    geographbg:имаАлтернативноИме "Къщата на Калиопа"@bg ;
    geographbg:находящСеВ geographbg:КъщатаНаКалиопа ;
    geographbg:имаОписание "Експозицията представя ролята на град Русе като врата към Европа и навлизането на европейската градска култура в България в края на 19 и началото на 20 век. Показани са примерни интериори и колекции от градско облекло, накити, сребърни прибори и порцелан. В музея се намира първият роял, внесен в България."@bg ;
    geographbg:имаГеографскаШирина "43.852778"^^xsd:decimal ;
    geographbg:имаГеографскаДължина "25.9525"^^xsd:decimal .

geographbg:КъщатаНаКалиопа a geographbg:КултуренОбект ;
    rdfs:label "Къщата на Калиопа"@bg ;
    geographbg:основанПрезГодина "1864"^^xsd:integer ;
    geographbg:находящСеВ geographbg:РусеГрад .

geographbg:ДечковаКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Дечкова къща"@bg ;
    geographbg:имаАлтернативноИме "Къщата на спомените"@bg ;
    geographbg:находящСеВ geographbg:ГабровоГрад ;
    geographbg:имаИстория "Сградата е построена през периода 1815 - 1820 година от чорбаджи Дечко. От 1840 г. става Главно мъжко училище. През 1873 г. е настанено Девическото главно училище. По време на Освободителната руско-турска война е болница. На 1 ноември 1883 г. в нея е основан габровският клон на Българско дружество Червен кръст. През 90-те години на ХІХ в. в нея се настанява администрацията на Община Габрово. От 1929 г. до началото на 60-те години на ХХ в. е градската амбулатория. Реставрирана през 1965-1967 г. Обявена е за паметник на културата с категория „местно значение” в края на 1986 г. В нея е разположена постоянна експозиция „Градски бит от края на XIX – 40-те години на XX век“."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейГаброво .

geographbg:РегионаленИсторическиМузейГаброво a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Габрово"@bg .

geographbg:ДобруджанскаКъщаАлфатар a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Добруджанска къща (Алфатар)"@bg ;
    geographbg:находящСеВ geographbg:АлфатарГрад ;
    geographbg:основанПрезГодина "1893"^^xsd:integer ;
    geographbg:имаОписание "Едноетажна постройка с ниско приземие и етаж с пруст и издаден напред кьошк. В къщата има четири помещения. Уредената етнографската експозиция представя добруджанското жилище в периода от края на XIX до средата на XX век, традиционни тъкани, покъщнина, интериор от 30-те – 40-те години на XX век, както и експозиция на лозаро-винарството."@bg .

geographbg:АлфатарГрад a geographbg:Град ;
    rdfs:label "Алфатар"@bg .

geographbg:ДомНаТрадициитеСтароЖелезаре a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Дом на традициите (Старо Железаре)"@bg ;
    geographbg:находящСеВ geographbg:СградаДомНаТрадициите ;
    geographbg:основанПрезГодина "2009"^^xsd:integer ;
    geographbg:имаОписание "Етнографска сбирка и демонстрационен център. Притежава богата сбирка от национални костюми, съдове и инвентар от бита. Обособени са експозиции за „Хлябът“, „Сватбата“, традиционните празници и обреди. Правят се демонстрации на старинни занаяти и дейности от бита."@bg .

geographbg:СградаДомНаТрадициите a geographbg:КултуренОбект ;
    rdfs:label "Сграда на Дом на традициите (Старо Железаре)"@bg ;
    geographbg:находящСеВ geographbg:СтароЖелезареСело .

geographbg:СтароЖелезареСело a geographbg:Село ;
    rdfs:label "Старо Железаре"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаХисаря .

geographbg:ОбщинаХисаря a geographbg:Община ;
    rdfs:label "Община Хисаря"@bg .

geographbg:ЕтнографскиКомплексДрасоваИРашоваКъщи a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Етнографски комплекс „Драсова и Рашова къщи“"@bg ;
    geographbg:находящСеВ geographbg:ЛовечГрад ;
    geographbg:находящСеВ geographbg:АрхитектурноИсторическиРезерватВарошаЛовеч ;
    geographbg:имаОписание "Състои се от 2-те съседни Драсова къща и Рашова къща. Драсовата къща пресъздава домашната уредба на заможно търговско семейство от края на ХIХ и началото на ХХ в. Рашовата къща отразява домашния бит и култура на средно заможен ловешки интелигент от първата половина на ХХ в."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейЛовеч .

geographbg:ЛовечГрад a geographbg:Град ;
    rdfs:label "Ловеч"@bg .

geographbg:АрхитектурноИсторическиРезерватВарошаЛовеч a geographbg:КултуренОбект ;
    rdfs:label "Архитектурно-исторически резерват „Вароша“ (Ловеч)"@bg .

geographbg:ДрасоваКъща a geographbg:КултуренОбект ;
    rdfs:label "Драсова къща"@bg ;
    geographbg:свързанС geographbg:ЕтнографскиКомплексДрасоваИРашоваКъщи .

geographbg:РашоваКъща a geographbg:КултуренОбект ;
    rdfs:label "Рашова къща"@bg ;
    geographbg:основанПрезГодина "1835"^^xsd:integer ;
    geographbg:свързанС geographbg:ЕтнографскиКомплексДрасоваИРашоваКъщи .

geographbg:РегионаленИсторическиМузейЛовеч a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Ловеч"@bg .

geographbg:ЕтнографскиМузейДунавскиРиболовИЛодкостроенеТутракан a geographbg:Музей ;
    rdfs:label "Етнографски музей „Дунавски риболов и лодкостроене“ (Тутракан)"@bg ;
    geographbg:находящСеВ geographbg:СградаМузейРиболовТутракан ;
    geographbg:основанПрезГодина "1974"^^xsd:integer ;
    geographbg:имаОписание "Единствен в страните по поречието на река Дунав. Създаден е, за да съхрани богатата материална и духовна култура, обществено устройство и бит на българите от крайдунавските рибарски селища. Експозицията е разположена в сграда с 7 изложбени зали, два аранжимента на интериор и минераложка изложба. В лапидариума са експонирани старинни модели на рибарски лодки и различни каменни тежести за въдици."@bg ;
    geographbg:свързанС geographbg:ИсторическиМузейТутракан .

geographbg:СградаМузейРиболовТутракан a geographbg:КултуренОбект ;
    rdfs:label "Сграда на Етнографски музей „Дунавски риболов и лодкостроене“"@bg ;
    geographbg:основанПрезГодина "1907"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ТутраканГрад .

geographbg:ТутраканГрад a geographbg:Град ;
    rdfs:label "Тутракан"@bg .

geographbg:ИсторическиМузейТутракан a geographbg:Музей ;
    rdfs:label "Исторически музей Тутракан"@bg .

geographbg:ЕтнографскоАрхеологическиМузейЕлхово a geographbg:Музей ;
    rdfs:label "Етнографско-археологически музей (Елхово)"@bg ;
    geographbg:находящСеВ geographbg:СградиМузейЕлхово ;
    geographbg:основанПрезГодина "1958"^^xsd:integer ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "244"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаОписание "Етнографската експозиция представя разнообразното етнографско наследство на община Елхово и на голяма част от Странджанско-Сакарския край. Фондът съхранява над 22500 оригинални етнографски материали. Археологическата експозиция представя богатата хилядолетна култура на земите по Долна Тунджа. Музеят притежава над 3100 тома специализирана литература."@bg .

geographbg:СградиМузейЕлхово a geographbg:КултуренОбект ;
    rdfs:label "Сгради на Етнографско-археологически музей Елхово"@bg ;
    geographbg:находящСеВ geographbg:ЕлховоГрад .

geographbg:ЕмфиеджиеваКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Емфиеджиева къща"@bg ;
    geographbg:находящСеВ geographbg:КюстендилГрад ;
    geographbg:основанПрезГодина "1874"^^xsd:integer ;
    geographbg:разположенВМестност geographbg:ЛесопаркХисарлъкаКюстендил ;
    geographbg:имаОписание "Архитектурен паметник от епохата на Възраждането. Помещава музейната експозиция „Градски бит и култура на населението в Кюстендил от края на ХІХ и началото на ХХ век“. В 2 от стаите се е помещавал щабът на IV улански харковски полк. Архитектурният ансамбъл има П-образен план, в 2 части – жилищна и стопанска."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейКюстендил .

geographbg:ЛесопаркХисарлъкаКюстендил a geographbg:Парк ; # Renamed from ЛесопаркХисарлъка to be specific
    rdfs:label "Лесопарк Хисарлъка (Кюстендил)"@bg .

geographbg:РегионаленИсторическиМузейКюстендил a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Кюстендил"@bg .

geographbg:ЕтнографскиМузейЧирпанлиеватаКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Етнографски музей \"Чирпанлиевата къща\""@bg ;
    geographbg:находящСеВ geographbg:ЧирпанлиеватаКъща ;
    geographbg:имаИстория "Създадена като етнографски музей през 1972 г."@bg ;
    geographbg:имаОписание "Показва предметите от традиционната материална и духовна култура от епохата на Възраждането. На първия етаж са показани два от типичните за Шипка занаяти - ножарство и свиркарство, а на втория е пресъздаден характерния шипченски бит от 19 - ти век и началото на 20- ти век."@bg ;
    geographbg:стопанисваСеОт geographbg:НародноЧиталищеСветлина1861 .

geographbg:ЧирпанлиеватаКъща a geographbg:КултуренОбект ;
    rdfs:label "Чирпанлиевата къща"@bg ;
    geographbg:находящСеВ geographbg:ШипкаГрад .

geographbg:ШипкаГрад a geographbg:Град ;
    rdfs:label "Шипка"@bg .

geographbg:НародноЧиталищеСветлина1861 a geographbg:КултуренОбект ; # Or Организация
    rdfs:label "Народно Читалище „Светлина-1861“"@bg .

geographbg:ЕтнографскиМузейРазград a geographbg:Музей ;
    rdfs:label "Етнографски музей (Разград)"@bg ;
    geographbg:находящСеВ geographbg:ВъзрожденскиКъщиМузейРазград ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "150"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаИстория "Експозицията е открита на 10 септември 1999 г."@bg ;
    geographbg:имаОписание "Посветен на културата на една от местните етнографски групи – капанците. Представена е традиционната духовна култура на местната етнографска група, основните празници в техния годишен календар, облекло, накити и други."@bg .

geographbg:ВъзрожденскиКъщиМузейРазград a geographbg:КултуренОбект ;
    rdfs:label "Възрожденски къщи (Етнографски музей Разград)"@bg ;
    geographbg:находящСеВ geographbg:РазградГрад .

geographbg:РазградГрад a geographbg:Град ;
    rdfs:label "Разград"@bg .

geographbg:ЕтнографскоВъзрожденскиКомплексСветиСофронийВрачански a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Етнографско-възрожденски комплекс „Свети Софроний Врачански“"@bg ;
    geographbg:находящСеВ geographbg:ВрацаГрад ;
    geographbg:имаИстория "Създадена между 1972 и 1987 година."@bg ;
    geographbg:имаОписание "Архитектурно-етнографска музейна експозиция. Включва 3 възрожденски къщи и училище „Възнесение“. Представя традиционния бит, занаятите и културата на населението от Врачански регион от края на XIX до средата на XX век."@bg ;
    geographbg:свързанС geographbg:РегионаленИсторическиМузейВраца ;
    geographbg:свързанС geographbg:КъщаДимитракиХаджитошев ;
    geographbg:свързанС geographbg:КъщаГригорияНайденов ;
    geographbg:свързанС geographbg:КъщаИванЗамбин ;
    geographbg:свързанС geographbg:УчилищеВъзнесениеВраца .

geographbg:РегионаленИсторическиМузейВраца a geographbg:Музей ;
    rdfs:label "Регионален исторически музей - Враца"@bg .

geographbg:КъщаДимитракиХаджитошев a geographbg:КултуренОбект ;
    rdfs:label "Къща на Димитраки Хаджитошев"@bg .

geographbg:КъщаГригорияНайденов a geographbg:КултуренОбект ;
    rdfs:label "Къща на Григория Найденов"@bg .

geographbg:КъщаИванЗамбин a geographbg:КултуренОбект ;
    rdfs:label "Къща на Иван Замбин"@bg .

geographbg:УчилищеВъзнесениеВраца a geographbg:КултуренОбект ; # Could also be a Музей if it has distinct exhibitions
    rdfs:label "Училище „Възнесение“ (Враца)"@bg .

geographbg:ЕтърМузей a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Регионален етнографски музей на открито „Етър“"@bg ;
    geographbg:находящСеВ geographbg:ГабровоГрад ;
    geographbg:основанПрезГодина "1964"^^xsd:integer ;
    geographbg:имаОписание "Музей на открито, представляващ възстановка на българския бит, култура и занаятчийство. Намира се единствената в България сбирка на народна техника на вода (10 експоната). Занаятчийска чаршия представя 16 образци на балканската архитектура. Обявен за паметник на културата през 1971 г."@bg .

geographbg:КапанскиАрхитектурноЕтнографскиКомплексСадина a geographbg:КултуренОбект, geographbg:Музей ;
    rdfs:label "Капански архитектурно-етнографски комплекс (Садина)"@bg ;
    geographbg:находящСеВ geographbg:СадинаСело ;
    geographbg:имаОписание "Стара къща с обширен двор, традиционна каменна чешма, навес в старинен стил. Представена е етнографска сбирка, представяща обичаите и традициите на капанците. Приготвят се традиционни храни и се представят обичаи. Комплексът разполага със стаи за гости и механа."@bg .

geographbg:СадинаСело a geographbg:Село ;
    rdfs:label "Садина"@bg ;
    geographbg:находящСеВ geographbg:ОбластТърговище .

geographbg:ОбластТърговище a geographbg:Област ;
    rdfs:label "Област Търговище"@bg .

geographbg:КръстатаКазарма a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Кръстата казарма"@bg ;
    geographbg:находящСеВ geographbg:ВидинГрад ;
    geographbg:основанПрезГодина "1801"^^xsd:integer ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1260"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] ;
    geographbg:имаИстория "Построена по поръчка на Осман Пазвантоглу през 1801 г. След Освобождението служи за съд и за казарма. През 1965 – 1967 година сградата е реставрирана и приспособена за музей. От 1969 година в сградата е уредена етнографска експозиция."@bg ;
    geographbg:имаОписание "Сградата е в рядката за строителството форма на правилен геометричен кръст и е обявена за паметник на културата от местно значение. Етнографската експозиция представя традиционната култура на населението от Видинска област от края на XIX век до 1920-те години."@bg ;
    geographbg:свързанС geographbg:РегионаленМузеенКомплексВидин .

geographbg:РегионаленМузеенКомплексВидин a geographbg:Музей ;
    rdfs:label "Регионален музеен комплекс Видин"@bg .

geographbg:КъщаМузейЛюбенИПеткоКаравелови a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Къща музей на Любен и Петко Каравелови"@bg ;
    geographbg:находящСеВ geographbg:КопривщицаГрад ;
    geographbg:имаИстория "Музеят е открит на 3 февруари 1954 г."@bg ;
    geographbg:имаОписание "Комплекс от къщи. Най-старата сграда е зимната (1810 г.), където е експонирана етнографска композиция и експозиция за Любен Каравелов, вкл. неговата печатарска машина. Втората сграда (1820 г.) е стопанско помещение. Лятната къща (1835 г.) е с открит чардак."@bg ;
    geographbg:стопанисваСеОт geographbg:ДирекцияНаМузеитеКопривщица ;
    geographbg:свързанС geographbg:ЗимнаСградаКаравелови ;
    geographbg:свързанС geographbg:СтопанскаСградаКаравелови ;
    geographbg:свързанС geographbg:ЛятнаКъщаКаравелови .

geographbg:ДирекцияНаМузеитеКопривщица a geographbg:Организация ;
    rdfs:label "Дирекция на Музеите град Копривщица"@bg .

geographbg:ЗимнаСградаКаравелови a geographbg:КултуренОбект ;
    rdfs:label "Зимна сграда (Къща музей Каравелови)"@bg ;
    geographbg:основанПрезГодина "1810"^^xsd:integer .

geographbg:СтопанскаСградаКаравелови a geographbg:КултуренОбект ;
    rdfs:label "Стопанска сграда (Къща музей Каравелови)"@bg ;
    geographbg:основанПрезГодина "1820"^^xsd:integer .

geographbg:ЛятнаКъщаКаравелови a geographbg:КултуренОбект ;
    rdfs:label "Лятна къща (Къща музей Каравелови)"@bg ;
    geographbg:основанПрезГодина "1835"^^xsd:integer .

geographbg:КъщаМузейТомаКърджиев a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Къща музей „Тома Кърджиев“"@bg ;
    geographbg:находящСеВ geographbg:РусеГрад ;
    geographbg:основанПрезГодина "1984"^^xsd:integer ;
    geographbg:имаИстория "Основана на 2 март 1984 година и е закрита през 1990 година. Продължават да се уреждат временни тематични изложби. През март 2008 година в музея е разгърната експозицията „Живата старина. Етнографският свят на Русенско“."@bg ;
    geographbg:имаОписание "Музейна етнографска сбирка към Историческия музей в град Русе, разкрита в дома на Тома Кърджиев. Експозицията „Живата старина. Етнографският свят на Русенско“ представя бита и традициите на старото местно население, хърцоите."@bg ;
    geographbg:свързанС geographbg:ИсторическиМузейРусе .

geographbg:ИсторическиМузейРусе a geographbg:Музей ;
    rdfs:label "Исторически музей Русе"@bg .

geographbg:ЛеденишкаКула a geographbg:КултуренОбект, geographbg:Музей ;
    rdfs:label "Леденишка кула"@bg ;
    geographbg:имаАлтернативноИме "Кулата на Шемши бей"@bg ;
    geographbg:имаАлтернативноИме "Бейската кула"@bg ;
    geographbg:находящСеВ geographbg:ЛеденикСело ;
    geographbg:близоДо geographbg:Янтра ;
    geographbg:имаИстория "Сграда от XVII век. Първите данни за сградата идват от 1650 г., когато е възстановена за обитаване от Шемши бей. Опожарявана на 2 пъти от български хайдути. Реставрирана е през 1969 г."@bg ;
    geographbg:имаОписание "Изградена от ломен камък. Считана е за най-високата битова сграда на Балканите, изградена изцяло от камък. Преобразувана в етнографски музей на 3 етажа. На 1-вия етаж е разположена етнографската експозиция. На 2-рия етаж се намират спалнята на Шемши бей и няколко гостни. На 3-тия етаж има 9 издадени покрити балкона и 2 просторни зали."@bg .

geographbg:ЛеденикСело a geographbg:Село ;
    rdfs:label "Леденик"@bg ;
    geographbg:находящСеВ geographbg:ОбщинаВеликоТърново .

geographbg:ОбщинаВеликоТърново a geographbg:Община ;
    rdfs:label "Община Велико Търново"@bg .

geographbg:ЛютоваКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Лютова къща"@bg ;
    geographbg:находящСеВ geographbg:КопривщицаГрад ;
    geographbg:основанПрезГодина "1854"^^xsd:integer ;
    geographbg:имаИстория "Построена от пловдивски майстори за Стефан Топалов. През 1906 г. къщата е продадена на търговеца Петко Лютов. От 1965 г. е превърната в етнографски музей."@bg ;
    geographbg:имаОписание "Паметник на възрожденската архитектура, стенопис, дърворезба и бит. Музейната експозиция пресъздава битовата наредба на заможен копривщенски дом от средата на ХІХ век. Външната ѝ украса е пестелива, но вътрешната стенопис е внушителна. В приземието е уредена постоянна изложба от оригинални плъстени килими."@bg ;
    geographbg:стопанисваСеОт geographbg:ДирекцияНаМузеитеКопривщица .

geographbg:МузейНаМагаретоГурково a geographbg:Музей ;
    rdfs:label "Музей на магарето (Гурково)"@bg ;
    geographbg:находящСеВ geographbg:ГурковоГрад ;
    geographbg:имаОписание "Етнографски музей, пряко свързан с традиционното „Био рали“. В музея се съхраняват: етнографски кът, фотоизложба от ралито, награди, препарирано магаре, атрибути свързани с отглеждането и използването на магарето. Има и археологически раздел с предмети, намерени в района на Гурково."@bg ;
    geographbg:имаИстория "Съществува от началото на био ралито. На 4 септември 2013 г. е обновен."@bg .

geographbg:МузейНаГайдатаСтойките a geographbg:Музей ;
    rdfs:label "Музей на гайдата (Стойките)"@bg ;
    geographbg:находящСеВ geographbg:СтойкитеСело ;
    geographbg:основанПрезГодина "2022"^^xsd:integer ;
    geographbg:имаОписание "Етнографски музей на българската гайда. В експозицията му са подредени предмети от над сто дарители, представители на седемте фолклорни области в България. Ценен експонат е гайдата, чийто съпровод лети в космоса с песента „Излел е Делю хайдутин“. Има кът за ателието на бай Дафо Трендафилов и стена с имената на гайдарите от Рекорда на Гинес. Включва планетариум и мултимедийни експонати."@bg ;
    geographbg:свързанС geographbg:НародноЧиталищеПробуда1903Стойките .

geographbg:НародноЧиталищеПробуда1903Стойките a geographbg:КултуренОбект ; # Or Организация
    rdfs:label "Народно читалище „Пробуда – 1903“ (Стойките)"@bg .

geographbg:НеолитниЖилищаСтараЗагора a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Музей „Неолитни жилища“ (Стара Загора)"@bg ;
    geographbg:находящСеВ geographbg:СтараЗагораГрад ;
    geographbg:основанПрезГодина "1979"^^xsd:integer ;
    geographbg:имаОписание "В музея може да се видят 2 жилища от новокаменната епоха (VI хилядолетие пр.н.е.), които са най-добре запазените и с най-богат инвентар в Европа. Жилищата са двуетажни, с по три помещения, изградени от дървени колове, пръти и глина. В музея е изложена постоянна експозиция „Праисторическото изкуство в Старозагорско“ с 333 експоната, включително керамични съдове, фигури, мраморни фигурки, най-древната тарамбука в Европа."@bg .

geographbg:ОслековаКъща a geographbg:Музей, geographbg:КултуренОбект ;
    rdfs:label "Ослекова къща"@bg ;
    geographbg:находящСеВ geographbg:КопривщицаГрад ;
    geographbg:основанПрезГодина "1856"^^xsd:integer ;
    geographbg:имаИстория "Строена е през 1856 г. за Ненчо Ослеков. От 1956 г. е превърната в етнографски музей. От 2013 година е частен музей. Стенописите на фасадата са реставрирани през 2018 г."@bg ;
    geographbg:имаОписание "Паметник на културата. Построена в бароков стил. Вътрешната част на къщата е богато декорирана със стенописи от майсторите Минчо и Коста Зограф. Експозицията представя копривщенския бит от втората половина на XIX век, женски накити, традиционни дрехи, предмети на абаджиите."@bg .

geographbg:РегионаленЕтнографскиМузейПловдив a geographbg:Музей ;
    rdfs:label "Регионален етнографски музей (Пловдив)"@bg ;
    geographbg:находящСеВ geographbg:КуюмджиеваКъща ;
    geographbg:имаИстория "Началото е поставено на 22 януари 1917 г. като Окръжен музей. От 1938 г. музеят се помещава в Куюмджиевата къща. На 14 октомври 1943 г. музеят е отворен за посещения. През 1952 г. е открита постоянна експозиция."@bg ;
    geographbg:имаОписание "Експозицията представя традиционната култура на хората, населявали Тракия, Родопите и Средногорието от периода на Възраждането. Представени са земеделието, животновъдството, традиционни занаяти, златарска работилница, колекция накити и църковна утвар, народни костюми, платове, килими, музикални инструменти и обреден реквизит, както и градският бит."@bg .

geographbg:КуюмджиеваКъща a geographbg:КултуренОбект ;
    rdfs:label "Куюмджиева къща"@bg ;
    geographbg:основанПрезГодина "1847"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ПловдивГрад ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2000"^^xsd:decimal ; # Текстът казва "над 2000", но за стойност трябва конкретно число.
        geographbg:имаМернаЕдиница geographbg:КвадратенМетър
    ] .

geographbg:ЧервениятАпартамент a geographbg:Музей ;
    rdfs:label "Червеният апартамент"@bg ;
    geographbg:находящСеВ geographbg:София ;
    geographbg:основанПрезГодина "2019"^^xsd:integer ;
    geographbg:имаОписание "Частен музей, посветен на бита на българина от времето на комунизма през периода 1944 – 1989 г."@bg .

geographbg:БългарскаНосия
    rdfs:label "Българска носия"@bg ;
    geographbg:имаОписание "Народното облекло на българина от Възраждането до към средата на 20 век. То отразява спецификата, традиционната култура и бита на българския народ. Произходът му е главно балкански. Мъжките носии се класифицират в две основни групи – чернодрешна и белодрешна, а женските – в три групи – двупрестилчена, сукманена и саичена носия."@bg ;
    geographbg:свързанС geographbg:БалканскиПолуостров .

geographbg:ЧернодрешнаНосия
    rdfs:label "Чернодрешна носия"@bg ;
    geographbg:имаОписание "Мъжки традиционен костюм, една от главните категории на мъжките български носии. Името идва от тъмния цвят на вълнената тъкан за горните дрехи. Костюмът включва панталони (потури, чешири, шалвари или димии), риза, горни дрехи (елек, джамадан, аба, салтамарка) и пояс. Разпространена приблизително на изток от ятовата граница, както и в Македония, достигайки на североизток до Кюстендилско и Горноджумайско."@bg ;
    geographbg:свързанС geographbg:МакедонияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:Кюстендилско ;
    geographbg:свързанС geographbg:Горноджумайско .

geographbg:БелодрешнаНосия
    rdfs:label "Белодрешна носия"@bg ;
    geographbg:имаОписание "Традиционен костюм, една от главните категории на мъжките български носии. Името идва от обикновено светлия цвят на горните дрехи. Характерни са светлите тесни панталони (беневреци или чешири). Разпространена приблизително на запад от ятовата граница, достигайки на юг до Самоковско и Дупнишко."@bg ;
    geographbg:свързанС geographbg:Самоковско ;
    geographbg:свързанС geographbg:Дупнишко .

geographbg:ДвупрестилченаНосия
    rdfs:label "Двупрестилчена носия"@bg ;
    geographbg:имаОписание "Женски традиционен костюм, една от главните категории на женските български носии. Характерна е с носенето на две престилки – предна и задна – направо върху ризата. Разпространена в по-голямата част от Северна България до Шуменско и Силистренско на изток."@bg ;
    geographbg:свързанС geographbg:СевернаБългарияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:Шуменско ;
    geographbg:свързанС geographbg:Силистренско .

geographbg:СукманенаНосия
    rdfs:label "Сукманена носия"@bg ;
    geographbg:имаОписание "Женски традиционен костюм, една от главните категории на женските български носии. Характерна е с носенето върху ризата на сукман – дебела вълнена туникообразна богато украсена дреха, – върху която се носи една предна престилка. Разпространена в равнинните части на Тракия, до Стара планина и Търновско на север, както и в Североизточна и Средна Западна България."@bg ;
    geographbg:свързанС geographbg:ТракияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:СтараПланина ;
    geographbg:свързанС geographbg:Търновско ;
    geographbg:свързанС geographbg:СевероизточнаБългарияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:СреднаЗападнаБългарияЕтнографскаОбласт .

geographbg:СаиченаНосия
    rdfs:label "Саичена носия"@bg ;
    geographbg:имаОписание "Женски традиционен костюм, една от главните категории на женските български носии. Характерна е с носенето върху ризата на сая – дебела вълнена закопчаваща се отпред дреха, върху която се носи една предна престилка. Разпространена в Родопите и Македония, до Дупнишко, Кюстендилско и Радомирско на север."@bg ;
    geographbg:свързанС geographbg:РодопиЕтнографскаОбласт ;
    geographbg:свързанС geographbg:МакедонияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:Дупнишко ;
    geographbg:свързанС geographbg:Кюстендилско ;
    geographbg:свързанС geographbg:Радомирско .

