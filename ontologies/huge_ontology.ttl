# --- From "Радова река" ---
geographbg:РадоваРека a geographbg:Река ;
    rdfs:label "Радова река"@bg ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "33.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:имаПриток geographbg:ЧерешкаРекаПритокРадова, geographbg:БлющицаРека, geographbg:СредложкиДол, geographbg:ДряновскаРекаПритокРадова, geographbg:ЛещоваРека, geographbg:ПапрашницаРека, geographbg:ПчелинскаРека, geographbg:ГарвашницаРека, geographbg:ЛазоваРека ;
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:label "извор-чешма, Тревненска планина, Стара планина, близо до гара Кръстец"@bg ;
        geographbg:находящСеВ geographbg:СтараПланина ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "938.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Габрищица"@bg, "Лява река (Радова)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "240.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:вливаСеВ geographbg:ЯзовирЖребчево ; # Or Тунджа
    geographbg:преминаваПрез geographbg:ЛяваРекаСело, geographbg:ПчелиновоСело, geographbg:НиколаевоГрад .

