geographbg:ДетскиЕкостационарБелитеБрези
    rdfs:label "Детски екостационар „Белите брези“"@bg ;
    geographbg:разположенВМестност [ a geographbg:Местност ; rdfs:label "Дендрариума"@bg ; geographbg:находящСеВ geographbg:ПрироденПаркВитоша ] ;
    geographbg:имаОписание "Комплексен, детски, информационен, образователен и изложбен център. Сградата е построена с използване на естествени, местни строителни материали. Построен 2011-2012 г."@bg ;
    geographbg:основанПрезГодина "2012"^^xsd:integer . # Officially opened

geographbg:БистришкоБранище a geographbg:Резерват, geographbg:БиосференРезерват ;
    rdfs:label "Бистришко бранище"@bg ;
    geographbg:находящСеВ geographbg:ПрироденПаркВитоша ;
    geographbg:основанПрезГодина "1934"^^xsd:integer ;
    geographbg:обявенаСъсЗаповед "Постановление на Министерския съвет от 27 октомври 1934 година"@bg ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1061.6"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:надморскаВисочина [ # Range
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1858"^^xsd:decimal ; # Midpoint of 1430-2286
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Обхваща водосборните басейни на реките Бистрица и Янчовска. Целта е запазване на типична за Витоша растителност. През 1977 г. влиза в програмата на ЮНЕСКО „Човек и биосфера“. През 2021 г. е изключен от тази програма. На 22 май 2001 г. силна буря поваля 754 декара смърчова гора."@bg ;
    geographbg:намираСеНаРека geographbg:БистрицаВитошка, geographbg:ЯнчовскаРека ;
    geographbg:държава geographbg:България .

