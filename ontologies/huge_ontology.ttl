geographbg:ЯзовирКараджаДере a geographbg:Язовир ; rdfs:label "Караджа дере (язовир)"@bg ; geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "121000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] .
geographbg:ЯзовирБлатото a geographbg:Язовир ; rdfs:label "Блатото (язовир)"@bg ; geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "122000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] .

# --- From "Широколъшка река" ---
geographbg:ШироколъшкаРека a geographbg:Река ;
