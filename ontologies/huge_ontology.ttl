geographbg:ГрадинскиЕзера a geographbg:Езеро ; # Group of lakes
    rdfs:label "Градински езера"@bg ;
    geographbg:находящСеВ [ a geographbg:Местност ; rdfs:label "Калински дял, Северозападна Рила"@bg ; geographbg:находящСеВ geographbg:Рила ] ;
    geographbg:близоДо [ a geographbg:ПланинскиВръх ; rdfs:label "Голям Полич (връх)"@bg ] ;
    geographbg:имаОписание "Две групи езера, всяка с по три циркусни езера. Източната група - Воденичарски/Горни Градински езера, другата - Долни Градински езера."@bg ;
    geographbg:държава geographbg:България .

geographbg:ДжубренаРека a geographbg:Река ;
    rdfs:label "Джубрена (река)"@bg ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
