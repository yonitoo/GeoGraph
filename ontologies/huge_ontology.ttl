# --- From "Сребра" ---
geographbg:СребраРека a geographbg:Река ;
    rdfs:label "Сребра (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Северозападна Сърнена Средна гора
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "21.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местност ; rdfs:label "Габров дол, Сърнена Средна гора, близо до с. Свежен"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "696.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Златоселска река"@bg, "Златна река"@bg, "Злата"@bg, "Азмак (Сребра)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "68.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ДондуковоСело, geographbg:ЗлатоселСело, geographbg:ДранговоСело, geographbg:ОтецКириловоСело, geographbg:РаковскиГрад, geographbg:ШишманциСело, geographbg:БелоземСело .

