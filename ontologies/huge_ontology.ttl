geographbg:ЗаслонСамара a geographbg:Заслон ;
    rdfs:label "Самара (заслон)"@bg ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:разположенВМестност geographbg:СедловинаСедлото ;
    geographbg:надморскаВисочина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "2062"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Метър
    ] ;
    geographbg:имаОписание "Намира се под връх Самара. До стълб номер 74 от зимната маркировка на маршрута от хижа „Кумата“ до Черни връх. Едноетажна каменна сграда с предверие и две стаи. Не функционира по предназначение."@bg ;
    geographbg:стопанисваСеОт [ a geographbg:Организация ; rdfs:label "Планинска спасителна служба – София"@bg ] ;
    geographbg:държава geographbg:България .

