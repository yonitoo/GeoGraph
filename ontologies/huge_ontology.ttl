# --- From "Азмака (приток на Сазлийка)" ---
geographbg:АзмакаПритокСазлийка a geographbg:Река ;
    rdfs:label "Азмака (приток на Сазлийка)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:притокНа geographbg:СазлийкаРека ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "25.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Извор ;
        rdfs:label "извор-чешма в Кирилово"@bg ;
        geographbg:находящСеВ geographbg:КириловоСело ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "265.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:вливаСеВ geographbg:СазлийкаРека ;
    # Mouth altitude: 138m
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "152.0"^^xsd:decimal ;
