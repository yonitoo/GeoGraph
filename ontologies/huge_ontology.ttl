    ] ;
    geographbg:имаАлтернативноИме "Семиза"@bg, "Беглишка река"@bg ; # Беглишка река е участък
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "427.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:ДевинГрад .

