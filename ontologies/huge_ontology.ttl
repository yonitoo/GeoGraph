geographbg:РекаСинаница a geographbg:Река ; rdfs:label "Синаница (река)"@bg .
geographbg:РекаШаралийска a geographbg:Река ; rdfs:label "Шаралийска река"@bg .
geographbg:СелоВлахи a geographbg:Село ; rdfs:label "Влахи (село)"@bg ; geographbg:находящСеВ geographbg:ОбщинаКресна .
geographbg:ОбщинаКресна a geographbg:Община ; rdfs:label "Община Кресна"@bg ; geographbg:находящСеВ geographbg:ОбластБлагоевград .

# --- Голема река (Богданска планина) ---
geographbg:РекаГолемаБогданска a geographbg:Река ;
    rdfs:label "Голема река (Богданска планина)"@bg ;
    geographbg:имаАлтернативноИме "Сали Милос"@bg ;
    geographbg:находящСеВ "Нигритско, Егейска Македония, Гърция"@bg, geographbg:БогданскаПланина ;
    geographbg:еПритокНа geographbg:РекаСтрума ;
    geographbg:странаНаПритока "десен"@bg ;
    geographbg:извираОт [
        a geographbg:Извор ;
        geographbg:находящСеВ geographbg:БогданскаПланина ;
        rdfs:comment "източно под връх Петало"
    ] ;
    geographbg:вливаСеВ geographbg:РекаСтрума ;
    geographbg:мястоНаВливане "местността Кара Орман"@bg ;
    geographbg:имаПриток geographbg:РекаРаково, geographbg:РекаЛясколака ;
    geographbg:протичаПрез "село Лъджа (Нигритско)"@bg .

