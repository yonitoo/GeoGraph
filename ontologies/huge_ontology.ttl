# --- From "Тополница" ---
geographbg:ТополницаРека a geographbg:Река ;
    rdfs:label "Тополница (река)"@bg ;
    geographbg:държава geographbg:България ;
    # Софийска област, Област Пазарджик
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "154.8"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Километър
    ] ;
    geographbg:извираОт [
        a geographbg:Местоположение ;
        rdfs:label "подножие на връх Бич, Същинска Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СъщинскаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "1402.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Ширенейска река"@bg, "Тополка"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "1789.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:КопривщицаГрад, geographbg:ДушанциСело, geographbg:ПетричСелоЗлатица, geographbg:МуховоСело, geographbg:ПоибренеСело, geographbg:ЛесичовоСело, geographbg:КалугеровоСелоПазарджик, geographbg:ДинкатаСело, geographbg:ПамидовоСело, geographbg:ЮнацитеСело, geographbg:ДрагорСело .

geographbg:КопривщицаГрад a geographbg:Град ; rdfs:label "Копривщица"@bg .
