geographbg:БАН a geographbg:Организация ;
    rdfs:label "Българска академия на науките"@bg .
geographbg:ИнститутЗаГоратаБАН geographbg:свързанС geographbg:БАН ;
    rdfs:label "Институт за гората"@bg ;
    a geographbg:Организация ;
    geographbg:основанПрезГодина "1928"^^xsd:integer ;
    geographbg:имаОписание "Научен институт на БАН. Провежда изследвания на горските екосистеми. Издава списанията „Наука за гората“ и „Silva balcanica“. Структура: 4 научни секции (Горска екология; Горска генетика, физиология и култури; Горска ентомология, фитопатология и ловна фауна; Лесовъдство и управление на горските ресурси)."@bg ;
    geographbg:имаИстория "Основан като „Служба за горско опитно дело“. През 1940 г. става Институт за горски изследвания и опити. От 1954 г. е самостоятелно звено при БАН."@bg .

geographbg:ГрадБялаСлатина a geographbg:Град ;
    rdfs:label "Бяла Слатина"@bg ;
    geographbg:държава geographbg:България .
geographbg:АгинотоБранище a geographbg:Местност ;
    rdfs:label "Агиното бранище"@bg ;
    geographbg:находящСеВ geographbg:ГрадБялаСлатина .
geographbg:КиткатаБялаСлатина a geographbg:ЗащитенаМестност ;
    rdfs:label "Китката (Бяла Слатина)"@bg ;
    geographbg:намираСеВЗемлищетоНа geographbg:ГрадБялаСлатина ;
    geographbg:имаОписание "2 групи от дъбови широколистни дървета. Според преданието засадени от османлия. Била част от герба на града. Изсечена от бракониери след 1989 г. заедно с местността Агиното бранище."@bg ;
    geographbg:имаХарактеренРастителенВид geographbg:ОбикновенДъб ;
    geographbg:държава geographbg:България .

geographbg:КварталКняжево a geographbg:Квартал ;
    rdfs:label "Княжево (квартал)"@bg ;
    geographbg:находящСеВ geographbg:София .
geographbg:ПрироденПаркВитоша a geographbg:ПрироденПарк ;
    rdfs:label "Природен парк „Витоша“"@bg ;
    geographbg:държава geographbg:България .
geographbg:КняжевскаГора a geographbg:Парк, geographbg:Гора ;
    rdfs:label "Княжевска гора"@bg ;
    geographbg:находящСеВ geographbg:КварталКняжево ;
    geographbg:имаОписание "Държавен парк. Сред основните туристически връзки на София с Природен парк „Витоша“. Попада във височинния пояс на мезофилните и ксеромезофилни дъбово-габърови гори (650 до 800 м н.в.). Надморска височина: 650-900 м. Площ: 910 декара (решение на МС). На територията на парка се намират 3 каптажа, 58 пейки с гранитна основа, гранитни стълби, 12 „витошки“ пейки и 2000 метра отводнени алеи."@bg ;
    geographbg:основанПрезГодина "1881"^^xsd:integer ;
    geographbg:имаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "91.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:Хектар
    ] ;
    geographbg:свързанС geographbg:ПрироденПаркВитоша ;
    geographbg:държава geographbg:България .

