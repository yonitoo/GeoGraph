# --- From "Омуровска река" ---
geographbg:ОмуровскаРека a geographbg:Река ;
    rdfs:label "Омуровска река"@bg ;
    geographbg:държава geographbg:България ;
    # Област Стара Загора, Област Пловдив
    geographbg:притокНа geographbg:Марица ;
    geographbg:общаДължина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "58.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Километър ] ;
    geographbg:извираОт [ a geographbg:Местоположение ; rdfs:label "близо до връх Чакалова поляна, Сърнена Средна гора"@bg ;
        geographbg:находящСеВ geographbg:СърненаСреднаГора ;
        geographbg:надморскаВисочина [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "820.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Метър ]
    ] ;
    geographbg:имаАлтернативноИме "Конакдере"@bg, "Старата река (Омуровска)"@bg ;
    geographbg:площНаВодосборенБасейн [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "305.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] ;
    geographbg:преминаваПрез geographbg:МедовоСело, geographbg:МарковоСелоСтараЗагора, geographbg:МалъкДолСело, geographbg:ГолямДолСело, geographbg:БратяДаскаловиСело, geographbg:ГорноБелевоСело, geographbg:ПартизанинСело, geographbg:ЧернаГораСело, geographbg:ПлодовитовоСело, geographbg:КрушевоСелоПловдив .

