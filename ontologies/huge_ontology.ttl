geographbg:ГерманОбичай a geographbg:Събитие ;
    rdfs:label "Герман (обичай)"@bg ;
    geographbg:имаОписание "Обичай за измолване на дъжд, разпространен в Северна България, Стара планина и Странджа. Изработва се мъжка фигура от кал (Герман), която ритуално се погребва край водоизточник."@bg ;
    geographbg:свързанС geographbg:СевернаБългарияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ЦентралнаСтараПланина ;
    geographbg:свързанС geographbg:ИзточнаСтараПланина ;
    geographbg:свързанС geographbg:СтранджаЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ТетевенскоОбласт ;
    geographbg:свързанС geographbg:ПлевенскоОбласт .

geographbg:ТетевенскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Тетевенско"@bg .

geographbg:ПлевенскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Плевенско"@bg .

geographbg:ГодежОбичай a geographbg:Събитие ;
    rdfs:label "Годеж (обичай)"@bg ;
    geographbg:имаОписание "Прави се на голям празник (Коледа, Ивановден, Великден). Включва тържествена трапеза, песни, хора. Момичето получава годежен дар (китка, наниз монети, пръстен). Извършва се пазарлък „бащино право“. Двамата млади отхапват от обща пита."@bg .

geographbg:ГоненеНаЗмейОбичай a geographbg:Събитие ;
    rdfs:label "Гонене на змей"@bg ;
    geographbg:имаОписание "Български обичай при продължително засушаване, разпространен в Западна и Северозападна България и Стара планина. Голи мъже обикалят селото и мушкат с тояги, за да прогонят змея, причиняващ сушата."@bg ;
    geographbg:свързанС geographbg:ЗападнаБългария ;
    geographbg:свързанС geographbg:СеверозападнаБългария ;
    geographbg:свързанС geographbg:ЦентралнаСтараПланина .

geographbg:ГрамадаОбичай
    rdfs:label "Грамада (обичай)"@bg ;
    geographbg:имаАлтернативноИме "проклятие"@bg ;
    geographbg:имаАлтернативноИме "проклетия"@bg ;
    geographbg:имаАлтернативноИме "анатема"@bg ;
    geographbg:имаАлтернативноИме "натемия"@bg ;
    geographbg:имаОписание "Български народен обичай от Северозападна България за групово проклинане на извършители на тежки престъпления, чрез хвърляне на камък на определено място (грамада)."@bg ;
    geographbg:свързанС geographbg:СеверозападнаБългария .

