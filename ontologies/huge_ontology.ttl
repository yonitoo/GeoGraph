    rdfs:label "Независима Македония (вестник, 1923-1926)"@bg ;
    geographbg:имаОписание "Български вестник, орган на македонската емиграция, излизал седмично от 1923 до 1926 г. в София."@bg ;
    geographbg:свързанС geographbg:СъюзНаМакедонскитеЕмигрантскиОрганизации ;
    geographbg:свързанС geographbg:София .

# Triples from "Пирин (1923 – 1924)"
