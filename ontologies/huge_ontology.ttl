        rdfs:comment "към 2002 г."@bg
    ] ;
    geographbg:имаИстория "Етнография (1873): Органджили, 76 домакинства, 184 мюсюлмани. Кънчов (1900): Органджели, 420 турци."@bg .

geographbg:ОрманлиСело geographbg:имаНаселение [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "34"^^xsd:integer ;
