# --- From "Каскада „Белмекен-Сестримо-Чаира“" ---
geographbg:КаскадаБелмекенСестримоЧаира a geographbg:Каскада ;
    rdfs:label "Каскада Белмекен-Сестримо-Чаира"@bg ;
    # Built 1964-1999
    geographbg:имаПлощ [ # Водосборна област
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "458.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
    # Total power 1599 MW
geographbg:ЯзовирСтанковиБараки a geographbg:Язовир ; rdfs:label "Станкови бараки (язовир)"@bg ; geographbg:частОтКаскада geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "420000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] .
geographbg:ЯзовирЧаира a geographbg:Язовир ; rdfs:label "Чаира (язовир)"@bg ; geographbg:частОтКаскада geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:основанПрезГодина "1989"^^xsd:integer ; # 1975-1989
    geographbg:намираСеВЗемлищетоНа geographbg:СестримоСело ;
    geographbg:находящСеВ geographbg:ОбластПазарджик ;
    geographbg:намираСеНаРека geographbg:ЧаирскаРека ; # "по течението на Чаирска река"
    geographbg:свързанС geographbg:ЯзовирЯденица ;
    geographbg:имаОбем [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "5600000.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КубиченМетър ] ;
    geographbg:имаЗалятаПлощ [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "0.2"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:КвадратенКилометър ] .
geographbg:ВЕЦСестримо a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Сестримо"@bg ; geographbg:частОтКаскада geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:основанПрезГодина "1975"^^xsd:integer ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "240.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] .
geographbg:ВЕЦМоминаКлисура a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Момина клисура"@bg ; geographbg:частОтКаскада geographbg:КаскадаБелмекенСестримоЧаира ;
    geographbg:основанПрезГодина "1975"^^xsd:integer ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "120.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] .

