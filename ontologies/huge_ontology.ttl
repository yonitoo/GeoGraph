# Many micro-dams

# --- From "Копринка (язовир)" ---
geographbg:ЯзовирКопринка a geographbg:Язовир ;
    rdfs:label "Копринка (язовир)"@bg ;
    geographbg:държава geographbg:България ;
    geographbg:находящСеВ geographbg:ОбластСтараЗагора ;
    geographbg:намираСеНаРека geographbg:ТунджаРека ;
    geographbg:намираСеВЗемлищетоНа geographbg:КопринкаСело, geographbg:ДолноСахранеСело, geographbg:ГорноЧерковищеСело, geographbg:ВиденСело ;
    geographbg:основанПрезГодина "1955"^^xsd:integer ; # Official opening
    geographbg:частОтКаскада geographbg:ХидровъзелКопринка ;
    geographbg:имаОбем [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "142200000.0"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КубиченМетър
    ] ;
    geographbg:имаЗалятаПлощ [
        a geographbg:КоличественаСтойност ;
        geographbg:имаСтойност "12.5"^^xsd:decimal ;
        geographbg:имаМернаЕдиница geographbg:КвадратенКилометър
    ] .
    # Dam height 44m, length 834m
geographbg:КопринкаСело a geographbg:Село ; rdfs:label "Копринка (село)"@bg .
geographbg:ДолноСахранеСело a geographbg:Село ; rdfs:label "Долно Сахране"@bg .
geographbg:ГорноЧерковищеСело a geographbg:Село ; rdfs:label "Горно Черковище"@bg .
geographbg:ХидровъзелКопринка a geographbg:Каскада ; rdfs:label "Хидровъзел Копринка"@bg . # Or ИнфраструктуренОбект
geographbg:ВЕЦКопринка a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Копринка"@bg ; geographbg:частОтКаскада geographbg:ХидровъзелКопринка ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "7.0"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] .
geographbg:ВЕЦСтараЗагора a geographbg:ВЕЦ ; rdfs:label "ВЕЦ Стара Загора"@bg ; geographbg:частОтКаскада geographbg:ХидровъзелКопринка ;
    geographbg:имаКапацитет [ a geographbg:КоличественаСтойност ; geographbg:имаСтойност "22.4"^^xsd:decimal ; geographbg:имаМернаЕдиница geographbg:Мегават ] .
geographbg:СевтополисГрад a geographbg:КултуренОбект ; rdfs:label "Севтополис"@bg ; geographbg:находящСеВ geographbg:ЯзовирКопринка . # Submerged city

