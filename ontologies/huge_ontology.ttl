    geographbg:находящСеВ geographbg:София .

geographbg:УлицаРусаляДианабадСофия a geographbg:Улица ;
    rdfs:label "Улица Русаля (кв. Дианабад, София)"@bg ;
    geographbg:находящСеВ geographbg:КварталДианабадСофия .

geographbg:КварталДианабадСофия a geographbg:Квартал ;
    rdfs:label "Дианабад (квартал, София)"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:УлицаРусалкаОрландовциСофия a geographbg:Улица ;
    rdfs:label "Улица Русалка (кв. Орландовци, София)"@bg ;
    geographbg:находящСеВ geographbg:КварталОрландовциСофия .

geographbg:КварталОрландовциСофия a geographbg:Квартал ;
    rdfs:label "Орландовци (квартал, София)"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:УлицаРусалскиЛъкСухатаРекаСофия a geographbg:Улица ;
    rdfs:label "Улица Русалски лък (кв. Сухата река, София)"@bg ;
    geographbg:находящСеВ geographbg:КварталСухатаРекаСофия .

geographbg:КварталСухатаРекаСофия a geographbg:Квартал ;
    rdfs:label "Сухата река (квартал, София)"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:РусаляСело a geographbg:Село ;
    rdfs:label "Русаля (село)"@bg ;
    geographbg:находящСеВ geographbg:ОбластВеликоТърново .

geographbg:СветецОбичай a geographbg:Събитие ;
    rdfs:label "Светец (обичай)"@bg ;
    geographbg:имаАлтернативноИме "слава"@bg, "светъц"@bg, "стопанин"@bg, "служба"@bg, "курбан"@bg, "свинтул"@bg ;
    geographbg:имаОписание "Традиционен празник на Балканите, отбелязван от семейство на определен християнски празник. Включва вечерница, празничен обяд, курбан, обредни хлябове, коливо, прекадяване. Патерица е денят след празника."@bg ;
    geographbg:свързанС geographbg:БалканскиПолуостров ;
    geographbg:свързанС geographbg:Сърбия ;
    geographbg:свързанС geographbg:ЗападнаБългария ;
    geographbg:свързанС geographbg:СевернаМакедония ;
    geographbg:свързанС geographbg:Косово ;
    geographbg:свързанС geographbg:ЧернаГора ;
    geographbg:свързанС geographbg:Албания ;
    geographbg:свързанС geographbg:БоснаИХерцеговина ;
    geographbg:свързанС geographbg:Далмация ;
    geographbg:свързанС geographbg:Румъния ;
    geographbg:свързанС geographbg:ТимошкоРегион .

geographbg:Косово a geographbg:Държава ; # Or ГеографскиРегион
    rdfs:label "Косово"@bg .

geographbg:ЧернаГора a geographbg:Държава ;
    rdfs:label "Черна гора"@bg .

geographbg:Далмация a geographbg:ИсторическаОбласт ;
    rdfs:label "Далмация"@bg .

geographbg:КурбанОбичай a geographbg:Събитие ;
    rdfs:label "Курбан (обичай)"@bg ;
    geographbg:имаОписание "Личен празник в България, правен от човек, избавил се от премеждие с помощта на светец. В Западна България е близък до светеца."@bg .

geographbg:Седянка a geographbg:Събитие ;
    rdfs:label "Седянка"@bg ;
    geographbg:имаОписание "Стар български обичай, практикуван най-вече по селата. Млади хора, готови за женитба, се събират около седенкарския огън през есента и зимата. Момите работят (предат, шият), пеят, разказват, танцуват. Момците се присъединяват, сядат до избраниците си. „Вземането на китката“ е важен момент."@bg .

geographbg:УлицаСедянкаСофия a geographbg:Улица ;
    rdfs:label "Улица Седянка (София)"@bg ;
    geographbg:находящСеВ geographbg:КварталКарпузицаСофия .

geographbg:КварталКарпузицаСофия a geographbg:Квартал ;
    rdfs:label "Карпузица (София)"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:СтарциОбичайКарлово a geographbg:Събитие ;
    rdfs:label "Старци (обичай, Карлово)"@bg ;
    geographbg:имаОписание "Карнавални игри в карловския квартал Сушица, провеждани на Сирни заговезни. Участват две групи „старци“ – „баджаци“ (с кози кожи, бели гугли, хлопки) и „белогаши“ (в бяло, с червен пояс, овчарски звънци, носят змия или колан)."@bg ;
    geographbg:находящСеВ geographbg:КварталСушицаКарлово ;
    geographbg:свързанС geographbg:СирниЗаговезниПразник .

geographbg:СирниЗаговезниПразник a geographbg:Събитие ;
    rdfs:label "Сирни заговезни"@bg .

geographbg:Сурвакане a geographbg:Събитие ;
    rdfs:label "Сурвакане"@bg ;
    geographbg:имаОписание "Български народен обичай на Сурваки (Нова година). Сурвакари (деца 4-12 г. или ергени) обхождат домове, сурвакат със сурвачка за здраве и плодородие, получават дарове. Регионални варианти включват „ходене за лешници“, „за китка“, роли на „шиповичар“, „коте“, „магаре“, „Носене на камък“ в Родопите."@bg ;
    geographbg:свързанС geographbg:СурвакиПразник ;
    geographbg:свързанС geographbg:Сурвачка ;
    geographbg:свързанС geographbg:СтранджанскиРегион ;
    geographbg:свързанС geographbg:СакарПланина ;
    geographbg:свързанС geographbg:ПиринскиКрай ;
    geographbg:свързанС geographbg:ПловдивскоОбласт ;
    geographbg:свързанС geographbg:ГоцеделчевскоРегион ;
    geographbg:свързанС geographbg:ЛомскоРегион ;
    geographbg:свързанС geographbg:РазложкоОбласт ;
    geographbg:свързанС geographbg:СофийскоПоле ; # or ОбластСофия
    geographbg:свързанС geographbg:Родопи .

geographbg:СурвакиПразник a geographbg:Събитие ;
    rdfs:label "Сурваки"@bg .

geographbg:СтранджанскиРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Странджански регион"@bg ;
    geographbg:свързанС geographbg:СтранджаПланина .

geographbg:ГоцеделчевскоРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Гоцеделчевско"@bg .

geographbg:ЛомскоРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Ломско"@bg .

geographbg:Сурвачка a geographbg:КултуренОбект ;
    rdfs:label "Сурвачка"@bg ;
    geographbg:имаАлтернативноИме "сурвакница"@bg ;
    geographbg:имаОписание "Украсена дрянова клонка, свита на полукръг, с която се сурвака на Нова година. Украсява се с конци, пуканки, сушени плодове, кравайчета, парички."@bg .

geographbg:Тримирене a geographbg:Събитие ;
    rdfs:label "Тримирене"@bg ;
    geographbg:имаАлтернативноИме "Тримеро"@bg, "Търпило"@bg, "Едноница"@bg ;
    geographbg:имаОписание "Спазване на строг пост (без храна и вода, сексуално въздържание) през първите три дни на Тодоровата неделя. В последния ден тримерникът се причестява и раздава постна храна. Смята се за „живо одуше“."@bg ;
    geographbg:свързанС geographbg:ТодороваНеделя .

geographbg:ТодороваНеделя a geographbg:Период ;
    rdfs:label "Тодорова неделя"@bg .

geographbg:ТричанеНаКучета a geographbg:Събитие ;
    rdfs:label "Тричане на кучетата"@bg ;
    geographbg:имаОписание "Обичай, изпълняван на Чист понеделник (Тодорова неделя) за предпазване на кучетата от бяс. Известен в Източна и Южна България. Включва ритуално въртене или люлеене на кучета. Регионални варианти: „цирене“ (Добруджа), „церилка“ (Странджа), „Виси куче“ (Пловдивско), „Беси понеделник“ (Троянско). Обичаят е криминализиран през 2011 г."@bg ;
    geographbg:свързанС geographbg:ТодороваНеделя ;
    geographbg:свързанС geographbg:ИзточнаБългарияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ЮжнаБългарияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ЦентралнаБългария ;
    geographbg:свързанС geographbg:ДобруджаЕтнографскаОбласт ;
    geographbg:свързанС geographbg:СтранджаЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ИзточниРодопи ;
    geographbg:свързанС geographbg:ПиринскиКрай ;
    geographbg:свързанС geographbg:ПловдивскоОбласт ;
    geographbg:свързанС geographbg:ТроянскоРегион ;
    geographbg:свързанС geographbg:Гърция ;
    geographbg:свързанС geographbg:Румъния .

geographbg:ЦентралнаБългария a geographbg:ГеографскиРегион ;
    rdfs:label "Централна България"@bg .

geographbg:ТроянскоРегион a geographbg:ГеографскиРегион ;
    rdfs:label "Троянско"@bg .

geographbg:ХлябИСолЦеремония a geographbg:Събитие ;
    rdfs:label "Хляб и сол (церемония)"@bg ;
    geographbg:имаОписание "Традиционна славянска церемония за посрещане на гости. Момиче в народна носия поднася питка и сол. Гостите откъсват залък, потапят в солта и изяждат. Разпространена в славянски страни, Литва и Румъния."@bg ;
    geographbg:свързанС geographbg:Русия ;
    geographbg:свързанС geographbg:Украйна ;
    geographbg:свързанС geographbg:България ;
    geographbg:свързанС geographbg:СевернаМакедония ;
    geographbg:свързанС geographbg:Хърватия ;
    geographbg:свързанС geographbg:Сърбия ;
    geographbg:свързанС geographbg:Полша ;
    geographbg:свързанС geographbg:Чехия ;
    geographbg:свързанС geographbg:Словакия ;
    geographbg:свързанС geographbg:Литва ;
    geographbg:свързанС geographbg:Румъния .

geographbg:Хърватия a geographbg:Държава ;
    rdfs:label "Хърватия"@bg .

geographbg:Литва a geographbg:Държава ;
    rdfs:label "Литва"@bg .

geographbg:ЧерквичкиГрамади a geographbg:КултуренОбект ;
    rdfs:label "Черквички-грамади"@bg ;
    geographbg:имаОписание "Стари ритуални обекти в Родопите. Натрупани камъни във вид на дъга с отвор в средата. Използвани за курбани, палене на свещи, поставяне на икони и дарове. Срещат се в Ситово, Добростан и Новаково (Пловдивско)."@bg ;
    geographbg:находящСеВ geographbg:Родопи ;
    geographbg:находящСеВ geographbg:СитовоСелоПловдивско ;
    geographbg:находящСеВ geographbg:ДобростанСело ;
    geographbg:находящСеВ geographbg:НоваковоСелоПловдивско .

geographbg:СитовоСелоПловдивско a geographbg:Село ;
    rdfs:label "Ситово (Пловдивско)"@bg ;
    geographbg:находящСеВ geographbg:ПловдивскоОбласт .

geographbg:ДобростанСело a geographbg:Село ;
    rdfs:label "Добростан"@bg ;
    geographbg:находящСеВ geographbg:ПловдивскоОбласт .

geographbg:НоваковоСелоПловдивско a geographbg:Село ;
    rdfs:label "Новаково (Пловдивско)"@bg ;
    geographbg:находящСеВ geographbg:ПловдивскоОбласт .

geographbg:ТаласъмСъщество a geographbg:КултуренОбект ;
    rdfs:label "Таласъм"@bg ;
    geographbg:имаОписание "Демонично същество от българската митология, което броди през Мръсните дни."@bg .

geographbg:БабаЯгаСъщество a geographbg:КултуренОбект ;
    rdfs:label "Баба Яга"@bg ;
    geographbg:имаОписание "Славянско митично същество, стара зла жена с магически способности. В Италия съответствието ѝ е Бефана. В руската митология се носи по небето в хаван."@bg ;
    geographbg:свързанС geographbg:БефанаСъщество .

geographbg:БефанаСъщество a geographbg:КултуренОбект ;
    rdfs:label "Бефана"@bg ;
    geographbg:имаОписание "Италианско митично същество, съответствие на Баба Яга. Пуска през комина чорапчета със сладкиши или въгленчета на 6 януари."@bg ;
    geographbg:свързанС geographbg:Италия .

geographbg:Италия a geographbg:Държава ;
    rdfs:label "Италия"@bg .

geographbg:ВампирСъщество a geographbg:КултуренОбект ;
    rdfs:label "Вампир (митология)"@bg ;
    geographbg:имаОписание "Митологичен персонаж, който пие кръв. В българския фолклор е дух на умрял човек, който тормози близките си, но не пие кръв. Страхува се от вода, тръни, светлина, огън, вълци. Може да се превърне в плътеник."@bg ;
    geographbg:имаАлтернативноИме "упир"@bg, "въпир"@bg, "онпыр"@bg ;
    geographbg:свързанС geographbg:ПлътеникСъщество .

geographbg:ПлътеникСъщество a geographbg:КултуренОбект ;
    rdfs:label "Плътеник"@bg ;
    geographbg:имаОписание "Материализиран вампир в българския фолклор, който оцелее повече от шест месеца. Има вид на човек със слаби кости, понякога без нокти, може да се преобразува в животни."@bg .

geographbg:ВидаЛегендарнаСестра a geographbg:КултуренОбект ;
    rdfs:label "Вида (легендарна сестра)"@bg ;
    geographbg:имаОписание "Легендарна сестра от Видинския край, дъщеря на български болярин. Не се задомила, изградила замък (Баба Вида)."@bg ;
    geographbg:свързанС geographbg:БабаВидаКрепост .

geographbg:КулаЛегендарнаСестра a geographbg:КултуренОбект ;
    rdfs:label "Кула (легендарна сестра)"@bg ;
    geographbg:имаОписание "Легендарна сестра от Видинския край, дъщеря на български болярин. Задомила се в град Кула, но съпругът ѝ пропилял наследството."@bg ;
    geographbg:свързанС geographbg:КулаГрад .

geographbg:ГъмзаЛегендарнаСестра a geographbg:КултуренОбект ;
    rdfs:label "Гъмза (легендарна сестра)"@bg ;
    geographbg:имаОписание "Легендарна сестра от Видинския край, дъщеря на български болярин. Омъжила се в Гъмзиград, но съпругът ѝ пропилял наследството."@bg ;
    geographbg:свързанС geographbg:ГъмзиградМестоположение .

geographbg:БабаВидаКрепост a geographbg:Крепост ;
    rdfs:label "Баба Вида"@bg ;
    geographbg:находящСеВ geographbg:ВидинГрад .

geographbg:ГъмзиградМестоположение a geographbg:Местоположение ; # Could be Град or Крепост
    rdfs:label "Гъмзиград"@bg ;
    geographbg:държава geographbg:Сърбия .

geographbg:ГъмзовоСело a geographbg:Село ;
    rdfs:label "Гъмзово"@bg ;
    geographbg:находящСеВ geographbg:ОбластВидин .

geographbg:ФонтанВидаКулаГъмза a geographbg:ИнфраструктуренОбект ; # Or КултуренОбект
    rdfs:label "Фонтан „Вида, Кула и Гъмза“"@bg ;
    geographbg:находящСеВ geographbg:ВидинГрад ;
    geographbg:имаОписание "Фонтан със скулптурна композиция от 3 девойки, свързвани с легендата за сестрите Вида, Кула и Гъмза."@bg .

geographbg:УлицаБабаВидаСофия a geographbg:Улица ;
    rdfs:label "Улица Баба Вида (София)"@bg ;
    geographbg:находящСеВ geographbg:КварталХаджиДимитърСофия .

geographbg:КварталХаджиДимитърСофия a geographbg:Квартал ;
    rdfs:label "Хаджи Димитър (квартал, София)"@bg ;
    geographbg:находящСеВ geographbg:София .

geographbg:ВитекСъщество a geographbg:КултуренОбект ;
    rdfs:label "Витек"@bg ;
    geographbg:имаОписание "Същество от българския фолклор, родено от човек и свръхестествен персонаж (змей, самодива) или кърмено от такъв. Отличава се с красота и сила, понякога има крилца. Бори се с лами и хали."@bg ;
    geographbg:свързанС geographbg:КралиМарко ;
    geographbg:свързанС geographbg:СекулаДетенце ;
    geographbg:свързанС geographbg:ДетеГоломеше ;
    geographbg:свързанС geographbg:МирчоЮнак ;
    geographbg:свързанС geographbg:ДойчинВойвода .

geographbg:СекулаДетенце a geographbg:КултуренОбект ;
    rdfs:label "Секула Детенце"@bg .

geographbg:ДетеГоломеше a geographbg:КултуренОбект ;
    rdfs:label "Дете Голомеше"@bg .

geographbg:МирчоЮнак a geographbg:КултуренОбект ;
    rdfs:label "Мирчо юнак"@bg .

geographbg:ДойчинВойвода a geographbg:КултуренОбект ;
    rdfs:label "Дойчин войвода"@bg .

geographbg:ВърколакСъщество a geographbg:КултуренОбект ;
    rdfs:label "Върколак"@bg ;
    geographbg:имаОписание "Митологично същество, дух на умрял човек. Живее сред хора или в гори. Заразява с ухапване. Убива се със сребро. Обитава изоставени места. Напада, пие кръв, яде. Може да има деца от жени. Предизвиква затъмнения."@bg .

geographbg:ЗмейСъщество a geographbg:КултуренОбект ;
    rdfs:label "Змей"@bg ;
    geographbg:имаАлтернативноИме "змей горянин"@bg ;
    geographbg:имаОписание "Митологично същество, огнедишащо, крилато, с люспесто тяло на змия и много глави. Може да приема антропоморфна форма. Живее в пещери или гори. Защитава села от хали и лами. Влюбва се в хора, отвлича моми. Причинява суши. Побеждава се с билки."@bg ;
    geographbg:свързанС geographbg:ХалаСъщество ;
    geographbg:свързанС geographbg:ЛамяСъщество .

geographbg:ХалаСъщество a geographbg:КултуренОбект ;
    rdfs:label "Хала"@bg ;
    geographbg:имаОписание "Зловредно същество от българския фолклор, носещо градушки."@bg .

geographbg:Змейково a geographbg:Местоположение ; # Mythical location
    rdfs:label "Змейково"@bg ;
    geographbg:имаОписание "Митично село в българските народни вярвания, където живеят самодиви, змейове и други митични същества. Намира се „накрай света“. Самодивите и змейовете живеят там през есента и зимата."@bg ;
    geographbg:свързанС geographbg:Самодива ;
    geographbg:свързанС geographbg:ЗмейСъщество ;
    geographbg:свързанС geographbg:РусалкиМитология .

geographbg:КараконджулСъщество a geographbg:КултуренОбект ;
    rdfs:label "Караконджул"@bg ;
    geographbg:имаАлтернативноИме "караконджер"@bg, "канканджур"@bg, "кара-кон"@bg, "кара-кончо"@bg, "калакандзер"@bg, "поганец"@bg, "буганец"@bg, "поганче"@bg, "меджарок"@bg, "кандзо"@bg, "гундурак"@bg, "вонкашно"@bg ;
    geographbg:имаОписание "Фолклорно създание, което плаши и вреди на хората през Мръсните дни. Космат човек с голяма глава, рога, опашка, едно око, един крак или получовек-полукон. Живее в пещери, реки, воденици. Злосторничи нощем. Плаши се от кръст, молитва, тамян, чесън, пелин."@bg ;
    geographbg:свързанС geographbg:МръсниДни .

geographbg:КикимораСъщество a geographbg:КултуренОбект ;
    rdfs:label "Кикимора"@bg ;
    geographbg:имаОписание "Домашен женски дух в славянската митология, партньорка на Домовика. Помага или вреди в зависимост от прилежността на домакинята. Вероятно дух на починала по-стара домакиня."@bg ;
    geographbg:свързанС geographbg:ДомовикСъщество .

geographbg:ДомовикСъщество a geographbg:КултуренОбект ;
    rdfs:label "Домовик"@bg ;
    geographbg:имаОписание "Домашен дух в славянската митология."@bg .

geographbg:ЛамяСъщество a geographbg:КултуренОбект ;
    rdfs:label "Ламя"@bg ;
    geographbg:имаОписание "Митологично женско същество с вид на грамадно влечуго с крила, люспи, остри нокти и зъби, и кучешки глави. Живее на дъното на езера, морета или в гори. Спира водите, изисква човешки жертви. Побеждавана от юнаци. Смесва се с халите."@bg ;
    geographbg:свързанС geographbg:ЗмейСъщество ;
    geographbg:свързанС geographbg:ХалаСъщество .

geographbg:МораСъщество a geographbg:КултуренОбект ;
    rdfs:label "Мора (митология)"@bg ;
    geographbg:имаОписание "Митично същество, зловреден дух, богиня на смъртта в славянската митология. Явява се нощем като човек или животно, за да измъчва хората, лягайки върху тях и ги задушавайки."@bg .

geographbg:МратинякСъщество a geographbg:КултуренОбект ;
    rdfs:label "Мратиняк"@bg ;
    geographbg:имаАлтернативноИме "мрата"@bg ;
    geographbg:имаОписание "Злотворен демон, причиняващ болест по кокошките. Представян като голяма черна кокошка с грозен вид. В негова чест се почита празника Мратинци."@bg ;
    geographbg:свързанС geographbg:Мратинци .

geographbg:РазковничеРастение a geographbg:РастителенВид ;
    rdfs:label "Разковниче"@bg ;
    geographbg:имаОписание "Легендарно растение с магическото свойство да отваря всичко заключено и да разкрива имане. Расте по ливадите. Костенурките умеят да го намират."@bg .

geographbg:Самодива a geographbg:КултуренОбект ;
    rdfs:label "Самодива"@bg ;
    geographbg:имаАлтернативноИме "самовила"@bg, "вила"@bg ;
    geographbg:имаОписание "Митични същества, красиви жени с крила, облечени в бяло. Живеят под стари дървета, в пещери, край води. Обичат музика и танци. Могат да са враждебни или да помагат. Яздят елени. Предпазва от тях чесън, тамян."@bg ;
    geographbg:находящСеВ geographbg:БеласицаПланина ;
    geographbg:находящСеВ geographbg:РудинаПланина ;
    geographbg:находящСеВ geographbg:Витоша ;
    geographbg:находящСеВ geographbg:Рила ;
    geographbg:находящСеВ geographbg:Родопи ;
    geographbg:находящСеВ geographbg:СтараПланина ;
    geographbg:находящСеВ geographbg:Пирин ;
    geographbg:находящСеВ geographbg:СреднаГора ;
    geographbg:находящСеВ geographbg:Змейково .

geographbg:РудинаПланина a geographbg:Планина ;
    rdfs:label "Рудина планина"@bg .

geographbg:УлицаСамодивиСофия a geographbg:Улица ;
    rdfs:label "Улица Самодиви (София)"@bg ;
    geographbg:находящСеВ geographbg:КварталДрагалевци .

geographbg:КадияИЯзаджияОбичай a geographbg:Събитие ;
    rdfs:label "Кадия и язаджия (обичай)"@bg ;
    geographbg:имаОписание "Български народен обичай, пролетна забава, играна на третия ден на Великден в Санданско. Моми се разделят на две групи, едната с кадия и язаджия, другата с баща, майка и челяд. Децата се преструват на куци, кадията ги „съди“, а накрая децата замерят „родителите“ с камъчета."@bg ;
    geographbg:свързанС geographbg:СанданскоРегион .

geographbg:КоледуванеОбичай a geographbg:Събитие ;
    rdfs:label "Коледуване (обичай)"@bg ;
    geographbg:имаОписание "Традиционен български обичай, част от Коледа и Мръсните дни. Младежи (коледари) с водач (станеник) обикалят домове, пеят песни за здраве и плодородие, получават дарове. Подготовката започва от Игнажден. Изпълнява се от полунощ до изгрев на Коледа."@bg ;
    geographbg:свързанС geographbg:КоледаПразник ;
    geographbg:свързанС geographbg:МръсниДни ;
    geographbg:държава geographbg:България, geographbg:Сърбия, geographbg:Русия, geographbg:Украйна, geographbg:Беларус, geographbg:Чехия, geographbg:Словакия, geographbg:Полша, geographbg:СевернаМакедония, geographbg:Румъния .

geographbg:КръщениеБългарскиНародниОбичаиОбичай a geographbg:Събитие ;
    rdfs:label "Кръщение (български народни обичаи)"@bg ;
    geographbg:имаОписание "Обичаи, свързани с кръщаването на дете, преплитащи християнски и езически елементи. Кръстникът е главно обредно лице. Включва калесване, църковен ритуал, празнична трапеза, даряване, избиране и обявяване на името. Обичай „хвърляне на детето“ за избор на нов кръстник."@bg .

geographbg:ЛадуванеОбичай a geographbg:Събитие ;
    rdfs:label "Ладуване (обичай)"@bg ;
    geographbg:имаОписание "Традиционен български момински обичай за гадаене за женитба, изпълняван на Васильовден, Гергьовден или Еньовден. Моми събират „мълчана вода“, пускат пръстени или китки, които дете изважда под съпровода на припевки."@bg ;
    geographbg:свързанС geographbg:ВасильовденПразник ;
    geographbg:свързанС geographbg:ГергьовденПразник ;
    geographbg:свързанС geographbg:ЕньовденПразник .

geographbg:ЛазаруванеОбичай a geographbg:Събитие ;
    rdfs:label "Лазаруване (обичай)"@bg ;
    geographbg:имаОписание "Славянски обичай на Лазаровден. Девойки (лазарки) над 12 г. в невестинско облекло обикалят полето и къщите, пеят и играят за любов, плодородие и здраве. В бовския край има „мятане“ на кърпа. В Северна България събират яйца."@bg ;
    geographbg:свързанС geographbg:ЛазаровденПразник ;
    geographbg:свързанС geographbg:БовскиКрай ;
    geographbg:свързанС geographbg:СевернаБългарияЕтнографскаОбласт .

geographbg:ЛеденоХороОбичай a geographbg:Събитие ;
    rdfs:label "Ледено хоро (обичай)"@bg ;
    geographbg:имаАлтернативноИме "мъжко хоро"@bg ;
    geographbg:имаОписание "Сравнително нов български обичай в Калофер на Йордановден. Мъже играят хоро в ледените води на р. Тунджа. Започва през 70-те г. на XX в. Изпълнява се и в други градове."@bg ;
    geographbg:находящСеВ geographbg:КалоферГрад ;
    geographbg:преминаваПрез geographbg:ТунджаРека ;
    geographbg:свързанС geographbg:ЙордановденПразник .

geographbg:МараЛишанкаОбичайОбичай a geographbg:Събитие ;
    rdfs:label "Мара Лишанка (обичай)"@bg ;
    geographbg:имаОписание "Момински обичай сред рупците в Странджа, изпълняван в срядата след Великден за плодородие, дъжд и предпазване от злини. Приготвя се кукла „Мара Лишанка“ от чехли, носи се от мома, пеят се песни, накрая куклата се „изкъпва“ в река."@bg ;
    geographbg:свързанС geographbg:СтранджаЕтнографскаОбласт ;
    geographbg:свързанС geographbg:РупциЕтнографскаГрупа .

geographbg:МишаСватбаОбичай a geographbg:Събитие ;
    rdfs:label "Миша сватба (обичай)"@bg ;
    geographbg:имаОписание "Обред за предпазване от мишки. Две жени улавят мъжка и женска мишка, стъкмяват ги като младоженци и ги изнасят извън землището под съпровода на сватбарска музика, след което ги пускат. Следва общоселска трапеза."@bg ;
    geographbg:държава geographbg:България .

geographbg:ОбреденХлябОбичай a geographbg:КултуренОбект ; # More of an object than an event itself
    rdfs:label "Обреден хляб (обичай)"@bg ;
    geographbg:имаОписание "Традиционно ястие, свързано с обреди около брака, раждането, погребенията, строежите, времето и медицината. Символизира плодородието и добруването. Замесва се от полово чисти жени с нов квас и мълчана вода. Има богата пластична украса."@bg .

geographbg:ПаликошОбичай a geographbg:Събитие ;
    rdfs:label "Паликош (обичай)"@bg ;
    geographbg:имаОписание "Народен обичай, разновидност на обредния огън на Сирни заговезни в Източна Тракия и сред източнотракийските преселници в Добруджа. Стар кош със слама се запалва и издига, докато мъжете обявяват сторени пакости и грешки."@bg ;
    geographbg:свързанС geographbg:СирниЗаговезниПразник ;
    geographbg:свързанС geographbg:ИзточнаТракия ;
    geographbg:свързанС geographbg:ДобруджаЕтнографскаОбласт .

geographbg:ПерницаОбичай a geographbg:КултуренОбект ; # More of an object than an event itself
    rdfs:label "Перница (обичай)"@bg ;
    geographbg:имаОписание "Малки стрелички (13-25 см) от дърво „мекиш“. Видове: обикновена перница, местница, картупъл. Изстрелват се нощем с две дървени пръчки, като ушите им се запалват. Свързани с пожелания."@bg .

geographbg:СурваканеОбичай a geographbg:Събитие ;
    rdfs:label "Сурвакане (обичай)"@bg ;
    geographbg:имаОписание "Български народен обичай на Сурваки. Сурвакари (деца или ергени) обхождат домове, сурвакат със сурвачка за здраве и плодородие, получават дарове. Регионални варианти включват „Носене на камък“ в Родопите."@bg ;
    geographbg:свързанС geographbg:СурвакиПразник ;
    geographbg:свързанС geographbg:Сурвачка .

geographbg:ТримиренеОбичай a geographbg:Събитие ;
    rdfs:label "Тримирене (обичай)"@bg ;
    geographbg:имаАлтернативноИме "Тримеро"@bg, "Търпило"@bg, "Едноница"@bg ;
    geographbg:имаОписание "Спазване на строг пост през първите три дни на Тодоровата неделя. В последния ден тримерникът се причестява и раздава постна храна. Смята се за „живо одуше“."@bg ;
    geographbg:свързанС geographbg:ТодороваНеделя .

geographbg:УрочасванеВярване a geographbg:КултуренОбект ; # More a belief/concept
    rdfs:label "Урочасване"@bg ;
    geographbg:имаАлтернативноИме "лоши очи"@bg ;
    geographbg:имаОписание "Суеверие за вредния ефект от погледа на някои хора. Предполага се, че причинява болести, провали. Предпазни мерки включват воали, рибарски мрежи, муски, талисмани, баене, леене на куршум."@bg .

geographbg:СтииСъщество a geographbg:КултуренОбект ;
    rdfs:label "Стии"@bg ;
    geographbg:имаОписание "Свръхестествени същества от вярванията в Македония. Във Велешко са водни духове (жени с дълги коси, давещи хора). В Битолско са дух-пазител на дома, имота, съкровище, с облик на голяма змия."@bg ;
    geographbg:свързанС geographbg:МакедонияЕтнографскаОбласт ;
    geographbg:свързанС geographbg:ВелешкоОбласт ;
    geographbg:свързанС geographbg:БитолскоОбласт .

geographbg:БитолскоОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Битолско"@bg .

geographbg:ДовледжикСело a geographbg:Село ;
    rdfs:label "Довледжик"@bg ;
    geographbg:находящСеВ geographbg:БитолскоОбласт .

geographbg:КръстоорСело a geographbg:Село ;
    rdfs:label "Кръстоор"@bg ;
    geographbg:находящСеВ geographbg:БитолскоОбласт .

geographbg:РаизаниСело a geographbg:Село ;
    rdfs:label "Раизани"@bg ; # Assuming this is a village name, might need disambiguation
    geographbg:находящСеВ geographbg:БитолскоОбласт .

geographbg:ТаласъмСъщество
    geographbg:имаАлтернативноИме "дракус"@bg, "таласъмин"@bg, "таласон"@bg, "талсон"@bg, "сенкя"@bg, "сенище"@bg, "явина"@bg ;
    geographbg:имаОписание "Зъл невидим дух, обитаващ мостове, чешми, сгради. Може да приема облик на куче или котка. Възниква от зазидан човек или имане. В Родопите е познат като дракус. Може да бъде прогонен с ритуал."@bg ;
    geographbg:свързанС geographbg:Родопи .

geographbg:ХунорИМагорЛегенда a geographbg:КултуренОбект ;
    rdfs:label "Хунор и Магор (легенда)"@bg ;
    geographbg:имаОписание "Унгарска легенда за прародителите на хуните и маджарите, синове на цар Нимрод или Яфет. Подгонили вълшебен елен, намерили и се оженили за дъщерите на аланския княз Дула. Наследниците на Хунор са хуните, на Магор - маджарите."@bg ;
    geographbg:свързанС geographbg:Хуни ;
    geographbg:свързанС geographbg:Маджари ;
    geographbg:свързанС geographbg:Скития ;
    geographbg:свързанС geographbg:Крим .

geographbg:Хуни a geographbg:ИсторическаОбласт ; # Placeholder for people/tribe
    rdfs:label "Хуни"@bg .

geographbg:Маджари a geographbg:ИсторическаОбласт ; # Placeholder for people/tribe
    rdfs:label "Маджари"@bg .

geographbg:Скития a geographbg:ИсторическаОбласт ;
    rdfs:label "Скития"@bg .

geographbg:Крим a geographbg:Полуостров ; # Or ИсторическаОбласт
    rdfs:label "Крим"@bg ;
    geographbg:имаИзлазНа geographbg:ЧерноМоре .

geographbg:ЮдаСъщество a geographbg:КултуренОбект ;
    rdfs:label "Юда (митология)"@bg ;
    geographbg:имаОписание "Зло женско митично същество в българския фолклор, сродно на самодивите. Обитава гори и планини. Занимава се с билкарство и отровителство. Омайва млади мъже и отвлича душите им. Предпазват от нея листа от вратика, босилек, комунига или пелин."@bg ;
    geographbg:свързанС geographbg:Самодива .

geographbg:БългарскаНароднаМузика a geographbg:КултуренОбект ; # Genre
    rdfs:label "Българска народна музика"@bg ;
    geographbg:имаОписание "Музикален жанр, базиран на традиционния музикален фолклор. Предимно вокална, с неравноделни размери. Разделена на фолклорни области: Северняшка, Добруджанска, Шопска, Тракийска, Странджанска, Македонска, Родопска. Основни инструменти: гайда, кавал, гъдулка, булгарина, тъпан."@bg ;
    geographbg:свързанС geographbg:СеверняшкаФолклорнаОбласт ;
    geographbg:свързанС geographbg:ДобруджанскаФолклорнаОбласт ;
    geographbg:свързанС geographbg:ШопскаФолклорнаОбласт ;
    geographbg:свързанС geographbg:ТракийскаФолклорнаОбласт ;
    geographbg:свързанС geographbg:СтранджанскаФолклорнаОбласт ;
    geographbg:свързанС geographbg:МакедонскаФолклорнаОбласт ;
    geographbg:свързанС geographbg:РодопскаФолклорнаОбласт .

geographbg:СеверняшкаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Северняшка фолклорна област"@bg .

geographbg:ДобруджанскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Добруджанска фолклорна област"@bg .

geographbg:ШопскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Шопска фолклорна област"@bg .

geographbg:ТракийскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Тракийска фолклорна област"@bg .

geographbg:СтранджанскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Странджанска фолклорна област"@bg .

geographbg:МакедонскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Македонска фолклорна област"@bg .

geographbg:РодопскаФолклорнаОбласт a geographbg:ЕтнографскаОбласт ;
    rdfs:label "Родопска фолклорна област"@bg .

geographbg:НеделинскиДвуглас a geographbg:КултуренОбект ; # Musical style
    rdfs:label "Неделински двуглас"@bg ;
    geographbg:имаОписание "Специфично пеене от Неделино, с кварти и секунди. Различава се от родопското пеене. Първият глас „води“, вторият „следи“. Песните са предимно безмензурни. Националният фолклорен фестивал в Неделино пази традицията."@bg ;
    geographbg:находящСеВ geographbg:НеделиноГрад .

geographbg:НационаленФолклоренФестивалНеделино a geographbg:Събитие ;
    rdfs:label "Национален фолклорен фестивал за двугласно пеене и народна песен (Неделино)"@bg ;
    geographbg:находящСеВ geographbg:НеделиноГрад ;
    geographbg:основанПрезГодина "2002"^^xsd:integer .

geographbg:АлбумПеснитеНаНашитеДеца a geographbg:КултуренОбект ; # Album
    rdfs:label "Песните на нашите деца (албум)"@bg ;
    geographbg:имаОписание "Втори фолклорен албум на Димитър Аргиров, издаден 2016 г. Посветен на 85-год. от рождението на Илия Аргиров. Съдържа 12 песни от репертоара на Илия Аргиров, три в дует."@bg ;
    geographbg:основанПрезГодина "2016"^^xsd:integer .

geographbg:АлбумПиринскиЦветя a geographbg:КултуренОбект ; # Album
    rdfs:label "Пирински цветя (албум)"@bg ;
    geographbg:имаОписание "Трети фолклорен албум на Димитър Аргиров, издаден 2017 г. Посветен на 50-год. юбилей на певеца и 5-год. от кончината на баща му Илия Аргиров. Съдържа 12 студийни и 1 концертна песен."@bg ;
    geographbg:основанПрезГодина "2017"^^xsd:integer .

geographbg:СватбарскаМузика a geographbg:КултуренОбект ; # Genre
    rdfs:label "Сватбарска музика"@bg ;
    geographbg:имаОписание "Жанр в българската народна музика, популярен през 70-те и 80-те г. на XX в. Изпълнявана от сватбарски оркестри. Характеризира се с виртуозни инструментални изпълнения, импровизация и интеграция на цигански, турски, сръбски и джаз елементи. Надсвирването в Стамболово е важна сцена."@bg ;
    geographbg:свързанС geographbg:НадсвирванеСтамболово .

geographbg:НадсвирванеСтамболово a geographbg:Събитие ;
    rdfs:label "Надсвирване в Стамболово"@bg ;
    geographbg:находящСеВ geographbg:СтамболовоСелоХасково .

geographbg:СтамболовоСелоХасково a geographbg:Село ;
    rdfs:label "Стамболово (Хасковско)"@bg ;
    geographbg:находящСеВ geographbg:ОбластХасково .

geographbg:СтариГрадскиПесни a geographbg:КултуренОбект ; # Genre
    rdfs:label "Стари градски песни"@bg ;
    geographbg:имаОписание "Жанр от българския песенен фолклор, развил се в началото на ХХ в. Тематиката е битова, хумористична и любовна. Николай Кауфман събира и издава сборник с 1500 такива песни."@bg .

geographbg:ТянковТВ a geographbg:Организация ;
    rdfs:label "Тянков ТВ"@bg ;
    geographbg:основанПрезГодина "2007"^^xsd:integer ;
    geographbg:имаОписание "Български музикален канал, излъчващ предимно българска народна музика. Централата е в с. Тополово, Пловдивско."@bg ;
    geographbg:находящСеВ geographbg:ТополовоСело .

geographbg:ФолклорТВ a geographbg:Организация ;
    rdfs:label "Фолклор ТВ"@bg ;
    geographbg:основанПрезГодина "2006"^^xsd:integer ;
    geographbg:имаОписание "Музикален телевизионен канал за българска народна музика. Представя ансамбли, доайени и популярни изпълнители. Собственост на Николина Чакърдъкова."@bg .

geographbg:БалканътПееИРазказва a geographbg:Събитие ;
    rdfs:label "Балканът пее и разказва"@bg ;
    geographbg:имаОписание "Фолклорен празник на балканските градове Елена, Дряново, Котел, Трявна, Твърдица и Гурково. Първият празник е в Елена през 1974 г. Провежда се на ротационен принцип."@bg ;
    geographbg:основанПрезГодина "1974"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ЕленаГрад ;
    geographbg:находящСеВ geographbg:ДряновоГрад ;
    geographbg:находящСеВ geographbg:КотелГрад ;
    geographbg:находящСеВ geographbg:ТрявнаГрад ;
    geographbg:находящСеВ geographbg:ТвърдицаГрад ;
    geographbg:находящСеВ geographbg:ГурковоГрад .

geographbg:КотелГрад a geographbg:Град ;
    rdfs:label "Котел"@bg .

geographbg:ТрявнаГрад a geographbg:Град ;
    rdfs:label "Трявна"@bg .

geographbg:МеждународенФолклоренФестивалВарна a geographbg:Събитие ;
    rdfs:label "Международен фолклорен фестивал във Варна"@bg ;
    geographbg:имаОписание "Ежегодно събитие от 1992 г. Провежда се в началото на август. Представя състави за народна музика и танци от различни националности. Проявите са на различни сцени в града и курортни комплекси."@bg ;
    geographbg:основанПрезГодина "1992"^^xsd:integer ;
    geographbg:находящСеВ geographbg:ВарнаГрад ;
    geographbg:находящСеВ geographbg:ПлощадНезависимостВарна ;
    geographbg:находящСеВ geographbg:ЛетенТеатърВарна ;
    geographbg:находящСеВ geographbg:СценаРаковинаВарна ;
    geographbg:находящСеВ geographbg:СвСвКонстантинИЕлена ;
    geographbg:находящСеВ geographbg:ПаркАспаруховоВарна ;
    geographbg:находящСеВ geographbg:ПаркВладиславовоВарна ;
    geographbg:находящСеВ geographbg:ПаркМладостВарна .

